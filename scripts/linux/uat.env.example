DSE_DEPLOYMENT_ENVIRONMENT=UAT
# Desktop compatibility floor. Keep 10.0.1 while 10.x releases remain backward compatible.
# Raise only when a release intentionally breaks compatibility with older supported desktops.
DSE_MINIMUM_SUPPORTED_DESKTOP_VERSION=10.0.1
# Android/iOS release policy is independent of the DSE server/desktop version.
DSE_MINIMUM_SUPPORTED_ANDROID_VERSION=1.2.3
DSE_LATEST_ANDROID_VERSION=1.2.3
DSE_MINIMUM_SUPPORTED_IOS_VERSION=1.2.3
DSE_LATEST_IOS_VERSION=1.2.3
DSE_SERVER_ADDRESS=127.0.0.1
DSE_SERVER_PORT=8081
DSE_DB_URL=jdbc:postgresql://127.0.0.1:5432/dse_erp_uat
DSE_DB_USERNAME=dse_erp_uat_app
DSE_DB_PASSWORD=CHANGE_ME
DSE_EXPECTED_DATABASE=dse_erp_uat
DSE_WORKSPACE_PATH=/srv/dse-erp/uat
DSE_POSTGRES_HOME=/usr/lib/postgresql/18
DSE_SERVER_BACKUP_ENABLED=true
DSE_BUSINESS_TIME_ZONE=Asia/Kolkata
DSE_BUSINESS_DATE_FORMAT=dd/MM/yyyy
