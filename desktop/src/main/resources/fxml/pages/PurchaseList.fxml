<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.PurchaseListController" styleClass="register-page,purchase-register-page,approved-ui,approved-screen,approved-screen-purchase-list,erp-screen-root">
 <top><VBox spacing="8" styleClass="register-top,purchase-register-top,erp-transparent-section-stack"><padding><Insets top="10" right="14" bottom="4" left="14"/></padding><HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header,purchase-register-hero"><StackPane fx:id="purchasePageIcon" styleClass="erp-page-header-icon"/><VBox spacing="3"><Label text="Purchase Register" styleClass="screen-title"/><Label text="Manage supplier purchases, payments and purchase communication" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnNewPurchase" text="Create Purchase" onAction="#newPurchase" styleClass="primary-action"/></HBox></VBox></top>
 <center><SplitPane fx:id="mainSplit" dividerPositions="0.8" styleClass="register-split,purchase-register-split"><padding><Insets top="10" right="14" bottom="14" left="14"/></padding><items><VBox spacing="10" styleClass="register-workspace,purchase-register-workspace"><padding><Insets top="0" right="12" bottom="0" left="0"/></padding><HBox spacing="12" styleClass="standard-kpi-row,erp-kpi-section">
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-blue" HBox.hgrow="ALWAYS"><StackPane fx:id="purchaseTotalIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Total Purchases" styleClass="metric-label"/><Label fx:id="lblTotal" styleClass="metric-value"/><Label fx:id="lblTotalCount" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-green" HBox.hgrow="ALWAYS"><StackPane fx:id="purchaseOrdersIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Total Orders" styleClass="metric-label"/><Label fx:id="lblToday" styleClass="metric-value"/><Label fx:id="lblTodayCount" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-orange" HBox.hgrow="ALWAYS"><StackPane fx:id="purchaseSuppliersIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Total Suppliers" styleClass="metric-label"/><Label fx:id="lblPending" styleClass="metric-value"/><Label fx:id="lblPendingCount" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-red" HBox.hgrow="ALWAYS"><StackPane fx:id="purchaseItemsIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Total Items" styleClass="metric-label"/><Label fx:id="lblOverdue" styleClass="metric-value"/><Label fx:id="lblOverdueCount" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-purple" HBox.hgrow="ALWAYS"><StackPane fx:id="purchasePaidIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Total Paid" styleClass="metric-label"/><Label fx:id="lblPaid" styleClass="metric-value"/><Label text="All Time" styleClass="metric-note"/></VBox></HBox>
</HBox><VBox spacing="10" styleClass="filter-surface,approved-filter-bar,erp-filter-section"><padding><Insets top="10" right="12" bottom="10" left="12"/></padding><HBox spacing="8"><TextField fx:id="txtSearch" promptText="Search invoice, supplier, mobile or GSTIN..." HBox.hgrow="ALWAYS" styleClass="approved-input"/><ToggleButton fx:id="btnAdvanced" selected="true" text="Advanced Filters" onAction="#toggleAdvanced"/><Button fx:id="btnReset" text="Reset" onAction="#resetFilters" styleClass="secondary-button"/><Button fx:id="btnRefresh" text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/></HBox><GridPane fx:id="advancedFilters" hgap="10" vgap="8"><columnConstraints><ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/></columnConstraints><VBox spacing="3"><Label text="Supplier" styleClass="filter-label"/><ComboBox fx:id="cmbSupplier" maxWidth="Infinity" styleClass="approved-input"/></VBox><VBox spacing="3" GridPane.columnIndex="1"><Label text="From Date" styleClass="filter-label"/><DatePicker fx:id="dpFrom" maxWidth="Infinity" styleClass="approved-input"/></VBox><VBox spacing="3" GridPane.columnIndex="2"><Label text="To Date" styleClass="filter-label"/><DatePicker fx:id="dpTo" maxWidth="Infinity" styleClass="approved-input"/></VBox><VBox spacing="3" GridPane.columnIndex="3"><Label text="Payment Status" styleClass="filter-label"/><ComboBox fx:id="cmbPaymentStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox><VBox spacing="3" GridPane.columnIndex="4"><Label text="Email Status" styleClass="filter-label"/><ComboBox fx:id="cmbMailStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox></GridPane><HBox spacing="8" alignment="CENTER_LEFT" styleClass="quick-date-row"><Button fx:id="btnTodayRange" text="Today" onAction="#showToday" styleClass="quick-range-button,approved-button,approved-secondary-button"/><Button fx:id="btnYesterdayRange" text="Yesterday" onAction="#showYesterday" styleClass="quick-range-button,approved-button,approved-secondary-button"/><Button fx:id="btnSevenDaysRange" text="7 Days" onAction="#showSevenDays" styleClass="quick-range-button,approved-button,approved-secondary-button"/><Button fx:id="btnThirtyDaysRange" text="30 Days" onAction="#showThirtyDays" styleClass="quick-range-button,approved-button,approved-secondary-button"/><Button fx:id="btnCustomRange" text="Custom Range" onAction="#showCustomRange" styleClass="quick-range-button,quick-range-custom,approved-button,approved-secondary-button"/></HBox></VBox>
 <TableView fx:id="tablePurchase" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="colInvoice" text="Invoice No." prefWidth="125" styleClass="approved-table-column"/><TableColumn fx:id="colDate" text="Date" prefWidth="90" styleClass="approved-table-column"/><TableColumn fx:id="colSupplier" text="Supplier" prefWidth="180" styleClass="approved-table-column"/><TableColumn fx:id="colMobile" text="Mobile" prefWidth="105" styleClass="approved-table-column"/><TableColumn fx:id="colAmount" text="Amount" prefWidth="105" styleClass="approved-table-column"/><TableColumn fx:id="colPaid" text="Paid" prefWidth="100" styleClass="approved-table-column"/><TableColumn fx:id="colBalance" text="Balance" prefWidth="100" styleClass="approved-table-column"/><TableColumn fx:id="colDue" text="Payment Due" prefWidth="120" styleClass="approved-table-column"/><TableColumn fx:id="colStatus" text="Status" prefWidth="90" styleClass="approved-table-column"/><TableColumn fx:id="colMail" text="Email" prefWidth="80" styleClass="approved-table-column"/><TableColumn fx:id="colActions" text="Actions" prefWidth="118" styleClass="approved-table-column"/></columns></TableView><HBox spacing="10" alignment="CENTER_LEFT" styleClass="table-footer"><padding><Insets top="9" right="12" bottom="9" left="12"/></padding><Label fx:id="lblPageInfo" styleClass="muted-text,register-record-count"/><Region HBox.hgrow="ALWAYS"/><Label text="Rows per page:"/><ComboBox fx:id="cmbPageSize" prefWidth="75" styleClass="approved-input"/><Button fx:id="btnFirstPage" text="First" onAction="#firstPage" styleClass="pager-button,approved-button,approved-secondary-button"/><Button fx:id="btnPreviousPage" text="Previous" onAction="#previousPage" styleClass="pager-button,approved-button,approved-secondary-button"/><Label fx:id="lblPageNumber" styleClass="page-number"/><Button fx:id="btnNextPage" text="Next" onAction="#nextPage" styleClass="pager-button,approved-button,approved-secondary-button"/><Button fx:id="btnLastPage" text="Last" onAction="#lastPage" styleClass="pager-button,approved-button,approved-secondary-button"/></HBox><HBox spacing="10" styleClass="export-bar" alignment="CENTER_LEFT"><padding><Insets top="10" right="12" bottom="10" left="12"/></padding><Button fx:id="btnExportExcel" text="Export Excel" onAction="#exportPurchase" styleClass="secondary-button"/><Button fx:id="btnExportPdf" text="Export PDF" onAction="#exportPdf" styleClass="secondary-button"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblSummary" styleClass="summary-amount,register-total-summary"/></HBox></VBox>
 <VBox fx:id="detailDrawer" spacing="11" prefWidth="300" minWidth="280" maxWidth="320" styleClass="detail-drawer,purchase-detail-drawer"><padding><Insets top="16" right="14" bottom="16" left="14"/></padding><HBox><Label text="Purchase Details" styleClass="drawer-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnCloseDetails" text="Close" onAction="#closeDetails" styleClass="danger-button,drawer-close-button,approved-button"/></HBox><Label fx:id="lblDetailInvoice" styleClass="drawer-document"/><Label fx:id="lblDetailSupplier" styleClass="drawer-customer"/><Label fx:id="lblDetailContact" styleClass="muted-text" wrapText="true"/><Separator/><GridPane hgap="12" vgap="8"><Label text="Invoice Amount"/><Label fx:id="lblDetailAmount" GridPane.columnIndex="1" styleClass="drawer-money"/><Label text="Paid" GridPane.rowIndex="1"/><Label fx:id="lblDetailPaid" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="summary-paid"/><Label text="Balance" GridPane.rowIndex="2"/><Label fx:id="lblDetailBalance" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="summary-balance"/><Label text="Due" GridPane.rowIndex="3"/><Label fx:id="lblDetailDue" GridPane.rowIndex="3" GridPane.columnIndex="1"/><Label text="GST Amount" GridPane.rowIndex="4"/><Label fx:id="lblDetailGst" GridPane.rowIndex="4" GridPane.columnIndex="1"/><Label text="Reference" GridPane.rowIndex="5"/><Label fx:id="lblDetailReference" GridPane.rowIndex="5" GridPane.columnIndex="1" wrapText="true"/><Label text="Payment Terms" GridPane.rowIndex="6"/><Label fx:id="lblDetailPaymentTerms" GridPane.rowIndex="6" GridPane.columnIndex="1" wrapText="true"/></GridPane><Separator/><Label text="Supplier Contact" styleClass="drawer-section"/><GridPane hgap="10" vgap="6"><Label text="Contact"/><Label fx:id="lblDetailContactPerson" GridPane.columnIndex="1"/><Label text="Phone" GridPane.rowIndex="1"/><Label fx:id="lblDetailPhone" GridPane.rowIndex="1" GridPane.columnIndex="1"/><Label text="Email" GridPane.rowIndex="2"/><Label fx:id="lblDetailEmail" GridPane.rowIndex="2" GridPane.columnIndex="1" wrapText="true"/><Label text="GSTIN" GridPane.rowIndex="3"/><Label fx:id="lblDetailGstin" GridPane.rowIndex="3" GridPane.columnIndex="1" wrapText="true"/></GridPane><Separator/><Label text="Quick Actions" styleClass="drawer-section"/><Button text="Record Supplier Payment" onAction="#paySelected" styleClass="approved-button,approved-primary-button"/><Button text="View / Print PDF" onAction="#pdfSelected" styleClass="approved-button,approved-secondary-button"/><Button text="Email Supplier" onAction="#emailSelected" styleClass="approved-button,approved-secondary-button"/><Region VBox.vgrow="ALWAYS"/><Button text="Close" onAction="#closeDetails" styleClass="secondary-button"/></VBox></items></SplitPane></center>
</BorderPane>