<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.PurchaseListController" styleClass="register-page,purchase-register-page,approved-ui,approved-screen,approved-screen-purchase-list,erp-screen-root">
 <top><VBox spacing="8" styleClass="register-top,purchase-register-top,erp-transparent-section-stack"><padding><Insets top="10" right="14" bottom="4" left="14"/></padding><HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header,purchase-register-hero"><StackPane fx:id="purchasePageIcon" styleClass="erp-page-header-icon"/><VBox spacing="3"><Label text="Purchase Register" styleClass="screen-title"/><Label text="Manage supplier purchases, payments and purchase communication" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><StackPane prefWidth="340" minWidth="240" maxWidth="360" styleClass="erp-item-search-shell,register-header-search-shell,purchase-header-search-shell"><TextField fx:id="txtSearch" promptText="Search invoice, supplier, mobile or GSTIN..." maxWidth="Infinity" styleClass="approved-input,erp-item-search,register-header-search-input"/><StackPane fx:id="purchaseHeaderSearchIcon" mouseTransparent="true" minWidth="24" prefWidth="24" maxWidth="24" minHeight="24" prefHeight="24" maxHeight="24" StackPane.alignment="CENTER_RIGHT" styleClass="erp-item-search-icon-box,register-header-search-icon"><StackPane.margin><Insets right="8"/></StackPane.margin></StackPane></StackPane><Button fx:id="btnNewPurchase" text="Create Purchase" onAction="#newPurchase" styleClass="primary-action"/></HBox></VBox></top>
 <center><SplitPane fx:id="mainSplit" dividerPositions="0.8" styleClass="register-split,purchase-register-split"><items><VBox spacing="10" styleClass="register-workspace,purchase-register-workspace"><padding><Insets top="0" right="12" bottom="0" left="0"/></padding><HBox spacing="12" styleClass="standard-kpi-row,erp-kpi-section">
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-blue" HBox.hgrow="ALWAYS"><StackPane fx:id="purchaseTotalIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Active Purchases" styleClass="metric-label"/><Label fx:id="lblTotal" styleClass="metric-value"/><Label fx:id="lblTotalCount" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-green" HBox.hgrow="ALWAYS"><StackPane fx:id="purchaseOrdersIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Total Orders" styleClass="metric-label"/><Label fx:id="lblToday" styleClass="metric-value"/><Label fx:id="lblTodayCount" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-orange" HBox.hgrow="ALWAYS"><StackPane fx:id="purchaseSuppliersIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Total Suppliers" styleClass="metric-label"/><Label fx:id="lblPending" styleClass="metric-value"/><Label fx:id="lblPendingCount" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-red" HBox.hgrow="ALWAYS"><StackPane fx:id="purchaseItemsIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Total Items" styleClass="metric-label"/><Label fx:id="lblOverdue" styleClass="metric-value"/><Label fx:id="lblOverdueCount" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-purple" HBox.hgrow="ALWAYS"><StackPane fx:id="purchasePaidIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Total Paid" styleClass="metric-label"/><Label fx:id="lblPaid" styleClass="metric-value"/><Label text="All Time" styleClass="metric-note"/></VBox></HBox>
</HBox><VBox spacing="10" styleClass="filter-surface,approved-filter-bar,erp-filter-section">
  <GridPane hgap="10" vgap="7" styleClass="register-visible-filter-grid,purchase-visible-filter-grid">
    <columnConstraints><ColumnConstraints percentWidth="22"/><ColumnConstraints percentWidth="16"/><ColumnConstraints percentWidth="16"/><ColumnConstraints percentWidth="22"/><ColumnConstraints percentWidth="24"/></columnConstraints>
    <VBox spacing="4"><Label text="Supplier" styleClass="filter-label,filter-label-supplier"/><ComboBox fx:id="cmbSupplier" promptText="All Suppliers" maxWidth="Infinity" styleClass="approved-input"/></VBox>
    <VBox spacing="4" GridPane.columnIndex="1"><Label text="From Date" styleClass="filter-label,filter-label-date"/><DatePicker fx:id="dpFrom" maxWidth="Infinity" styleClass="approved-input"/></VBox>
    <VBox spacing="4" GridPane.columnIndex="2"><Label text="To Date" styleClass="filter-label,filter-label-date"/><DatePicker fx:id="dpTo" maxWidth="Infinity" styleClass="approved-input"/></VBox>
    <VBox spacing="4" GridPane.columnIndex="3"><Label text="Document Status" styleClass="filter-label,filter-label-document"/><ComboBox fx:id="cmbDocumentStatus" promptText="Document Status" maxWidth="Infinity" styleClass="approved-input"/></VBox>
    <VBox spacing="4" GridPane.columnIndex="4"><Label text="Payment Status" styleClass="filter-label,filter-label-payment"/><ComboBox fx:id="cmbPaymentStatus" promptText="Payment Status" maxWidth="Infinity" styleClass="approved-input"/></VBox>
  </GridPane>
  <GridPane fx:id="advancedFilters" hgap="10" vgap="8" visible="false" managed="false">
    <VBox spacing="3"><Label text="Email Status" styleClass="filter-label"/><ComboBox fx:id="cmbMailStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox>
  </GridPane>
  <HBox spacing="8" alignment="CENTER_LEFT" styleClass="quick-date-row,register-quick-range-row">
    <Button fx:id="btnAllDatesRange" text="All Date" onAction="#showAllDates" styleClass="quick-range-button,quick-range-all,approved-button,approved-secondary-button"/>
    <Button fx:id="btnTodayRange" text="Today" onAction="#showToday" styleClass="quick-range-today,quick-range-button,quick-range-today,approved-button,approved-secondary-button"/>
    <Button fx:id="btnYesterdayRange" text="Yesterday" onAction="#showYesterday" styleClass="quick-range-yesterday,quick-range-button,quick-range-yesterday,approved-button,approved-secondary-button"/>
    <Button fx:id="btnSevenDaysRange" text="7 Days" onAction="#showSevenDays" styleClass="quick-range-button,quick-range-seven,approved-button,approved-secondary-button"/>
    <Button fx:id="btnThirtyDaysRange" text="30 Days" onAction="#showThirtyDays" styleClass="quick-range-button,quick-range-thirty,approved-button,approved-secondary-button"/>
    <Button fx:id="btnCustomRange" text="Custom Range" onAction="#showCustomRange" visible="false" managed="false" styleClass="quick-range-button,quick-range-custom,approved-button,approved-secondary-button"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="btnReset" text="Reset" onAction="#resetFilters" styleClass="secondary-button,register-reset-button"/>
    <Button fx:id="btnRefresh" text="Refresh" onAction="#refreshWithFeedback" styleClass="approved-button,approved-secondary-button,register-refresh-button"/>
  </HBox>
</VBox>
 <TableView fx:id="tablePurchase" minHeight="0" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="colInvoice" text="Invoice No." prefWidth="125" styleClass="approved-table-column"/><TableColumn fx:id="colDate" text="Date" prefWidth="90" styleClass="approved-table-column"/><TableColumn fx:id="colSupplier" text="Supplier" prefWidth="180" styleClass="approved-table-column"/><TableColumn fx:id="colMobile" text="Mobile" prefWidth="105" styleClass="approved-table-column"/><TableColumn fx:id="colAmount" text="Amount" prefWidth="105" styleClass="approved-table-column"/><TableColumn fx:id="colPaid" text="Paid" prefWidth="100" styleClass="approved-table-column"/><TableColumn fx:id="colBalance" text="Pending" prefWidth="100" styleClass="approved-table-column"/><TableColumn fx:id="colDue" text="Payment Due" prefWidth="120" styleClass="approved-table-column"/><TableColumn fx:id="colStatus" text="Document Status" prefWidth="110" styleClass="approved-table-column"/><TableColumn fx:id="colPaymentStatus" text="Payment Status" prefWidth="118" styleClass="approved-table-column"/><TableColumn fx:id="colMail" text="Email" prefWidth="80" styleClass="approved-table-column"/><TableColumn fx:id="colActions" text="Actions" styleClass="approved-table-column" minWidth="120" prefWidth="124" maxWidth="132" sortable="false" resizable="false"/></columns></TableView><HBox spacing="10" alignment="CENTER_LEFT" styleClass="table-footer"><Label fx:id="lblPageInfo" styleClass="muted-text,register-record-count"/><Region HBox.hgrow="ALWAYS"/><Label text="Rows per page:"/><ComboBox fx:id="cmbPageSize" prefWidth="75" styleClass="approved-input"/><Button fx:id="btnFirstPage" text="First" onAction="#firstPage" styleClass="pager-button,approved-button,approved-secondary-button"/><Button fx:id="btnPreviousPage" text="Previous" onAction="#previousPage" styleClass="pager-button,approved-button,approved-secondary-button"/><Label fx:id="lblPageNumber" styleClass="page-number"/><Button fx:id="btnNextPage" text="Next" onAction="#nextPage" styleClass="pager-button,approved-button,approved-secondary-button"/><Button fx:id="btnLastPage" text="Last" onAction="#lastPage" styleClass="pager-button,approved-button,approved-secondary-button"/></HBox><HBox spacing="10" styleClass="export-bar" alignment="CENTER_LEFT"><Button fx:id="btnExportExcel" text="Export Excel" onAction="#exportPurchase" styleClass="secondary-button"/><Button fx:id="btnExportPdf" text="Export PDF" onAction="#exportPdf" styleClass="secondary-button"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblSummary" styleClass="summary-amount,register-total-summary"/></HBox></VBox>
 <VBox fx:id="detailDrawer" spacing="10" prefWidth="310" minWidth="290" maxWidth="340" styleClass="detail-drawer,erp-detail-drawer-card,purchase-detail-drawer" minHeight="0">
  <HBox alignment="CENTER_LEFT"><Label text="Purchase Details" styleClass="drawer-title,erp-drawer-caption"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnCloseDetails" text="Close" onAction="#closeDetails" styleClass="danger-button,drawer-close-button,approved-button"/></HBox>
  <Label fx:id="lblDetailInvoice" styleClass="drawer-document"/>
  <Label fx:id="lblDetailSupplier" styleClass="drawer-customer"/>
  <Label fx:id="lblDetailContact" styleClass="muted-text" wrapText="true"/>
  <VBox fx:id="approvalActionBox" spacing="7" visible="false" managed="false" styleClass="sales-approval-card,purchase-approval-card">
    <Label text="Admin Approval Required" styleClass="drawer-section,erp-drawer-caption"/>
    <Label text="This purchase is waiting for Admin approval. Stock has not been posted and payments/returns are locked." wrapText="true" styleClass="sales-approval-note"/>
    <HBox spacing="8"><Button fx:id="btnApprovePurchase" text="Approve" onAction="#approveSelectedPurchase" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="approved-button,approved-success-button"/><Button fx:id="btnRejectPurchase" text="Reject" onAction="#rejectSelectedPurchase" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="approved-button,approved-danger-button"/></HBox>
  </VBox>
  <Separator/>
  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="erp-detail-scroll,purchase-detail-scroll">
    <content>
      <VBox spacing="10">
        <Label text="Amount &amp; Tax" styleClass="drawer-section,erp-drawer-caption"/>
        <GridPane hgap="12" vgap="7">
          <columnConstraints><ColumnConstraints percentWidth="43"/><ColumnConstraints percentWidth="57"/></columnConstraints>
          <Label text="Invoice Amount" styleClass="detail-label,field-label-amount"/><Label fx:id="lblDetailAmount" GridPane.columnIndex="1" styleClass="drawer-money"/>
          <Label text="Paid" GridPane.rowIndex="1" styleClass="detail-label,field-label-payment"/><Label fx:id="lblDetailPaid" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="summary-paid"/>
          <Label text="Pending" GridPane.rowIndex="2" styleClass="detail-label,field-label-balance"/><Label fx:id="lblDetailBalance" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="summary-balance"/>
          <Label text="Due" GridPane.rowIndex="3" styleClass="detail-label,field-label-calendar"/><Label fx:id="lblDetailDue" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="drawer-due"/>
          <Label text="GST Amount" GridPane.rowIndex="4" styleClass="detail-label,field-label-tax"/><Label fx:id="lblDetailGst" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="drawer-tax"/>
          <Label text="Charge GST" GridPane.rowIndex="5" styleClass="detail-label,field-label-tax"/><Label fx:id="lblDetailChargeTax" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
          <Label text="GST Type" GridPane.rowIndex="6" styleClass="detail-label,field-label-tax"/><Label fx:id="lblDetailGstType" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
          <Label text="Reference" GridPane.rowIndex="7" styleClass="detail-label,field-label-reference"/><Label fx:id="lblDetailReference" GridPane.rowIndex="7" GridPane.columnIndex="1" wrapText="true"/>
          <Label text="Payment Terms" GridPane.rowIndex="8" styleClass="detail-label,field-label-payment"/><Label fx:id="lblDetailPaymentTerms" GridPane.rowIndex="8" GridPane.columnIndex="1" wrapText="true"/>
        </GridPane>
        <Separator/>
        <Label text="Additional Charges" styleClass="drawer-section,erp-drawer-caption"/>
        <Label fx:id="lblDetailCharges" text="Not Applicable" wrapText="true" styleClass="purchase-detail-charge-value"/>
        <Separator/>
        <Label text="Supplier &amp; Addresses" styleClass="drawer-section,erp-drawer-caption"/>
        <GridPane hgap="10" vgap="6">
          <columnConstraints><ColumnConstraints percentWidth="40"/><ColumnConstraints percentWidth="60"/></columnConstraints>
          <Label text="Contact" styleClass="detail-label,field-label-user"/><Label fx:id="lblDetailContactPerson" GridPane.columnIndex="1" wrapText="true"/>
          <Label text="Phone" GridPane.rowIndex="1" styleClass="detail-label,field-label-phone"/><Label fx:id="lblDetailPhone" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          <Label text="Email" GridPane.rowIndex="2" styleClass="detail-label,field-label-email"/><Label fx:id="lblDetailEmail" GridPane.rowIndex="2" GridPane.columnIndex="1" wrapText="true"/>
          <Label text="GSTIN" GridPane.rowIndex="3" styleClass="detail-label,field-label-tax"/><Label fx:id="lblDetailGstin" GridPane.rowIndex="3" GridPane.columnIndex="1" wrapText="true"/>
          <Label text="Billing Address" GridPane.rowIndex="4" styleClass="detail-label,field-label-location"/><Label fx:id="lblDetailBillingAddress" GridPane.rowIndex="4" GridPane.columnIndex="1" wrapText="true"/>
          <Label text="Delivery Address" GridPane.rowIndex="5" styleClass="detail-label,field-label-location"/><Label fx:id="lblDetailDeliveryAddress" GridPane.rowIndex="5" GridPane.columnIndex="1" wrapText="true"/>
        </GridPane>
        <Separator/>
        <Label text="Transport, Notes &amp; Attachment" styleClass="drawer-section,erp-drawer-caption"/>
        <GridPane hgap="10" vgap="6">
          <columnConstraints><ColumnConstraints percentWidth="40"/><ColumnConstraints percentWidth="60"/></columnConstraints>
          <Label text="Transporter" styleClass="detail-label,field-label-delivery"/><Label fx:id="lblDetailTransporter" GridPane.columnIndex="1" wrapText="true"/>
          <Label text="Vehicle No." GridPane.rowIndex="1" styleClass="detail-label,field-label-delivery"/><Label fx:id="lblDetailVehicle" GridPane.rowIndex="1" GridPane.columnIndex="1" wrapText="true"/>
          <Label text="Notes" GridPane.rowIndex="2" styleClass="detail-label,field-label-notes"/><Label fx:id="lblDetailNotes" GridPane.rowIndex="2" GridPane.columnIndex="1" wrapText="true"/>
          <Label text="Attachment" GridPane.rowIndex="3" styleClass="detail-label,field-label-attachment"/><Label fx:id="lblDetailAttachment" GridPane.rowIndex="3" GridPane.columnIndex="1" wrapText="true"/>
        </GridPane>
        <Separator/>
        <Label text="Quick Actions" styleClass="drawer-section,erp-drawer-caption"/>
        <GridPane hgap="8" vgap="8">
          <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
          <Button text="Send Email" onAction="#emailSelected" maxWidth="Infinity" styleClass="approved-button,approved-primary-button"/>
          <Button text="Edit Purchase" onAction="#editSelected" maxWidth="Infinity" GridPane.columnIndex="1" styleClass="approved-button,approved-primary-button"/>
          <Button text="Record Payment" onAction="#paySelected" maxWidth="Infinity" GridPane.rowIndex="1" styleClass="approved-button,approved-primary-button"/>
          <Button text="View / Download Excel" onAction="#excelSelected" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="approved-button,approved-secondary-button"/>
        </GridPane>
      </VBox>
    </content>
  </ScrollPane>
</VBox></items></SplitPane></center>
</BorderPane>