<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.PurchaseListController" styleClass="register-page,purchase-register-page,approved-ui,approved-screen,approved-screen-purchase-list,erp-screen-root">
 <top><VBox spacing="8" styleClass="register-top,purchase-register-top,erp-transparent-section-stack"><padding><Insets top="10" right="14" bottom="4" left="14"/></padding><HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header,purchase-register-hero"><StackPane fx:id="purchasePageIcon" styleClass="erp-page-header-icon"/><VBox spacing="3"><Label text="Purchase Register" styleClass="screen-title"/><Label text="Manage supplier purchases, payments and purchase communication" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><StackPane prefWidth="340" minWidth="240" maxWidth="360" styleClass="erp-item-search-shell,register-header-search-shell,purchase-header-search-shell"><TextField fx:id="txtSearch" promptText="Search invoice, supplier, mobile or GSTIN..." maxWidth="Infinity" styleClass="approved-input,erp-item-search,register-header-search-input"/><StackPane fx:id="purchaseHeaderSearchIcon" mouseTransparent="true" minWidth="24" prefWidth="24" maxWidth="24" minHeight="24" prefHeight="24" maxHeight="24" StackPane.alignment="CENTER_RIGHT" styleClass="erp-item-search-icon-box,register-header-search-icon"><StackPane.margin><Insets right="8"/></StackPane.margin></StackPane></StackPane><Button fx:id="btnNewPurchase" text="Create Purchase" onAction="#newPurchase" styleClass="primary-action,approved-button,approved-primary-button"/></HBox></VBox></top>
 <center><SplitPane fx:id="mainSplit" dividerPositions="0.8" styleClass="register-split,purchase-register-split"><items><VBox spacing="10" styleClass="register-workspace,purchase-register-workspace"><padding><Insets top="0" right="12" bottom="0" left="0"/></padding><HBox spacing="12" styleClass="standard-kpi-row,erp-kpi-section">
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-blue" HBox.hgrow="ALWAYS"><StackPane fx:id="purchaseTotalIcon" styleClass="standard-kpi-icon"/><VBox spacing="4" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Active Purchases" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="+5.2%" styleClass="metric-trend-pill,trend-positive"/></HBox><Label fx:id="lblTotal" styleClass="metric-value"/><Label fx:id="lblTotalCount" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-green" HBox.hgrow="ALWAYS"><StackPane fx:id="purchaseOrdersIcon" styleClass="standard-kpi-icon"/><VBox spacing="4" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Total Orders" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Today" styleClass="metric-trend-pill,trend-neutral"/></HBox><Label fx:id="lblToday" styleClass="metric-value"/><Label fx:id="lblTodayCount" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-orange" HBox.hgrow="ALWAYS"><StackPane fx:id="purchaseSuppliersIcon" styleClass="standard-kpi-icon"/><VBox spacing="4" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Total Suppliers" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Active" styleClass="metric-trend-pill,trend-warning"/></HBox><Label fx:id="lblPending" styleClass="metric-value"/><Label fx:id="lblPendingCount" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-red" HBox.hgrow="ALWAYS"><StackPane fx:id="purchaseItemsIcon" styleClass="standard-kpi-icon"/><VBox spacing="4" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Total Items" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Catalog" styleClass="metric-trend-pill,trend-info"/></HBox><Label fx:id="lblOverdue" styleClass="metric-value"/><Label fx:id="lblOverdueCount" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-purple" HBox.hgrow="ALWAYS"><StackPane fx:id="purchasePaidIcon" styleClass="standard-kpi-icon"/><VBox spacing="4" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Total Paid" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Settled" styleClass="metric-trend-pill,trend-positive"/></HBox><Label fx:id="lblPaid" styleClass="metric-value"/><Label text="All Time" styleClass="metric-note"/></VBox></HBox>
</HBox><VBox spacing="10" styleClass="filter-surface,approved-filter-bar,erp-filter-section">
  <GridPane hgap="10" vgap="7" styleClass="register-visible-filter-grid,purchase-visible-filter-grid">
    <columnConstraints><ColumnConstraints percentWidth="18"/><ColumnConstraints percentWidth="13"/><ColumnConstraints percentWidth="13"/><ColumnConstraints percentWidth="18"/><ColumnConstraints percentWidth="19"/><ColumnConstraints percentWidth="19"/></columnConstraints>
    <VBox spacing="4"><Label text="Supplier" styleClass="filter-label,filter-label-supplier"/><ComboBox fx:id="cmbSupplier" promptText="All Suppliers" maxWidth="Infinity" styleClass="approved-input"/></VBox>
    <VBox spacing="4" GridPane.columnIndex="1"><Label text="From Date" styleClass="filter-label,filter-label-date"/><DatePicker fx:id="dpFrom" maxWidth="Infinity" styleClass="approved-input"/></VBox>
    <VBox spacing="4" GridPane.columnIndex="2"><Label text="To Date" styleClass="filter-label,filter-label-date"/><DatePicker fx:id="dpTo" maxWidth="Infinity" styleClass="approved-input"/></VBox>
    <VBox spacing="4" GridPane.columnIndex="3"><Label text="Document Status" styleClass="filter-label,filter-label-document"/><ComboBox fx:id="cmbDocumentStatus" promptText="Document Status" maxWidth="Infinity" styleClass="approved-input"/></VBox>
    <VBox spacing="4" GridPane.columnIndex="4"><Label text="Payment Status" styleClass="filter-label,filter-label-payment"/><ComboBox fx:id="cmbPaymentStatus" promptText="Payment Status" maxWidth="Infinity" styleClass="approved-input"/></VBox>
    <VBox spacing="4" GridPane.columnIndex="5"><Label text="Return Status" styleClass="filter-label,filter-label-return"/><ComboBox fx:id="cmbReturnStatus" promptText="Return Status" maxWidth="Infinity" styleClass="approved-input"/></VBox>
  </GridPane>
  <GridPane fx:id="advancedFilters" hgap="10" vgap="8" visible="false" managed="false">
    <VBox spacing="3"><Label text="Email Status" styleClass="filter-label"/><ComboBox fx:id="cmbMailStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox>
  </GridPane>
  <HBox spacing="8" alignment="CENTER_LEFT" styleClass="quick-date-row,register-quick-range-row">
    <Button fx:id="btnAllDatesRange" text="All Date" onAction="#showAllDates" styleClass="quick-range-button,quick-range-all,approved-button,approved-secondary-button"/>
    <Button fx:id="btnTodayRange" text="Today" onAction="#showToday" styleClass="quick-range-today,quick-range-button,quick-range-today,approved-button,approved-secondary-button"/>
    <Button fx:id="btnYesterdayRange" text="Yesterday" onAction="#showYesterday" styleClass="quick-range-yesterday,quick-range-button,quick-range-yesterday,approved-button,approved-secondary-button"/>
    <Button fx:id="btnSevenDaysRange" text="7 Days" onAction="#showSevenDays" styleClass="quick-range-button,quick-range-seven,approved-button,approved-secondary-button"/>
    <Button fx:id="btnThirtyDaysRange" text="30 Days" onAction="#showThirtyDays" styleClass="quick-range-button,quick-range-thirty,approved-button,approved-secondary-button"/>
    <Button fx:id="btnThisFyRange" text="This FY" onAction="#showThisFinancialYear" styleClass="quick-range-button,approved-button,approved-secondary-button"/>
    <Button fx:id="btnThisQuarterRange" text="This Quarter" onAction="#showThisQuarter" styleClass="quick-range-button,approved-button,approved-secondary-button"/>
    <Button fx:id="btnCustomRange" text="Custom Range" onAction="#showCustomRange" visible="false" managed="false" styleClass="quick-range-button,quick-range-custom,approved-button,approved-secondary-button"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="btnExportExcel" text="Export Excel" onAction="#exportPurchase" styleClass="secondary-button,approved-button,approved-secondary-button"/>
    <Button fx:id="btnExportPdf" text="Export PDF" onAction="#exportPdf" styleClass="secondary-button,approved-button,approved-secondary-button"/>
    <Button fx:id="btnPrint" text="Print" onAction="#printRegister" styleClass="secondary-button,approved-button,approved-secondary-button"/>
    <Button fx:id="btnReset" text="Reset" onAction="#resetFilters" styleClass="register-action-button,register-reset-button,approved-button,approved-secondary-button"/>
    <Button fx:id="btnRefresh" text="Refresh" onAction="#refreshWithFeedback" styleClass="register-action-button,register-refresh-button,approved-button,approved-secondary-button"/>
  </HBox>
</VBox>
 <TableView fx:id="tablePurchase" minHeight="0" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="colInvoice" text="Invoice No." styleClass="approved-table-column"/><TableColumn fx:id="colDate" text="Date" styleClass="approved-table-column"/><TableColumn fx:id="colSupplier" text="Supplier" styleClass="approved-table-column"/><TableColumn fx:id="colMobile" text="Mobile" styleClass="approved-table-column"/><TableColumn fx:id="colAmount" text="Amount" styleClass="approved-table-column"/><TableColumn fx:id="colPaid" text="Paid" styleClass="approved-table-column"/><TableColumn fx:id="colBalance" text="Pending" styleClass="approved-table-column"/><TableColumn fx:id="colDue" text="Payment Due" styleClass="approved-table-column"/><TableColumn fx:id="colStatus" text="Document Status" styleClass="approved-table-column"/><TableColumn fx:id="colPaymentStatus" text="Payment Status" styleClass="approved-table-column"/><TableColumn fx:id="colReturnStatus" text="Return Status" styleClass="approved-table-column"/><TableColumn fx:id="colMail" text="Email" styleClass="approved-table-column"/><TableColumn fx:id="colActions" text="Actions" styleClass="approved-table-column" sortable="false" resizable="false"/></columns></TableView><HBox spacing="10" alignment="CENTER_LEFT" styleClass="table-footer"><Label fx:id="lblPageInfo" styleClass="muted-text,register-record-count"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblSummary" styleClass="summary-amount,register-total-summary"/><Region HBox.hgrow="ALWAYS"/><Label text="Rows per page:"/><ComboBox fx:id="cmbPageSize" prefWidth="92" styleClass="approved-input"/><Button fx:id="btnFirstPage" text="First" onAction="#firstPage" styleClass="pager-button,approved-button,approved-secondary-button"/><Button fx:id="btnPreviousPage" text="Previous" onAction="#previousPage" styleClass="pager-button,approved-button,approved-secondary-button"/><Label fx:id="lblPageNumber" styleClass="page-number"/><Button fx:id="btnNextPage" text="Next" onAction="#nextPage" styleClass="pager-button,approved-button,approved-secondary-button"/><Button fx:id="btnLastPage" text="Last" onAction="#lastPage" styleClass="pager-button,approved-button,approved-secondary-button"/></HBox></VBox></items></SplitPane></center>
</BorderPane>
