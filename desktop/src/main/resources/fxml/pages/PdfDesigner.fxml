<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="root" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.documentstudio.controller.PdfDesignerController" styleClass="pdf-v2-root">
    <top>
        <VBox spacing="8" styleClass="pdf-v2-topbar">
            <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button text="← Library" onAction="#backToLibrary" styleClass="approved-button,approved-secondary-button"/>
                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblTemplateName" text="PDF Studio" styleClass="page-title"/>
                    <Label fx:id="lblTemplateMeta" text="Template" styleClass="muted-label"/>
                </VBox>
                <Label text="Auto Map" styleClass="field-caption"/>
                <ProgressBar fx:id="mappingProgress" prefWidth="130" progress="0"/>
                <Label fx:id="lblMappingPercent" text="0%" styleClass="pdf-v2-map-percent"/>
                <Label fx:id="lblMappingSummary" text="Not analyzed" styleClass="muted-label"/>
                <Button text="Auto Map" onAction="#autoMapNow" styleClass="approved-button,approved-secondary-button"/>
                <Button fx:id="btnPreview" text="Preview" onAction="#togglePreview" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Save" onAction="#saveDraft" styleClass="approved-button,approved-secondary-button"/>
                <Button fx:id="btnSaveDefault" text="Save &amp; Set Default" onAction="#saveAndDefault" styleClass="approved-button,approved-primary-button"/>
                <Button text="Export PDF" onAction="#exportPdf" styleClass="approved-button,approved-secondary-button"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Preview record" styleClass="field-caption"/>
                <ComboBox fx:id="cmbSampleDocument" prefWidth="290" onAction="#sampleChanged"/>
                <Separator orientation="VERTICAL" prefHeight="24"/>
                <Button text="Undo" onAction="#undo" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Redo" onAction="#redo" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Duplicate" onAction="#duplicateSelected" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Delete" onAction="#deleteSelected" styleClass="approved-button,approved-danger-button"/>
                <Button text="Copy Format" onAction="#copyFormat" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Paste Format" onAction="#pasteFormat" styleClass="approved-button,approved-secondary-button"/>
                <Separator orientation="VERTICAL" prefHeight="24"/>
                <Button text="Align Left" onAction="#alignLeft" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Center" onAction="#alignCenter" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Align Right" onAction="#alignRight" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Top" onAction="#alignTop" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Middle" onAction="#alignMiddle" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Bottom" onAction="#alignBottom" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Distribute H" onAction="#distributeHorizontal" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Distribute V" onAction="#distributeVertical" styleClass="approved-button,approved-secondary-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <CheckBox fx:id="chkSnap" text="Snap" selected="true"/>
                <Button text="Fit Width" onAction="#fitWidth" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Fit Page" onAction="#fitPage" styleClass="approved-button,approved-secondary-button"/>
                <Slider fx:id="zoomSlider" min="35" max="220" value="100" prefWidth="130"/>
                <Label fx:id="lblZoom" text="100%"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <TabPane fx:id="leftTabs" prefWidth="270" tabClosingPolicy="UNAVAILABLE" styleClass="pdf-v2-left-tabs">
            <tabs>
                <Tab text="CREATE">
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                        <content>
                            <VBox spacing="10" styleClass="pdf-v2-palette">
                                <padding><Insets top="12" right="10" bottom="18" left="10"/></padding>
                                <Label text="DRAG OR CLICK" styleClass="field-caption"/>
                                <Label text="Drop objects anywhere on the page. Nothing is forced into a grid." wrapText="true" styleClass="pdf-designer-help"/>
                                <TilePane hgap="8" vgap="8" prefColumns="2">
                                    <Button text="Text" onAction="#addText" onDragDetected="#dragCreateText" styleClass="pdf-v2-tool"/>
                                    <Button text="Heading" onAction="#addHeading" onDragDetected="#dragCreateHeading" styleClass="pdf-v2-tool"/>
                                    <Button text="Block" onAction="#addBlock" onDragDetected="#dragCreateBlock" styleClass="pdf-v2-tool"/>
                                    <Button text="Rectangle" onAction="#addRectangle" onDragDetected="#dragCreateRectangle" styleClass="pdf-v2-tool"/>
                                    <Button text="Line" onAction="#addLine" onDragDetected="#dragCreateLine" styleClass="pdf-v2-tool"/>
                                    <Button text="Image" onAction="#addImage" onDragDetected="#dragCreateImage" styleClass="pdf-v2-tool"/>
                                    <Button text="Item Repeater" onAction="#addItemRepeater" onDragDetected="#dragCreateItems" styleClass="pdf-v2-tool"/>
                                    <Button text="Charge Repeater" onAction="#addChargeRepeater" onDragDetected="#dragCreateCharges" styleClass="pdf-v2-tool"/>
                                </TilePane>
                                <Separator/>
                                <Label text="GROUP / CONTAINER" styleClass="field-caption"/>
                                <Button text="Group Selected in Block" onAction="#groupSelected" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
                                <Button text="Ungroup Selected" onAction="#ungroupSelected" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
                                <Label text="Children can inherit the parent block style and still be overridden individually." wrapText="true" styleClass="pdf-designer-help"/>
                            </VBox>
                        </content>
                    </ScrollPane>
                </Tab>
                <Tab text="ERP FIELDS">
                    <BorderPane>
                        <top><VBox spacing="7" styleClass="pdf-v2-palette"><padding><Insets top="12" right="10" bottom="8" left="10"/></padding><TextField fx:id="txtFieldSearch" promptText="Search ERP fields..."/><Label text="Drag a field onto blank space or directly onto detected PDF text." wrapText="true" styleClass="pdf-designer-help"/></VBox></top>
                        <center><ListView fx:id="lstFields"/></center>
                    </BorderPane>
                </Tab>
                <Tab text="PAGES">
                    <VBox spacing="8" styleClass="pdf-v2-palette">
                        <padding><Insets top="12" right="10" bottom="12" left="10"/></padding>
                        <ListView fx:id="lstPages" VBox.vgrow="ALWAYS"/>
                        <HBox spacing="6"><Button text="+ Page" onAction="#appendBlankPage" HBox.hgrow="ALWAYS" maxWidth="Infinity"/><Button text="Delete" onAction="#deleteCurrentPage" HBox.hgrow="ALWAYS" maxWidth="Infinity"/></HBox>
                        <HBox spacing="6"><Button text="↶ Rotate" onAction="#rotatePageLeft" HBox.hgrow="ALWAYS" maxWidth="Infinity"/><Button text="Rotate ↷" onAction="#rotatePageRight" HBox.hgrow="ALWAYS" maxWidth="Infinity"/></HBox>
                    </VBox>
                </Tab>
                <Tab text="LAYERS">
                    <VBox spacing="8" styleClass="pdf-v2-palette">
                        <padding><Insets top="12" right="10" bottom="12" left="10"/></padding>
                        <ListView fx:id="lstLayers" VBox.vgrow="ALWAYS"/>
                        <HBox spacing="6"><Button text="Front" onAction="#bringToFront" HBox.hgrow="ALWAYS" maxWidth="Infinity"/><Button text="Back" onAction="#sendToBack" HBox.hgrow="ALWAYS" maxWidth="Infinity"/></HBox>
                        <HBox spacing="6"><Button text="Forward" onAction="#moveForward" HBox.hgrow="ALWAYS" maxWidth="Infinity"/><Button text="Backward" onAction="#moveBackward" HBox.hgrow="ALWAYS" maxWidth="Infinity"/></HBox>
                        <HBox spacing="6"><Button text="Lock" onAction="#toggleLock" HBox.hgrow="ALWAYS" maxWidth="Infinity"/><Button text="Show / Hide" onAction="#toggleVisibility" HBox.hgrow="ALWAYS" maxWidth="Infinity"/></HBox>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </left>

    <center>
        <VBox spacing="0" styleClass="pdf-v2-workspace">
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="pdf-v2-canvas-info">
                <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
                <Label fx:id="lblPageSize" text="A4"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="lblSelection" text="Nothing selected"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblPageWarning" text="" styleClass="pdf-v2-warning"/>
            </HBox>
            <ScrollPane fx:id="canvasScroll" pannable="true" fitToHeight="false" fitToWidth="false" VBox.vgrow="ALWAYS" styleClass="pdf-v2-canvas-scroll">
                <content><StackPane fx:id="canvasHolder" alignment="TOP_LEFT" styleClass="pdf-v2-canvas-holder"><Pane fx:id="canvasPane" styleClass="pdf-v2-canvas"/></StackPane></content>
            </ScrollPane>
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="pdf-v2-status"><padding><Insets top="7" right="10" bottom="7" left="10"/></padding><Label fx:id="lblSaveState" text="Ready"/><Region HBox.hgrow="ALWAYS"/><Label text="Click anything → properties populate automatically • Shift-click = multi-select • Double-click text = edit" styleClass="muted-label"/></HBox>
        </VBox>
    </center>

    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="330" styleClass="pdf-v2-inspector-scroll">
            <content>
                <VBox spacing="10" styleClass="pdf-v2-inspector">
                    <padding><Insets top="12" right="12" bottom="20" left="12"/></padding>
                    <Label text="INSPECTOR" styleClass="field-caption"/>
                    <Label fx:id="lblInspectorType" text="Select any text, image, block or table" wrapText="true" styleClass="pdf-v2-inspector-title"/>
                    <Label fx:id="lblInspectorHint" text="Properties appear automatically." wrapText="true" styleClass="pdf-designer-help"/>

                    <VBox fx:id="textSection" spacing="7">
                        <Label text="CONTENT / ERP MAPPING" styleClass="field-caption"/>
                        <TextArea fx:id="txtContent" prefRowCount="4" wrapText="true" promptText="Text or {{erp.field}} expression"/>
                        <ComboBox fx:id="cmbFieldBinding" maxWidth="Infinity" promptText="ERP field binding"/>
                        <Label text="Literal text and ERP expressions can live in the same object, e.g. GSTIN: {{customer.gstin}}" wrapText="true" styleClass="pdf-designer-help"/>
                        <GridPane hgap="7" vgap="7">
                            <Label text="Font" GridPane.columnIndex="0" GridPane.rowIndex="0"/><ComboBox fx:id="cmbFontFamily" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>
                            <Label text="Size" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="txtFontSize" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="Fit" GridPane.columnIndex="0" GridPane.rowIndex="2"/><ComboBox fx:id="cmbTextFit" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"/>
                            <Label text="Align" GridPane.columnIndex="0" GridPane.rowIndex="3"/><ComboBox fx:id="cmbTextAlignment" GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="Infinity"/>
                            <Label text="Line spacing" GridPane.columnIndex="0" GridPane.rowIndex="4"/><TextField fx:id="txtLineSpacing" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                            <columnConstraints><ColumnConstraints minWidth="90"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
                        </GridPane>
                        <HBox spacing="8"><CheckBox fx:id="chkBold" text="Bold"/><CheckBox fx:id="chkItalic" text="Italic"/><CheckBox fx:id="chkInheritParent" text="Inherit block"/></HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT"><Label text="Text"/><ColorPicker fx:id="colorText"/><Label text="Fill"/><ColorPicker fx:id="colorFill"/><Label text="Border"/><ColorPicker fx:id="colorStroke"/></HBox>
                    </VBox>

                    <Separator/>
                    <Label text="GEOMETRY" styleClass="field-caption"/>
                    <GridPane hgap="7" vgap="7">
                        <Label text="X" GridPane.columnIndex="0" GridPane.rowIndex="0"/><TextField fx:id="txtX" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Y" GridPane.columnIndex="2" GridPane.rowIndex="0"/><TextField fx:id="txtY" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        <Label text="Width" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="txtWidth" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Height" GridPane.columnIndex="2" GridPane.rowIndex="1"/><TextField fx:id="txtHeight" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        <Label text="Rotation" GridPane.columnIndex="0" GridPane.rowIndex="2"/><TextField fx:id="txtRotation" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="Opacity %" GridPane.columnIndex="2" GridPane.rowIndex="2"/><TextField fx:id="txtOpacity" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                        <columnConstraints><ColumnConstraints minWidth="55"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints minWidth="65"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
                    </GridPane>
                    <Label text="Objects may extend outside the page. Studio warns but does not block the edit; export clips at the PDF boundary." wrapText="true" styleClass="pdf-designer-help"/>

                    <Separator/>
                    <Label text="BOX / PADDING" styleClass="field-caption"/>
                    <HBox spacing="8"><CheckBox fx:id="chkFillEnabled" text="Fill" selected="true"/><CheckBox fx:id="chkStrokeEnabled" text="Border" selected="true"/><CheckBox fx:id="chkPaddingLinked" text="Link padding" selected="true"/></HBox>
                    <GridPane hgap="7" vgap="7">
                        <Label text="Border width" GridPane.columnIndex="0" GridPane.rowIndex="0"/><TextField fx:id="txtStrokeWidth" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Radius" GridPane.columnIndex="2" GridPane.rowIndex="0"/><TextField fx:id="txtRadius" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        <Label text="Pad top" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="txtPadTop" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Right" GridPane.columnIndex="2" GridPane.rowIndex="1"/><TextField fx:id="txtPadRight" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        <Label text="Bottom" GridPane.columnIndex="0" GridPane.rowIndex="2"/><TextField fx:id="txtPadBottom" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="Left" GridPane.columnIndex="2" GridPane.rowIndex="2"/><TextField fx:id="txtPadLeft" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                        <columnConstraints><ColumnConstraints minWidth="75"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints minWidth="55"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
                    </GridPane>

                    <VBox fx:id="imageSection" spacing="7">
                        <Separator/>
                        <Label text="IMAGE" styleClass="field-caption"/>
                        <Button text="Replace / Choose Image" onAction="#replaceSelectedImage" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
                        <ComboBox fx:id="cmbImageFit" maxWidth="Infinity"/>
                        <CheckBox fx:id="chkPreserveRatio" text="Preserve aspect ratio" selected="true"/>
                    </VBox>

                    <VBox fx:id="repeaterSection" spacing="7">
                        <Separator/>
                        <Label text="REPEATER" styleClass="field-caption"/>
                        <Label text="Each item/charge row is generated from live ERP data and can paginate automatically." wrapText="true" styleClass="pdf-designer-help"/>
                        <TextField fx:id="txtTableColumns" promptText="serial,hsn,description,qty,unit,rate,amount"/>
                        <GridPane hgap="7" vgap="7"><Label text="Row height" GridPane.columnIndex="0"/><TextField fx:id="txtRowHeight" GridPane.columnIndex="1"/><Label text="Header" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="txtHeaderHeight" GridPane.columnIndex="1" GridPane.rowIndex="1"/><columnConstraints><ColumnConstraints minWidth="80"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints></GridPane>
                        <CheckBox fx:id="chkUseSourceTableDesign" text="Keep imported table/grid design" selected="true"/>
                    </VBox>

                    <Separator/>
                    <Label text="OBJECT" styleClass="field-caption"/>
                    <HBox spacing="8"><CheckBox fx:id="chkLocked" text="Locked"/><CheckBox fx:id="chkVisible" text="Visible" selected="true"/></HBox>
                    <ComboBox fx:id="cmbPageRule" maxWidth="Infinity"/>
                    <Button text="Apply Current Inspector Values" onAction="#applyInspector" maxWidth="Infinity" styleClass="approved-button,approved-primary-button"/>
                    <Label text="Most controls apply immediately on Enter/change. Apply is available for pasted numeric values." wrapText="true" styleClass="pdf-designer-help"/>
                </VBox>
            </content>
        </ScrollPane>
    </right>
</BorderPane>
