<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="root" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.documentstudio.controller.PdfStudioController" styleClass="pdf-v2-root,pdf-mapper-root">
    <top>
        <VBox spacing="0" styleClass="pdf-mapper-header">
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="pdf-mapper-titlebar">
                <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                <Button text="← Templates" onAction="#backToLibrary" styleClass="approved-button,approved-secondary-button"/>
                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblTemplateName" text="PDF Studio – Template Mapping" styleClass="page-title"/>
                    <Label fx:id="lblTemplateMeta" text="Sales Invoice" styleClass="muted-label"/>
                </VBox>
                <Button fx:id="btnDataPreviewMode" text="Preview with Data" onAction="#showDataPreviewMode" styleClass="approved-button,approved-secondary-button"/>
                <Button text="View JSON Data" onAction="#viewJsonData" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Save" onAction="#saveDraft" styleClass="approved-button,approved-secondary-button"/>
                <Button fx:id="btnPublish" text="Publish" onAction="#publishTemplate" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Publish &amp; Set as Default" onAction="#publishAndSetDefault" styleClass="approved-button,approved-primary-button"/>
            </HBox>

            <FlowPane hgap="8" vgap="6" alignment="CENTER_LEFT" styleClass="pdf-mapper-toolbar">
                <padding><Insets top="7" right="12" bottom="7" left="12"/></padding>
                <Button fx:id="btnDesignMode" text="Edit Mapping" onAction="#showDesignMode" styleClass="approved-button,approved-secondary-button"/>
                <Button fx:id="btnFinalMode" text="Final PDF" onAction="#showFinalMode" styleClass="approved-button,approved-secondary-button"/>
                <Separator orientation="VERTICAL" prefHeight="24"/>
                <Button text="Auto Map Fields" onAction="#autoMapNow" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Undo" onAction="#undo" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Redo" onAction="#redo" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Duplicate" onAction="#duplicateSelected" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Delete" onAction="#deleteSelected" styleClass="approved-button,approved-danger-button"/>
                <Separator orientation="VERTICAL" prefHeight="24"/>
                <CheckBox fx:id="chkSnap" text="Snap" selected="true"/>
                <Button text="Fit Width" onAction="#fitWidth" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Fit Page" onAction="#fitPage" styleClass="approved-button,approved-secondary-button"/>
                <Slider fx:id="zoomSlider" min="35" max="220" value="100" prefWidth="120"/>
                <Label fx:id="lblZoom" text="100%"/>
                <Label text="Mapping" styleClass="field-caption"/>
                <ProgressBar fx:id="mappingProgress" prefWidth="100" progress="0"/>
                <Label fx:id="lblMappingPercent" text="0%" styleClass="pdf-v2-map-percent"/>
                <Label fx:id="lblMappingSummary" text="Not analyzed" styleClass="muted-label"/>
            </FlowPane>
        </VBox>
    </top>

    <left>
        <VBox prefWidth="300" spacing="8" styleClass="pdf-mapper-side,pdf-mapper-fields">
            <padding><Insets top="12" right="10" bottom="12" left="10"/></padding>
            <Label text="Available ERP / JSON Fields" styleClass="pdf-mapper-panel-title"/>
            <Label text="Browse / Drag ERP Fields onto the exact rectangle in the PDF. The user never writes JSON manually." wrapText="true" styleClass="pdf-designer-help"/>
            <TextField fx:id="txtFieldSearch" promptText="Search fields..."/>
            <ListView fx:id="lstFields" VBox.vgrow="ALWAYS" styleClass="pdf-mapper-field-list"/>
            <Separator/>
            <Button text="Auto Map Detected Values" onAction="#autoMapNow" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
            <Button text="+ Add Text" onAction="#addText" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
            <TitledPane text="Advanced Create Tools" expanded="false">
                <content>
                    <TilePane hgap="6" vgap="6" prefColumns="2" styleClass="pdf-v2-palette">
                        <Button text="Heading" onAction="#addHeading" onDragDetected="#dragCreateHeading" styleClass="pdf-v2-tool"/>
                        <Button text="Section" onAction="#addBlock" onDragDetected="#dragCreateBlock" styleClass="pdf-v2-tool"/>
                        <Button text="Rectangle" onAction="#addRectangle" onDragDetected="#dragCreateRectangle" styleClass="pdf-v2-tool"/>
                        <Button text="Hide Area" onAction="#addHideArea" onDragDetected="#dragCreateHideArea" styleClass="pdf-v2-tool"/>
                        <Button text="Line" onAction="#addLine" onDragDetected="#dragCreateLine" styleClass="pdf-v2-tool"/>
                        <Button text="Image" onAction="#addImage" onDragDetected="#dragCreateImage" styleClass="pdf-v2-tool"/>
                        <Button text="Item Table" onAction="#addItemRepeater" onDragDetected="#dragCreateItems" styleClass="pdf-v2-tool"/>
                        <Button text="Charge Table" onAction="#addChargeRepeater" onDragDetected="#dragCreateCharges" styleClass="pdf-v2-tool"/>
                        <Button text="Text" onAction="#addText" onDragDetected="#dragCreateText" styleClass="pdf-v2-tool"/>
                    </TilePane>
                </content>
            </TitledPane>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" styleClass="pdf-v2-workspace">
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="pdf-v2-canvas-info">
                <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
                <Label text="Original PDF (protected)" styleClass="field-caption"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="lblPageSize" text="A4"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="lblSelection" text="Nothing selected"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblPageWarning" text="" styleClass="pdf-v2-warning"/>
            </HBox>
            <ScrollPane fx:id="canvasScroll" pannable="true" fitToHeight="false" fitToWidth="false" VBox.vgrow="ALWAYS" styleClass="pdf-v2-canvas-scroll">
                <content><StackPane fx:id="canvasHolder" alignment="TOP_LEFT" styleClass="pdf-v2-canvas-holder"><Pane fx:id="canvasPane" styleClass="pdf-v2-canvas"/></StackPane></content>
            </ScrollPane>
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="pdf-v2-status">
                <padding><Insets top="7" right="10" bottom="7" left="10"/></padding>
                <Label fx:id="lblSaveState" text="Ready"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Fixed PDF artwork • JSON changes values only • no page reflow" styleClass="muted-label"/>
            </HBox>
        </VBox>
    </center>

    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="365" styleClass="pdf-v2-inspector-scroll,pdf-mapper-side">
            <content>
                <VBox spacing="10" styleClass="pdf-v2-inspector,pdf-mapper-inspector">
                    <padding><Insets top="12" right="12" bottom="20" left="12"/></padding>
                    <Label text="Field Properties" styleClass="pdf-mapper-panel-title"/>
                    <Label fx:id="lblInspectorType" text="Select a mapped field" wrapText="true" styleClass="pdf-v2-inspector-title"/>
                    <Label fx:id="lblInspectorHint" text="Drag a JSON field onto the PDF, then fine-tune it here." wrapText="true" styleClass="pdf-designer-help"/>

                    <VBox fx:id="textSection" spacing="7">
                        <Label text="ERP / JSON Field" styleClass="field-caption"/>
                        <ComboBox fx:id="cmbFieldBinding" maxWidth="Infinity" promptText="Choose a field"/>
                        <TextArea fx:id="txtContent" prefRowCount="2" wrapText="true" promptText="Optional literal text / expression"/>
                        <GridPane hgap="7" vgap="7">
                            <Label text="Font" GridPane.columnIndex="0" GridPane.rowIndex="0"/><ComboBox fx:id="cmbFontFamily" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>
                            <Label text="Size" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="txtFontSize" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="Fit" GridPane.columnIndex="0" GridPane.rowIndex="2"/><ComboBox fx:id="cmbTextFit" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"/>
                            <Label text="Align" GridPane.columnIndex="0" GridPane.rowIndex="3"/><ComboBox fx:id="cmbTextAlignment" GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="Infinity"/>
                            <Label text="Line spacing" GridPane.columnIndex="0" GridPane.rowIndex="4"/><TextField fx:id="txtLineSpacing" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                            <columnConstraints><ColumnConstraints minWidth="90"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
                        </GridPane>
                        <HBox spacing="8"><CheckBox fx:id="chkBold" text="Bold"/><CheckBox fx:id="chkItalic" text="Italic"/><CheckBox fx:id="chkInheritParent" text="Inherit"/></HBox>
                    </VBox>

                    <Separator/>
                    <Label text="Position &amp; Size" styleClass="field-caption"/>
                    <GridPane hgap="7" vgap="7">
                        <Label text="X" GridPane.columnIndex="0" GridPane.rowIndex="0"/><TextField fx:id="txtX" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Y" GridPane.columnIndex="2" GridPane.rowIndex="0"/><TextField fx:id="txtY" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        <Label text="Width" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="txtWidth" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Height" GridPane.columnIndex="2" GridPane.rowIndex="1"/><TextField fx:id="txtHeight" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        <columnConstraints><ColumnConstraints minWidth="48"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints minWidth="52"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
                    </GridPane>
                    <Button text="Apply Field Properties" onAction="#applyInspector" maxWidth="Infinity" styleClass="approved-button,approved-primary-button"/>

                    <Separator/>
                    <HBox alignment="CENTER_LEFT"><Label text="Mapped Fields" styleClass="pdf-mapper-panel-title"/><Region HBox.hgrow="ALWAYS"/><Label text="Page objects" styleClass="muted-label"/></HBox>
                    <ListView fx:id="lstLayers" prefHeight="210" VBox.vgrow="ALWAYS" styleClass="pdf-mapper-mapped-list"/>
                    <Button text="Validate Mapping" onAction="#validateMapping" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>

                    <TitledPane text="Preview Record" expanded="true">
                        <content><VBox spacing="7"><ComboBox fx:id="cmbSampleDocument" maxWidth="Infinity" onAction="#sampleChanged"/><Button text="Preview with Selected Record" onAction="#showDataPreviewMode" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/></VBox></content>
                    </TitledPane>

                    <TitledPane text="Advanced" expanded="false">
                        <content>
                            <VBox spacing="8">
                                <HBox spacing="8"><Button text="Copy Format" onAction="#copyFormat"/><Button text="Paste Format" onAction="#pasteFormat"/></HBox>
                                <FlowPane hgap="5" vgap="5"><Button text="Left" onAction="#alignLeft"/><Button text="Center" onAction="#alignCenter"/><Button text="Right" onAction="#alignRight"/><Button text="Top" onAction="#alignTop"/><Button text="Middle" onAction="#alignMiddle"/><Button text="Bottom" onAction="#alignBottom"/><Button text="Distribute H" onAction="#distributeHorizontal"/><Button text="Distribute V" onAction="#distributeVertical"/></FlowPane>
                                <HBox spacing="8" alignment="CENTER_LEFT"><Label text="Text"/><ColorPicker fx:id="colorText"/><Label text="Fill"/><ColorPicker fx:id="colorFill"/><Label text="Border"/><ColorPicker fx:id="colorStroke"/></HBox>
                                <HBox spacing="8"><CheckBox fx:id="chkFillEnabled" text="Fill"/><CheckBox fx:id="chkStrokeEnabled" text="Border"/><CheckBox fx:id="chkPaddingLinked" text="Link padding" selected="true"/></HBox>
                                <GridPane hgap="7" vgap="7">
                                    <Label text="Rotation" GridPane.columnIndex="0"/><TextField fx:id="txtRotation" GridPane.columnIndex="1"/>
                                    <Label text="Opacity %" GridPane.columnIndex="2"/><TextField fx:id="txtOpacity" GridPane.columnIndex="3"/>
                                    <Label text="Border width" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="txtStrokeWidth" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    <Label text="Radius" GridPane.columnIndex="2" GridPane.rowIndex="1"/><TextField fx:id="txtRadius" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                                    <Label text="Pad top" GridPane.columnIndex="0" GridPane.rowIndex="2"/><TextField fx:id="txtPadTop" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                    <Label text="Right" GridPane.columnIndex="2" GridPane.rowIndex="2"/><TextField fx:id="txtPadRight" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                                    <Label text="Bottom" GridPane.columnIndex="0" GridPane.rowIndex="3"/><TextField fx:id="txtPadBottom" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                    <Label text="Left" GridPane.columnIndex="2" GridPane.rowIndex="3"/><TextField fx:id="txtPadLeft" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                                </GridPane>
                                <VBox fx:id="imageSection" spacing="6"><Label text="Image" styleClass="field-caption"/><Button text="Replace / Choose Image" onAction="#replaceSelectedImage" maxWidth="Infinity"/><ComboBox fx:id="cmbImageFit" maxWidth="Infinity"/><CheckBox fx:id="chkPreserveRatio" text="Preserve aspect ratio" selected="true"/></VBox>
                                <VBox fx:id="repeaterSection" spacing="6"><Label text="Repeating Table" styleClass="field-caption"/><TextField fx:id="txtTableColumns" promptText="serial,hsn,description,quantity,rate,unit,total"/><GridPane hgap="7" vgap="7"><Label text="Row height" GridPane.columnIndex="0"/><TextField fx:id="txtRowHeight" GridPane.columnIndex="1"/><Label text="Header" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="txtHeaderHeight" GridPane.columnIndex="1" GridPane.rowIndex="1"/></GridPane><CheckBox fx:id="chkUseSourceTableDesign" text="Keep imported table/grid design" selected="true"/></VBox>
                                <HBox spacing="8"><CheckBox fx:id="chkLocked" text="Locked"/><CheckBox fx:id="chkVisible" text="Visible" selected="true"/></HBox>
                                <ComboBox fx:id="cmbPageRule" maxWidth="Infinity"/>
                                <Separator/>
                                <Label text="Pages" styleClass="field-caption"/>
                                <ListView fx:id="lstPages" prefHeight="90"/>
                                <HBox spacing="5"><Button text="+ Page" onAction="#appendBlankPage"/><Button text="Delete" onAction="#deleteCurrentPage"/><Button text="↶" onAction="#rotatePageLeft"/><Button text="↷" onAction="#rotatePageRight"/></HBox>
                                <Separator/>
                                <Button fx:id="btnSaveDefault" text="Set Published Version as Default" onAction="#markDefault" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
                                <Button text="Export Test PDF" onAction="#exportPdf" maxWidth="Infinity"/>
                                <Button text="Group Selected" onAction="#groupSelected" maxWidth="Infinity"/><Button text="Ungroup Selected" onAction="#ungroupSelected" maxWidth="Infinity"/>
                                <HBox spacing="5"><Button text="Front" onAction="#bringToFront"/><Button text="Back" onAction="#sendToBack"/><Button text="Forward" onAction="#moveForward"/><Button text="Backward" onAction="#moveBackward"/></HBox>
                                <HBox spacing="5"><Button text="Lock" onAction="#toggleLock"/><Button text="Show / Hide" onAction="#toggleVisibility"/></HBox>
                            </VBox>
                        </content>
                    </TitledPane>
                </VBox>
            </content>
        </ScrollPane>
    </right>
</BorderPane>
