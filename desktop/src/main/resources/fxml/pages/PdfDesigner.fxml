<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="root" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.documentstudio.controller.PdfStudioController" styleClass="pdf-v2-root,pdf-mapper-root">
    <top>
        <VBox spacing="0" styleClass="pdf-mapper-header">
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="pdf-mapper-titlebar">
                <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                <Button text="← Templates" onAction="#backToLibrary" styleClass="approved-button,approved-secondary-button"/>
                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblTemplateName" text="PDF Studio – Template Mapping" styleClass="page-title"/>
                    <Label fx:id="lblTemplateMeta" text="Sales Invoice" styleClass="muted-label"/>
                </VBox>
                <Button fx:id="btnDataPreviewMode" text="Preview with Data" onAction="#showDataPreviewMode" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Save" onAction="#saveDraft" styleClass="approved-button,approved-secondary-button"/>
                <Button fx:id="btnPublish" text="Publish" onAction="#publishTemplate" styleClass="approved-button,approved-secondary-button"/>
                <Button fx:id="btnPublishDefault" text="Publish &amp; Set as Default" onAction="#publishAndSetDefault" styleClass="approved-button,approved-primary-button"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="erp-template-readiness">
                <padding><Insets top="7" right="12" bottom="7" left="12"/></padding>
                <Label text="Template Readiness" styleClass="erp-readiness-title"/>
                <Label fx:id="lblRequiredSummary" text="0 / 0 required mapped" styleClass="erp-status-chip,erp-status-neutral"/>
                <Label fx:id="lblIssueSummary" text="0 errors • 0 warnings" styleClass="erp-status-chip,erp-status-neutral"/>
                <Label text="Mapping" styleClass="field-caption"/>
                <ProgressBar fx:id="mappingProgress" prefWidth="90" progress="0"/>
                <Label fx:id="lblMappingPercent" text="0%" styleClass="pdf-v2-map-percent"/>
                <Label fx:id="lblMappingSummary" text="Not analyzed" styleClass="muted-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnFixNext" text="Fix Next Required" onAction="#fixNextIssue" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Review Issues" onAction="#reviewIssues" styleClass="approved-button,approved-secondary-button"/>
            </HBox>

            <FlowPane hgap="8" vgap="6" alignment="CENTER_LEFT" styleClass="pdf-mapper-toolbar">
                <padding><Insets top="7" right="12" bottom="7" left="12"/></padding>
                <Button fx:id="btnDesignMode" text="Edit Mapping" onAction="#showDesignMode" styleClass="approved-button,approved-secondary-button"/>
                <Button fx:id="btnFinalMode" text="Final PDF" onAction="#showFinalMode" styleClass="approved-button,approved-secondary-button"/>
                <Separator orientation="VERTICAL" prefHeight="24"/>
                <Button text="Auto Map Fields" onAction="#autoMapNow" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Detect Item Headers" onAction="#detectItemHeaders" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Review Mapping" onAction="#reviewMapping" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Validate Mapping" onAction="#validateMapping" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Mapping Guide PDF" onAction="#downloadMappingGuide" styleClass="approved-button,approved-secondary-button"/>
                <Separator orientation="VERTICAL" prefHeight="24"/>
                <Button text="Fit Width" onAction="#fitWidth" styleClass="approved-button,approved-secondary-button"/>
                <Button text="Fit Page" onAction="#fitPage" styleClass="approved-button,approved-secondary-button"/>
            </FlowPane>
        </VBox>
    </top>

    <left>
        <VBox prefWidth="350" spacing="8" styleClass="pdf-mapper-side,pdf-mapper-fields">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Mapping Checklist" styleClass="pdf-mapper-panel-title"/>
            <Label text="Required business fields are shown first. Double-click a requirement to jump directly to its best ERP-field matches." wrapText="true" styleClass="pdf-designer-help"/>
            <HBox spacing="6">
                <ToggleButton fx:id="tglRequired" text="Required" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="erp-filter-toggle"/>
                <ToggleButton fx:id="tglAll" text="All" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="erp-filter-toggle"/>
                <ToggleButton fx:id="tglMapped" text="Mapped" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="erp-filter-toggle"/>
            </HBox>
            <ListView fx:id="lstRequirements" prefHeight="235" styleClass="erp-requirement-list"/>
            <Separator/>
            <Label text="ERP Field Search" styleClass="pdf-mapper-panel-title"/>
            <TextField fx:id="txtFieldSearch" promptText="Search HSN, qty, remark, GST, invoice no..." styleClass="erp-search-field"/>
            <ListView fx:id="lstFields" VBox.vgrow="ALWAYS" styleClass="pdf-mapper-field-list,erp-field-search-list"/>
            <TitledPane text="Advanced Create Tools (optional)" expanded="false">
                <content>
                    <TilePane hgap="6" vgap="6" prefColumns="2" styleClass="pdf-v2-palette">
                        <Button text="Heading" onAction="#addHeading" onDragDetected="#dragCreateHeading" styleClass="pdf-v2-tool"/>
                        <Button text="Section" onAction="#addBlock" onDragDetected="#dragCreateBlock" styleClass="pdf-v2-tool"/>
                        <Button text="Rectangle" onAction="#addRectangle" onDragDetected="#dragCreateRectangle" styleClass="pdf-v2-tool"/>
                        <Button text="Hide Area" onAction="#addHideArea" onDragDetected="#dragCreateHideArea" styleClass="pdf-v2-tool"/>
                        <Button text="Line" onAction="#addLine" onDragDetected="#dragCreateLine" styleClass="pdf-v2-tool"/>
                        <Button text="Image" onAction="#addImage" onDragDetected="#dragCreateImage" styleClass="pdf-v2-tool"/>
                        <Button text="Item Table" onAction="#addItemRepeater" onDragDetected="#dragCreateItems" styleClass="pdf-v2-tool"/>
                        <Button text="Charge Table" onAction="#addChargeRepeater" onDragDetected="#dragCreateCharges" styleClass="pdf-v2-tool"/>
                        <Button text="Financial Summary" onAction="#addFinancialSummary" styleClass="pdf-v2-tool"/>
                        <Button text="Text" onAction="#addText" onDragDetected="#dragCreateText" styleClass="pdf-v2-tool"/>
                    </TilePane>
                </content>
            </TitledPane>
            <Label text="Repeated tables: create one Item Table, then drag Item ERP fields onto it once in PDF column order. The table repeats rows and paginates automatically." wrapText="true" styleClass="pdf-v2-help"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" styleClass="pdf-v2-workspace">
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="pdf-v2-canvas-info">
                <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
                <Label text="Original PDF (protected)" styleClass="field-caption"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="lblPageSize" text="A4"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="lblSelection" text="Nothing selected"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblPageWarning" text="" styleClass="pdf-v2-warning"/>
            </HBox>
            <ScrollPane fx:id="canvasScroll" pannable="true" fitToHeight="false" fitToWidth="false" VBox.vgrow="ALWAYS" styleClass="pdf-v2-canvas-scroll">
                <content><StackPane fx:id="canvasHolder" alignment="TOP_LEFT" styleClass="pdf-v2-canvas-holder"><Pane fx:id="canvasPane" styleClass="pdf-v2-canvas"/></StackPane></content>
            </ScrollPane>
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="pdf-v2-status">
                <padding><Insets top="7" right="10" bottom="7" left="10"/></padding>
                <Label fx:id="lblSaveState" text="Ready"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="lblIssueBar" text="Template mapping is being analyzed" styleClass="erp-issue-bar-text"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Required mappings and page-flow safety are checked before final activation" styleClass="muted-label"/>
            </HBox>
        </VBox>
    </center>

    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="355" styleClass="pdf-v2-inspector-scroll,pdf-mapper-side">
            <content>
                <VBox spacing="10" styleClass="pdf-v2-inspector,pdf-mapper-inspector">
                    <padding><Insets top="10" right="10" bottom="20" left="10"/></padding>
                    <Label text="Mapping Coach" styleClass="pdf-mapper-panel-title"/>
                    <Label fx:id="lblInspectorType" text="Select a mapped field" wrapText="true" styleClass="pdf-v2-inspector-title"/>
                    <Label fx:id="lblInspectorHint" text="Click PDF text, choose the ERP field below, then Map. The readiness counters update immediately." wrapText="true" styleClass="pdf-designer-help"/>

                    <VBox fx:id="textSection" spacing="7">
                        <Label text="Choose ERP field" styleClass="field-caption"/>
                        <Label fx:id="lblBindingContext" text="Select a checklist requirement to see the recommended ERP fields first." wrapText="true" styleClass="erp-mapping-context"/>
                        <TextField fx:id="txtInspectorFieldSearch" promptText="Search ERP field..." styleClass="erp-search-field"/>
                        <ListView fx:id="lstInspectorFieldSuggestions" prefHeight="135" styleClass="erp-field-search-list"/>
                        <Button fx:id="btnMapSelectedField" text="Select ERP Field to Map" onAction="#applySuggestedBinding" maxWidth="Infinity" disable="true" styleClass="approved-button,approved-primary-button"/>
                    </VBox>

                    <TitledPane text="Mapped Fields / Page Objects" expanded="false">
                        <content><VBox spacing="7"><ListView fx:id="lstLayers" prefHeight="200" styleClass="pdf-mapper-mapped-list"/><Button text="Remove Selected Mapping / Object" onAction="#deleteSelected" maxWidth="Infinity" styleClass="approved-button,approved-danger-button"/></VBox></content>
                    </TitledPane>

                    <TitledPane text="Preview Record" expanded="true">
                        <content><VBox spacing="7"><ComboBox fx:id="cmbSampleDocument" maxWidth="Infinity" onAction="#sampleChanged"/><Button text="Preview with Selected Record" onAction="#showDataPreviewMode" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/></VBox></content>
                    </TitledPane>

                    <TitledPane text="Advanced Design (optional)" expanded="false">
                        <content>
                            <VBox spacing="8">
                                <Label text="Only use these controls when Preview or Validate asks for a layout correction. Normal field mapping does not require them." wrapText="true" styleClass="pdf-designer-help"/>
                                <Button text="Preview JSON" onAction="#viewJsonData" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
                                <TitledPane text="Text / Position correction" expanded="false">
                                    <content>
                                        <VBox spacing="7">
                                            <Label text="Source style is preserved automatically. Change these values only when Preview shows a real alignment or text-fit problem." wrapText="true" styleClass="pdf-designer-help"/>
                                            <TextArea fx:id="txtContent" prefRowCount="2" wrapText="true" promptText="Optional literal text / expression"/>
                                            <GridPane hgap="7" vgap="7">
                                                <Label text="Font" GridPane.columnIndex="0" GridPane.rowIndex="0"/><ComboBox fx:id="cmbFontFamily" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>
                                                <Label text="Size" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="txtFontSize" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                                <Label text="Fit" GridPane.columnIndex="0" GridPane.rowIndex="2"/><ComboBox fx:id="cmbTextFit" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"/>
                                                <Label text="Align" GridPane.columnIndex="0" GridPane.rowIndex="3"/><ComboBox fx:id="cmbTextAlignment" GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="Infinity"/>
                                                <Label text="Line spacing" GridPane.columnIndex="0" GridPane.rowIndex="4"/><TextField fx:id="txtLineSpacing" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                                                <columnConstraints><ColumnConstraints minWidth="90"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
                                            </GridPane>
                                            <HBox spacing="8"><CheckBox fx:id="chkBold" text="Bold"/><CheckBox fx:id="chkItalic" text="Italic"/><CheckBox fx:id="chkInheritParent" text="Inherit"/></HBox>
                                            <Separator/>
                                            <Label text="Position &amp; Size" styleClass="field-caption"/>
                                            <GridPane hgap="7" vgap="7">
                                                <Label text="X" GridPane.columnIndex="0" GridPane.rowIndex="0"/><TextField fx:id="txtX" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                                <Label text="Y" GridPane.columnIndex="2" GridPane.rowIndex="0"/><TextField fx:id="txtY" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                                                <Label text="Width" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="txtWidth" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                                <Label text="Height" GridPane.columnIndex="2" GridPane.rowIndex="1"/><TextField fx:id="txtHeight" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                                                <columnConstraints><ColumnConstraints minWidth="48"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints minWidth="52"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
                                            </GridPane>
                                            <Button text="Apply Advanced Correction" onAction="#applyInspector" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
                                        </VBox>
                                    </content>
                                </TitledPane>
                                <VBox fx:id="imageSection" spacing="6">
                                    <Label text="Image options" styleClass="field-caption"/>
                                    <Button text="Replace / Choose Image" onAction="#replaceSelectedImage" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
                                    <ComboBox fx:id="cmbImageFit" maxWidth="Infinity"/>
                                    <CheckBox fx:id="chkPreserveRatio" text="Preserve aspect ratio" selected="true"/>
                                </VBox>
                                <VBox fx:id="repeaterSection" spacing="6">
                                    <Label text="Item / Charge table sizing" styleClass="field-caption"/>
                                    <Label text="Leave the detected columns unchanged. Adjust row/header height only if Validate reports page-capacity problems." wrapText="true" styleClass="pdf-designer-help"/>
                                    <GridPane hgap="7" vgap="7">
                                        <Label text="Row height" GridPane.columnIndex="0"/><TextField fx:id="txtRowHeight" GridPane.columnIndex="1"/>
                                        <Label text="Header height" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="txtHeaderHeight" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    </GridPane>
                                    <CheckBox fx:id="chkUseSourceTableDesign" text="Keep imported table/grid design" selected="true"/>
                                </VBox>
                                <Separator/>
                                <Label text="Flow safety" styleClass="field-caption"/>
                                <Label text="Auto Height is recommended for Address, Payment Terms and Terms &amp; Conditions. Growth/Overflow normally stay on the values chosen automatically by PDF Studio." wrapText="true" styleClass="pdf-designer-help"/>
                                <GridPane hgap="7" vgap="7">
                                    <CheckBox fx:id="chkAutoHeight" text="Auto Height" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
                                    <Label text="Growth" GridPane.columnIndex="0" GridPane.rowIndex="1"/><ComboBox fx:id="cmbGrowthDirection" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity"/>
                                    <Label text="Overflow" GridPane.columnIndex="0" GridPane.rowIndex="2"/><ComboBox fx:id="cmbOverflowPolicy" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"/>
                                </GridPane>
                            </VBox>
                        </content>
                    </TitledPane>

                    <!-- Kept instantiated for backward-compatible template editing/controller state, but intentionally removed from the normal mapping UI. -->
                    <VBox visible="false" managed="false">
                        <CheckBox fx:id="chkSnap" selected="true"/>
                        <Slider fx:id="zoomSlider" min="35" max="220" value="100"/>
                        <Label fx:id="lblZoom" text="100%"/>
                        <HBox spacing="8"><Button text="Copy Format" onAction="#copyFormat"/><Button text="Paste Format" onAction="#pasteFormat"/></HBox>
                        <FlowPane hgap="5" vgap="5"><Button text="Left" onAction="#alignLeft"/><Button text="Center" onAction="#alignCenter"/><Button text="Right" onAction="#alignRight"/><Button text="Top" onAction="#alignTop"/><Button text="Middle" onAction="#alignMiddle"/><Button text="Bottom" onAction="#alignBottom"/><Button text="Distribute H" onAction="#distributeHorizontal"/><Button text="Distribute V" onAction="#distributeVertical"/></FlowPane>
                        <HBox spacing="8" alignment="CENTER_LEFT"><Label text="Text"/><ColorPicker fx:id="colorText"/><Label text="Fill"/><ColorPicker fx:id="colorFill"/><Label text="Border"/><ColorPicker fx:id="colorStroke"/></HBox>
                        <HBox spacing="8"><CheckBox fx:id="chkFillEnabled" text="Fill"/><CheckBox fx:id="chkStrokeEnabled" text="Border"/><CheckBox fx:id="chkPaddingLinked" text="Link padding" selected="true"/></HBox>
                        <GridPane hgap="7" vgap="7">
                            <TextField fx:id="txtRotation"/><TextField fx:id="txtOpacity" GridPane.columnIndex="1"/>
                            <TextField fx:id="txtStrokeWidth" GridPane.rowIndex="1"/><TextField fx:id="txtRadius" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <TextField fx:id="txtPadTop" GridPane.rowIndex="2"/><TextField fx:id="txtPadRight" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <TextField fx:id="txtPadBottom" GridPane.rowIndex="3"/><TextField fx:id="txtPadLeft" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        </GridPane>
                        <TextField fx:id="txtTableColumns"/>
                        <ComboBox fx:id="cmbFlowAnchorMode"/><TextField fx:id="txtFlowAnchorId"/><TextField fx:id="txtFlowGap"/><TextField fx:id="txtFlowGroupId"/><TextField fx:id="txtFlowRole"/>
                        <CheckBox fx:id="chkLocked"/><CheckBox fx:id="chkVisible" selected="true"/><ComboBox fx:id="cmbPageRule"/>
                        <ListView fx:id="lstPages" prefHeight="1"/>
                        <Button fx:id="btnSaveDefault" text="Set Published Version as Default" onAction="#markDefault"/>
                        <Button text="Export Test PDF" onAction="#exportPdf"/>
                        <Button text="Group Selected" onAction="#groupSelected"/><Button text="Ungroup Selected" onAction="#ungroupSelected"/>
                        <Button text="Front" onAction="#bringToFront"/><Button text="Back" onAction="#sendToBack"/><Button text="Forward" onAction="#moveForward"/><Button text="Backward" onAction="#moveBackward"/>
                        <Button text="Lock" onAction="#toggleLock"/><Button text="Show / Hide" onAction="#toggleVisibility"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </right>
</BorderPane>
