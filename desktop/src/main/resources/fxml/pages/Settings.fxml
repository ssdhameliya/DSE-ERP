<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.SettingsController" styleClass="settings-page-shell,approved-ui,approved-screen,approved-screen-settings,erp-screen-root">
    <!-- =====================================================
         HEADER
         ===================================================== -->

    <top>
        <HBox fx:id="settingsPageHeader" alignment="CENTER_LEFT" spacing="12" styleClass="page-heading,erp-page-identity-header">


            <StackPane minWidth="42" prefWidth="42" maxWidth="42" minHeight="42" prefHeight="42" maxHeight="42" styleClass="settings-page-icon-box">
                <SVGPath content="M8.8 2h2.4l.5 2a6.8 6.8 0 0 1 1.5.9l2-.6 1.2 2.1-1.5 1.4c.1.5.1 1 0 1.5l1.5 1.4-1.2 2.1-2-.6c-.5.4-1 .7-1.5.9l-.5 2H8.8l-.5-2a6.8 6.8 0 0 1-1.5-.9l-2 .6-1.2-2.1 1.5-1.4a6 6 0 0 1 0-1.5L3.6 6.4l1.2-2.1 2 .6c.5-.4 1-.7 1.5-.9l.5-2zM10 7a2 2 0 1 0 0 4 2 2 0 0 0 0-4z" styleClass="settings-page-icon-svg"/>
            </StackPane>

            <VBox spacing="4" HBox.hgrow="ALWAYS">

                <Label text="Settings" styleClass="settings-page-title"/>

                <Label text="Company configuration, payments, invoices, notifications and email delivery" wrapText="true" styleClass="settings-page-description"/>

            </VBox>

            <Button fx:id="btnTestEmail" text="Test Email" onAction="#testEmail" styleClass="settings-action-button,settings-secondary-button">

                <graphic>
                    <SVGPath content="M2 4h16v12H2V4zm2 2v.3l6 4.2 6-4.2V6H4zm12 8V8.7l-5.4 3.8a1 1 0 0 1-1.2 0L4 8.7V14h12z" styleClass="settings-button-icon"/>
                </graphic>

            </Button>

            <Button fx:id="btnSaveSettings" text="Save Settings" onAction="#save" defaultButton="true" styleClass="settings-action-button,settings-primary-button">

                <graphic>
                    <SVGPath content="M3 2h11l3 3v12H3V2zm2 2v4h8V4H5zm1 8v3h8v-3H6z" styleClass="settings-button-icon"/>
                </graphic>

            </Button>

        </HBox>
    </top>

    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>
        <VBox spacing="8" styleClass="settings-content,settings-workspace-layout">

            <!-- 7.3.8: Settings categories are selected from the main sidebar accordion. -->

            <!-- Active category gets the full application width below the navigator. -->
            <ScrollPane fx:id="panelScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="clean-scroll,settings-panel-scroll,settings-workspace-panel-scroll">
                <content>
<StackPane fx:id="panelHost" maxWidth="Infinity" styleClass="settings-panel-host">

                        </StackPane>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
