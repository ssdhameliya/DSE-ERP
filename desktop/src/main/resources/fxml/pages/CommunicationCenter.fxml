<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.CommunicationCenterController" spacing="14" styleClass="register-page,approved-ui,approved-screen,approved-screen-communication-center,erp-screen-root">
  <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header"><StackPane styleClass="erp-page-header-icon"><Label text="✉" styleClass="erp-page-header-symbol"/></StackPane><VBox><Label text="Communication Center" styleClass="screen-title"/><Label text="Track invoice emails, WhatsApp activity and delivery failures" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Email Settings" onAction="#openEmailSettings" styleClass="secondary-button"/></HBox>
  <HBox spacing="12" styleClass="standard-kpi-row,erp-kpi-section">
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-blue" HBox.hgrow="ALWAYS"><StackPane fx:id="communicationTotalIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Total Activity" styleClass="metric-label"/><Label fx:id="lblTotal" styleClass="metric-value"/><Label text="All communication events" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-green" HBox.hgrow="ALWAYS"><StackPane fx:id="communicationSuccessIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Successful" styleClass="metric-label"/><Label fx:id="lblSuccess" styleClass="metric-value"/><Label text="Delivered successfully" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-red" HBox.hgrow="ALWAYS"><StackPane fx:id="communicationFailedIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Failed" styleClass="metric-label"/><Label fx:id="lblFailed" styleClass="metric-value"/><Label text="Needs attention" styleClass="metric-note"/></VBox></HBox>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-purple" HBox.hgrow="ALWAYS"><StackPane fx:id="communicationChannelIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Email / WhatsApp" styleClass="metric-label"/><Label fx:id="lblChannels" styleClass="metric-value"/><Label text="Channel distribution" styleClass="metric-note"/></VBox></HBox>
</HBox>
  <HBox spacing="8"><TextField fx:id="txtSearch" promptText="Search recipient, subject or document..." HBox.hgrow="ALWAYS" styleClass="approved-input"/><ComboBox fx:id="cmbChannel" prefWidth="150" styleClass="approved-input"/><ComboBox fx:id="cmbStatus" prefWidth="150" styleClass="approved-input"/><Button text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/></HBox>
  <!-- A constrained table guarantees that Subject remains visible and consumes unused width. -->
  <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-history"><columns><TableColumn fx:id="colTime" text="Date &amp; Time" styleClass="approved-table-column"/><TableColumn fx:id="colEntity" text="Document" styleClass="approved-table-column"/><TableColumn fx:id="colChannel" text="Channel" styleClass="approved-table-column"/><TableColumn fx:id="colRecipient" text="Recipient" styleClass="approved-table-column"/><TableColumn fx:id="colSubject" text="Subject" styleClass="approved-table-column"/><TableColumn fx:id="colStatus" text="Status" styleClass="approved-table-column"/><TableColumn fx:id="colError" text="Result / Error" styleClass="approved-table-column"/><TableColumn fx:id="colUser" text="Created By" styleClass="approved-table-column"/><TableColumn fx:id="colActions" text="Resend" resizable="false" sortable="false" styleClass="approved-table-column"/></columns></TableView>
</VBox>
