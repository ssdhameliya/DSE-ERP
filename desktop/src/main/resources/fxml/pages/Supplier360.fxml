<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.Supplier360Controller" spacing="8" styleClass="register-page,customer-360-page,approved-ui,approved-screen,erp-screen-root">
    <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="entity-page-header,approved-section-header,erp-page-identity-header">
        <StackPane fx:id="pageIcon" styleClass="erp-page-header-icon"/>
        <VBox spacing="2"><Label fx:id="lblTitle" text="Supplier 360°" styleClass="screen-title"/><Label text="Complete supplier profile, purchases, payables, payments, contacts, notes and documents" styleClass="screen-subtitle"/></VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Back to Suppliers" onAction="#backToSuppliers" styleClass="approved-button,approved-secondary-button,erp-nav-button"/>
        <Button text="Edit Supplier" onAction="#editSupplier" styleClass="approved-button,approved-secondary-button"/>
        <Button text="New Purchase" onAction="#newPurchase" styleClass="approved-button,approved-primary-button"/>
        <Button text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/>
    </HBox>

    <VBox spacing="6" styleClass="customer-360-profile-card,approved-section-card,customer-360-profile-compact">
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="customer-360-profile-heading"><Label text="Supplier Details" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="Status" styleClass="field-label-status"/><Label fx:id="lblStatus" styleClass="status-pill"/></HBox>
        <GridPane hgap="8" vgap="6" styleClass="customer-360-identity-grid">
            <columnConstraints><ColumnConstraints percentWidth="33.333"/><ColumnConstraints percentWidth="33.333"/><ColumnConstraints percentWidth="33.334"/></columnConstraints>
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="customer-360-detail-cell"><Label text="Supplier Code" styleClass="field-label-reference"/><Label fx:id="lblCode" styleClass="field-value"/></VBox>
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="customer-360-detail-cell"><Label text="GSTIN" styleClass="field-label-tax"/><Label fx:id="lblGstin" styleClass="field-value"/></VBox>
            <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="customer-360-detail-cell"><Label text="Contact Person" styleClass="field-label-customer"/><Label fx:id="lblContact" styleClass="field-value"/></VBox>
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="customer-360-detail-cell"><Label text="Mobile" styleClass="field-label-phone"/><Label fx:id="lblPhone" styleClass="field-value"/></VBox>
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="customer-360-detail-cell"><Label text="Email" styleClass="field-label-email"/><Label fx:id="lblEmail" wrapText="true" styleClass="field-value"/></VBox>
            <VBox GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="customer-360-detail-cell"><Label text="Address" styleClass="field-label-address"/><Label fx:id="lblAddress" wrapText="true" styleClass="field-value"/></VBox>
        </GridPane>
    </VBox>

    <HBox spacing="8" styleClass="entity-kpi-row,erp-kpi-section,erp-kpi-profile-six">
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="9" styleClass="entity-kpi-card,kpi-blue"><StackPane fx:id="outstandingIcon" styleClass="entity-kpi-icon"/><VBox><Label text="Outstanding Payable" styleClass="metric-label"/><Label fx:id="lblOutstanding" text="₹ 0.00" styleClass="metric-value"/></VBox></HBox>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="9" styleClass="entity-kpi-card,kpi-green"><StackPane fx:id="purchaseCountIcon" styleClass="entity-kpi-icon"/><VBox><Label text="Purchase Documents" styleClass="metric-label"/><Label fx:id="lblPurchaseCount" text="0 purchases" styleClass="metric-value"/></VBox></HBox>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="9" styleClass="entity-kpi-card,kpi-blue"><StackPane fx:id="purchasesIcon" styleClass="entity-kpi-icon"/><VBox><Label text="Total Purchases" styleClass="metric-label"/><Label fx:id="lblPurchases" text="₹ 0.00" styleClass="metric-value"/></VBox></HBox>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="9" styleClass="entity-kpi-card,kpi-green"><StackPane fx:id="paymentIcon" styleClass="entity-kpi-icon"/><VBox><Label text="Last Payment" styleClass="metric-label"/><Label fx:id="lblLastPayment" text="₹ 0.00" styleClass="metric-value"/></VBox></HBox>
    </HBox>

    <TabPane fx:id="tabs" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="customer-360-tabs"><tabs>
        <Tab fx:id="tabOverview" text="Overview"><content><VBox spacing="10" styleClass="customer-360-tab-content"><Label text="Recent Business Activity" styleClass="section-title"/><HBox spacing="10" VBox.vgrow="ALWAYS">
            <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="entity-table-card"><Label text="Recent Purchases" styleClass="section-title"/><TableView fx:id="tblRecentPurchases" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="rpNo" text="Purchase"/><TableColumn fx:id="rpDate" text="Date"/><TableColumn fx:id="rpAmount" text="Amount"/><TableColumn fx:id="rpOutstanding" text="Outstanding"/></columns></TableView><Label text="Double-click a record to open the existing Purchase register." styleClass="muted-text"/></VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="entity-table-card"><Label text="Recent Payments" styleClass="section-title"/><TableView fx:id="tblRecentPayments" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="rpayDate" text="Date"/><TableColumn fx:id="rpayInvoice" text="Purchase"/><TableColumn fx:id="rpayAmount" text="Amount"/><TableColumn fx:id="rpayMode" text="Mode"/></columns></TableView><Label text="Double-click a payment to open its linked Purchase." styleClass="muted-text"/></VBox>
        </HBox></VBox></content></Tab>
        <Tab fx:id="tabContacts" text="Contacts"><content><VBox spacing="8" styleClass="customer-360-tab-content"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Supplier Contacts" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Add Contact" onAction="#addContact" styleClass="approved-button,approved-primary-button"/><Button text="Edit" onAction="#editContact" styleClass="approved-button,approved-secondary-button"/><Button text="Delete" onAction="#deleteContact" styleClass="approved-button,approved-danger-button"/></HBox><TableView fx:id="tblContacts" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-master"><columns><TableColumn fx:id="cName" text="Name"/><TableColumn fx:id="cDesignation" text="Designation"/><TableColumn fx:id="cDepartment" text="Department"/><TableColumn fx:id="cMobile" text="Mobile"/><TableColumn fx:id="cEmail" text="Email"/><TableColumn fx:id="cPrimary" text="Primary"/></columns></TableView></VBox></content></Tab>
        <Tab fx:id="tabPurchases" text="Purchases"><content><VBox spacing="8" styleClass="customer-360-tab-content"><Label text="Supplier Purchases" styleClass="section-title"/><TableView fx:id="tblPurchases" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="pNo" text="Purchase No."/><TableColumn fx:id="pDate" text="Date"/><TableColumn fx:id="pAmount" text="Amount"/><TableColumn fx:id="pPaid" text="Paid"/><TableColumn fx:id="pOutstanding" text="Outstanding"/><TableColumn fx:id="pStatus" text="Status"/></columns></TableView><Label text="Double-click to open the existing Purchase register. Supplier 360° does not recalculate purchase totals." styleClass="muted-text"/></VBox></content></Tab>
        <Tab fx:id="tabPayments" text="Payments"><content><VBox spacing="8" styleClass="customer-360-tab-content"><Label text="Supplier Payments" styleClass="section-title"/><TableView fx:id="tblPayments" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="payDate" text="Date"/><TableColumn fx:id="payInvoice" text="Purchase"/><TableColumn fx:id="payMode" text="Mode"/><TableColumn fx:id="payReference" text="Reference"/><TableColumn fx:id="payAmount" text="Amount"/><TableColumn fx:id="payNotes" text="Notes"/></columns></TableView><Label text="Double-click a payment to open its linked Purchase. Payment posting remains in the existing payment flow." styleClass="muted-text"/></VBox></content></Tab>
        <Tab fx:id="tabNotes" text="Notes"><content><VBox spacing="8" styleClass="customer-360-tab-content"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Supplier-level Notes" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Add Note" onAction="#addNote" styleClass="approved-button,approved-primary-button"/><Button text="Edit" onAction="#editNote" styleClass="approved-button,approved-secondary-button"/><Button text="Delete" onAction="#deleteNote" styleClass="approved-button,approved-danger-button"/></HBox><TableView fx:id="tblNotes" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="nDate" text="Date / Time"/><TableColumn fx:id="nBy" text="User"/><TableColumn fx:id="nText" text="Note"/></columns></TableView></VBox></content></Tab>
        <Tab fx:id="tabDocuments" text="Documents"><content><VBox spacing="8" styleClass="customer-360-tab-content"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Supplier Documents" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Add Document" onAction="#addDocument" styleClass="approved-button,approved-primary-button"/><Button text="Preview" onAction="#viewDocument" styleClass="approved-button,approved-secondary-button"/><Button text="Delete" onAction="#deleteDocument" styleClass="approved-button,approved-danger-button"/></HBox><TableView fx:id="tblDocuments" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="dName" text="Document"/><TableColumn fx:id="dUploaded" text="Uploaded"/><TableColumn fx:id="dBy" text="Uploaded By"/></columns></TableView><Label text="Documents are stored through the existing server-managed attachment infrastructure." styleClass="muted-text"/></VBox></content></Tab>
    </tabs></TabPane>
</VBox>
