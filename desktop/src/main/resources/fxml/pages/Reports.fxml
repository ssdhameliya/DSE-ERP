<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.ReportsController"
      spacing="8" styleClass="approved-ui,approved-screen,approved-screen-reports,erp-screen-root,reports-workspace">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="approved-page-header,approved-section-header,erp-page-identity-header,reports-header">
        <StackPane fx:id="reportPageIcon" styleClass="erp-page-header-icon"/>
        <VBox spacing="3" alignment="CENTER_LEFT">
            <Label fx:id="lblPageTitle" text="Reports Dashboard" styleClass="approved-page-title,page-title"/>
            <Label fx:id="lblPageSubtitle" text="Real-time financial and operational summary" styleClass="approved-page-subtitle,page-subtitle,reports-header-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnRefresh" text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/>
        <MenuButton fx:id="btnExport" text="Export" styleClass="approved-menu-button,approved-button,approved-primary-button,reports-export-button">
            <items>
                <MenuItem fx:id="miExcel" text="Export Excel" onAction="#exportExcel"/>
                <MenuItem fx:id="miPdf" text="Export PDF" onAction="#exportPdf"/>
                <MenuItem fx:id="miCsv" text="Export CSV" onAction="#exportCsv"/>
            </items>
        </MenuButton>
        <Button fx:id="btnContextAction" text="Recent Exports" onAction="#headerContextAction" visible="false" managed="false" styleClass="approved-button,approved-primary-button"/>
    </HBox>

    <TabPane fx:id="reportTabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="reporting-tabs,reports-main-tabs">
        <tabs>
            <Tab text="Dashboard">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="approved-page-scroll,reports-scroll">
                    <content>
                        <VBox spacing="10" styleClass="reports-dashboard-page">
                            <padding><Insets top="6" right="8" bottom="10" left="8"/></padding>

                            <VBox spacing="8" styleClass="report-filter-card,reports-dashboard-filter">
                                <GridPane hgap="10" vgap="6">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="16.666" hgrow="ALWAYS"/><ColumnConstraints percentWidth="16.666" hgrow="ALWAYS"/>
                                        <ColumnConstraints percentWidth="16.666" hgrow="ALWAYS"/><ColumnConstraints percentWidth="16.666" hgrow="ALWAYS"/>
                                        <ColumnConstraints percentWidth="16.666" hgrow="ALWAYS"/><ColumnConstraints percentWidth="16.666" hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <VBox spacing="3"><Label text="Period" styleClass="field-label"/><ComboBox fx:id="cmbDashboardPeriod" maxWidth="Infinity" styleClass="approved-input"/></VBox>
                                    <VBox GridPane.columnIndex="1" spacing="3"><Label text="From Date" styleClass="field-label"/><DatePicker fx:id="dpFrom" maxWidth="Infinity" styleClass="approved-input"/></VBox>
                                    <VBox GridPane.columnIndex="2" spacing="3"><Label text="To Date" styleClass="field-label"/><DatePicker fx:id="dpTo" maxWidth="Infinity" styleClass="approved-input"/></VBox>
                                    <VBox GridPane.columnIndex="3" spacing="3"><Label text="Party" styleClass="field-label"/><ComboBox fx:id="cmbParty" maxWidth="Infinity" styleClass="approved-input"/></VBox>
                                    <VBox GridPane.columnIndex="4" spacing="3"><Label text="Item" styleClass="field-label"/><ComboBox fx:id="cmbItem" maxWidth="Infinity" styleClass="approved-input"/></VBox>
                                    <VBox GridPane.columnIndex="5" spacing="3"><Label text="Salesperson" styleClass="field-label"/><ComboBox fx:id="cmbSalesPerson" maxWidth="Infinity" styleClass="approved-input"/></VBox>
                                </GridPane>
                                <ComboBox fx:id="cmbReportType" visible="false" managed="false" styleClass="approved-input"/>
                                <HBox alignment="CENTER_RIGHT" spacing="8"><Button fx:id="btnReset" text="Reset" onAction="#resetFilters" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnApply" text="Apply Filters" onAction="#refresh" styleClass="approved-button,approved-primary-button"/></HBox>
                            </VBox>

                            <GridPane hgap="10" vgap="10" styleClass="report-kpi-grid,erp-kpi-section">
                                <HBox GridPane.columnIndex="0" onMouseClicked="#openSalesRegister" alignment="CENTER_LEFT" spacing="10" styleClass="sales-metric-card,report-kpi-card,report-kpi-clickable,kpi-sales"><StackPane fx:id="reportSalesIcon" styleClass="sales-metric-icon,approved-kpi-icon"/><VBox spacing="2"><Label text="Active Sales" styleClass="metric-label,approved-kpi-caption"/><Label fx:id="lblSales" styleClass="metric-value,approved-kpi-value,report-responsive-value"/><Label text="View Sales Register →" styleClass="metric-note,approved-link"/></VBox></HBox>
                                <HBox GridPane.columnIndex="1" onMouseClicked="#openPurchaseRegister" alignment="CENTER_LEFT" spacing="10" styleClass="sales-metric-card,report-kpi-card,report-kpi-clickable,kpi-purchase"><StackPane fx:id="reportPurchaseIcon" styleClass="sales-metric-icon,approved-kpi-icon"/><VBox spacing="2"><Label text="Active Purchases" styleClass="metric-label,approved-kpi-caption"/><Label fx:id="lblPurchase" styleClass="metric-value,approved-kpi-value,report-responsive-value"/><Label text="View Purchase Register →" styleClass="metric-note,approved-link"/></VBox></HBox>
                                <HBox GridPane.columnIndex="2" onMouseClicked="#openProfitability" alignment="CENTER_LEFT" spacing="10" styleClass="sales-metric-card,report-kpi-card,report-kpi-clickable,kpi-profit"><StackPane fx:id="reportProfitIcon" styleClass="sales-metric-icon,approved-kpi-icon"/><VBox spacing="2"><Label text="Gross Profit" styleClass="metric-label,approved-kpi-caption"/><Label fx:id="lblProfit" styleClass="metric-value,approved-kpi-value,report-responsive-value"/><Label text="View Profitability →" styleClass="metric-note,approved-link"/></VBox></HBox>
                                <HBox GridPane.columnIndex="3" onMouseClicked="#openReceivables" alignment="CENTER_LEFT" spacing="10" styleClass="sales-metric-card,report-kpi-card,report-kpi-clickable,kpi-receivable"><StackPane fx:id="reportReceivableIcon" styleClass="sales-metric-icon,approved-kpi-icon"/><VBox spacing="2"><Label text="Receivables" styleClass="metric-label,approved-kpi-caption"/><Label fx:id="lblReceivables" styleClass="metric-value,approved-kpi-value,report-responsive-value"/><Label text="View Ageing →" styleClass="metric-note,approved-link"/></VBox></HBox>
                                <HBox GridPane.columnIndex="4" onMouseClicked="#openInventory" alignment="CENTER_LEFT" spacing="10" styleClass="sales-metric-card,report-kpi-card,report-kpi-clickable,kpi-stock"><StackPane fx:id="reportStockIcon" styleClass="sales-metric-icon,approved-kpi-icon"/><VBox spacing="2"><Label text="Stock Value" styleClass="metric-label,approved-kpi-caption"/><Label fx:id="lblStock" styleClass="metric-value,approved-kpi-value,report-responsive-value"/><Label fx:id="lblLowStock" styleClass="metric-note,approved-link"/></VBox></HBox>
                                <HBox GridPane.columnIndex="5" alignment="CENTER_LEFT" spacing="10" styleClass="sales-metric-card,report-kpi-card,kpi-customer"><StackPane fx:id="reportCustomerIcon" styleClass="sales-metric-icon,approved-kpi-icon"/><VBox spacing="2"><Label text="Customers" styleClass="metric-label,approved-kpi-caption"/><Label fx:id="lblCustomers" styleClass="metric-value,approved-kpi-value"/><Label text="Active customers" styleClass="metric-note"/></VBox></HBox>
                            </GridPane>

                            <GridPane hgap="10" vgap="10" prefHeight="280" styleClass="reports-dashboard-primary-row">
                                <columnConstraints><ColumnConstraints percentWidth="40" hgrow="ALWAYS"/><ColumnConstraints percentWidth="40" hgrow="ALWAYS"/><ColumnConstraints percentWidth="20" hgrow="ALWAYS"/></columnConstraints>
                                <VBox GridPane.columnIndex="0" spacing="8" styleClass="report-card"><HBox alignment="CENTER_LEFT"><Label text="Recent Sales Invoices" styleClass="approved-card-title,section-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnViewSales" text="View Report" onAction="#openSalesRegister" styleClass="approved-button,approved-secondary-button"/></HBox><TableView fx:id="tblSales" VBox.vgrow="ALWAYS" styleClass="approved-table,report-table,erp-table-profile-summary"><columns><TableColumn fx:id="colSaleNo" text="Invoice No."/><TableColumn fx:id="colSaleDate" text="Date"/><TableColumn fx:id="colSaleParty" text="Customer"/><TableColumn fx:id="colSaleAmount" text="Amount"/><TableColumn fx:id="colSaleStatus" text="Status"/></columns></TableView></VBox>
                                <VBox GridPane.columnIndex="1" spacing="8" styleClass="report-card"><HBox alignment="CENTER_LEFT"><Label text="Recent Purchase Invoices" styleClass="approved-card-title,section-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnViewPurchases" text="View Report" onAction="#openPurchaseRegister" styleClass="approved-button,approved-secondary-button"/></HBox><TableView fx:id="tblPurchases" VBox.vgrow="ALWAYS" styleClass="approved-table,report-table,erp-table-profile-summary"><columns><TableColumn fx:id="colPurchaseNo" text="Invoice No."/><TableColumn fx:id="colPurchaseDate" text="Date"/><TableColumn fx:id="colPurchaseParty" text="Supplier"/><TableColumn fx:id="colPurchaseAmount" text="Amount"/><TableColumn fx:id="colPurchaseStatus" text="Status"/></columns></TableView></VBox>
                                <VBox GridPane.columnIndex="2" spacing="8" styleClass="report-card"><Label text="Payment Snapshot" styleClass="approved-card-title,section-title"/><ListView fx:id="paymentSummary" VBox.vgrow="ALWAYS" styleClass="approved-list,summary-list,reports-summary-list"/></VBox>
                            </GridPane>

                            <GridPane hgap="10" vgap="10" prefHeight="205" styleClass="reports-dashboard-insight-row">
                                <columnConstraints><ColumnConstraints percentWidth="25" hgrow="ALWAYS"/><ColumnConstraints percentWidth="25" hgrow="ALWAYS"/><ColumnConstraints percentWidth="25" hgrow="ALWAYS"/><ColumnConstraints percentWidth="25" hgrow="ALWAYS"/></columnConstraints>
                                <VBox GridPane.columnIndex="0" spacing="8" styleClass="report-card"><Label text="Top Customers" styleClass="approved-card-title,section-title"/><ListView fx:id="topCustomersSummary" VBox.vgrow="ALWAYS" styleClass="approved-list,summary-list,reports-summary-list"/></VBox>
                                <VBox GridPane.columnIndex="1" spacing="8" styleClass="report-card"><Label text="Top Selling Items" styleClass="approved-card-title,section-title"/><ListView fx:id="topItemsSummary" VBox.vgrow="ALWAYS" styleClass="approved-list,summary-list,reports-summary-list"/></VBox>
                                <VBox GridPane.columnIndex="2" spacing="8" styleClass="report-card"><Label text="Business Health" styleClass="approved-card-title,section-title"/><Label text="Gross Margin" styleClass="field-label"/><Label fx:id="lblMargin" text="0.00%" styleClass="metric-value"/><ProgressBar fx:id="profitProgress" progress="0" maxWidth="Infinity"/><ListView fx:id="performanceSummary" VBox.vgrow="ALWAYS" styleClass="approved-list,summary-list,reports-summary-list"/></VBox>
                                <VBox GridPane.columnIndex="3" spacing="8" styleClass="report-card"><Label text="Stock Attention" styleClass="approved-card-title,section-title"/><ListView fx:id="stockSummary" VBox.vgrow="ALWAYS" styleClass="approved-list,summary-list,reports-summary-list"/></VBox>
                            </GridPane>
                        </VBox>
                    </content>
                </ScrollPane>
            </Tab>

            <Tab text="Report Center">
                <BorderPane styleClass="reports-tab-page,report-center-root">
                    <top>
                        <VBox spacing="8">
                            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="reports-tab-toolbar">
                                <VBox spacing="2"><Label text="Report Center" styleClass="approved-page-title,page-title"/><Label text="Choose a category, search the catalog and open a unified report viewer." styleClass="approved-page-subtitle,page-subtitle"/></VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <StackPane minWidth="330" prefWidth="390" maxWidth="520" styleClass="erp-item-search-shell,register-header-search-shell,report-search-shell">
                                    <TextField fx:id="txtReportSearch" promptText="Search reports, e.g. GST..." maxWidth="Infinity" styleClass="approved-input,erp-item-search,register-header-search-input"/>
                                    <StackPane fx:id="reportCenterSearchIcon" mouseTransparent="true" minWidth="24" prefWidth="24" maxWidth="24" minHeight="24" prefHeight="24" maxHeight="24" StackPane.alignment="CENTER_RIGHT" styleClass="erp-item-search-icon-box,register-header-search-icon"><StackPane.margin><Insets right="8"/></StackPane.margin></StackPane>
                                </StackPane>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="approved-card,approved-surface,report-category-strip">
                                <Label text="Report Categories" styleClass="approved-card-title,section-title"/>
                                <ListView fx:id="reportCategories" orientation="HORIZONTAL" HBox.hgrow="ALWAYS" prefHeight="52" minHeight="52" maxHeight="52" styleClass="approved-list,report-category-list,report-category-strip-list"/>
                            </HBox>
                        </VBox>
                    </top>
                    <center>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="reports-scroll,report-center-scroll">
                            <content>
                                <VBox spacing="10" styleClass="report-center-content">
                                    <padding><Insets top="8" right="4" bottom="12" left="4"/></padding>
                                    <Label fx:id="lblReportCenterCategory" text="SALES REPORTS" styleClass="report-category-heading,approved-card-title"/>
                                    <TilePane fx:id="reportCards" prefColumns="3" hgap="12" vgap="12" tileAlignment="TOP_LEFT" styleClass="report-center-cards"/>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </center>
                </BorderPane>
            </Tab>

            <Tab text="Saved Reports">
                <VBox spacing="10" styleClass="reports-tab-page">
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="reports-tab-toolbar">
                        <VBox spacing="2"><Label text="Saved Reports" styleClass="approved-page-title,page-title"/><Label text="Reusable report configurations with dynamic periods, grouping, sorting and visible columns." styleClass="approved-page-subtitle,page-subtitle"/></VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Create from Report Center" onAction="#openReportCenterTab" styleClass="approved-button,approved-primary-button"/>
                    </HBox>
                    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="report-card,saved-report-panel">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <StackPane minWidth="300" prefWidth="390" maxWidth="520" styleClass="erp-item-search-shell,register-header-search-shell,report-search-shell">
                                <TextField fx:id="txtSavedSearch" promptText="Search saved reports..." maxWidth="Infinity" styleClass="approved-input,erp-item-search,register-header-search-input"/>
                                <StackPane fx:id="savedReportSearchIcon" mouseTransparent="true" minWidth="24" prefWidth="24" maxWidth="24" minHeight="24" prefHeight="24" maxHeight="24" StackPane.alignment="CENTER_RIGHT" styleClass="erp-item-search-icon-box,register-header-search-icon"><StackPane.margin><Insets right="8"/></StackPane.margin></StackPane>
                            </StackPane>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Refresh" onAction="#loadSavedReports" styleClass="approved-button,approved-secondary-button"/>
                        </HBox>
                        <TableView fx:id="tblSavedReports" VBox.vgrow="ALWAYS" styleClass="approved-table,report-table,erp-table-profile-register">
                            <columns>
                                <TableColumn fx:id="colSavedName" text="Saved Report"/>
                                <TableColumn fx:id="colSavedBase" text="Base Report"/>
                                <TableColumn fx:id="colSavedPreset" text="Date Preset"/>
                                <TableColumn fx:id="colSavedGrouping" text="Grouping"/>
                                <TableColumn fx:id="colSavedSorting" text="Sorting"/>
                                <TableColumn fx:id="colSavedColumns" text="Columns"/>
                                <TableColumn fx:id="colSavedStatus" text="Schedule"/>
                                <TableColumn fx:id="colSavedActions" text="Actions"/>
                            </columns>
                        </TableView>
                        <Label text="Saved Reports store configuration only. Opening one restores the filters and runs fresh server data." wrapText="true" styleClass="approved-page-subtitle,page-subtitle"/>
                    </VBox>
                </VBox>
            </Tab>

            <Tab text="Scheduled">
                <VBox spacing="10" styleClass="reports-tab-page">
                    <HBox alignment="CENTER_LEFT" styleClass="reports-tab-toolbar"><VBox spacing="2"><Label text="Scheduled Reports" styleClass="approved-page-title,page-title"/><Label text="Server-side schedules built from Saved Reports with dynamic date presets and delivery history." styleClass="approved-page-subtitle,page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/></HBox>
                    <GridPane hgap="10" vgap="10" styleClass="report-kpi-grid,erp-kpi-section">
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sales-metric-card,report-kpi-card,kpi-profit"><StackPane styleClass="sales-metric-icon,approved-kpi-icon"/><VBox><Label text="Active Schedules" styleClass="metric-label"/><Label fx:id="lblActiveSchedules" text="0" styleClass="metric-value"/><Label text="Enabled" styleClass="metric-note"/></VBox></HBox>
                        <HBox GridPane.columnIndex="1" alignment="CENTER_LEFT" spacing="10" styleClass="sales-metric-card,report-kpi-card,kpi-stock"><StackPane styleClass="sales-metric-icon,approved-kpi-icon"/><VBox><Label text="Next Run" styleClass="metric-label"/><Label fx:id="lblNextRun" text="Not scheduled" styleClass="metric-value"/><Label text="Server scheduler" styleClass="metric-note"/></VBox></HBox>
                        <HBox GridPane.columnIndex="2" alignment="CENTER_LEFT" spacing="10" styleClass="sales-metric-card,report-kpi-card,kpi-customer"><StackPane styleClass="sales-metric-icon,approved-kpi-icon"/><VBox><Label text="Reports This Month" styleClass="metric-label"/><Label fx:id="lblReportsMonth" text="0" styleClass="metric-value"/><Label text="Generated" styleClass="metric-note"/></VBox></HBox>
                        <HBox GridPane.columnIndex="3" alignment="CENTER_LEFT" spacing="10" styleClass="sales-metric-card,report-kpi-card,kpi-profit"><StackPane styleClass="sales-metric-icon,approved-kpi-icon"/><VBox><Label text="Failures" styleClass="metric-label"/><Label fx:id="lblScheduleFailures" text="0" styleClass="metric-value"/><Label text="Last 30 days" styleClass="metric-note"/></VBox></HBox>
                    </GridPane>
                    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="report-card">
                        <HBox spacing="10" alignment="BOTTOM_LEFT">
                            <StackPane minWidth="300" prefWidth="390" maxWidth="520" styleClass="erp-item-search-shell,register-header-search-shell,report-search-shell">
                                <TextField fx:id="txtScheduleSearch" promptText="Search schedules..." maxWidth="Infinity" styleClass="approved-input,erp-item-search,register-header-search-input"/>
                                <StackPane fx:id="scheduleSearchIcon" mouseTransparent="true" minWidth="24" prefWidth="24" maxWidth="24" minHeight="24" prefHeight="24" maxHeight="24" StackPane.alignment="CENTER_RIGHT" styleClass="erp-item-search-icon-box,register-header-search-icon"><StackPane.margin><Insets right="8"/></StackPane.margin></StackPane>
                            </StackPane>
                            <VBox spacing="3"><Label text="Status" styleClass="field-label"/><ComboBox fx:id="cmbScheduleStatus" prefWidth="180" styleClass="approved-input"/></VBox>
                            <VBox spacing="3"><Label text="Format" styleClass="field-label"/><ComboBox fx:id="cmbScheduleFormat" prefWidth="180" styleClass="approved-input"/></VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <TableView fx:id="tblSchedules" VBox.vgrow="ALWAYS" styleClass="approved-table,report-table,erp-table-profile-register">
                            <columns>
                                <TableColumn fx:id="colScheduleName" text="Schedule"/><TableColumn fx:id="colScheduleReport" text="Saved Report"/><TableColumn fx:id="colScheduleFrequency" text="Frequency"/><TableColumn fx:id="colScheduleTime" text="Time"/><TableColumn fx:id="colScheduleFormat" text="Format"/><TableColumn fx:id="colScheduleDelivery" text="Delivery"/><TableColumn fx:id="colScheduleNextRun" text="Next Run"/><TableColumn fx:id="colScheduleStatus" text="Status"/><TableColumn fx:id="colScheduleActions" text="Actions"/>
                            </columns>
                        </TableView>
                        <Label text="Schedules run on the server, resolve the Saved Report period at execution time, export the same report result and record delivery history." wrapText="true" styleClass="approved-page-subtitle,page-subtitle"/>
                    </VBox>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
