<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.chart.*?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.QuotationController" styleClass="register-page,quotation-register-page,approved-ui,approved-screen,approved-screen-quotations,erp-screen-root">

    <top>
        <VBox spacing="10" styleClass="quotation-register-top,erp-transparent-section-stack">
            <padding><Insets top="14" right="14" bottom="0" left="14"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header">
                <StackPane fx:id="pageIcon" styleClass="quotation-page-icon"/>
                <VBox spacing="2">
                    <Label text="Quotation Register" styleClass="screen-title"/>
                    <Label text="Manage all quotations, follow-ups, conversion and customer communication" styleClass="screen-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane prefWidth="340" minWidth="240" maxWidth="360" styleClass="erp-item-search-shell,register-header-search-shell,quotation-header-search-shell">
                    <TextField fx:id="txtSearch" promptText="Search quotation, customer, mobile or GSTIN..." maxWidth="Infinity" styleClass="approved-input,erp-item-search,register-header-search-input"/>
                    <StackPane fx:id="quotationHeaderSearchIcon" mouseTransparent="true" minWidth="24" prefWidth="24" maxWidth="24" minHeight="24" prefHeight="24" maxHeight="24" StackPane.alignment="CENTER_RIGHT" styleClass="erp-item-search-icon-box,register-header-search-icon">
                        <StackPane.margin><Insets right="8"/></StackPane.margin>
                    </StackPane>
                </StackPane>
                <Button fx:id="btnNewQuotation" text="New Quotation" onAction="#newQuotation" styleClass="quotation-primary-button"/>
            </HBox>


        </VBox>
    </top>

    <center>
        <SplitPane fx:id="mainSplit" dividerPositions="1" styleClass="quotation-register-split"><BorderPane.margin><Insets top="14" right="14" bottom="14" left="14"/></BorderPane.margin>
            <items>
                <VBox spacing="12" styleClass="quotation-register-workspace">
                    <HBox spacing="12" styleClass="quotation-metric-row,erp-kpi-section">
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="quotation-metric-card,quotation-metric-total" HBox.hgrow="ALWAYS">
                    <StackPane fx:id="totalMetricIcon" styleClass="quotation-metric-icon,total-quotation-icon"/>
                    <VBox spacing="4"><Label text="Total Quotations" styleClass="metric-label"/><Label fx:id="lblTotalValue" styleClass="metric-value"/><Label fx:id="lblTotalCount" styleClass="metric-note"/></VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="quotation-metric-card,quotation-metric-pending" HBox.hgrow="ALWAYS">
                    <StackPane fx:id="pendingMetricIcon" styleClass="quotation-metric-icon,pending-quotation-icon"/>
                    <VBox spacing="4"><Label text="Pending Quotations" styleClass="metric-label"/><Label fx:id="lblPendingValue" styleClass="metric-value"/><Label fx:id="lblPendingCount" styleClass="metric-note"/></VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="quotation-metric-card,quotation-metric-accepted" HBox.hgrow="ALWAYS">
                    <StackPane fx:id="acceptedMetricIcon" styleClass="quotation-metric-icon,accepted-quotation-icon"/>
                    <VBox spacing="4"><Label text="Accepted Quotations" styleClass="metric-label"/><Label fx:id="lblAcceptedValue" styleClass="metric-value"/><Label fx:id="lblAcceptedCount" styleClass="metric-note"/></VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="quotation-metric-card,quotation-metric-expired" HBox.hgrow="ALWAYS">
                    <StackPane fx:id="expiredMetricIcon" styleClass="quotation-metric-icon,expired-quotation-icon"/>
                    <VBox spacing="4"><Label text="Expired Quotations" styleClass="metric-label"/><Label fx:id="lblExpiredValue" styleClass="metric-value"/><Label fx:id="lblExpiredCount" styleClass="metric-note"/></VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="quotation-metric-card,quotation-metric-conversion" HBox.hgrow="ALWAYS">
                    <StackPane fx:id="conversionMetricIcon" styleClass="quotation-metric-icon,conversion-quotation-icon"/>
                    <VBox spacing="4"><Label text="Conversion Rate" styleClass="metric-label"/><Label fx:id="lblConversion" styleClass="metric-value"/><Label text="Accepted / total" styleClass="metric-note"/></VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="quotation-metric-card,quotation-metric-average" HBox.hgrow="ALWAYS">
                    <StackPane fx:id="averageMetricIcon" styleClass="quotation-metric-icon,average-quotation-icon"/>
                    <VBox spacing="4"><Label text="Average Value" styleClass="metric-label"/><Label fx:id="lblAverage" styleClass="metric-value"/><Label text="All quotations" styleClass="metric-note"/></VBox>
                </HBox>
            </HBox>
                    <VBox spacing="10" styleClass="quotation-filter-card,approved-filter-bar,erp-filter-section">
                        <GridPane hgap="10" vgap="7" styleClass="register-visible-filter-grid,quotation-visible-filter-grid">
                            <columnConstraints><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="18"/><ColumnConstraints percentWidth="18"/><ColumnConstraints percentWidth="21"/><ColumnConstraints percentWidth="18"/></columnConstraints>
                            <VBox spacing="4"><Label text="Customer" styleClass="filter-label,filter-label-customer"/><ComboBox fx:id="cmbCustomer" maxWidth="Infinity" styleClass="approved-input"/></VBox>
                            <VBox spacing="4" GridPane.columnIndex="1"><Label text="From Date" styleClass="filter-label,filter-label-date"/><DatePicker fx:id="dpFrom" maxWidth="Infinity" styleClass="approved-input"/></VBox>
                            <VBox spacing="4" GridPane.columnIndex="2"><Label text="To Date" styleClass="filter-label,filter-label-date"/><DatePicker fx:id="dpTo" maxWidth="Infinity" styleClass="approved-input"/></VBox>
                            <VBox spacing="4" GridPane.columnIndex="3"><Label text="Document Status" styleClass="filter-label,filter-label-document"/><ComboBox fx:id="cmbStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox>
                            <VBox spacing="4" GridPane.columnIndex="4"><Label text="Quotation No." styleClass="filter-label,filter-label-document"/><TextField fx:id="txtNumber" promptText="Quotation no." styleClass="approved-input"/></VBox>
                        </GridPane>

                        <GridPane fx:id="advancedFilters" hgap="12" vgap="10" visible="false" managed="false" styleClass="quotation-filter-grid,approved-filter-bar">
                            <VBox spacing="4"><Label text="Valid Upto" styleClass="filter-label"/><DatePicker fx:id="dpValid" maxWidth="Infinity" promptText="Any date" styleClass="approved-input"/></VBox>
                            <VBox spacing="4" GridPane.columnIndex="1"><Label text="Sales Person" styleClass="filter-label"/><ComboBox fx:id="cmbSalesperson" maxWidth="Infinity" styleClass="approved-input"/></VBox>
                            <VBox spacing="4" GridPane.columnIndex="2"><Label text="Amount From" styleClass="filter-label"/><TextField fx:id="txtAmountFrom" promptText="Min Amount" styleClass="approved-input"/></VBox>
                            <VBox spacing="4" GridPane.columnIndex="3"><Label text="Amount To" styleClass="filter-label"/><TextField fx:id="txtAmountTo" promptText="Max Amount" styleClass="approved-input"/></VBox>
                            <VBox spacing="4" GridPane.columnIndex="4"><Label text="Follow Up" styleClass="filter-label"/><ComboBox fx:id="cmbFollowUp" maxWidth="Infinity" styleClass="approved-input"/></VBox>
                            <VBox spacing="4" GridPane.columnIndex="5"><Label text="Source" styleClass="filter-label"/><ComboBox fx:id="cmbSource" maxWidth="Infinity" styleClass="approved-input"/></VBox>
                            <Button fx:id="btnApplyFilters" text="Apply Filters" onAction="#applyFilters" visible="false" managed="false"/>
                        </GridPane>

                        <ToggleButton fx:id="btnAdvanced" text="Advanced Filters" selected="false" onAction="#toggleAdvanced" visible="false" managed="false"/>
                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="quick-date-row,register-quick-range-row">
                            <Button fx:id="btnAllDatesRange" text="All Date" onAction="#showAllDates" styleClass="quick-range-button,quick-range-all,approved-button,approved-secondary-button"/>
                            <Button fx:id="btnTodayRange" text="Today" onAction="#showToday" styleClass="quick-range-today,quick-range-button,quick-range-today,approved-button,approved-secondary-button"/>
                            <Button fx:id="btnYesterdayRange" text="Yesterday" onAction="#showYesterday" styleClass="quick-range-yesterday,quick-range-button,quick-range-yesterday,approved-button,approved-secondary-button"/>
                            <Button fx:id="btnSevenDaysRange" text="7 Days" onAction="#showSevenDays" styleClass="quick-range-button,quick-range-seven,approved-button,approved-secondary-button"/>
                            <Button fx:id="btnThirtyDaysRange" text="30 Days" onAction="#showThirtyDays" styleClass="quick-range-button,quick-range-thirty,approved-button,approved-secondary-button"/>
                            <Button fx:id="btnCustomRange" text="Custom Range" onAction="#showCustomRange" visible="false" managed="false" styleClass="quick-range-button,quick-range-custom,approved-button,approved-secondary-button"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnReset" text="Reset" onAction="#resetFilters" styleClass="register-action-button,register-reset-button"/>
                            <Button fx:id="btnRefresh" text="Refresh" onAction="#refreshWithFeedback" styleClass="register-action-button,register-refresh-button"/>
                        </HBox>
                        <FlowPane fx:id="activeFilterChips" hgap="6" vgap="5" visible="false" managed="false"/>
                    </VBox>

                    <VBox spacing="0" styleClass="quotation-table-card" VBox.vgrow="ALWAYS">
                        <TableView fx:id="table" minHeight="0" VBox.vgrow="ALWAYS" styleClass="professional-table,quotation-register-table,erp-table-profile-register,erp-purple-selection-table">
                            <columns>
                                <TableColumn fx:id="colNo" text="Quotation No." styleClass="approved-table-column"/>
                                <TableColumn fx:id="colDate" text="Date" styleClass="approved-table-column"/>
                                <TableColumn fx:id="colCustomer" text="Customer" styleClass="approved-table-column"/>
                                <TableColumn fx:id="colAmount" text="Amount" styleClass="approved-table-column"/>
                                <TableColumn fx:id="colValid" text="Valid Upto" styleClass="approved-table-column"/>
                                <TableColumn fx:id="colStatus" text="Status" styleClass="approved-table-column"/>
                                <TableColumn fx:id="colFollowUp" text="Follow Up" styleClass="approved-table-column"/>
                                <TableColumn fx:id="colConverted" text="Converted To" styleClass="approved-table-column"/>
                                <TableColumn fx:id="colSalesperson" text="Sales Person" styleClass="approved-table-column"/>
                                <TableColumn fx:id="colCreatedBy" text="Created By" styleClass="approved-table-column"/>
                                <TableColumn fx:id="colActions" text="Actions" styleClass="approved-table-column" sortable="false" resizable="false"/>
                            </columns>
                        </TableView>

                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="quotation-export-bar">
                            <Button fx:id="btnExportExcel" text="Export Excel" onAction="#exportExcel" styleClass="quotation-export-button,approved-button,approved-secondary-button"/>
                            <Button fx:id="btnExportPdf" text="Export PDF" onAction="#exportRegisterPdf" styleClass="quotation-export-button,approved-button,approved-secondary-button"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblFilteredSummary" styleClass="quotation-filtered-summary"/><Button fx:id="btnPrevPage" text="‹ Previous" onAction="#previousPage" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnNextPage" text="Next ›" onAction="#nextPage" styleClass="approved-button,approved-secondary-button"/>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox fx:id="detailDrawer" spacing="11" prefWidth="410" minWidth="390" maxWidth="440" styleClass="detail-drawer,erp-detail-drawer-card,quotation-detail-drawer" minHeight="0">
                    <HBox alignment="CENTER_LEFT" spacing="8"><Label text="Quotation Details" styleClass="drawer-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Close" onAction="#closeDetails" styleClass="quotation-detail-close-button,approved-button,approved-danger-button"/></HBox>
                    <Label fx:id="lblDetailNo" styleClass="drawer-document"/>
                    <HBox spacing="8"><Label fx:id="lblDetailDate"/><Label fx:id="lblDetailStatus" styleClass="status-pill,approved-status"/></HBox>
                    <Separator/><Label fx:id="lblDetailCustomer" styleClass="drawer-customer"/><Label fx:id="lblDetailContact" wrapText="true" styleClass="quotation-detail-contact"/><Separator/>
                    <GridPane hgap="12" vgap="8">
                        <Label text="Quotation Amount"/><Label fx:id="lblDetailAmount" GridPane.columnIndex="1" styleClass="drawer-money"/>
                        <Label text="Discount" GridPane.rowIndex="1"/><Label fx:id="lblDetailDiscount" styleClass="quotation-detail-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Valid Upto" GridPane.rowIndex="2"/><Label fx:id="lblDetailValid" styleClass="quotation-detail-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Follow Up" GridPane.rowIndex="3"/><Label fx:id="lblDetailFollow" styleClass="quotation-detail-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="Converted To" GridPane.rowIndex="4"/><Label fx:id="lblDetailConverted" styleClass="quotation-detail-value" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    </GridPane>
                    <Separator/><VBox spacing="8" styleClass="quotation-attachment-card"><Label text="Attached Document" styleClass="drawer-section"/><Label fx:id="lblDetailAttachment" text="No document attached" wrapText="true" styleClass="quotation-attachment-name"/><HBox spacing="8"><Button text="Add / Replace" onAction="#attachSelected" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="approved-button,approved-primary-button"/><Button fx:id="btnPreviewAttachment" text="Preview" onAction="#previewAttachmentSelected" disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnRemoveAttachment" text="Remove" onAction="#removeAttachmentSelected" disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="approved-button,approved-danger-button"/></HBox></VBox><Separator/><Label text="Quick Actions" styleClass="drawer-section"/>
                    <GridPane hgap="7" vgap="7">
                        <Button text="Edit" onAction="#editSelected" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
                        <Button text="PDF" onAction="#pdfSelected" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
                        <Button text="Email" onAction="#emailSelected" GridPane.rowIndex="1" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
                        <Button text="Convert to Sale" onAction="#convertSelected" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
                        <Button fx:id="btnOpenConvertedSale" text="Open Sale" onAction="#openConvertedSale" disable="true" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
                        <Button text="Follow Up" onAction="#followUpSelected" GridPane.rowIndex="3" GridPane.columnSpan="2" maxWidth="Infinity" styleClass="approved-button,approved-secondary-button"/>
                    </GridPane>
                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>
