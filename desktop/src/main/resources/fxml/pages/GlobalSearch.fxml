<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.GlobalSearchController" styleClass="erp-screen-root,dse-global-search-page">
  <top><VBox spacing="12" styleClass="dse-search-header">
    <padding><Insets top="16" right="18" bottom="12" left="18"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="10"><VBox spacing="2" HBox.hgrow="ALWAYS"><Label text="Global Search" styleClass="page-title,dse-search-page-title"/><Label text="Search every permitted ERP record and open the exact matching entry." styleClass="muted-label"/></VBox><ProgressIndicator fx:id="searchProgress" visible="false" managed="false" prefWidth="26" prefHeight="26"/></HBox>
    <HBox spacing="10" alignment="CENTER_LEFT"><TextField fx:id="txtGlobalSearch" promptText="Search party, document, item, reference, bank narration, reminder…" onAction="#search" HBox.hgrow="ALWAYS" styleClass="dse-search-input"/><ComboBox fx:id="cmbModule" prefWidth="210"/><Button text="Search" onAction="#search" styleClass="approved-button,approved-primary-button"/><Button text="Clear" onAction="#clearSearch" styleClass="approved-button,approved-secondary-button"/></HBox>
    <Label fx:id="lblResultSummary" styleClass="dse-search-summary"/>
  </VBox></top>
  <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="clean-scroll,dse-search-scroll"><content><VBox fx:id="resultGroups" spacing="12" styleClass="dse-search-groups"><padding><Insets top="8" right="18" bottom="18" left="18"/></padding></VBox></content></ScrollPane></center>
</BorderPane>
