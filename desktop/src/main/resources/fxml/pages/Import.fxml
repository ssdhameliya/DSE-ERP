<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ImportController" spacing="12" styleClass="import-page,approved-ui,erp-screen-root"><padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
 <HBox alignment="CENTER_LEFT" spacing="12" styleClass="import-page-header,ua-premium-header,erp-page-identity-header"><StackPane fx:id="importPageIcon" styleClass="erp-page-header-icon,import-header-icon-box"/><VBox><Label text="Data Import" styleClass="screen-title"/><Label text="Import ERP master and transaction data from Excel templates" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnImportGuide" text="Import Guide" onAction="#showImportGuide" styleClass="approved-button,approved-secondary-button"/></HBox>
 <HBox alignment="CENTER" spacing="0" styleClass="import-wizard-bar,import-wizard-group-panel"><VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="import-step-panel"><Label fx:id="step1Badge" text="1" styleClass="wizard-badge"/><Label text="Select Data" styleClass="wizard-title"/><Label text="Choose what to import" styleClass="muted-label"/></VBox><Region fx:id="wizardLine1" styleClass="wizard-line,wizard-line-pending" HBox.hgrow="ALWAYS"/><VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="import-step-panel"><Label fx:id="step2Badge" text="2" styleClass="wizard-badge"/><Label text="Upload File" styleClass="wizard-title"/><Label text="Select your Excel file" styleClass="muted-label"/></VBox><Region fx:id="wizardLine2" styleClass="wizard-line,wizard-line-pending" HBox.hgrow="ALWAYS"/><VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="import-step-panel"><Label fx:id="step3Badge" text="3" styleClass="wizard-badge"/><Label text="Map Columns" styleClass="wizard-title"/><Label text="Match Excel to ERP fields" styleClass="muted-label"/></VBox><Region fx:id="wizardLine3" styleClass="wizard-line,wizard-line-pending" HBox.hgrow="ALWAYS"/><VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="import-step-panel"><Label fx:id="step4Badge" text="4" styleClass="wizard-badge"/><Label text="Review &amp; Import" styleClass="wizard-title"/><Label text="Validate and import data" styleClass="muted-label"/></VBox></HBox>
 <StackPane VBox.vgrow="ALWAYS">
  <VBox fx:id="stepSelect" spacing="12" styleClass="import-card,import-stage-card"><HBox><VBox><Label text="What would you like to import?" styleClass="section-title"/><Label text="Select the type of data you want to import into your ERP" styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><ComboBox fx:id="cmbImportModule" visible="false" managed="false"/><TextField fx:id="txtImportNote" promptText="Optional import note" prefWidth="260" styleClass="approved-input"/></HBox><GridPane hgap="12" vgap="12" VBox.vgrow="ALWAYS"><columnConstraints><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.34"/></columnConstraints><rowConstraints><RowConstraints percentHeight="50"/><RowConstraints percentHeight="50"/></rowConstraints>
   <VBox spacing="8" styleClass="import-choice-card,template-item"><StackPane fx:id="itemChoiceIcon" styleClass="import-choice-icon"/><Label text="Item Master" styleClass="section-title"/><Label text="Import product items, stock information, pricing and tax details." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8"><Button text="Select" onAction="#selectItemMaster" styleClass="primary-button"/><Button fx:id="btnDownloadItemTemplate" text="Download Template" onAction="#downloadItemTemplate" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
   <VBox GridPane.columnIndex="1" spacing="8" styleClass="import-choice-card,template-customer"><StackPane fx:id="customerChoiceIcon" styleClass="import-choice-icon"/><Label text="Customers / CRM" styleClass="section-title"/><Label text="Import customer and CRM information with contact details." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8"><Button text="Select" onAction="#selectCustomers" styleClass="primary-button"/><Button fx:id="btnDownloadCustomerTemplate" text="Download Template" onAction="#downloadCustomerTemplate" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
   <VBox GridPane.columnIndex="2" spacing="8" styleClass="import-choice-card,template-supplier"><StackPane fx:id="supplierChoiceIcon" styleClass="import-choice-icon"/><Label text="Suppliers / HRM" styleClass="section-title"/><Label text="Import supplier and vendor information and contact details." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8"><Button text="Select" onAction="#selectSuppliers" styleClass="primary-button"/><Button fx:id="btnDownloadSupplierTemplate" text="Download Template" onAction="#downloadSupplierTemplate" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
   <VBox GridPane.rowIndex="1" spacing="8" styleClass="import-choice-card,template-sales"><StackPane fx:id="salesChoiceIcon" styleClass="import-choice-icon"/><Label text="Sales" styleClass="section-title"/><Label text="Import sales invoices, orders and related transaction data." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8"><Button text="Select" onAction="#selectSales" styleClass="primary-button"/><Button fx:id="btnDownloadSalesTemplate" text="Download Template" onAction="#downloadSalesTemplate" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
   <VBox GridPane.rowIndex="1" GridPane.columnIndex="1" spacing="8" styleClass="import-choice-card,template-purchase"><StackPane fx:id="purchaseChoiceIcon" styleClass="import-choice-icon"/><Label text="Purchases" styleClass="section-title"/><Label text="Import purchase invoices, bills and related transaction data." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8"><Button text="Select" onAction="#selectPurchases" styleClass="primary-button"/><Button fx:id="btnDownloadPurchaseTemplate" text="Download Template" onAction="#downloadPurchaseTemplate" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
   <VBox GridPane.rowIndex="1" GridPane.columnIndex="2" spacing="8" styleClass="import-choice-card,template-master"><StackPane fx:id="masterChoiceIcon" styleClass="import-choice-icon"/><Label text="Master Categories &amp; Values" styleClass="section-title"/><Label text="Import master categories, units, brands and reference data." wrapText="true" styleClass="muted-label"/><Region VBox.vgrow="ALWAYS"/><HBox spacing="8"><Button text="Select" onAction="#selectMasterValues" styleClass="primary-button"/><Button fx:id="btnDownloadMasterTemplate" text="Download Template" onAction="#downloadMasterTemplate" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
  </GridPane><HBox spacing="20" styleClass="import-benefits"><Label text="✓ Safe &amp; Secure"/><Label text="✓ Auto Validation"/><Label text="✓ Backup First"/><Label text="✓ Easy Mapping"/></HBox></VBox>
  <VBox fx:id="stepUpload" spacing="14" visible="false" managed="false" styleClass="import-card,import-stage-card"><Label text="Upload Excel File" styleClass="section-title"/><Label text="Upload your selected ERP data in Excel format" styleClass="muted-label"/><HBox spacing="22" VBox.vgrow="ALWAYS" alignment="CENTER"><VBox fx:id="dropZone" alignment="CENTER" spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="import-drop-zone,import-drop-zone-large" onDragOver="#onDragOver" onDragEntered="#onDragEntered" onDragExited="#onDragExited" onDragDropped="#onDragDropped"><Label fx:id="lblDropIcon" styleClass="drop-icon"/><Label text="Drag and drop your Excel file here" styleClass="drop-title"/><Label text="or" styleClass="muted-label"/><Button fx:id="btnChooseFile" text="Browse File" onAction="#onChooseImportFile" styleClass="primary-button"/><Label text="Supported formats: .xlsx, .xls  •  Maximum file size: 20 MB" styleClass="muted-label"/></VBox><VBox spacing="12" prefWidth="390" styleClass="import-selected-file-panel"><StackPane fx:id="selectedFileExcelIcon" styleClass="import-selected-excel-icon"/><Label text="Selected File" styleClass="section-title"/><Label fx:id="lblChosenFile" text="No file selected" wrapText="true" styleClass="selected-file"/><Button text="Change File" onAction="#onChooseImportFile" styleClass="approved-button,approved-secondary-button"/><Label text="Need help? Download the matching template from Step 1." wrapText="true" styleClass="muted-label"/></VBox></HBox><HBox><Button text="Back" onAction="#wizardBackToSelect" styleClass="approved-button,approved-secondary-button"/><Region HBox.hgrow="ALWAYS"/><Button text="Continue" onAction="#wizardContinueUpload" styleClass="primary-button"/></HBox></VBox>
  <VBox fx:id="stepMap" spacing="10" visible="false" managed="false" styleClass="import-card,import-stage-card"><HBox alignment="CENTER_LEFT"><VBox><Label text="Map Excel Columns to ERP Fields" styleClass="section-title"/><Label text="Map each column from your Excel file to the corresponding ERP field." styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnAutoMap" text="Auto Map" onAction="#autoMapColumns" styleClass="primary-button"/><Button fx:id="btnResetMapping" text="Reset Mapping" onAction="#resetMapping" styleClass="approved-button,approved-secondary-button"/></HBox><ScrollPane fx:id="mappingScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="import-inner-scroll"><GridPane fx:id="gridMapping" minWidth="950" styleClass="import-mapping-grid"/></ScrollPane><HBox><Label fx:id="lblMappingCount" text="0 of 0 fields mapped" styleClass="import-success-text"/><Region HBox.hgrow="ALWAYS"/><Button text="Back" onAction="#wizardBackToUpload" styleClass="approved-button,approved-secondary-button"/><Button text="Continue" onAction="#wizardContinueMap" styleClass="primary-button"/></HBox></VBox>
  <VBox fx:id="stepReview" spacing="10" visible="false" managed="false" styleClass="import-card,import-stage-card"><HBox alignment="CENTER_LEFT"><VBox><Label text="Review &amp; Validate Data" styleClass="section-title"/><Label text="Review the summary and data preview before importing" styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblPreviewCount" text="0 rows" styleClass="metric-value"/></HBox><TableView fx:id="tblPreview" VBox.vgrow="ALWAYS" styleClass="import-preview-table,approved-table,erp-table-profile-import"/><HBox alignment="CENTER_LEFT" spacing="10"><Label fx:id="lblPreviewStatus" text="No preview loaded" styleClass="approved-status"/><Region HBox.hgrow="ALWAYS"/><Label text="Existing records:"/><ComboBox fx:id="cmbImportMode" prefWidth="230"/><CheckBox fx:id="chkDryRun" text="Validate only (do not save)"/></HBox><VBox fx:id="progressContainer" spacing="5" visible="false" managed="false"><HBox><Label fx:id="lblProgressStatus" text="Importing data..."/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblProgressPercent" text="0%"/></HBox><ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0"/></VBox><VBox fx:id="importCompletedPanel" visible="false" managed="false" alignment="CENTER" spacing="9" styleClass="import-completed-panel"><Label text="✓" styleClass="import-completed-icon"/><Label text="Import Completed Successfully" styleClass="section-title,import-completed-title"/><Label fx:id="lblImportCompletedSummary" text="Import completed" styleClass="import-success-text"/><HBox alignment="CENTER" spacing="10"><Button text="View Imported Records" onAction="#viewImportedRecords" styleClass="primary-button"/><Button text="Start Another Import" onAction="#startAnotherImport" styleClass="approved-button,approved-secondary-button"/><Button text="Close Import" onAction="#closeImport" styleClass="approved-button,approved-secondary-button"/></HBox></VBox><HBox alignment="CENTER_RIGHT" spacing="10"><Button text="Back" onAction="#wizardBackToMap" styleClass="approved-button,approved-secondary-button"/><Label fx:id="lblReadyStatus" text="Ready for validation" styleClass="muted-label"/><Button fx:id="btnRunImport" text="Import Records" onAction="#onRunImport" disable="true" styleClass="primary-button,import-run-button"/></HBox></VBox>
 </StackPane>
</VBox>
