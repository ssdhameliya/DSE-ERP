<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.ReportViewerController"
      spacing="8" styleClass="approved-ui,approved-screen,erp-screen-root,report-viewer-root,reports-workspace">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="approved-page-header,approved-section-header,erp-page-identity-header,reports-header,report-viewer-header">
        <StackPane fx:id="viewerPageIcon" styleClass="erp-page-header-icon"/>
        <VBox spacing="3"><Label fx:id="lblTitle" text="Report" styleClass="approved-page-title,page-title"/><Label fx:id="lblDescription" text="Unified financial and operational report" styleClass="approved-page-subtitle,page-subtitle,reports-header-subtitle"/></VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Report Information" onAction="#showInformation" styleClass="approved-button,approved-secondary-button"/>
        <Button text="Refresh" onAction="#refreshReport" styleClass="approved-button,approved-secondary-button"/>
        <MenuButton text="Export" styleClass="approved-menu-button,approved-button,approved-primary-button,reports-export-button"><items><MenuItem text="PDF" onAction="#exportPdf"/><MenuItem text="Excel" onAction="#exportExcel"/><MenuItem text="CSV" onAction="#exportCsv"/></items></MenuButton>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="report-view-nav,reports-view-nav">
        <Button text="Dashboard" onAction="#goDashboard" styleClass="approved-button,approved-secondary-button,report-nav-button"/>
        <Button text="Report Center" onAction="#goReportCenter" styleClass="approved-button,approved-secondary-button,report-nav-button,report-nav-selected"/>
        <Button text="Saved Reports" onAction="#goSavedReports" styleClass="approved-button,approved-secondary-button,report-nav-button"/>
        <Button text="Scheduled" onAction="#goScheduled" styleClass="approved-button,approved-secondary-button,report-nav-button"/>
    </HBox>

    <VBox fx:id="filterPanel" spacing="7" styleClass="report-filter-card,report-viewer-filter-panel">
        <HBox alignment="CENTER_LEFT" spacing="8"><Label text="Filters" styleClass="approved-card-title,section-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnCollapseFilters" text="Collapse ▲" onAction="#toggleFilters" styleClass="approved-button,approved-link-button,link-button"/></HBox>
        <GridPane fx:id="filterGrid" hgap="10" vgap="7">
            <columnConstraints><ColumnConstraints percentWidth="25" hgrow="ALWAYS"/><ColumnConstraints percentWidth="25" hgrow="ALWAYS"/><ColumnConstraints percentWidth="25" hgrow="ALWAYS"/><ColumnConstraints percentWidth="25" hgrow="ALWAYS"/></columnConstraints>
            <VBox fx:id="boxPeriod" spacing="3"><Label text="Period" styleClass="field-label"/><ComboBox fx:id="cmbDatePreset" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            <VBox fx:id="boxParty" GridPane.columnIndex="1" spacing="3"><Label text="Party" styleClass="field-label"/><ComboBox fx:id="cmbParty" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            <VBox fx:id="boxItem" GridPane.columnIndex="2" spacing="3"><Label text="Item" styleClass="field-label"/><ComboBox fx:id="cmbItem" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            <VBox fx:id="boxSalesperson" GridPane.columnIndex="3" spacing="3"><Label text="Salesperson" styleClass="field-label"/><ComboBox fx:id="cmbSalesperson" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            <VBox fx:id="boxDocumentStatus" GridPane.rowIndex="1" spacing="3"><Label text="Status" styleClass="field-label"/><ComboBox fx:id="cmbDocumentStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            <VBox fx:id="boxPaymentStatus" GridPane.rowIndex="1" GridPane.columnIndex="1" spacing="3"><Label text="Payment" styleClass="field-label"/><ComboBox fx:id="cmbPaymentStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            <VBox fx:id="boxFrom" GridPane.rowIndex="1" GridPane.columnIndex="2" spacing="3"><Label text="From Date" styleClass="field-label"/><DatePicker fx:id="dpFrom" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            <VBox fx:id="boxTo" GridPane.rowIndex="1" GridPane.columnIndex="3" spacing="3"><Label text="To Date" styleClass="field-label"/><DatePicker fx:id="dpTo" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            <VBox fx:id="boxReturnStatus" GridPane.rowIndex="2" spacing="3"><Label text="Return Status" styleClass="field-label"/><ComboBox fx:id="cmbReturnStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            <VBox fx:id="boxGstRate" GridPane.rowIndex="2" GridPane.columnIndex="1" spacing="3"><Label text="GST Rate" styleClass="field-label"/><ComboBox fx:id="cmbGstRate" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            <VBox fx:id="boxWarehouse" GridPane.rowIndex="2" GridPane.columnIndex="2" spacing="3"><Label text="Warehouse / Location" styleClass="field-label"/><ComboBox fx:id="cmbWarehouse" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            <VBox fx:id="boxBankStatus" GridPane.rowIndex="2" GridPane.columnIndex="3" spacing="3"><Label text="Bank Status" styleClass="field-label"/><ComboBox fx:id="cmbBankStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            <VBox fx:id="boxMinAmount" GridPane.rowIndex="3" spacing="3"><Label text="Min Amount" styleClass="field-label"/><TextField fx:id="txtMinAmount" promptText="Any" styleClass="approved-input"/></VBox>
            <VBox fx:id="boxMaxAmount" GridPane.rowIndex="3" GridPane.columnIndex="1" spacing="3"><Label text="Max Amount" styleClass="field-label"/><TextField fx:id="txtMaxAmount" promptText="Any" styleClass="approved-input"/></VBox>
        </GridPane>
        <HBox alignment="CENTER_LEFT" spacing="8"><Label fx:id="lblActiveFilters" text="Active filters: Period" styleClass="approved-page-subtitle,page-subtitle"/><Region HBox.hgrow="ALWAYS"/><Button text="Reset" onAction="#resetFilters" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnApply" text="Apply Filters" onAction="#applyFilters" styleClass="approved-button,approved-primary-button"/></HBox>
    </VBox>

    <HBox alignment="BOTTOM_LEFT" spacing="8" styleClass="approved-toolbar,report-results-toolbar">
        <StackPane minWidth="270" prefWidth="360" maxWidth="520" styleClass="erp-item-search-shell,register-header-search-shell,report-search-shell">
            <TextField fx:id="txtSearch" promptText="Search invoice / party / item / reference..." maxWidth="Infinity" styleClass="approved-input,erp-item-search,register-header-search-input"/>
            <StackPane fx:id="reportSearchIcon" mouseTransparent="true" minWidth="24" prefWidth="24" maxWidth="24" minHeight="24" prefHeight="24" maxHeight="24" StackPane.alignment="CENTER_RIGHT" styleClass="erp-item-search-icon-box,register-header-search-icon"><StackPane.margin><Insets right="8"/></StackPane.margin></StackPane>
        </StackPane>
        <Label fx:id="lblRecords" styleClass="approved-page-subtitle,page-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox spacing="3"><Label text="Group By" styleClass="field-label"/><ComboBox fx:id="cmbGroup" prefWidth="145" styleClass="approved-input"/></VBox>
        <VBox spacing="3"><Label text="Sort" styleClass="field-label"/><ComboBox fx:id="cmbSort" prefWidth="145" styleClass="approved-input"/></VBox>
        <VBox spacing="3"><Label text="Direction" styleClass="field-label"/><ComboBox fx:id="cmbDirection" prefWidth="115" styleClass="approved-input"/></VBox>
        <MenuButton fx:id="btnColumns" text="Columns" styleClass="approved-menu-button,approved-button,approved-secondary-button"/>
        <Button text="Save Report" onAction="#saveReport" styleClass="approved-button,approved-success-button,success-button"/>
    </HBox>

    <VBox spacing="6" VBox.vgrow="ALWAYS" styleClass="report-card,report-results-panel">
        <TableView fx:id="tblReport" VBox.vgrow="ALWAYS" styleClass="approved-table,report-table,erp-table-profile-register"/>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="report-viewer-footer">
            <Button text="View Source" onAction="#viewSelectedSource" styleClass="approved-button,approved-secondary-button"/>
            <Label text="Select a row to open the originating transaction." styleClass="approved-page-subtitle,page-subtitle"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Rows per page" styleClass="field-label"/><ComboBox fx:id="cmbRows" prefWidth="82" styleClass="approved-input"/>
            <Button fx:id="btnFirst" text="First" onAction="#firstPage" styleClass="approved-button,approved-secondary-button"/>
            <Button fx:id="btnPrev" text="Previous" onAction="#previousPage" styleClass="approved-button,approved-secondary-button"/>
            <Label fx:id="lblPage" text="1 / 1" styleClass="section-title"/>
            <Button fx:id="btnNext" text="Next" onAction="#nextPage" styleClass="approved-button,approved-secondary-button"/>
            <Button fx:id="btnLast" text="Last" onAction="#lastPage" styleClass="approved-button,approved-secondary-button"/>
            <Button text="Print" onAction="#printReport" styleClass="approved-button,approved-secondary-button"/>
        </HBox>
    </VBox>
</VBox>
