<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ReturnRefundController" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="clean-scroll,approved-ui,approved-screen,erp-screen-root">
 <content><VBox spacing="12" styleClass="sales-flow-page"><padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
  <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="Infinity" styleClass="erp-page-identity-header">
   <VBox spacing="2"><Label fx:id="pageTitle" text="Return Refund" styleClass="page-title,payment-page-title"/><Label fx:id="pageSubtitle" text="Record refund • review history • manage proof documents" styleClass="payment-page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Back to Return Register" onAction="#back" styleClass="approved-button,back-register-button"/>
  </HBox>
  <HBox spacing="14">
   <VBox spacing="12" HBox.hgrow="ALWAYS">
    <VBox spacing="10" styleClass="flow-card,invoice-overview-card"><HBox spacing="18" alignment="CENTER_LEFT">
     <VBox prefWidth="230"><Label text="Return No." styleClass="meta-label,meta-blue"/><Label fx:id="returnNo" styleClass="meta-value,invoice-number"/></VBox>
     <VBox prefWidth="250"><Label text="Customer / Supplier" styleClass="meta-label,meta-purple"/><Label fx:id="party" styleClass="meta-value,customer-name"/></VBox>
     <VBox prefWidth="185"><Label text="Original Document" styleClass="meta-label,meta-cyan"/><Label fx:id="originalDocument" styleClass="meta-value"/></VBox>
     <VBox prefWidth="145"><Label text="Return Date" styleClass="meta-label,meta-orange"/><Label fx:id="returnDate" styleClass="meta-value"/></VBox>
     <VBox prefWidth="175"><Label text="Return Total" styleClass="meta-label,meta-green"/><Label fx:id="total" styleClass="money-hero"/></VBox>
    </HBox></VBox>
    <VBox spacing="10" styleClass="flow-card,payment-entry-card"><Label text="Record New Refund" styleClass="flow-title,section-accent-title"/>
     <GridPane hgap="16" vgap="9"><columnConstraints><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.34"/></columnConstraints>
      <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0"><Label text="Refund Date *" styleClass="field-label,field-blue"/><DatePicker fx:id="refundDate" maxWidth="Infinity" styleClass="payment-input"/></VBox>
      <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0"><Label text="Payment Mode *" styleClass="field-label,field-purple"/><ComboBox fx:id="mode" maxWidth="Infinity" styleClass="payment-input"/></VBox>
      <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0"><Label text="Reference No." styleClass="field-label,field-orange"/><TextField fx:id="reference" styleClass="payment-input"/></VBox>
      <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1"><Label fx:id="partyFieldLabel" text="Refunded To *" styleClass="field-label,field-cyan"/><TextField fx:id="refundedParty" styleClass="payment-input"/></VBox>
      <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label text="Bank Account *" styleClass="field-label,field-green"/><ComboBox fx:id="bankAccount" maxWidth="Infinity" styleClass="payment-input"/></VBox>
      <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="1"><Label fx:id="amountFieldLabel" text="Refund Amount *" styleClass="field-label,field-red"/><TextField fx:id="amount" styleClass="payment-input,amount-input"/></VBox>
     </GridPane>
     <HBox spacing="12" alignment="CENTER_LEFT"><RadioButton fx:id="fullRefund" text="FULL REFUND" styleClass="payment-type-radio"/><RadioButton fx:id="partialRefund" text="PARTIAL REFUND" styleClass="payment-type-radio"/><Region HBox.hgrow="ALWAYS"/><VBox alignment="CENTER_RIGHT"><Label text="Balance After Refund" styleClass="balance-after-payment-label"/><Label fx:id="after" styleClass="money-strong"/></VBox></HBox>
     <HBox spacing="14" alignment="BOTTOM_CENTER"><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Notes" styleClass="field-label,field-purple"/><TextArea fx:id="notes" promptText="Refund notes (optional)" prefRowCount="2" maxHeight="72"/></VBox><HBox alignment="CENTER_RIGHT" spacing="10"><Button text="Reset" onAction="#reset" styleClass="approved-button,approved-secondary-button"/><Button text="Save Refund" onAction="#save" styleClass="blue-button"/></HBox></HBox>
    </VBox>
   </VBox>
   <VBox spacing="12" prefWidth="390">
    <VBox spacing="12" styleClass="flow-card,summary-card"><Label text="Refund Summary" styleClass="summary-title"/><HBox><Label text="Return Total" styleClass="summary-label,total-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="summaryTotal" styleClass="summary-value,total-value"/></HBox><HBox><Label text="Refunded Amount" styleClass="summary-label,paid-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="summaryRefunded" styleClass="summary-value,paid-value"/></HBox><HBox><Label text="Refund Balance" styleClass="summary-label,balance-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="summaryBalance" styleClass="summary-value,balance-value"/></HBox><Separator/><ProgressBar fx:id="refundProgress" maxWidth="Infinity" styleClass="payment-progress"/><Label fx:id="refundPercent" alignment="CENTER" maxWidth="Infinity" styleClass="paid-percent"/><HBox visible="false" managed="false"><Label fx:id="refunded"/><Label fx:id="balance"/></HBox></VBox>
    <VBox spacing="8" styleClass="flow-card,proof-side-card"><Label text="Attach Refund / Bank Proof" styleClass="attachment-title"/><VBox fx:id="proofDropZone" alignment="CENTER" spacing="8" minHeight="165" styleClass="proof-drop-zone"><Label text="Refund proof" styleClass="proof-hint"/><HBox spacing="8" alignment="CENTER"><Button text="Add / Replace" onAction="#browseFile" styleClass="approved-button,approved-primary-button"/><Button text="Preview" onAction="#previewProof" styleClass="approved-button,approved-secondary-button"/><Button text="Remove" onAction="#removeProof" styleClass="approved-button,approved-danger-button"/></HBox><Label fx:id="proofName" text="No file selected" styleClass="attachment-file-name"/><Label text="JPG, PNG or PDF • Maximum 25 MB" styleClass="caption"/></VBox></VBox>
   </VBox>
  </HBox>
  <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="flow-card,payment-history-card"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Refund History" styleClass="history-title"/><Label fx:id="historyCount" text="0 Refunds" styleClass="history-count"/></HBox><TableView fx:id="historyTable" prefHeight="240" minHeight="190" maxHeight="Infinity" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-register"><columns><TableColumn fx:id="cDate" text="Refund Date" prefWidth="135"/><TableColumn fx:id="cMode" text="Payment Mode" prefWidth="155"/><TableColumn fx:id="cReference" text="Reference No." prefWidth="160"/><TableColumn fx:id="cParty" text="Refunded To / From" prefWidth="190"/><TableColumn fx:id="cAmount" text="Amount (₹)" prefWidth="145"/><TableColumn fx:id="cStatus" text="Status" prefWidth="125"/><TableColumn fx:id="cNotes" text="Notes" prefWidth="230"/><TableColumn fx:id="cAction" text="Actions" prefWidth="145"/></columns></TableView></VBox>
 </VBox></content>
</ScrollPane>
