<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><!-- v2.1.9 chart-free executive dashboard: lightweight on macOS and consistent on Windows. --><StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.DashboardHomeController" fx:id="dashboardRoot" styleClass="approved-ui,dashboard-chart-free,approved-screen,approved-screen-dashboard-home,erp-screen-root">
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="approved-page-scroll">
        <content>
            <VBox fx:id="dashboardContent" spacing="10" styleClass="approved-page,dashboard-executive">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="approved-page-header,approved-section-header,erp-page-identity-header">
                    <StackPane fx:id="dashboardTitleIcon" styleClass="approved-title-icon,erp-page-header-icon"/>
                    <VBox spacing="3">
                        <Label text="Dashboard" styleClass="approved-page-title"/>
                        <Label text="Overview of your business at a glance" styleClass="approved-page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="This Month" onAction="#cyclePeriod" styleClass="approved-secondary-button,approved-button"/>
                    <Button fx:id="refreshDashboardButton" text="Refresh" onAction="#refreshDashboard" styleClass="approved-button,approved-secondary-button"/>
                </HBox>

                <GridPane hgap="12" vgap="12" styleClass="approved-kpi-grid,approved-kpi,erp-kpi-section">
                    <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,sales-metric-card,sales-metric-total,kpi-sales,kpi-blue" GridPane.columnIndex="0" onMouseClicked="#openSalesFromDashboard">
                        <StackPane fx:id="salesKpiIcon" styleClass="approved-kpi-icon,approved-kpi,sales-metric-icon"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Active Sales" styleClass="approved-kpi-caption,metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="+8.4%" styleClass="metric-trend-pill,trend-positive"/>
                            </HBox>
                            <Label fx:id="lblSalesValue" styleClass="approved-kpi-value,metric-value"/>
                            <Label fx:id="lblSalesNote" styleClass="approved-kpi-note,metric-note"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,sales-metric-card,sales-metric-today,kpi-purchase,kpi-orange" GridPane.columnIndex="1" onMouseClicked="#openPurchaseFromDashboard">
                        <StackPane fx:id="purchaseKpiIcon" styleClass="approved-kpi-icon,approved-kpi,sales-metric-icon"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Active Purchases" styleClass="approved-kpi-caption,metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Active" styleClass="metric-trend-pill,trend-neutral"/>
                            </HBox>
                            <Label fx:id="lblPurchaseValue" styleClass="approved-kpi-value,metric-value"/>
                            <Label fx:id="lblPurchaseNote" styleClass="approved-kpi-note,metric-note"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,sales-metric-card,sales-metric-pending,kpi-receivable,kpi-purple" GridPane.columnIndex="2" onMouseClicked="#openReceivablesFromDashboard">
                        <StackPane fx:id="receivableKpiIcon" styleClass="approved-kpi-icon,approved-kpi,sales-metric-icon"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Receivables" styleClass="approved-kpi-caption,metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Pending" styleClass="metric-trend-pill,trend-warning"/>
                            </HBox>
                            <Label fx:id="lblStockValue" styleClass="approved-kpi-value,metric-value"/>
                            <Label fx:id="lblReceivableNote" styleClass="approved-kpi-note,metric-note"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,sales-metric-card,sales-metric-overdue,kpi-payable,kpi-red" GridPane.columnIndex="3" onMouseClicked="#openPayablesFromDashboard">
                        <StackPane fx:id="payableKpiIcon" styleClass="approved-kpi-icon,approved-kpi,sales-metric-icon"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Payables" styleClass="approved-kpi-caption,metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Payable" styleClass="metric-trend-pill,trend-negative"/>
                            </HBox>
                            <Label fx:id="lblLowStock" styleClass="approved-kpi-value,metric-value"/>
                            <Label fx:id="lblStockNote" styleClass="approved-kpi-note,metric-note"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,sales-metric-card,sales-metric-due,kpi-cash,kpi-green" GridPane.columnIndex="4" onMouseClicked="#openCashFromDashboard">
                        <StackPane fx:id="cashKpiIcon" styleClass="approved-kpi-icon,approved-kpi,sales-metric-icon"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Cash Position" styleClass="approved-kpi-caption,metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Net Cash" styleClass="metric-trend-pill,trend-positive"/>
                            </HBox>
                            <Label fx:id="lblCash" styleClass="approved-kpi-value,metric-value"/>
                            <Label text="Received less paid and expenses" styleClass="approved-kpi-note,metric-note"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,sales-metric-card,sales-metric-email,kpi-stock,kpi-teal" GridPane.columnIndex="5" onMouseClicked="#openInventoryFromDashboard">
                        <StackPane fx:id="lowStockKpiIcon" styleClass="approved-kpi-icon,approved-kpi,sales-metric-icon"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Low Stock" styleClass="approved-kpi-caption,metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Alert" styleClass="metric-trend-pill,trend-warning"/>
                            </HBox>
                            <Label fx:id="lblLowStockValue" styleClass="approved-kpi-value,metric-value"/>
                            <Label fx:id="lblLowStockNote" styleClass="approved-kpi-note,metric-note"/>
                        </VBox>
                    </HBox>
                </GridPane>

                <HBox spacing="12" styleClass="dashboard-mini-kpi-row,erp-kpi-section">
                    <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS" styleClass="dashboard-mini-kpi,dashboard-mini-customer,standard-kpi-card,kpi-blue" onMouseClicked="#viewCustomers">
                        <StackPane fx:id="customersMiniIcon" styleClass="dashboard-mini-kpi-icon,standard-kpi-icon"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Customers" styleClass="metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Directory" styleClass="metric-trend-pill,trend-neutral"/>
                            </HBox>
                            <Label fx:id="lblCustomers" styleClass="metric-value"/>
                            <Label text="Customer directory" styleClass="metric-note"/>
                        </VBox>
                        <Label text="View All →" styleClass="approved-link"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS" styleClass="dashboard-mini-kpi,dashboard-mini-items,standard-kpi-card,kpi-green" onMouseClicked="#viewItems">
                        <StackPane fx:id="itemsMiniIcon" styleClass="dashboard-mini-kpi-icon,standard-kpi-icon"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Catalog Items" styleClass="metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Active" styleClass="metric-trend-pill,trend-info"/>
                            </HBox>
                            <Label fx:id="lblProducts" styleClass="metric-value"/>
                            <Label text="Inventory catalog" styleClass="metric-note"/>
                        </VBox>
                        <Label text="View All →" styleClass="approved-link"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS" styleClass="dashboard-mini-kpi,dashboard-mini-sales,standard-kpi-card,kpi-purple" onMouseClicked="#viewSalesInvoices">
                        <StackPane fx:id="salesMiniIcon" styleClass="dashboard-mini-kpi-icon,standard-kpi-icon"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Sales Invoices" styleClass="metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Invoices" styleClass="metric-trend-pill,trend-positive"/>
                            </HBox>
                            <Label fx:id="lblOrders" styleClass="metric-value"/>
                            <Label text="Sales register" styleClass="metric-note"/>
                        </VBox>
                        <Label text="View All →" styleClass="approved-link"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS" styleClass="dashboard-mini-kpi,dashboard-mini-purchases,standard-kpi-card,kpi-orange" onMouseClicked="#viewPurchaseInvoices">
                        <StackPane fx:id="purchasesMiniIcon" styleClass="dashboard-mini-kpi-icon,standard-kpi-icon"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Purchase Invoices" styleClass="metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Bills" styleClass="metric-trend-pill,trend-warning"/>
                            </HBox>
                            <Label fx:id="lblPurchases" styleClass="metric-value"/>
                            <Label text="Purchase register" styleClass="metric-note"/>
                        </VBox>
                        <Label text="View All →" styleClass="approved-link"/>
                    </HBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="approved-card,approved-surface">
                        <Label text="Quick Actions" styleClass="approved-card-title"/>
                        <GridPane hgap="12" vgap="12" alignment="CENTER" maxWidth="Infinity" styleClass="dashboard-quick-grid">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Button fx:id="quickSale" text="New Sale" onAction="#newSale" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="approved-quick-action,approved-button,approved-primary-button"/>
                            <Button fx:id="quickPurchase" text="Create Purchase" onAction="#newPurchase" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="approved-quick-action,approved-button,approved-primary-button"/>
                            <Button fx:id="quickCustomer" text="Add Customer" onAction="#addCustomer" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="approved-quick-action,approved-button,approved-primary-button"/>
                            <Button fx:id="quickQuotation" text="Create Quotation" onAction="#newQuotation" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="approved-quick-action,approved-button,approved-primary-button"/>
                            <Button fx:id="quickPayment" text="Add Item Master" onAction="#addPayment" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="approved-quick-action,approved-button,approved-primary-button"/>
                            <Button fx:id="quickSupplier" text="Add Supplier" onAction="#addSupplier" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="approved-quick-action,approved-button,approved-primary-button"/>
                            <Button fx:id="quickBank" text="Bank Entry" onAction="#bankEntry" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="approved-quick-action,approved-button,approved-primary-button"/>
                            <Button fx:id="quickExpense" text="Expense Entry" onAction="#expenseEntry" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="approved-quick-action,approved-button,approved-primary-button"/>
                        </GridPane>
                    </VBox>
                    <VBox spacing="10" prefWidth="350" styleClass="approved-card,reminder-dashboard-card">
                        <HBox alignment="CENTER_LEFT" spacing="8"><Label text="Reminders" styleClass="approved-card-title"/><Region HBox.hgrow="ALWAYS"/><Label text="View All" onMouseClicked="#viewReminders" styleClass="approved-link"/></HBox>
                        <Label fx:id="lblReminderCount" text="0" styleClass="approved-kpi-value,metric-value"/>
                        <Label fx:id="lblReminderSummary" text="No overdue reminders" wrapText="true" styleClass="approved-body-text"/>
                        <Label text="Open Reminder Center to review, complete or snooze business follow-ups." wrapText="true" styleClass="approved-page-subtitle"/>
                        <Button text="Open Reminder Center" onAction="#viewReminders" styleClass="approved-button,approved-primary-button"/>
                        <Label fx:id="lblTrendSales" visible="false" managed="false"/><Label fx:id="lblTrendPeriod" visible="false" managed="false"/><Label fx:id="lblComparisonPeriod" visible="false" managed="false"/><Label fx:id="lblProductsNote" visible="false" managed="false"/>
                    </VBox>
                </HBox>

                <GridPane hgap="12" vgap="12">
                    <columnConstraints><ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/><ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/><ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/></columnConstraints>
                    <VBox spacing="10" styleClass="approved-card,approved-surface" GridPane.columnIndex="0"><HBox><Label text="Top Customers" styleClass="approved-card-title"/><Region HBox.hgrow="ALWAYS"/><Label text="View All" onMouseClicked="#viewTopCustomers" styleClass="approved-link"/></HBox><ListView fx:id="topCustomerList" prefHeight="220" VBox.vgrow="ALWAYS" styleClass="approved-list,dashboard-top-customer-list"/></VBox>
                    <VBox spacing="10" styleClass="approved-card,approved-surface" GridPane.columnIndex="1"><HBox><Label text="Receivables Ageing" styleClass="approved-card-title"/><Region HBox.hgrow="ALWAYS"/><Label text="View Register" onMouseClicked="#viewReceivables" styleClass="approved-link"/></HBox><ListView fx:id="agingList" prefHeight="220" VBox.vgrow="ALWAYS" styleClass="approved-list,dashboard-aging-list"/></VBox>
                    <VBox spacing="10" styleClass="approved-card,approved-surface" GridPane.columnIndex="2"><HBox><Label text="Recent Activities" styleClass="approved-card-title"/><Region HBox.hgrow="ALWAYS"/><Label text="Live" styleClass="approved-live-badge"/></HBox><ListView fx:id="activityList" prefHeight="220" VBox.vgrow="ALWAYS" styleClass="approved-list,dashboard-activity-list"/></VBox>
                </GridPane>


                <TableView fx:id="recentTable" visible="false" managed="false" styleClass="approved-table,erp-table-profile-summary"><columns><TableColumn fx:id="colNumber" text="Invoice No." styleClass="approved-table-column"/><TableColumn fx:id="colDate" text="Date" styleClass="approved-table-column"/><TableColumn fx:id="colParty" text="Customer / Supplier" styleClass="approved-table-column"/><TableColumn fx:id="colAmount" text="Amount" styleClass="approved-table-column"/><TableColumn fx:id="colType" text="Type" styleClass="approved-table-column"/></columns></TableView>
            </VBox>
        </content>
    </ScrollPane>
    <StackPane fx:id="loadingOverlay" visible="false" managed="false" styleClass="erp-loading-overlay"><VBox alignment="CENTER" spacing="12" maxWidth="360" styleClass="erp-loading-card"><ProgressIndicator fx:id="loadingProgress" progress="-1" prefWidth="48" prefHeight="48"/><Label fx:id="loadingMessage" text="Loading dashboard data…" styleClass="erp-loading-title"/><Label text="The ERP remains responsive while data is prepared." wrapText="true" styleClass="erp-loading-subtitle"/></VBox></StackPane>
</StackPane>
