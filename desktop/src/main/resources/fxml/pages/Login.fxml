<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import org.example.ui.SharedApplicationFooter?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.LoginController" styleClass="auth-page,approved-ui,approved-screen,approved-screen-login,erp-screen-root">

    <left>
        <VBox fx:id="brandPanel" prefWidth="600" minWidth="360" alignment="CENTER" spacing="18" styleClass="auth-brand-panel,auth-unified-brand-panel">
            <StackPane fx:id="brandLogoBox" minHeight="118" prefHeight="118" maxWidth="520" styleClass="auth-company-logo-box"><ImageView fx:id="imgBrandLogo" preserveRatio="false" smooth="true" managed="false" visible="false"/></StackPane>
            <StackPane styleClass="auth-logo-badge"><Label fx:id="lblBrandMark" text="◆" styleClass="auth-logo-mark"/></StackPane>
            <Label fx:id="lblBrandName" text="DSE ERP" styleClass="auth-brand-title"/>
            <Region prefHeight="2" maxWidth="80" styleClass="auth-brand-line"/>
            <Label fx:id="lblBrandTagline" text="Business Management Suite" styleClass="auth-brand-subtitle"/>
            <Label fx:id="lblBrandQuote" text="Precision in Engineering Excellence in Business." wrapText="true" textAlignment="CENTER" styleClass="auth-brand-quote"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label fx:id="lblVersion" text="Version" styleClass="auth-version"/>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="auth-content,auth-unified-content">
            <VBox maxWidth="720" spacing="14" alignment="CENTER" styleClass="auth-card,auth-unified-card">
                <StackPane styleClass="auth-section-icon,auth-login-section-icon"><Label text="⌾"/></StackPane>
                <Label text="Welcome Back" styleClass="auth-eyebrow"/>
                <Label text="Sign in to your account" styleClass="auth-title"/>
                <Label fx:id="lblBrandDescription" text="Role-aware secure access to DSE ERP" styleClass="auth-description"/>

                <VBox fx:id="loginPanel" spacing="11" maxWidth="620" alignment="CENTER">
                    <VBox spacing="5" maxWidth="620">
                        <Label text="Email or username *" styleClass="auth-field-label"/>
                        <TextField fx:id="txtUsername" promptText="Email or username" prefHeight="44" styleClass="auth-input"/>
                        <Label fx:id="lblUsernameError" managed="false" visible="false" styleClass="field-error"/>
                    </VBox>

                    <VBox spacing="5" maxWidth="620">
                        <Label text="Password *" styleClass="auth-field-label"/>
                        <PasswordField fx:id="txtPassword" promptText="Password" prefHeight="44" styleClass="auth-input"/>
                        <Label fx:id="lblPasswordError" managed="false" visible="false" styleClass="field-error"/>
                    </VBox>

                    <VBox spacing="5" maxWidth="620">
                        <Label text="Role *" styleClass="auth-field-label"/>
                        <ComboBox fx:id="cmbRole" promptText="Select your role" prefHeight="44" maxWidth="Infinity" styleClass="auth-input"/>
                        <Label fx:id="lblRoleError" managed="false" visible="false" styleClass="field-error"/>
                    </VBox>

                    <VBox fx:id="otpPanel" spacing="5" maxWidth="620" managed="false" visible="false">
                        <Label text="Email verification code" styleClass="auth-field-label"/>
                        <TextField fx:id="txtOtp" promptText="Required for Manager and Sales" prefHeight="44" styleClass="auth-input"/>
                        <Label fx:id="lblOtpError" managed="false" visible="false" styleClass="field-error"/>
                    </VBox>

                    <HBox maxWidth="620" alignment="CENTER_LEFT">
                        <CheckBox fx:id="chkRemember" text="Remember Me"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ToggleButton fx:id="btnTheme" text="Dark Mode" onAction="#toggleTheme" styleClass="auth-theme-button"/>
                    </HBox>

                    <Button fx:id="btnLogin" text="LOGIN" onAction="#login" maxWidth="360" prefHeight="46" styleClass="auth-primary-button"/>
                    <HBox alignment="CENTER" spacing="12" maxWidth="620">
                        <Region HBox.hgrow="ALWAYS" styleClass="auth-divider"/>
                        <Label text="OR" styleClass="auth-or"/>
                        <Region HBox.hgrow="ALWAYS" styleClass="auth-divider"/>
                    </HBox>
                    <Button fx:id="btnRegister" text="Create a new User account" onAction="#register" maxWidth="360" styleClass="auth-secondary-button"/>
                    <Button fx:id="btnEmailSettings" text="Configure Email / OTP Settings" onAction="#openEmailSettings" maxWidth="360" styleClass="auth-secondary-button,auth-email-button"/>
                    <Button fx:id="btnForgotPassword" text="Forgot Password?" onAction="#forgotPassword" maxWidth="360" styleClass="auth-secondary-button"/>
                </VBox>

                <VBox fx:id="resetPanel" managed="false" visible="false" spacing="11" maxWidth="620" alignment="CENTER">
                    <Label text="Reset your password" styleClass="auth-eyebrow"/>
                    <Label text="A verification code will be sent to the registered email address." wrapText="true" styleClass="auth-description"/>

                    <VBox spacing="5" maxWidth="620">
                        <Label text="Email or username *" styleClass="auth-field-label"/>
                        <TextField fx:id="txtResetIdentity" promptText="Email or username" prefHeight="44" styleClass="auth-input"/>
                        <Label fx:id="lblResetIdentityError" managed="false" visible="false" styleClass="field-error"/>
                    </VBox>

                    <Button fx:id="btnSendResetOtp" text="SEND RESET CODE" onAction="#sendResetOtp" maxWidth="360" styleClass="auth-secondary-button,auth-email-button"/>

                    <VBox spacing="5" maxWidth="620">
                        <Label text="Reset verification code *" styleClass="auth-field-label"/>
                        <TextField fx:id="txtResetOtp" promptText="6-digit verification code" prefHeight="44" styleClass="auth-input"/>
                        <Label fx:id="lblResetOtpError" managed="false" visible="false" styleClass="field-error"/>
                    </VBox>

                    <VBox spacing="5" maxWidth="620">
                        <Label text="New password *" styleClass="auth-field-label"/>
                        <PasswordField fx:id="txtNewPassword" promptText="8+ characters, letter and number" prefHeight="44" styleClass="auth-input"/>
                        <Label fx:id="lblNewPasswordError" managed="false" visible="false" styleClass="field-error"/>
                    </VBox>

                    <VBox spacing="5" maxWidth="620">
                        <Label text="Confirm new password *" styleClass="auth-field-label"/>
                        <PasswordField fx:id="txtConfirmPassword" promptText="Repeat new password" prefHeight="44" styleClass="auth-input"/>
                        <Label fx:id="lblConfirmPasswordError" managed="false" visible="false" styleClass="field-error"/>
                    </VBox>

                    <HBox spacing="12" alignment="CENTER">
                        <Button fx:id="btnBackToLogin" text="Back to Login" onAction="#backToLogin" styleClass="auth-secondary-button"/>
                        <Button fx:id="btnResetPassword" text="RESET PASSWORD" onAction="#resetPassword" styleClass="auth-primary-button"/>
                    </HBox>
                </VBox>

                <Label fx:id="lblMessage" wrapText="true" maxWidth="620" styleClass="auth-message"/>
            </VBox>
        </StackPane>
    </center>
    <bottom><SharedApplicationFooter/></bottom>
</BorderPane>
