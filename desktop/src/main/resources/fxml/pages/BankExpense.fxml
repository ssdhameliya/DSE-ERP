<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.BankExpenseController" spacing="12" styleClass="bank-expense-page,approved-screen,erp-screen-root">
  <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header">
    <StackPane styleClass="erp-page-header-icon"><Label text="₹" styleClass="erp-page-header-symbol"/></StackPane>
    <VBox spacing="2"><Label fx:id="lblTitle" text="Bank Entry" styleClass="screen-title"/><Label fx:id="lblSubtitle" text="Manage all bank transactions in one place" styleClass="screen-subtitle"/></VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <HBox spacing="6" styleClass="bank-expense-mode-strip">
      <Button fx:id="btnBankMode" text="Bank Entry" onAction="#showBankMode" styleClass="approved-button,bank-expense-mode-button"/>
      <Button fx:id="btnExpenseMode" text="Expense Entry" onAction="#showExpenseMode" styleClass="approved-button,bank-expense-mode-button"/>
      <Button fx:id="btnBankRecon" text="Bank Reconciliation" onAction="#showBankReconciliation" styleClass="approved-button,bank-expense-mode-button,bank-recon-nav-button"/>
    </HBox>
  </HBox>

  <HBox spacing="10" styleClass="erp-kpi-section">
    <VBox styleClass="finance-kpi-card,finance-kpi-blue" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT" spacing="10"><Label fx:id="kpi1Icon" styleClass="finance-kpi-icon"/><Label fx:id="kpi1Label" styleClass="finance-kpi-label"/></HBox><Label fx:id="kpi1Value" styleClass="finance-kpi-value"/><Label fx:id="kpi1Note" styleClass="finance-kpi-note"/></VBox>
    <VBox styleClass="finance-kpi-card,finance-kpi-purple" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT" spacing="10"><Label fx:id="kpi2Icon" styleClass="finance-kpi-icon"/><Label fx:id="kpi2Label" styleClass="finance-kpi-label"/></HBox><Label fx:id="kpi2Value" styleClass="finance-kpi-value"/><Label fx:id="kpi2Note" styleClass="finance-kpi-note"/></VBox>
    <VBox styleClass="finance-kpi-card,finance-kpi-green" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT" spacing="10"><Label fx:id="kpi3Icon" styleClass="finance-kpi-icon"/><Label fx:id="kpi3Label" styleClass="finance-kpi-label"/></HBox><Label fx:id="kpi3Value" styleClass="finance-kpi-value"/><Label fx:id="kpi3Note" styleClass="finance-kpi-note"/></VBox>
    <VBox styleClass="finance-kpi-card,finance-kpi-red" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT" spacing="10"><Label fx:id="kpi4Icon" styleClass="finance-kpi-icon"/><Label fx:id="kpi4Label" styleClass="finance-kpi-label"/></HBox><Label fx:id="kpi4Value" styleClass="finance-kpi-value"/><Label fx:id="kpi4Note" styleClass="finance-kpi-note"/></VBox>
  </HBox>

  <HBox fx:id="workspaceRow" spacing="12" VBox.vgrow="ALWAYS">
    <VBox fx:id="entryFormPanel" prefWidth="760" minWidth="700" maxWidth="860" spacing="10" styleClass="finance-entry-card,finance-entry-dialog-card">
      <Label fx:id="formTitle" text="Add Bank Entry" styleClass="finance-section-title"/>
      <HBox spacing="14" VBox.vgrow="ALWAYS">
        <VBox spacing="8" HBox.hgrow="ALWAYS" minWidth="0" styleClass="finance-entry-column,finance-entry-primary-column">
          <Label text="Date *" styleClass="finance-field-label"/><DatePicker fx:id="entryDate" maxWidth="Infinity"/>
          <VBox fx:id="bankOnlyFields" spacing="8">
            <Label text="Account *" styleClass="finance-field-label"/><ComboBox fx:id="bankAccount" maxWidth="Infinity"/>
            <Label text="Type *" styleClass="finance-field-label"/>
            <HBox spacing="12"><RadioButton fx:id="creditRadio" text="Deposit (Credit)"/><RadioButton fx:id="debitRadio" text="Withdrawal (Debit)"/></HBox>
          </VBox>
          <VBox fx:id="expenseOnlyFields" spacing="8" visible="false" managed="false">
            <Label text="Category *" styleClass="finance-field-label"/><ComboBox fx:id="expenseCategory" editable="false" maxWidth="Infinity"/>
            <Label text="Account *" styleClass="finance-field-label"/><ComboBox fx:id="expenseAccount" maxWidth="Infinity"/>
          </VBox>
          <Label text="Payment Mode *" styleClass="finance-field-label"/><ComboBox fx:id="paymentMode" maxWidth="Infinity"/>
          <Region VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS" minWidth="0" styleClass="finance-entry-column,finance-entry-secondary-column">
          <Label text="Reference No." styleClass="finance-field-label"/><TextField fx:id="referenceNo" promptText="Enter reference / cheque no."/>
          <Label text="Description *" styleClass="finance-field-label"/><TextArea fx:id="description" promptText="Enter description" prefRowCount="4" wrapText="true" VBox.vgrow="ALWAYS"/>
          <Label text="Amount *" styleClass="finance-field-label"/><TextField fx:id="amount" promptText="₹   Enter amount"/>
          <VBox fx:id="billBox" spacing="5" visible="false" managed="false">
            <Label text="Upload Bill (Optional)" styleClass="finance-field-label"/>
            <HBox spacing="8"><Button text="Choose Bill" onAction="#chooseBill" styleClass="approved-button,approved-secondary-button"/><Label fx:id="billName" text="No file selected" styleClass="finance-file-name" HBox.hgrow="ALWAYS"/></HBox>
          </VBox>
          <Region VBox.vgrow="ALWAYS"/>
        </VBox>
      </HBox>
      <HBox spacing="8"><Button fx:id="saveButton" text="Save Entry" onAction="#saveEntry" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="approved-button,approved-primary-button"/><Button text="Clear" onAction="#clearForm" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="approved-button,approved-secondary-button"/></HBox>
    </VBox>

    <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="finance-list-card">
      <Label fx:id="listTitle" text="Bank Entries" styleClass="finance-section-title"/>
      <HBox spacing="10" alignment="BOTTOM_LEFT" styleClass="finance-filter-toolbar">
        <VBox spacing="4">
          <Label text="Search" styleClass="finance-filter-label,finance-filter-label-search"/>
          <HBox alignment="CENTER_LEFT" spacing="0" styleClass="finance-filter-search-shell">
            <StackPane fx:id="financeSearchIcon" minWidth="32" prefWidth="32" styleClass="finance-filter-search-icon"/>
            <TextField fx:id="searchField" promptText="Search reference, description..." prefWidth="270" onKeyReleased="#applyFilters" styleClass="finance-filter-search-input"/>
          </HBox>
        </VBox>
        <VBox spacing="4">
          <Label text="Type" styleClass="finance-filter-label,finance-filter-label-type"/>
          <ComboBox fx:id="typeFilter" prefWidth="160" onAction="#applyFilters"/>
        </VBox>
        <VBox spacing="4">
          <Label text="From Date" styleClass="finance-filter-label,finance-filter-label-date"/>
          <DatePicker fx:id="filterFrom" prefWidth="150"/>
        </VBox>
        <VBox spacing="4">
          <Label text="To Date" styleClass="finance-filter-label,finance-filter-label-date"/>
          <DatePicker fx:id="filterTo" prefWidth="150"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnResetFilters" text="Reset" onAction="#resetFilters" styleClass="approved-button,approved-secondary-button"/>
        <Button fx:id="btnRefreshEntries" text="Refresh" onAction="#refreshWithFeedback" styleClass="approved-button,approved-secondary-button"/>
        <Button fx:id="addButton" text="Add Entry" onAction="#focusForm" styleClass="approved-button,approved-primary-button"/>
      </HBox>
      <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="finance-table,erp-table-profile-register,erp-purple-selection-table">
        <columns>
          <TableColumn fx:id="colDate" text="Date"/>
          <TableColumn fx:id="colType" text="Type"/>
          <TableColumn fx:id="colDescription" text="Description"/>
          <TableColumn fx:id="colAccount" text="Account"/>
          <TableColumn fx:id="colMode" text="Mode"/>
          <TableColumn fx:id="colReference" text="Reference"/>
          <TableColumn fx:id="colAmount" text="Amount"/>
          <TableColumn fx:id="colMatch" text="Match / Link"/>
          <TableColumn fx:id="colAction" text="Actions" minWidth="156" prefWidth="160" maxWidth="168" sortable="false" resizable="false"/>
        </columns>
      </TableView>
      <HBox alignment="CENTER_LEFT">
        <Label fx:id="showingLabel" text="Showing 0 to 0 of 0 entries" styleClass="finance-showing-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="‹" onAction="#previousPage" styleClass="approved-button,approved-secondary-button,finance-page-button"/>
        <Label fx:id="pageLabel" text="1 / 1" styleClass="finance-page-label"/>
        <Button text="›" onAction="#nextPage" styleClass="approved-button,approved-secondary-button,finance-page-button"/>
      </HBox>
    </VBox>
  </HBox>
</VBox>
