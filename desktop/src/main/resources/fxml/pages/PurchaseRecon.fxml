<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.PurchaseReconController" spacing="12" styleClass="recon-page,recon-register-page,approved-ui,erp-screen-root">
 <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
 <HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header,approved-card"><StackPane fx:id="pageIcon" styleClass="erp-page-header-icon"/><VBox><Label text="Purchase Recon" styleClass="screen-title"/><Label text="Independent purchase invoice reconciliation against Bank Statement" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnBankStatement" text="Bank Statement" onAction="#openBankStatementWorkspace" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnRefresh" text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnNew" text="New Purchase Recon" onAction="#newRecord" styleClass="approved-button,approved-primary-button"/></HBox>
 <HBox spacing="8" styleClass="standard-kpi-row,recon-metric-row,erp-kpi-section">
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-blue"><StackPane fx:id="kpiTotalIcon" styleClass="standard-kpi-icon"/><VBox spacing="3"><Label text="Total" styleClass="metric-label"/><Label fx:id="kpiTotal" text="0" styleClass="metric-value"/><Label text="Purchase Recon records" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-red"><StackPane fx:id="kpiOpenIcon" styleClass="standard-kpi-icon"/><VBox spacing="3"><Label text="Open" styleClass="metric-label"/><Label fx:id="kpiOpen" text="0" styleClass="metric-value"/><Label text="Not yet linked" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-purple"><StackPane fx:id="kpiPartialIcon" styleClass="standard-kpi-icon"/><VBox spacing="3"><Label text="Partial" styleClass="metric-label"/><Label fx:id="kpiPartial" text="0" styleClass="metric-value"/><Label text="Partially reconciled" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-green"><StackPane fx:id="kpiDoneIcon" styleClass="standard-kpi-icon"/><VBox spacing="3"><Label text="Reconciled" styleClass="metric-label"/><Label fx:id="kpiDone" text="0" styleClass="metric-value"/><Label text="Fully linked" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-orange"><StackPane fx:id="kpiReviewIcon" styleClass="standard-kpi-icon"/><VBox spacing="3"><Label text="Needs Review" styleClass="metric-label"/><Label fx:id="kpiReview" text="0" styleClass="metric-value"/><Label text="Tax difference review" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-purple"><StackPane fx:id="kpiOutstandingIcon" styleClass="standard-kpi-icon"/><VBox spacing="3"><Label text="Outstanding" styleClass="metric-label"/><Label fx:id="kpiOutstanding" text="₹ 0.00" styleClass="metric-value"/><Label text="Awaiting bank linkage" styleClass="metric-note"/></VBox></HBox>
 </HBox>
 <HBox fx:id="workspaceRow" spacing="12" VBox.vgrow="ALWAYS">
  <VBox spacing="9" HBox.hgrow="ALWAYS" styleClass="approved-card"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Purchase Recon Register" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><TextField fx:id="txtSearch" promptText="Search PRC ref, supplier, GSTIN, invoice..." prefWidth="300"/><ComboBox fx:id="cmbFilterStatus" prefWidth="145"/><Button text="Search" onAction="#applyFilters" styleClass="approved-button,approved-secondary-button"/></HBox>
   <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-responsive,erp-purple-selection-table"><columns><TableColumn fx:id="colRef" text="System Ref" prefWidth="135"/><TableColumn fx:id="colDate" text="Invoice Date" prefWidth="105"/><TableColumn fx:id="colSupplier" text="Recon Supplier" prefWidth="220"/><TableColumn fx:id="colInvoice" text="Supplier Invoice" prefWidth="135"/><TableColumn fx:id="colValue" text="Invoice Value" prefWidth="115"/><TableColumn fx:id="colLinked" text="Linked" prefWidth="105"/><TableColumn fx:id="colBalance" text="Balance" prefWidth="105"/><TableColumn fx:id="colStatus" text="Status" prefWidth="120"/><TableColumn fx:id="colSource" text="Source" prefWidth="90"/><TableColumn fx:id="colAction" text="Actions" prefWidth="120" sortable="false"/></columns></TableView>
   <HBox alignment="CENTER_LEFT" spacing="8" styleClass="table-footer"><Label fx:id="lblPageInfo" text="Showing 0 of 0 records" styleClass="register-record-count"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnPrevPage" text="‹ Previous" onAction="#previousPage" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnNextPage" text="Next ›" onAction="#nextPage" styleClass="approved-button,approved-secondary-button"/></HBox>
  </VBox>
  <VBox fx:id="editorPanel" spacing="9" prefWidth="430" minWidth="400" styleClass="approved-card,recon-editor-panel"><HBox alignment="CENTER_LEFT"><VBox><Label fx:id="lblEditorTitle" text="Purchase Recon Details" styleClass="section-title"/><Label fx:id="lblReference" text="Select a record or create a new one" styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Close" onAction="#closeEditor" styleClass="approved-button,approved-secondary-button"/></HBox><Separator/>
   <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="import-inner-scroll"><VBox spacing="10">
    <HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Recon Supplier" styleClass="field-label"/><ComboBox fx:id="cmbSupplier" maxWidth="Infinity"/></VBox><Button fx:id="btnAddSupplier" text="Add Recon Supplier" onAction="#addSupplier" styleClass="approved-button,approved-secondary-button"/></HBox>
    <GridPane hgap="8" vgap="8"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><Label text="Supplier Invoice No." styleClass="field-label"/><Label text="Invoice Date" styleClass="field-label" GridPane.columnIndex="1"/><TextField fx:id="txtInvoiceNo" GridPane.rowIndex="1"/><DatePicker fx:id="dpInvoiceDate" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity"/><Label text="Taxable Value" styleClass="field-label" GridPane.rowIndex="2"/><Label text="Invoice Value" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="1"/><TextField fx:id="txtTaxable" GridPane.rowIndex="3"/><TextField fx:id="txtInvoiceValue" GridPane.rowIndex="3" GridPane.columnIndex="1"/><Label text="CGST" styleClass="field-label" GridPane.rowIndex="4"/><Label text="SGST / UTGST" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="1"/><TextField fx:id="txtCgst" GridPane.rowIndex="5"/><TextField fx:id="txtSgst" GridPane.rowIndex="5" GridPane.columnIndex="1"/><Label text="IGST" styleClass="field-label" GridPane.rowIndex="6"/><Label text="Other / Rounding" styleClass="field-label" GridPane.rowIndex="6" GridPane.columnIndex="1"/><TextField fx:id="txtIgst" GridPane.rowIndex="7"/><TextField fx:id="txtOther" GridPane.rowIndex="7" GridPane.columnIndex="1"/></GridPane>
    <HBox spacing="8" styleClass="approved-highlight-strip"><VBox HBox.hgrow="ALWAYS"><Label text="Linked Amount" styleClass="metric-label"/><Label fx:id="lblLinked" text="₹ 0.00" styleClass="metric-value"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Balance" styleClass="metric-label"/><Label fx:id="lblBalance" text="₹ 0.00" styleClass="metric-value"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Status" styleClass="metric-label"/><Label fx:id="lblStatus" text="OPEN" styleClass="approved-status"/></VBox></HBox>
    <Label fx:id="lblTaxWarning" text="" visible="false" managed="false" wrapText="true" styleClass="import-warning-text"/>
    <Label text="Notes" styleClass="field-label"/><TextArea fx:id="txtNotes" prefRowCount="3" wrapText="true"/>
    <VBox spacing="7" styleClass="approved-card"><HBox alignment="CENTER_LEFT"><Label text="Attachments" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="Stored on server" styleClass="muted-label"/></HBox><ListView fx:id="listAttachments" prefHeight="105"/><HBox spacing="7"><Button fx:id="btnAttachmentAdd" text="Add" onAction="#addAttachment" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnAttachmentPreview" text="Preview" onAction="#previewAttachment" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnAttachmentDelete" text="Delete" onAction="#deleteAttachment" styleClass="approved-button,approved-danger-button"/></HBox></VBox>
    <VBox spacing="7" styleClass="approved-card"><HBox alignment="CENTER_LEFT"><Label text="Bank Statement Links" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="Purchase Recon ↔ Bank Statement ↔ Bank Entry" styleClass="muted-label"/></HBox><ListView fx:id="listBankLinks" prefHeight="105"/><HBox spacing="7"><Button fx:id="btnOpenStatement" text="Open Bank Statement" onAction="#openBankStatement" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnOpenBankEntry" text="Open Bank Entry" onAction="#openBankEntry" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
   </VBox></ScrollPane>
   <HBox alignment="CENTER_RIGHT" spacing="8"><Button text="Cancel" onAction="#closeEditor" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnSave" text="Save Purchase Recon" onAction="#saveRecord" styleClass="approved-button,approved-primary-button"/></HBox>
  </VBox>
 </HBox>
</VBox>
