<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.WorkflowDocumentController" spacing="14" styleClass="register-page,approved-ui,approved-screen,erp-screen-root">
 <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
 <Label fx:id="lblWorkflowType" text="PROJECT" visible="false" managed="false"/>
 <HBox alignment="CENTER_LEFT" styleClass="entity-page-header,approved-section-header,erp-page-identity-header"><StackPane fx:id="pageIcon" styleClass="erp-page-header-icon"/><VBox spacing="3"><Label fx:id="lblTitle" text="Projects / Jobs" styleClass="screen-title"/><Label fx:id="lblSubtitle" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Create" onAction="#create" styleClass="primary-action,entity-create-button,approved-button,approved-primary-button"/></HBox>
 <HBox spacing="12" styleClass="standard-kpi-row,erp-kpi-section">
  <HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-blue" HBox.hgrow="ALWAYS"><StackPane fx:id="totalIcon" styleClass="standard-kpi-icon"/><VBox><Label text="Records" styleClass="metric-label"/><Label fx:id="lblTotal" text="0" styleClass="metric-value"/></VBox></HBox>
  <HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-orange" HBox.hgrow="ALWAYS"><StackPane fx:id="openIcon" styleClass="standard-kpi-icon"/><VBox><Label text="Open" styleClass="metric-label"/><Label fx:id="lblOpen" text="0" styleClass="metric-value"/></VBox></HBox>
  <HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-green" HBox.hgrow="ALWAYS"><StackPane fx:id="valueIcon" styleClass="standard-kpi-icon"/><VBox><Label text="Value" styleClass="metric-label"/><Label fx:id="lblValue" text="₹ 0.00" styleClass="metric-value"/></VBox></HBox>
 </HBox>
 <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-surface,entity-toolbar,approved-filter-bar,approved-toolbar,erp-filter-section"><TextField fx:id="txtSearch" promptText="Search number, project, party or status..." HBox.hgrow="ALWAYS" styleClass="entity-search"/><ComboBox fx:id="cmbStatus" prefWidth="170" styleClass="approved-input"/><Button text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/><Button text="Clear" onAction="#clearFilters" styleClass="approved-button,approved-secondary-button"/></HBox>
 <VBox spacing="0" VBox.vgrow="ALWAYS" maxWidth="Infinity" styleClass="entity-table-card"><TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="professional-table,entity-table,erp-table-profile-register"><columns><TableColumn fx:id="colNo" text="Number" styleClass="approved-table-column"/><TableColumn fx:id="colProject" text="Project" styleClass="approved-table-column"/><TableColumn fx:id="colParty" text="Party" styleClass="approved-table-column"/><TableColumn fx:id="colParent" text="Source / PO" styleClass="approved-table-column"/><TableColumn fx:id="colDate" text="Date" styleClass="approved-table-column"/><TableColumn fx:id="colExpected" text="Expected" styleClass="approved-table-column"/><TableColumn fx:id="colStatus" text="Status" styleClass="approved-table-column"/><TableColumn fx:id="colTotal" text="Value" styleClass="approved-table-column"/><TableColumn fx:id="colActions" text="Actions" sortable="false" styleClass="approved-table-column"/></columns></TableView><HBox alignment="CENTER_RIGHT" styleClass="table-footer,entity-table-footer"><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblRecordCount" text="Showing 0 Records" styleClass="record-count-pill"/></HBox></VBox>
</VBox>