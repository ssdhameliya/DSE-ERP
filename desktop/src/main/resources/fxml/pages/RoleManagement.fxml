<?xml version="1.0" encoding="UTF-8"?><?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.RoleManagementController" spacing="14" styleClass="user-access-page,approved-ui,erp-screen-root"><padding><Insets top="14" right="18" bottom="14" left="18"/></padding><HBox alignment="CENTER_LEFT"><VBox><Label text="Role Management" styleClass="screen-title"/><Label text="Create clean business roles without mixing user and permission tables" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Back to Users" onAction="#back" styleClass="approved-button,approved-secondary-button"/><Button text="Permission Matrix" onAction="#openPermissions" styleClass="primary-button"/></HBox><HBox spacing="12"><VBox styleClass="user-kpi,user-kpi-blue" HBox.hgrow="ALWAYS"><Label text="System Roles" styleClass="metric-title"/><Label fx:id="lblRoles" text="0" styleClass="metric-value"/></VBox><VBox styleClass="user-kpi,user-kpi-green" HBox.hgrow="ALWAYS"><Label text="Assigned Users" styleClass="metric-title"/><Label fx:id="lblAssigned" text="0" styleClass="metric-value"/></VBox><VBox styleClass="user-kpi,user-kpi-purple" HBox.hgrow="ALWAYS"><Label text="Business Roles" styleClass="metric-title"/><Label fx:id="lblCustom" text="0" styleClass="metric-value"/></VBox></HBox><VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="user-access-card,ua-full-card"><HBox alignment="CENTER_LEFT"><VBox><Label text="Roles" styleClass="section-title"/><Label text="Keep responsibilities clear and reusable across users" styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/><Button text="Add Role" onAction="#addRole" styleClass="primary-button"/></HBox><TableView fx:id="roleTable" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-administration"><columns><TableColumn fx:id="colName" text="Role Name"/><TableColumn fx:id="colDescription" text="Description"/><TableColumn fx:id="colUsers" text="Users"/><TableColumn fx:id="colStatus" text="Status"/></columns></TableView><HBox alignment="CENTER_RIGHT" spacing="8"><Button text="Delete" onAction="#deleteRole" styleClass="danger-button"/><Button text="Edit Role" onAction="#editRole" styleClass="approved-button,approved-secondary-button"/><Button text="Manage Permissions" onAction="#openPermissions" styleClass="primary-button"/></HBox></VBox></VBox>
