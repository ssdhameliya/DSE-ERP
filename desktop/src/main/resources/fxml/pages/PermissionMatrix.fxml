<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.PermissionMatrixController" spacing="12" styleClass="user-access-page,approved-ui,erp-screen-root">
  <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header">
    <StackPane styleClass="erp-page-header-icon,permission-header-icon"><Label text="▦" styleClass="erp-page-header-symbol"/></StackPane>
    <VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="Permission Matrix" styleClass="screen-title"/><Label text="Control the real application capabilities available to each protected business role" styleClass="screen-subtitle"/></VBox>
    <Button fx:id="btnBack" text="Back to Roles" onAction="#back" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnSaveTop" text="Save Permissions" onAction="#save" styleClass="primary-button"/>
  </HBox>
  <HBox spacing="12" styleClass="standard-kpi-row,erp-kpi-section">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-green" HBox.hgrow="ALWAYS"><StackPane styleClass="standard-kpi-icon"><Label text="✓"/></StackPane><VBox spacing="3"><Label text="Granted" styleClass="metric-title"/><Label fx:id="lblGranted" text="0" styleClass="metric-value"/></VBox></HBox>
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-red" HBox.hgrow="ALWAYS"><StackPane styleClass="standard-kpi-icon"><Label text="×"/></StackPane><VBox spacing="3"><Label text="Not Granted" styleClass="metric-title"/><Label fx:id="lblDenied" text="0" styleClass="metric-value"/></VBox></HBox>
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-blue" HBox.hgrow="ALWAYS"><StackPane styleClass="standard-kpi-icon"><Label text="▦"/></StackPane><VBox spacing="3"><Label text="Modules" styleClass="metric-title"/><Label fx:id="lblModules" text="0" styleClass="metric-value"/></VBox></HBox>
  </HBox>
  <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="user-access-card,ua-full-card">
    <HBox alignment="CENTER_LEFT" spacing="10"><Label text="Role" styleClass="field-label"/><ComboBox fx:id="cmbRole" prefWidth="220" styleClass="approved-input"/><Label text="Module" styleClass="field-label"/><ComboBox fx:id="cmbModule" prefWidth="220" styleClass="approved-input"/><Label fx:id="lblHint" text="Select a role" styleClass="muted-label"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnGrantAll" text="Grant Visible" onAction="#grantAll" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnRevokeAll" text="Revoke Visible" onAction="#revokeAll" styleClass="approved-button,approved-secondary-button"/></HBox>
    <TableView fx:id="table" editable="true" VBox.vgrow="ALWAYS" styleClass="approved-table,permission-matrix-table,erp-table-profile-permission"><columns><TableColumn fx:id="colModule" text="Module"/><TableColumn fx:id="colAction" text="Capability"/><TableColumn fx:id="colDescription" text="What this allows"/><TableColumn fx:id="colAllowed" text="Allowed"/></columns></TableView>
    <HBox alignment="CENTER_LEFT" spacing="8"><Label text="ADMIN is always full access by system policy. MANAGER and SALES use the saved matrix." styleClass="muted-label"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnReset" text="Reset Changes" onAction="#reset" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnSaveBottom" text="Save Permissions" onAction="#save" styleClass="primary-button"/></HBox>
  </VBox>
</VBox>
