<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import org.example.ui.SharedApplicationFooter?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.SplashController" styleClass="auth-page,auth-standard-shell,approved-ui,approved-screen,approved-screen-splash,erp-screen-root,dse-startup-splash,auth-splash-shell">
  <left>
    <VBox prefWidth="600" minWidth="360" alignment="CENTER" spacing="18" styleClass="auth-brand-panel,auth-unified-brand-panel">
      <StackPane fx:id="brandLogoBox" minHeight="118" prefHeight="118" maxWidth="520" styleClass="auth-company-logo-box,splash-brand-logo-box"><ImageView fx:id="imgBrandLogo" preserveRatio="false" smooth="true" managed="false" visible="false"/></StackPane>
      <StackPane styleClass="auth-logo-badge"><Label fx:id="lblBrandMark" text="◆" styleClass="auth-logo-mark,splash-brand-mark"/></StackPane>
      <Label fx:id="lblBrandName" text="DSE ERP" styleClass="auth-brand-title,splash-brand-title"/>
      <Region prefHeight="2" maxWidth="80" styleClass="auth-brand-line"/>
      <Label fx:id="lblBrandTagline" text="Business Management Suite" styleClass="auth-brand-subtitle,splash-brand-subtitle"/>
      <Label fx:id="lblBrandQuote" text="Precision in Engineering Excellence in Business." wrapText="true" textAlignment="CENTER" styleClass="auth-brand-quote"/>
      <Region VBox.vgrow="ALWAYS"/>
      <Label fx:id="versionLabel" text="Version" styleClass="auth-version"/>
    </VBox>
  </left>
  <center>
    <StackPane styleClass="auth-content,auth-unified-content,splash-auth-content">
      <VBox maxWidth="720" spacing="12" alignment="CENTER" styleClass="auth-card,auth-unified-card,splash-auth-card">
        <Label fx:id="lblStarting" text="Starting DSE ERP..." styleClass="auth-title,splash-start-title"/>
        <Label text="Please wait while we prepare everything for you." styleClass="auth-description,splash-start-copy"/>
        <VBox styleClass="splash-stage-card" spacing="0" maxWidth="620">
          <HBox styleClass="splash-stage-row" alignment="CENTER_LEFT" spacing="12"><StackPane styleClass="splash-stage-icon,splash-icon-workspace"><Label text="▰"/></StackPane><VBox HBox.hgrow="ALWAYS" spacing="2"><Label text="1. Workspace" styleClass="splash-stage-title"/><Label text="Loading workspace and configuration" styleClass="splash-stage-copy"/></VBox><Label fx:id="workspaceStatus" text="Completed" styleClass="splash-stage-state,splash-state-complete"/><Label fx:id="workspaceTime" text="" styleClass="splash-stage-time"/></HBox>
          <HBox styleClass="splash-stage-row" alignment="CENTER_LEFT" spacing="12"><StackPane styleClass="splash-stage-icon,splash-icon-postgres"><Label text="●"/></StackPane><VBox HBox.hgrow="ALWAYS" spacing="2"><Label text="2. PostgreSQL" styleClass="splash-stage-title"/><Label text="Starting and verifying managed database" styleClass="splash-stage-copy"/></VBox><Label fx:id="postgresStatus" text="Pending" styleClass="splash-stage-state,splash-state-pending"/><Label fx:id="postgresTime" text="" styleClass="splash-stage-time"/></HBox>
          <HBox styleClass="splash-stage-row" alignment="CENTER_LEFT" spacing="12"><StackPane styleClass="splash-stage-icon,splash-icon-spring"><Label text="⚙"/></StackPane><VBox HBox.hgrow="ALWAYS" spacing="2"><Label text="3. Spring Boot Services" styleClass="splash-stage-title"/><Label text="Starting backend services" styleClass="splash-stage-copy"/></VBox><Label fx:id="springStatus" text="Pending" styleClass="splash-stage-state,splash-state-pending"/><Label fx:id="springTime" text="" styleClass="splash-stage-time"/></HBox>
          <HBox styleClass="splash-stage-row" alignment="CENTER_LEFT" spacing="12"><StackPane styleClass="splash-stage-icon,splash-icon-schema"><Label text="✓"/></StackPane><VBox HBox.hgrow="ALWAYS" spacing="2"><Label text="4. Database &amp; Schema" styleClass="splash-stage-title"/><Label text="Verifying database, schema and migrations" styleClass="splash-stage-copy"/></VBox><Label fx:id="schemaStatus" text="Pending" styleClass="splash-stage-state,splash-state-pending"/><Label fx:id="schemaTime" text="" styleClass="splash-stage-time"/></HBox>
          <HBox styleClass="splash-stage-row,splash-stage-row-last" alignment="CENTER_LEFT" spacing="12"><StackPane styleClass="splash-stage-icon,splash-icon-app"><Label text="➤"/></StackPane><VBox HBox.hgrow="ALWAYS" spacing="2"><Label text="5. Application" styleClass="splash-stage-title"/><Label text="Finalizing and opening login" styleClass="splash-stage-copy"/></VBox><Label fx:id="applicationStatus" text="Pending" styleClass="splash-stage-state,splash-state-pending"/><Label fx:id="applicationTime" text="" styleClass="splash-stage-time"/></HBox>
          <VBox styleClass="splash-progress-area" spacing="6"><Label text="Overall Progress" styleClass="splash-progress-caption"/><HBox alignment="CENTER" spacing="12"><ProgressBar fx:id="progressBar" progress="0.10" maxWidth="Infinity" HBox.hgrow="ALWAYS"/><Label fx:id="progressPercent" text="10%" styleClass="splash-progress-percent"/></HBox><Label fx:id="lblStatus" text="Loading workspace and configuration..." styleClass="splash-live-status"/></VBox>
          <HBox styleClass="splash-info-strip" alignment="CENTER" spacing="0" maxWidth="620"><VBox HBox.hgrow="ALWAYS" styleClass="splash-info-cell" spacing="2"><Label text="Elapsed Time" styleClass="splash-info-label"/><Label fx:id="elapsedTime" text="00:00:00" styleClass="splash-info-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="splash-info-cell" spacing="2"><Label text="Startup Stage" styleClass="splash-info-label"/><Label fx:id="stageValue" text="1 / 5" styleClass="splash-info-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="splash-info-cell" spacing="2"><Label text="System" styleClass="splash-info-label"/><Label fx:id="systemValue" text="Detecting..." styleClass="splash-info-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="splash-info-cell" spacing="2"><Label text="Database" styleClass="splash-info-label"/><Label fx:id="databaseValue" text="PostgreSQL" styleClass="splash-info-value"/></VBox></HBox>
        </VBox>
      </VBox>
    </StackPane>
  </center>
    <bottom><SharedApplicationFooter/></bottom>
</BorderPane>
