<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.image.ImageView?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import org.example.ui.SharedApplicationFooter?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.EmailSettingsController" styleClass="auth-page,auth-standard-shell,approved-ui,approved-screen,approved-screen-email-settings,erp-screen-root">

    <left>
        <VBox fx:id="brandPanel" alignment="CENTER" spacing="18" styleClass="auth-brand-panel,auth-unified-brand-panel">
            <Region VBox.vgrow="ALWAYS"/>
            <StackPane fx:id="brandLogoBox" minHeight="118" prefHeight="118" maxWidth="520" styleClass="auth-company-logo-box"><ImageView fx:id="imgBrandLogo" preserveRatio="false" smooth="true" managed="false" visible="false"/></StackPane>
            <StackPane fx:id="brandMarkBox" managed="false" visible="false" styleClass="auth-logo-badge"><ImageView fx:id="imgBrandMark" preserveRatio="true" fitWidth="58" fitHeight="58" smooth="true"/><Label fx:id="lblBrandMark" text="◆" managed="false" visible="false" styleClass="auth-logo-mark"/></StackPane>
            <Label fx:id="lblBrandName" text="DSE ERP" styleClass="auth-brand-title"/>
            <Region prefHeight="2" maxWidth="80" styleClass="auth-brand-line"/>
            <Label fx:id="lblBrandTagline" text="Business Management Suite" styleClass="auth-brand-subtitle"/>
            <Label fx:id="lblBrandDescription" text="Business Management Suite" wrapText="true" textAlignment="CENTER" styleClass="auth-brand-quote"/>
            <Region prefHeight="4"/>
            <Label fx:id="lblVersion" text="Version" styleClass="auth-version"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center><StackPane styleClass="auth-content,auth-unified-content"><VBox maxWidth="720" spacing="14" alignment="CENTER" styleClass="auth-card,auth-unified-card">
        <StackPane styleClass="auth-section-icon"><Label text="✉"/></StackPane>
        <Label text="Email Configuration" styleClass="auth-title"/>
        <Label text="Configure the same SMTP account used by login verification and business emails." styleClass="auth-description"/>
        <VBox spacing="5" maxWidth="620"><Label text="Sending email address *" styleClass="auth-field-label"/><TextField fx:id="txtSmtpEmail" promptText="name@example.com" styleClass="auth-input"/><Label fx:id="lblEmailError" managed="false" visible="false" styleClass="field-error"/></VBox>
        <VBox spacing="5" maxWidth="620"><Label text="Email app password *" styleClass="auth-field-label"/><HBox spacing="8"><StackPane HBox.hgrow="ALWAYS"><PasswordField fx:id="txtSmtpPassword" promptText="Provider app password" maxWidth="Infinity" styleClass="auth-input"/><TextField fx:id="txtSmtpPasswordVisible" promptText="Provider app password" maxWidth="Infinity" visible="false" managed="false" styleClass="auth-input"/></StackPane><CheckBox fx:id="chkShowSmtpPassword" text="Show" onAction="#togglePasswordVisibility"/></HBox><Label fx:id="lblPasswordError" managed="false" visible="false" styleClass="field-error"/></VBox>
        <GridPane hgap="12" vgap="8" maxWidth="620"><columnConstraints><ColumnConstraints percentWidth="68" hgrow="ALWAYS"/><ColumnConstraints percentWidth="32" hgrow="ALWAYS"/></columnConstraints><VBox spacing="5"><Label text="SMTP host" styleClass="auth-field-label"/><TextField fx:id="txtSmtpHost" promptText="smtp.gmail.com" styleClass="auth-input"/><Label fx:id="lblHostError" managed="false" visible="false" styleClass="field-error"/></VBox><VBox spacing="5" GridPane.columnIndex="1"><Label text="SMTP port *" styleClass="auth-field-label"/><TextField fx:id="txtSmtpPort" promptText="587" styleClass="auth-input"/><Label fx:id="lblPortError" managed="false" visible="false" styleClass="field-error"/></VBox></GridPane>
        <HBox spacing="12" maxWidth="620" alignment="CENTER_LEFT" styleClass="auth-info-box"><Label text="i" styleClass="auth-info-icon"/><Label text="Use an app password supplied by your email provider. Leave SMTP host blank to let DSE ERP infer Gmail, Yahoo or Microsoft hosts from the email address." wrapText="true" HBox.hgrow="ALWAYS"/></HBox>
        <HBox spacing="10" alignment="CENTER"><Button fx:id="btnTestEmail" text="Test Email" onAction="#testEmail" maxWidth="220" styleClass="auth-secondary-button"/><Button fx:id="btnSave" text="Save Email Settings" onAction="#save" maxWidth="300" styleClass="auth-primary-button"/></HBox>
        <Button fx:id="btnBack" text="Back to login" onAction="#back" maxWidth="220" styleClass="auth-secondary-button"/>
        <Label fx:id="lblMessage" wrapText="true" maxWidth="620" styleClass="auth-message"/>
    </VBox></StackPane></center>
    <bottom><SharedApplicationFooter/></bottom>
</BorderPane>
