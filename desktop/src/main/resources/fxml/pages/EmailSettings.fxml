<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.image.ImageView?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import org.example.ui.SharedApplicationFooter?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.EmailSettingsController" styleClass="auth-page,approved-ui,approved-screen,approved-screen-email-settings,erp-screen-root">

    <left>
        <VBox prefWidth="600" minWidth="360" alignment="CENTER" spacing="18" styleClass="auth-brand-panel,auth-unified-brand-panel">
            <StackPane fx:id="brandLogoBox" minHeight="118" prefHeight="118" maxWidth="520" styleClass="auth-company-logo-box"><ImageView fx:id="imgBrandLogo" preserveRatio="false" smooth="true" managed="false" visible="false"/><Label fx:id="lblBrandMark" text="◆" styleClass="auth-logo-mark"/></StackPane>
            <Label fx:id="lblBrandName" text="DSE ERP" styleClass="auth-brand-title"/>
            <Region prefHeight="2" maxWidth="80" styleClass="auth-brand-line"/>
            <Label fx:id="lblBrandTagline" text="Business Management Suite" styleClass="auth-brand-subtitle"/>
            <Label fx:id="lblBrandDescription" text="Business Management Suite" wrapText="true" textAlignment="CENTER" styleClass="auth-brand-quote"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Version 7.3.11" styleClass="auth-version"/>
        </VBox>
    </left>

    <center><StackPane styleClass="auth-content,auth-unified-content"><VBox maxWidth="680" spacing="14" alignment="CENTER" styleClass="auth-card,auth-unified-card">
        <StackPane styleClass="auth-section-icon"><Label text="✉"/></StackPane>
        <Label text="Yahoo Email Setup" styleClass="auth-title"/>
        <Label text="Required for secure OTP sign-in and optional invoice emails." styleClass="auth-description"/>
        <VBox spacing="5" maxWidth="600"><Label text="Yahoo email address *" styleClass="auth-field-label"/><TextField fx:id="txtSmtpEmail" promptText="name@yahoo.com" styleClass="auth-input"/><Label fx:id="lblEmailError" managed="false" visible="false" styleClass="field-error"/></VBox>
        <VBox spacing="5" maxWidth="600"><Label text="Yahoo app password *" styleClass="auth-field-label"/><PasswordField fx:id="txtSmtpPassword" promptText="Yahoo app password" styleClass="auth-input"/><Label fx:id="lblPasswordError" managed="false" visible="false" styleClass="field-error"/></VBox>
        <HBox spacing="12" maxWidth="600" alignment="CENTER_LEFT" styleClass="auth-info-box"><Label text="i" styleClass="auth-info-icon"/><Label text="Create this in Yahoo Account Security → Generate app password. Your normal Yahoo password will not work." wrapText="true" HBox.hgrow="ALWAYS"/></HBox>
        <Button fx:id="btnSave" text="Save Email Settings" onAction="#save" maxWidth="360" styleClass="auth-primary-button"/>
        <Button fx:id="btnBack" text="Back to login" onAction="#back" maxWidth="220" styleClass="auth-secondary-button"/>
        <Label fx:id="lblMessage" wrapText="true" maxWidth="600" styleClass="auth-message"/>
    </VBox></StackPane></center>
    <bottom><SharedApplicationFooter/></bottom>
</BorderPane>
