<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.image.ImageView?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import org.example.ui.SharedApplicationFooter?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.RegistrationController" styleClass="auth-page,auth-standard-shell,approved-ui,approved-screen,approved-screen-registration,erp-screen-root">
<left><VBox fx:id="brandPanel" alignment="CENTER" spacing="18" styleClass="auth-brand-panel,auth-unified-brand-panel"><Region VBox.vgrow="ALWAYS"/><StackPane fx:id="brandLogoBox" minHeight="118" prefHeight="118" maxWidth="520" styleClass="auth-company-logo-box"><ImageView fx:id="imgBrandLogo" preserveRatio="false" smooth="true" managed="false" visible="false"/></StackPane><StackPane fx:id="brandMarkBox" managed="false" visible="false" styleClass="auth-logo-badge"><ImageView fx:id="imgBrandMark" preserveRatio="true" fitWidth="58" fitHeight="58" smooth="true"/><Label fx:id="lblBrandMark" text="◆" managed="false" visible="false" styleClass="auth-logo-mark"/></StackPane><Label fx:id="lblBrandName" text="DSE ERP" styleClass="auth-brand-title"/><Region prefHeight="2" maxWidth="80" styleClass="auth-brand-line"/><Label fx:id="lblBrandTagline" text="Business Management Suite" styleClass="auth-brand-subtitle"/><Label fx:id="lblBrandDescription" wrapText="true" textAlignment="CENTER" styleClass="auth-brand-quote"/><Region VBox.vgrow="ALWAYS"/><Label fx:id="lblVersion" text="Version" styleClass="auth-version"/></VBox></left>
<center><StackPane alignment="CENTER" styleClass="registration-center-host"><VBox maxWidth="860" spacing="10" alignment="CENTER" styleClass="auth-card,auth-unified-card,registration-card,registration-no-scroll"><Label text="Create New Account" styleClass="auth-title"/><Label text="Non-Admin registration: CAPTCHA → Email OTP → Authenticator → Admin approval" wrapText="true" styleClass="auth-description"/><GridPane hgap="14" vgap="8" maxWidth="780"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><VBox spacing="4"><Label text="Full name *" styleClass="auth-field-label"/><TextField fx:id="txtName" styleClass="auth-input"/><Label fx:id="lblNameError" managed="false" visible="false" styleClass="field-error"/></VBox><VBox spacing="4" GridPane.columnIndex="1"><Label text="Username *" styleClass="auth-field-label"/><TextField fx:id="txtUsername" styleClass="auth-input"/><Label fx:id="lblUsernameError" managed="false" visible="false" styleClass="field-error"/></VBox><VBox spacing="4" GridPane.rowIndex="1" GridPane.columnSpan="2"><Label text="Email *" styleClass="auth-field-label"/><TextField fx:id="txtEmail" styleClass="auth-input"/><Label fx:id="lblEmailError" managed="false" visible="false" styleClass="field-error"/></VBox><VBox spacing="4" GridPane.rowIndex="2" GridPane.columnSpan="2"><Label text="Registration role" styleClass="auth-field-label"/><TextField fx:id="txtRole" editable="false" focusTraversable="false" promptText="Configured by Administrator" styleClass="auth-input,registration-role-readonly"/><Label fx:id="lblRoleError" managed="false" visible="false" styleClass="field-error"/></VBox><VBox spacing="4" GridPane.rowIndex="3"><Label text="Password *" styleClass="auth-field-label"/><PasswordField fx:id="txtPassword" styleClass="auth-input"/><Label fx:id="lblPasswordError" managed="false" visible="false" styleClass="field-error"/></VBox><VBox spacing="4" GridPane.rowIndex="3" GridPane.columnIndex="1"><Label text="Confirm password *" styleClass="auth-field-label"/><PasswordField fx:id="txtConfirm" styleClass="auth-input"/><Label fx:id="lblConfirmError" managed="false" visible="false" styleClass="field-error"/></VBox></GridPane>
<Separator maxWidth="780"/>
<VBox maxWidth="780" spacing="7" styleClass="registration-step-card"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Step 1 • CAPTCHA" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnRefreshCaptcha" text="Refresh" onAction="#refreshCaptcha" styleClass="approved-button,approved-secondary-button"/></HBox><Label fx:id="lblCaptchaQuestion" text="Loading CAPTCHA..." styleClass="auth-field-label"/><TextField fx:id="txtCaptcha" promptText="Answer" styleClass="auth-input"/><Label fx:id="lblCaptchaError" managed="false" visible="false" styleClass="field-error"/><Button fx:id="btnSendOtp" text="Send email OTP" onAction="#sendOtp" maxWidth="1.7976931348623157E308" styleClass="auth-secondary-button"/></VBox>
<VBox maxWidth="780" spacing="7" styleClass="registration-step-card"><Label text="Step 2 • Email OTP" styleClass="section-title"/><TextField fx:id="txtOtp" promptText="Enter email OTP" styleClass="auth-input"/><Label fx:id="lblOtpError" managed="false" visible="false" styleClass="field-error"/><Button fx:id="btnVerifyEmail" text="Verify Email OTP" onAction="#verifyEmail" maxWidth="1.7976931348623157E308" styleClass="approved-button,approved-secondary-button"/></VBox>
<VBox maxWidth="780" spacing="6" styleClass="registration-step-card"><Label text="Step 3 • Google / Microsoft Authenticator" styleClass="section-title"/><Label fx:id="lblAuthenticatorStatus" text="Verify your email first. The QR scanner will open automatically. After authenticator verification, Submit for Admin Approval." wrapText="true" styleClass="auth-description"/></VBox>
<Button fx:id="btnBack" text="Back to login" onAction="#back" maxWidth="220" styleClass="auth-secondary-button"/><Label fx:id="lblMessage" wrapText="true" maxWidth="780" styleClass="auth-message"/></VBox></StackPane></center><bottom><SharedApplicationFooter/></bottom></BorderPane>
