<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.image.ImageView?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.RegistrationController" styleClass="auth-page,approved-ui,approved-screen,approved-screen-registration,erp-screen-root">

    <left>
        <VBox prefWidth="360" minWidth="320" alignment="CENTER" spacing="18" styleClass="auth-brand-panel">
            <StackPane minHeight="100" prefHeight="100" maxWidth="330" styleClass="auth-company-logo-box"><ImageView fx:id="imgBrandLogo" fitWidth="310" fitHeight="90" preserveRatio="true" smooth="true" managed="false" visible="false"/><Label fx:id="lblBrandMark" text="◆" styleClass="auth-logo-mark"/></StackPane>
            <Label fx:id="lblBrandName" text="DSE ERP" styleClass="auth-brand-title"/>
            <Region prefHeight="2" maxWidth="80" styleClass="auth-brand-line"/>
            <Label fx:id="lblBrandTagline" text="Business Management Suite" styleClass="auth-brand-subtitle"/>
            <Label fx:id="lblBrandDescription" text="Business Management Suite" wrapText="true" textAlignment="CENTER" styleClass="auth-brand-quote"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Version 7.3.0" styleClass="auth-version"/>
        </VBox>
    </left>

    <center><StackPane styleClass="auth-content"><VBox maxWidth="760" spacing="12" alignment="CENTER" styleClass="auth-card">
        <StackPane styleClass="auth-section-icon"><Label text="+"/></StackPane>
        <Label text="Create New Account" styleClass="auth-title"/>
        <Label text="Choose Manager or Sale. Administrator accounts remain protected." styleClass="auth-description"/>
        <GridPane hgap="14" vgap="7" maxWidth="680">
            <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
            <VBox spacing="4" GridPane.columnIndex="0"><Label text="Full name *" styleClass="auth-field-label"/><TextField fx:id="txtName" promptText="Full name" styleClass="auth-input"/><Label fx:id="lblNameError" managed="false" visible="false" styleClass="field-error"/></VBox>
            <VBox spacing="4" GridPane.columnIndex="1"><Label text="Username *" styleClass="auth-field-label"/><TextField fx:id="txtUsername" promptText="Username" styleClass="auth-input"/><Label fx:id="lblUsernameError" managed="false" visible="false" styleClass="field-error"/></VBox>
            <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnSpan="2"><Label text="Email address *" styleClass="auth-field-label"/><TextField fx:id="txtEmail" promptText="Email address" styleClass="auth-input"/><Label fx:id="lblEmailError" managed="false" visible="false" styleClass="field-error"/></VBox>
            <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnSpan="2"><Label text="Role *" styleClass="auth-field-label"/><ComboBox fx:id="cmbRole" promptText="Select role" maxWidth="1.7976931348623157E308" styleClass="auth-input"/><Label fx:id="lblRoleError" managed="false" visible="false" styleClass="field-error"/></VBox>
            <VBox spacing="4" GridPane.rowIndex="3" GridPane.columnIndex="0"><Label text="Password *" styleClass="auth-field-label"/><PasswordField fx:id="txtPassword" promptText="8+ characters, letter and number" styleClass="auth-input"/><Label fx:id="lblPasswordError" managed="false" visible="false" styleClass="field-error"/></VBox>
            <VBox spacing="4" GridPane.rowIndex="3" GridPane.columnIndex="1"><Label text="Confirm password *" styleClass="auth-field-label"/><PasswordField fx:id="txtConfirm" promptText="Confirm password" styleClass="auth-input"/><Label fx:id="lblConfirmError" managed="false" visible="false" styleClass="field-error"/></VBox>
        </GridPane>
        <Button fx:id="btnSendOtp" text="Send email OTP" onAction="#sendOtp" maxWidth="300" styleClass="auth-secondary-button,auth-email-button"/>
        <VBox spacing="4" maxWidth="680"><Label text="Verification code *" styleClass="auth-field-label"/><TextField fx:id="txtOtp" promptText="Enter OTP" styleClass="auth-input"/><Label fx:id="lblOtpError" managed="false" visible="false" styleClass="field-error"/></VBox>
        <Button fx:id="btnCreate" text="Create verified account" onAction="#register" maxWidth="380" styleClass="auth-primary-button"/>
        <Button fx:id="btnBack" text="Back to login" onAction="#back" maxWidth="220" styleClass="auth-secondary-button"/>
        <Label fx:id="lblMessage" wrapText="true" maxWidth="680" styleClass="auth-message"/>
    </VBox></StackPane></center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="auth-footer">
            <padding><Insets top="9" right="18" bottom="9" left="18"/></padding>
            <Label text="DS Engineers" styleClass="auth-footer-strong"/>
            <Label text="•"/><Label text="Phone: 9099839193"/>
            <Label text="•"/><Label text="Email: jatindhameliya1989@gmail.com"/>
            <Label text="•"/><Label text="Website: www.company.com"/>
            <Label text="•"/><Label text="GSTIN: BEEPD4909N123456"/>
            <Label text="•"/><Label text="Address: H-52 darshan Villa society, New Naroda, Ahmedabad - 382346" HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblClock" text="00:00:00" styleClass="auth-footer-clock"/>
        </HBox>
    </bottom>
</BorderPane>
