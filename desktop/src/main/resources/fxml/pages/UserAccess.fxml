<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.UserAccessController" spacing="12" styleClass="user-access-page,approved-ui,erp-screen-root">
 <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
 <HBox alignment="CENTER_LEFT" spacing="12" styleClass="ua-premium-header,erp-page-identity-header"><StackPane fx:id="userAccessPageIcon" styleClass="erp-page-header-icon"/><VBox spacing="2"><Label text="User Access &amp; Permissions" styleClass="screen-title"/><Label text="Manage users, account security and access from one administration workspace" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Manage Roles" onAction="#manageRoles" styleClass="approved-button,approved-secondary-button"/><Button text="Permission Matrix" onAction="#showPermissionMatrix" styleClass="primary-button"/><Button text="Add New User" onAction="#addUser" styleClass="primary-button,user-access-add-user"/></HBox>
 <TextField fx:id="txtSearch" managed="false"/>
 <HBox spacing="10"><VBox styleClass="user-kpi,user-kpi-purple" HBox.hgrow="ALWAYS"><Label text="Total Users" styleClass="metric-title"/><Label fx:id="lblTotal" text="0" styleClass="metric-value"/><Label fx:id="iconTotalUsers"/></VBox><VBox styleClass="user-kpi,user-kpi-green" HBox.hgrow="ALWAYS"><Label text="Active Users" styleClass="metric-title"/><Label fx:id="lblActive" text="0" styleClass="metric-value"/><Label fx:id="iconActiveUsers"/></VBox><VBox styleClass="user-kpi,user-kpi-blue" HBox.hgrow="ALWAYS"><Label text="Roles" styleClass="metric-title"/><Label fx:id="lblRoles" text="0" styleClass="metric-value"/><Label fx:id="iconRoles"/></VBox><VBox styleClass="user-kpi,user-kpi-red" HBox.hgrow="ALWAYS"><Label text="Locked Accounts" styleClass="metric-title"/><Label fx:id="lblLocked" text="0" styleClass="metric-value"/><Label fx:id="iconLocked"/></VBox><VBox styleClass="user-kpi,user-kpi-cyan" HBox.hgrow="ALWAYS"><Label text="Login Activity Today" styleClass="metric-title"/><Label fx:id="lblLogins" text="0" styleClass="metric-value"/><Label fx:id="iconLogins"/></VBox></HBox>
 <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="user-access-card,ua-full-card"><HBox alignment="CENTER_LEFT"><VBox><Label text="User Management" styleClass="section-title"/><Label text="Search, filter and manage ERP users" styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><ComboBox fx:id="cmbRole" promptText="All Roles" prefWidth="180" styleClass="approved-input"/><ComboBox fx:id="cmbStatus" prefWidth="160" styleClass="approved-input"/><ComboBox fx:id="cmbBranch" promptText="All Branches" prefWidth="180" styleClass="approved-input"/><Button text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/></HBox>
 <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="user-access-user-table,approved-table,erp-table-profile-administration"><columns><TableColumn fx:id="colUser" text="User"/><TableColumn fx:id="colEmail" text="Email / Username"/><TableColumn fx:id="colRole" text="Role"/><TableColumn fx:id="colDepartment" text="Department"/><TableColumn fx:id="colAccess" text="Access"/><TableColumn fx:id="colBranch" text="Branch"/><TableColumn fx:id="colStatus" text="Status"/><TableColumn fx:id="colLastLogin" text="Last Login"/><TableColumn fx:id="colMfa" text="MFA"/><TableColumn fx:id="colActions" text="Actions" minWidth="120" prefWidth="124" maxWidth="132" sortable="false" resizable="false"/></columns></TableView>
 <HBox spacing="8" alignment="CENTER_RIGHT"><Button text="Edit Selected" onAction="#editSelected" styleClass="approved-button,approved-secondary-button"/><Button text="Reset Password" onAction="#resetSelected" styleClass="approved-button,approved-secondary-button"/><Button text="Add New User" onAction="#addUser" styleClass="primary-button"/></HBox></VBox>
 <!-- hidden compatibility controls: roles/permissions now live on separate full pages -->
 <TabPane fx:id="accessTabs" visible="false" managed="false"><tabs><Tab fx:id="tabRoles"/><Tab fx:id="tabPermissions"/></tabs></TabPane>
 <ComboBox fx:id="cmbPermissionRole" visible="false" managed="false"/><Label fx:id="lblRoleHint" visible="false" managed="false"/>
 <TableView fx:id="roleTable" visible="false" managed="false"><columns><TableColumn fx:id="colRoleName"/><TableColumn fx:id="colRoleDescription"/><TableColumn fx:id="colRoleUsers"/><TableColumn fx:id="colRoleStatus"/><TableColumn fx:id="colRoleActions"/></columns></TableView>
 <TableView fx:id="permissionTable" visible="false" managed="false"><columns><TableColumn fx:id="colPermissionModule"/><TableColumn fx:id="colPermissionAction"/><TableColumn fx:id="colPermissionDescription"/><TableColumn fx:id="colPermissionAllowed"/></columns></TableView>
</VBox>
