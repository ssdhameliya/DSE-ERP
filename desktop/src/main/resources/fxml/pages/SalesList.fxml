<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.chart.*?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.SalesListController" styleClass="register-page,sales-register-page,approved-ui,approved-screen,approved-screen-sales-list,erp-screen-root">
  <top>
    <VBox spacing="8" styleClass="sales-register-top">
      <padding><Insets top="10" right="14" bottom="0" left="14"/></padding>

      <HBox alignment="CENTER_LEFT" spacing="12" styleClass="sales-register-hero,approved-section-header,erp-page-identity-header">
        <StackPane fx:id="salesTitleIcon" styleClass="sales-title-icon"/>
        <VBox spacing="3">
          <Label text="Sales Register" styleClass="screen-title,sales-screen-title"/>
          <Label text="Manage all sales invoices, collections and customer communication" styleClass="screen-subtitle,sales-register-subtitle-accent"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNewSale" text="New Sale (F2)" onAction="#newSale" styleClass="primary-action,sales-new-button"/>
      </HBox>

    </VBox>
  </top>

  <center>
    <SplitPane fx:id="mainSplit" dividerPositions="0.81" styleClass="register-split,sales-register-split">
      <padding><Insets top="10" right="18" bottom="14" left="0"/></padding>
      <items>
        <VBox spacing="10" minWidth="620" styleClass="register-workspace,sales-register-workspace">
          <padding><Insets top="0" right="18" bottom="0" left="18"/></padding>

          <HBox spacing="8" styleClass="sales-metric-row,sales-kpi-panel,erp-kpi-section">
            <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="sales-metric-card,sales-metric-total" HBox.hgrow="ALWAYS">
              <StackPane fx:id="totalSalesIcon" styleClass="sales-metric-icon,total-sales-icon"/>
              <VBox spacing="4">
                <Label text="Total Sales" styleClass="metric-label"/>
                <Label fx:id="lblTotalSales" styleClass="metric-value"/>
                <Label fx:id="lblInvoiceCount" styleClass="metric-note"/>
              </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="sales-metric-card,sales-metric-today" HBox.hgrow="ALWAYS">
              <StackPane fx:id="todaySalesIcon" styleClass="sales-metric-icon,today-sales-icon"/>
              <VBox spacing="4">
                <Label text="Today's Sales" styleClass="metric-label"/>
                <Label fx:id="lblTodaySales" styleClass="metric-value"/>
                <Label fx:id="lblTodayCount" styleClass="metric-note"/>
              </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="sales-metric-card,sales-metric-pending" HBox.hgrow="ALWAYS">
              <StackPane fx:id="pendingSalesIcon" styleClass="sales-metric-icon,pending-sales-icon"/>
              <VBox spacing="4">
                <Label text="Pending Receivables" styleClass="metric-label"/>
                <Label fx:id="lblPending" styleClass="metric-value"/>
                <Label fx:id="lblPendingCount" styleClass="metric-note"/>
              </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="sales-metric-card,sales-metric-overdue" HBox.hgrow="ALWAYS">
              <StackPane fx:id="overdueSalesIcon" styleClass="sales-metric-icon,overdue-sales-icon"/>
              <VBox spacing="4">
                <Label text="Overdue Receivables" styleClass="metric-label"/>
                <Label fx:id="lblOverdue" styleClass="metric-value"/>
                <Label fx:id="lblOverdueCount" styleClass="metric-note"/>
              </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="sales-metric-card,sales-metric-due" HBox.hgrow="ALWAYS">
              <StackPane fx:id="dueSoonIcon" styleClass="sales-metric-icon,due-sales-icon"/>
              <VBox spacing="4">
                <Label text="Due in 7 Days" styleClass="metric-label"/>
                <Label fx:id="lblDueSoon" styleClass="metric-value"/>
                <Label fx:id="lblDueSoonCount" styleClass="metric-note"/>
              </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="sales-metric-card,sales-metric-email" HBox.hgrow="ALWAYS">
              <StackPane fx:id="emailRateIcon" styleClass="sales-metric-icon,email-sales-icon"/>
              <VBox spacing="4">
                <Label text="Email Sent %" styleClass="metric-label"/>
                <Label fx:id="lblEmailRate" styleClass="metric-value"/>
                <Label text="All invoices" styleClass="metric-note"/>
              </VBox>
            </HBox>
          </HBox>

          <VBox spacing="10" styleClass="filter-surface,sales-filter-surface,approved-filter-bar,erp-filter-section">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
            <HBox spacing="9" alignment="CENTER_LEFT">
              <TextField fx:id="txtSearch" promptText="Search by invoice, customer, mobile or GSTIN..." prefWidth="360" HBox.hgrow="ALWAYS" styleClass="approved-input"/>
              <ToggleButton fx:id="btnAdvanced" text="Advanced Filters" selected="true" onAction="#toggleAdvanced"/>
              <MenuButton text="Saved Views" fx:id="savedViewsMenu" styleClass="approved-menu-button"/>
              <Button fx:id="btnResetFilters" text="Reset" onAction="#resetFilters" styleClass="secondary-button,sales-toolbar-button"/>
              <Button fx:id="btnRefreshSales" text="Refresh" onAction="#refresh" styleClass="secondary-button,sales-toolbar-button"/>
            </HBox>

            <GridPane fx:id="advancedFilters" hgap="12" vgap="9" styleClass="sales-filter-grid,approved-filter-bar">
              <columnConstraints>
                <ColumnConstraints percentWidth="16.66"/>
                <ColumnConstraints percentWidth="16.66"/>
                <ColumnConstraints percentWidth="16.66"/>
                <ColumnConstraints percentWidth="16.66"/>
                <ColumnConstraints percentWidth="16.66"/>
                <ColumnConstraints percentWidth="16.7"/>
              </columnConstraints>
              <VBox spacing="4"><Label text="Invoice No." styleClass="filter-label"/><TextField fx:id="txtInvoice" promptText="Enter invoice no." styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.columnIndex="1"><Label text="Customer" styleClass="filter-label"/><ComboBox fx:id="cmbCustomer" promptText="All customers" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.columnIndex="2"><Label text="From Date" styleClass="filter-label"/><DatePicker fx:id="dpFrom" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.columnIndex="3"><Label text="To Date" styleClass="filter-label"/><DatePicker fx:id="dpTo" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.columnIndex="4"><Label text="Amount From" styleClass="filter-label"/><TextField fx:id="txtAmountFrom" promptText="Min amount" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.columnIndex="5"><Label text="Amount To" styleClass="filter-label"/><TextField fx:id="txtAmountTo" promptText="Max amount" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.rowIndex="1"><Label text="Payment Status" styleClass="filter-label"/><ComboBox fx:id="cmbPaymentStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="1"><Label text="Payment Due" styleClass="filter-label"/><ComboBox fx:id="cmbPaymentDue" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="2"><Label text="Email Status" styleClass="filter-label"/><ComboBox fx:id="cmbMailStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="3"><Label text="WhatsApp Status" styleClass="filter-label"/><ComboBox fx:id="cmbWhatsappStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="4"><Label text="Invoice Type" styleClass="filter-label"/><ComboBox fx:id="cmbInvoiceType" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <HBox spacing="8" alignment="BOTTOM_RIGHT" GridPane.rowIndex="1" GridPane.columnIndex="5">
                <Button text="Save View" onAction="#saveCurrentView" styleClass="secondary-button"/>
                <Button fx:id="btnApplyFilters" text="Apply Filters" onAction="#applyFilters" styleClass="primary-action,sales-apply-button"/>
              </HBox>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="sales-quick-range-row">
              <Button fx:id="btnTodayRange" text="Today" onAction="#showToday" styleClass="sales-range-button,approved-button,approved-secondary-button"/>
              <Button fx:id="btnYesterdayRange" text="Yesterday" onAction="#showYesterday" styleClass="sales-range-button,approved-button,approved-secondary-button"/>
              <Button fx:id="btnSevenDaysRange" text="7 Days" onAction="#showSevenDays" styleClass="sales-range-button,approved-button,approved-secondary-button"/>
              <Button fx:id="btnThirtyDaysRange" text="30 Days" onAction="#showThirtyDays" styleClass="sales-range-button,approved-button,approved-secondary-button"/>
              <Button fx:id="btnCustomRange" text="Custom Range" onAction="#focusCustomRange" styleClass="sales-range-button,sales-custom-range-button,approved-button,approved-secondary-button"/>
            </HBox>

            <FlowPane fx:id="activeFilterChips" hgap="7" vgap="6" visible="false" managed="false" styleClass="sales-filter-chips,approved-filter-bar"/>
          </VBox>

          <VBox spacing="0" VBox.vgrow="ALWAYS" styleClass="sales-table-card">
            <TableView fx:id="tableSales" VBox.vgrow="ALWAYS" styleClass="professional-table,sales-register-table,erp-table-profile-register">
              <columns>
                <TableColumn fx:id="colInvoice" text="Invoice No." prefWidth="98" minWidth="88" styleClass="approved-table-column"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="82" minWidth="76" styleClass="approved-table-column"/>
                <TableColumn fx:id="colCustomer" text="Customer" prefWidth="128" minWidth="110" styleClass="approved-table-column"/>
                <TableColumn fx:id="colMobile" text="Mobile" prefWidth="92" minWidth="84" styleClass="approved-table-column"/>
                <TableColumn fx:id="colGstin" text="GSTIN" prefWidth="112" minWidth="100" styleClass="approved-table-column"/>
                <TableColumn fx:id="colTotal" text="Amount" prefWidth="96" minWidth="88" styleClass="approved-table-column"/>
                <TableColumn fx:id="colPaid" text="Paid" prefWidth="82" minWidth="74" styleClass="approved-table-column"/>
                <TableColumn fx:id="colBalance" text="Balance" prefWidth="90" minWidth="82" styleClass="approved-table-column"/>
                <TableColumn fx:id="colDue" text="Payment Due" prefWidth="102" minWidth="94" styleClass="approved-table-column"/>
                <TableColumn fx:id="colStatus" text="Document Status" prefWidth="104" minWidth="96" styleClass="approved-table-column"/>
                <TableColumn fx:id="colMail" text="Email" prefWidth="70" minWidth="64" styleClass="approved-table-column"/>
                <TableColumn fx:id="colAction" text="Actions" prefWidth="72" minWidth="68" maxWidth="76" styleClass="approved-table-column"/>
              </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="table-footer,sales-table-footer">
              <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
              <Label fx:id="lblPageInfo" styleClass="muted-text,register-record-count"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label text="Rows per page" styleClass="sales-page-label,register-page-size-label"/>
              <ComboBox fx:id="cmbPageSize" prefWidth="75" styleClass="approved-input"/>
              <Button text="|‹" onAction="#firstPage" styleClass="pager-button,approved-button,approved-secondary-button"/>
              <Button text="‹" onAction="#previousPage" styleClass="pager-button,approved-button,approved-secondary-button"/>
              <Label fx:id="lblPageNumber" styleClass="page-number"/>
              <Button text="›" onAction="#nextPage" styleClass="pager-button,approved-button,approved-secondary-button"/>
              <Button text="›|" onAction="#lastPage" styleClass="pager-button,approved-button,approved-secondary-button"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="export-bar,sales-export-bar">
              <padding><Insets top="11" right="12" bottom="11" left="12"/></padding>
              <Button fx:id="btnExportExcel" text="Export Excel" onAction="#exportSale" styleClass="secondary-button,sales-export-button"/>
              <Button fx:id="btnExportPdf" text="Export PDF" onAction="#exportRegisterPdf" styleClass="secondary-button,sales-export-button"/>
              <Button fx:id="btnPrintRegister" text="Print" onAction="#printRegister" styleClass="secondary-button,sales-export-button"/>
              <Region HBox.hgrow="ALWAYS"/>
              <HBox spacing="0" styleClass="sales-summary-strip">
                <VBox alignment="CENTER_RIGHT" styleClass="sales-summary-block">
                  <Label text="Total Amount" styleClass="summary-caption"/>
                  <Label fx:id="lblFooterTotal" styleClass="register-total-value,register-total-sales,summary-amount"/>
                </VBox>
                <VBox alignment="CENTER_RIGHT" styleClass="sales-summary-block">
                  <Label text="Total Paid" styleClass="summary-caption"/>
                  <Label fx:id="lblFooterPaid" styleClass="register-total-value,register-total-paid,summary-paid"/>
                </VBox>
                <VBox alignment="CENTER_RIGHT" styleClass="sales-summary-block,last-summary-block">
                  <Label text="Total Balance" styleClass="summary-caption"/>
                  <Label fx:id="lblFooterBalance" styleClass="register-total-value,register-total-balance,summary-balance"/>
                </VBox>
              </HBox>
            </HBox>
          </VBox>
        </VBox>

        <VBox fx:id="detailDrawer" spacing="12" prefWidth="300" minWidth="280" maxWidth="310" styleClass="detail-drawer,sales-detail-drawer">
          <padding><Insets top="16" right="14" bottom="16" left="14"/></padding>
          <HBox><Label text="Invoice Details" styleClass="drawer-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnCloseDetails" text="Close" onAction="#closeDetails" styleClass="icon-button,detail-close-button,approved-button,approved-danger-button"/></HBox>
          <Label fx:id="lblDetailInvoice" styleClass="drawer-document,sales-detail-invoice"/>
          <HBox spacing="8"><Label fx:id="lblDetailDate"/><Label fx:id="lblDetailStatus" styleClass="status-pill,approved-status"/></HBox>
          <Separator/>
          <Label text="Customer" styleClass="drawer-section"/>
          <Label fx:id="lblDetailCustomer" styleClass="drawer-customer,sales-detail-customer"/>
          <Label fx:id="lblDetailContact" wrapText="true" styleClass="muted-text,sales-detail-contact"/>
          <Separator/>
          <GridPane hgap="12" vgap="8">
            <columnConstraints>
              <ColumnConstraints percentWidth="42"/>
              <ColumnConstraints percentWidth="58"/>
            </columnConstraints>
            <Label text="Invoice Amount"/><Label fx:id="lblDetailAmount" GridPane.columnIndex="1" styleClass="drawer-money"/>
            <Label text="Paid Amount" GridPane.rowIndex="1"/><Label fx:id="lblDetailPaid" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="summary-paid"/>
            <Label text="Balance" GridPane.rowIndex="2"/><Label fx:id="lblDetailBalance" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="summary-balance"/>
            <Label text="Due Date" GridPane.rowIndex="3"/><Label fx:id="lblDetailDue" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Charges" GridPane.rowIndex="4" styleClass="sales-detail-charge-label"/>
            <Label fx:id="lblDetailCharges" text="Not Applicable" GridPane.rowIndex="4" GridPane.columnIndex="1"
                   wrapText="true" styleClass="sales-detail-charge-value"/>
          </GridPane>
          <Separator/>
          <Label text="Tax &amp; Transport" styleClass="drawer-section,sales-detail-transport-title"/>
          <GridPane hgap="10" vgap="6" styleClass="sales-detail-transport-grid">
            <columnConstraints>
              <ColumnConstraints percentWidth="42"/>
              <ColumnConstraints percentWidth="58"/>
            </columnConstraints>
            <Label text="GST Type"/><Label fx:id="lblDetailGstType" GridPane.columnIndex="1" styleClass="sales-detail-meta-value"/>
            <Label text="GSTIN" GridPane.rowIndex="1"/><Label fx:id="lblDetailGstin" GridPane.rowIndex="1" GridPane.columnIndex="1" wrapText="true" styleClass="sales-detail-meta-value"/>
            <Label text="Transporter" GridPane.rowIndex="2"/><Label fx:id="lblDetailTransporter" GridPane.rowIndex="2" GridPane.columnIndex="1" wrapText="true" styleClass="sales-detail-meta-value"/>
            <Label text="Vehicle No." GridPane.rowIndex="3"/><Label fx:id="lblDetailVehicle" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="sales-detail-meta-value"/>
          </GridPane>
          <Separator/>
          <GridPane hgap="8" vgap="8" styleClass="sales-detail-action-grid">
            <columnConstraints>
              <ColumnConstraints percentWidth="50"/>
              <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <Button text="Send Email" onAction="#emailSelected" maxWidth="Infinity"
                    styleClass="approved-button,approved-primary-button"/>
            <Button text="Edit Sale" onAction="#editSelectedSale" maxWidth="Infinity" GridPane.columnIndex="1"
                    styleClass="approved-button,approved-primary-button,sales-detail-edit-button"/>
            <Button text="Record Payment" onAction="#recordSelectedPayment" maxWidth="Infinity" GridPane.rowIndex="1"
                    styleClass="approved-button,approved-primary-button"/>
            <Button text="Send Reminder" onAction="#remindSelected" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"
                    styleClass="approved-button,approved-primary-button"/>
          </GridPane>
          <Region VBox.vgrow="ALWAYS"/>
          <PieChart fx:id="dueChart" visible="false" managed="false"/>
          <BarChart fx:id="customerChart" visible="false" managed="false"><xAxis><NumberAxis/></xAxis><yAxis><CategoryAxis/></yAxis></BarChart>
          <LineChart fx:id="salesChart" visible="false" managed="false"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis/></yAxis></LineChart>
        </VBox>
      </items>
    </SplitPane>
  </center>
</BorderPane>