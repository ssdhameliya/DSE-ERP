<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.chart.*?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.SalesListController" styleClass="register-page,sales-register-page,approved-ui,approved-screen,approved-screen-sales-list,erp-screen-root">
  <top>
    <VBox spacing="8" styleClass="sales-register-top">
      <padding><Insets top="10" right="14" bottom="4" left="14"/></padding>

      <HBox alignment="CENTER_LEFT" spacing="12" styleClass="sales-register-hero,approved-section-header,erp-page-identity-header">
        <StackPane fx:id="salesTitleIcon" styleClass="sales-title-icon"/>
        <VBox spacing="3">
          <Label text="Sales Register" styleClass="screen-title,sales-screen-title"/>
          <Label text="Manage all sales invoices, collections and customer communication" styleClass="screen-subtitle,sales-register-subtitle-accent"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <StackPane prefWidth="340" minWidth="240" maxWidth="360" styleClass="erp-item-search-shell,register-header-search-shell,sales-header-search-shell">
          <TextField fx:id="txtSearch" promptText="Search invoice, customer, mobile or GSTIN..." maxWidth="Infinity" styleClass="approved-input,erp-item-search,register-header-search-input"/>
          <StackPane fx:id="salesHeaderSearchIcon" mouseTransparent="true" minWidth="24" prefWidth="24" maxWidth="24" minHeight="24" prefHeight="24" maxHeight="24" StackPane.alignment="CENTER_RIGHT" styleClass="erp-item-search-icon-box,register-header-search-icon">
            <StackPane.margin><Insets right="8"/></StackPane.margin>
          </StackPane>
        </StackPane>
        <Button fx:id="btnNewSale" text="New Sale" onAction="#newSale" styleClass="primary-action,sales-new-button"/>
      </HBox>

    </VBox>
  </top>

  <center>
    <SplitPane fx:id="mainSplit" dividerPositions="0.81" styleClass="register-split,sales-register-split">

      <items>
        <VBox spacing="10" minWidth="620" styleClass="register-workspace,sales-register-workspace">
          <padding><Insets top="0" right="12" bottom="0" left="0"/></padding>

          <HBox spacing="8" styleClass="sales-metric-row,sales-kpi-panel,erp-kpi-section">
            <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="sales-metric-card,sales-metric-total" HBox.hgrow="ALWAYS">
              <StackPane fx:id="totalSalesIcon" styleClass="sales-metric-icon,total-sales-icon"/>
              <VBox spacing="4">
                <Label text="Active Sales" styleClass="metric-label"/>
                <Label fx:id="lblTotalSales" styleClass="metric-value"/>
                <Label fx:id="lblInvoiceCount" styleClass="metric-note"/>
              </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="sales-metric-card,sales-metric-today" HBox.hgrow="ALWAYS">
              <StackPane fx:id="todaySalesIcon" styleClass="sales-metric-icon,today-sales-icon"/>
              <VBox spacing="4">
                <Label text="Today's Sales" styleClass="metric-label"/>
                <Label fx:id="lblTodaySales" styleClass="metric-value"/>
                <Label fx:id="lblTodayCount" styleClass="metric-note"/>
              </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="sales-metric-card,sales-metric-pending" HBox.hgrow="ALWAYS">
              <StackPane fx:id="pendingSalesIcon" styleClass="sales-metric-icon,pending-sales-icon"/>
              <VBox spacing="4">
                <Label text="Pending Receivables" styleClass="metric-label"/>
                <Label fx:id="lblPending" styleClass="metric-value"/>
                <Label fx:id="lblPendingCount" styleClass="metric-note"/>
              </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="sales-metric-card,sales-metric-overdue" HBox.hgrow="ALWAYS">
              <StackPane fx:id="overdueSalesIcon" styleClass="sales-metric-icon,overdue-sales-icon"/>
              <VBox spacing="4">
                <Label text="Overdue Receivables" styleClass="metric-label"/>
                <Label fx:id="lblOverdue" styleClass="metric-value"/>
                <Label fx:id="lblOverdueCount" styleClass="metric-note"/>
              </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="sales-metric-card,sales-metric-due" HBox.hgrow="ALWAYS">
              <StackPane fx:id="dueSoonIcon" styleClass="sales-metric-icon,due-sales-icon"/>
              <VBox spacing="4">
                <Label text="Due in 7 Days" styleClass="metric-label"/>
                <Label fx:id="lblDueSoon" styleClass="metric-value"/>
                <Label fx:id="lblDueSoonCount" styleClass="metric-note"/>
              </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" styleClass="sales-metric-card,sales-metric-email" HBox.hgrow="ALWAYS">
              <StackPane fx:id="emailRateIcon" styleClass="sales-metric-icon,email-sales-icon"/>
              <VBox spacing="4">
                <Label text="Email Sent %" styleClass="metric-label"/>
                <Label fx:id="lblEmailRate" styleClass="metric-value"/>
                <Label text="All invoices" styleClass="metric-note"/>
              </VBox>
            </HBox>
          </HBox>

          <VBox spacing="10" styleClass="filter-surface,sales-filter-surface,approved-filter-bar,erp-filter-section">
            <GridPane hgap="10" vgap="7" styleClass="register-visible-filter-grid,sales-visible-filter-grid">
              <columnConstraints>
                <ColumnConstraints percentWidth="22"/>
                <ColumnConstraints percentWidth="16"/>
                <ColumnConstraints percentWidth="16"/>
                <ColumnConstraints percentWidth="22"/>
                <ColumnConstraints percentWidth="24"/>
              </columnConstraints>
              <VBox spacing="4"><Label text="Customer" styleClass="filter-label,filter-label-customer"/><ComboBox fx:id="cmbCustomer" promptText="All customers" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.columnIndex="1"><Label text="From Date" styleClass="filter-label,filter-label-date"/><DatePicker fx:id="dpFrom" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.columnIndex="2"><Label text="To Date" styleClass="filter-label,filter-label-date"/><DatePicker fx:id="dpTo" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.columnIndex="3"><Label text="Document Status" styleClass="filter-label,filter-label-document"/><ComboBox fx:id="cmbDocumentStatus" promptText="Document Status" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.columnIndex="4"><Label text="Payment Status" styleClass="filter-label,filter-label-payment"/><ComboBox fx:id="cmbPaymentStatus" promptText="Payment Status" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            </GridPane>

            <GridPane fx:id="advancedFilters" hgap="12" vgap="9" visible="false" managed="false" styleClass="sales-filter-grid,approved-filter-bar">
              <columnConstraints><ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/></columnConstraints>
              <VBox spacing="4"><Label text="Invoice No." styleClass="filter-label"/><TextField fx:id="txtInvoice" promptText="Enter invoice no." styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.columnIndex="1"><Label text="Amount From" styleClass="filter-label"/><TextField fx:id="txtAmountFrom" promptText="Min amount" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.columnIndex="2"><Label text="Amount To" styleClass="filter-label"/><TextField fx:id="txtAmountTo" promptText="Max amount" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.columnIndex="3"><Label text="Email Status" styleClass="filter-label"/><ComboBox fx:id="cmbMailStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.columnIndex="4"><Label text="WhatsApp Status" styleClass="filter-label"/><ComboBox fx:id="cmbWhatsappStatus" maxWidth="Infinity" styleClass="approved-input"/></VBox>
              <VBox spacing="4" GridPane.rowIndex="1"><Label text="Invoice Type" styleClass="filter-label"/><ComboBox fx:id="cmbInvoiceType" maxWidth="Infinity" styleClass="approved-input"/></VBox>
            </GridPane>

            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="sales-quick-range-row,register-quick-range-row">
              <Button fx:id="btnAllDatesRange" text="All Date" onAction="#showAllDates" styleClass="sales-range-button,quick-range-button,quick-range-all,approved-button,approved-secondary-button"/>
              <Button fx:id="btnTodayRange" text="Today" onAction="#showToday" styleClass="quick-range-today,sales-range-button,quick-range-button,quick-range-today,approved-button,approved-secondary-button"/>
              <Button fx:id="btnYesterdayRange" text="Yesterday" onAction="#showYesterday" styleClass="quick-range-yesterday,sales-range-button,quick-range-button,quick-range-yesterday,approved-button,approved-secondary-button"/>
              <Button fx:id="btnSevenDaysRange" text="7 Days" onAction="#showSevenDays" styleClass="sales-range-button,quick-range-button,quick-range-seven,approved-button,approved-secondary-button"/>
              <Button fx:id="btnThirtyDaysRange" text="30 Days" onAction="#showThirtyDays" styleClass="sales-range-button,quick-range-button,quick-range-thirty,approved-button,approved-secondary-button"/>
              <Button fx:id="btnCustomRange" text="Custom Range" onAction="#focusCustomRange" visible="false" managed="false" styleClass="sales-range-button,sales-custom-range-button,approved-button,approved-secondary-button"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Button fx:id="btnResetFilters" text="Reset" onAction="#resetFilters" styleClass="register-action-button,register-reset-button"/>
              <Button fx:id="btnRefreshSales" text="Refresh" onAction="#refreshWithFeedback" styleClass="register-action-button,register-refresh-button"/>
            </HBox>

            <FlowPane fx:id="activeFilterChips" hgap="7" vgap="6" visible="false" managed="false" styleClass="sales-filter-chips,approved-filter-bar"/>
          </VBox>

          <VBox spacing="0" minHeight="0" VBox.vgrow="ALWAYS" styleClass="sales-table-card">
            <TableView fx:id="tableSales" minHeight="0" VBox.vgrow="ALWAYS" styleClass="professional-table,sales-register-table,erp-table-profile-register">
              <columns>
                <TableColumn fx:id="colInvoice" text="Invoice No." styleClass="approved-table-column"/>
                <TableColumn fx:id="colDate" text="Date" styleClass="approved-table-column"/>
                <TableColumn fx:id="colCustomer" text="Customer" styleClass="approved-table-column"/>
                <TableColumn fx:id="colMobile" text="Mobile" styleClass="approved-table-column"/>
                <TableColumn fx:id="colGstin" text="GSTIN" styleClass="approved-table-column"/>
                <TableColumn fx:id="colTotal" text="Amount" styleClass="approved-table-column"/>
                <TableColumn fx:id="colPaid" text="Paid" styleClass="approved-table-column"/>
                <TableColumn fx:id="colBalance" text="Pending" styleClass="approved-table-column"/>
                <TableColumn fx:id="colDue" text="Payment Due" styleClass="approved-table-column"/>
                <TableColumn fx:id="colStatus" text="Document Status" styleClass="approved-table-column"/>
                <TableColumn fx:id="colPaymentStatus" text="Payment Status" styleClass="approved-table-column"/>
                <TableColumn fx:id="colReturnStatus" text="Return Status" styleClass="approved-table-column"/>
                <TableColumn fx:id="colMail" text="Email" styleClass="approved-table-column"/>
                <TableColumn fx:id="colAction" text="Actions" styleClass="approved-table-column" sortable="false" resizable="false"/>
              </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="table-footer,sales-table-footer">
              <Label fx:id="lblPageInfo" styleClass="muted-text,register-record-count"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label text="Rows per page" styleClass="sales-page-label,register-page-size-label"/>
              <ComboBox fx:id="cmbPageSize" prefWidth="92" styleClass="approved-input"/>
              <Button text="|‹" onAction="#firstPage" styleClass="pager-button,approved-button,approved-secondary-button"/>
              <Button text="‹" onAction="#previousPage" styleClass="pager-button,approved-button,approved-secondary-button"/>
              <Label fx:id="lblPageNumber" styleClass="page-number"/>
              <Button text="›" onAction="#nextPage" styleClass="pager-button,approved-button,approved-secondary-button"/>
              <Button text="›|" onAction="#lastPage" styleClass="pager-button,approved-button,approved-secondary-button"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="export-bar,sales-export-bar">
              <Button fx:id="btnExportExcel" text="Export Excel" onAction="#exportSale" styleClass="secondary-button,sales-export-button"/>
              <Button fx:id="btnExportPdf" text="Export PDF" onAction="#exportRegisterPdf" styleClass="secondary-button,sales-export-button"/>
              <Button fx:id="btnPrintRegister" text="Print" onAction="#printRegister" styleClass="secondary-button,sales-export-button"/>
              <Region HBox.hgrow="ALWAYS"/>
              <HBox spacing="0" styleClass="sales-summary-strip">
                <VBox alignment="CENTER_RIGHT" styleClass="sales-summary-block">
                  <Label text="Total Amount" styleClass="summary-caption"/>
                  <Label fx:id="lblFooterTotal" styleClass="register-total-value,register-total-sales,summary-amount"/>
                </VBox>
                <VBox alignment="CENTER_RIGHT" styleClass="sales-summary-block">
                  <Label text="Total Paid" styleClass="summary-caption"/>
                  <Label fx:id="lblFooterPaid" styleClass="register-total-value,register-total-paid,summary-paid"/>
                </VBox>
                <VBox alignment="CENTER_RIGHT" styleClass="sales-summary-block,last-summary-block">
                  <Label text="Total Pending" styleClass="summary-caption"/>
                  <Label fx:id="lblFooterBalance" styleClass="register-total-value,register-total-balance,summary-balance"/>
                </VBox>
              </HBox>
            </HBox>
          </VBox>
        </VBox>

        <VBox fx:id="detailDrawer" spacing="8" prefWidth="350" minWidth="320" maxWidth="390" minHeight="0" styleClass="detail-drawer,erp-detail-drawer-card,sales-detail-drawer,sales-detail-sheet">
          <HBox alignment="CENTER_LEFT" spacing="8" styleClass="sales-detail-fixed-header"><Label text="Invoice Details" styleClass="drawer-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnCloseDetails" text="Close" onAction="#closeDetails" styleClass="icon-button,detail-close-button,approved-button,approved-danger-button"/></HBox>
          <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sales-detail-identity"><VBox spacing="2" HBox.hgrow="ALWAYS"><Label fx:id="lblDetailInvoice" styleClass="drawer-document,sales-detail-invoice"/><Label fx:id="lblDetailCustomer" wrapText="true" styleClass="drawer-customer,sales-detail-customer"/><Label fx:id="lblDetailContact" wrapText="true" styleClass="muted-text,sales-detail-contact"/></VBox><VBox alignment="TOP_RIGHT" spacing="4"><Label fx:id="lblDetailDate"/><Label fx:id="lblDetailStatus" styleClass="status-pill,approved-status"/></VBox></HBox>
          <Separator/>
          <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="sales-detail-scroll,erp-inner-scroll">
            <content>
              <VBox spacing="10" fillWidth="true">
                <Label text="Amount &amp; Tax" styleClass="drawer-section"/>
                <GridPane hgap="10" vgap="7" styleClass="sales-detail-sheet-grid,sales-detail-two-column"><columnConstraints><ColumnConstraints percentWidth="43"/><ColumnConstraints percentWidth="57"/></columnConstraints>
                  <Label fx:id="capInvoiceAmount" text="Invoice Amount"/><Label fx:id="lblDetailAmount" GridPane.columnIndex="1" styleClass="drawer-money"/>
                  <Label fx:id="capPaidAmount" text="Paid Amount" GridPane.rowIndex="1"/><Label fx:id="lblDetailPaid" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="summary-paid"/>
                  <Label fx:id="capBalance" text="Pending" GridPane.rowIndex="2"/><Label fx:id="lblDetailBalance" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="summary-balance"/>
                  <Label fx:id="capDueDate" text="Due Date" GridPane.rowIndex="3"/><Label fx:id="lblDetailDue" GridPane.rowIndex="3" GridPane.columnIndex="1" wrapText="true"/>
                  <Label fx:id="capGstAmount" text="GST Amount" GridPane.rowIndex="4"/><Label fx:id="lblDetailGstAmount" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                  <Label fx:id="capTotalCharges" text="Total Charges" GridPane.rowIndex="5"/><Label fx:id="lblDetailTotalCharges" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                  <Label fx:id="capChargeGst" text="Charge GST" GridPane.rowIndex="6"/><Label fx:id="lblDetailChargeTax" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                  <Label fx:id="capCharges" text="Charges" GridPane.rowIndex="7"/><Label fx:id="lblDetailCharges" text="Not Applicable" GridPane.rowIndex="7" GridPane.columnIndex="1" wrapText="true"/>
                </GridPane>
                <Separator/>
                <Label text="Customer &amp; Addresses" styleClass="drawer-section"/>
                <GridPane hgap="10" vgap="8" styleClass="sales-detail-sheet-grid,sales-detail-two-column"><columnConstraints><ColumnConstraints percentWidth="43"/><ColumnConstraints percentWidth="57"/></columnConstraints>
                  <Label fx:id="capBillingAddress" text="Billing Address"/><Label fx:id="lblDetailBillingAddress" GridPane.columnIndex="1" wrapText="true"/>
                  <Label fx:id="capDeliveryAddress" text="Shipping Address" GridPane.rowIndex="1"/><Label fx:id="lblDetailDeliveryAddress" GridPane.rowIndex="1" GridPane.columnIndex="1" wrapText="true"/>
                </GridPane>
                <Separator/>
                <Label text="Tax &amp; Transport" styleClass="drawer-section"/>
                <GridPane hgap="10" vgap="7" styleClass="sales-detail-sheet-grid,sales-detail-two-column"><columnConstraints><ColumnConstraints percentWidth="43"/><ColumnConstraints percentWidth="57"/></columnConstraints>
                  <Label fx:id="capGstType" text="GST Type"/><Label fx:id="lblDetailGstType" GridPane.columnIndex="1" wrapText="true"/>
                  <Label fx:id="capGstin" text="GSTIN" GridPane.rowIndex="1"/><Label fx:id="lblDetailGstin" GridPane.rowIndex="1" GridPane.columnIndex="1" wrapText="true"/>
                  <Label fx:id="capTransporter" text="Transporter" GridPane.rowIndex="2"/><Label fx:id="lblDetailTransporter" GridPane.rowIndex="2" GridPane.columnIndex="1" wrapText="true"/>
                  <Label text="Door Delivery" GridPane.rowIndex="3"/><Label fx:id="lblDetailDoorDelivery" GridPane.rowIndex="3" GridPane.columnIndex="1" wrapText="true"/>
                  <Label fx:id="capVehicle" text="Vehicle No." GridPane.rowIndex="4"/><Label fx:id="lblDetailVehicle" GridPane.rowIndex="4" GridPane.columnIndex="1" wrapText="true"/>
                  <Label fx:id="capContactPerson" text="Contact Person" GridPane.rowIndex="5"/><Label fx:id="lblDetailContactPerson" GridPane.rowIndex="5" GridPane.columnIndex="1" wrapText="true"/>
                  <Label fx:id="capContactMobile" text="Contact Mobile" GridPane.rowIndex="6"/><Label fx:id="lblDetailContactMobile" GridPane.rowIndex="6" GridPane.columnIndex="1" wrapText="true"/>
                </GridPane>
                <Separator/>
                <VBox fx:id="approvalActionBox" spacing="7" visible="false" managed="false" styleClass="sales-approval-card">
                  <Label text="Admin Approval" styleClass="drawer-section"/>
                  <Label text="This record is waiting for Admin approval. Stock has not been posted yet." wrapText="true" styleClass="sales-approval-note"/>
                  <HBox spacing="8"><Button fx:id="btnApproveSale" text="Approve" onAction="#approveSelectedSale" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="approved-button,approved-success-button"/><Button fx:id="btnRejectSale" text="Reject" onAction="#rejectSelectedSale" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="approved-button,approved-danger-button"/></HBox>
                </VBox>
                <Label text="Quick Actions" styleClass="drawer-section"/>
                <GridPane hgap="8" vgap="8" styleClass="sales-detail-action-grid"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                  <Button text="Send Email" onAction="#emailSelected" maxWidth="Infinity" styleClass="approved-button,approved-primary-button"/><Button text="Edit Sale" onAction="#editSelectedSale" maxWidth="Infinity" GridPane.columnIndex="1" styleClass="approved-button,approved-primary-button"/>
                  <Button text="Record Payment" onAction="#recordSelectedPayment" maxWidth="Infinity" GridPane.rowIndex="1" styleClass="approved-button,approved-primary-button"/><Button text="Excel" onAction="#excelSelected" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="approved-button,approved-secondary-button"/>
                </GridPane>
              </VBox>
            </content>
          </ScrollPane>
          <PieChart fx:id="dueChart" visible="false" managed="false"/><BarChart fx:id="customerChart" visible="false" managed="false"><xAxis><NumberAxis/></xAxis><yAxis><CategoryAxis/></yAxis></BarChart><LineChart fx:id="salesChart" visible="false" managed="false"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis/></yAxis></LineChart>
        </VBox>
      </items>
    </SplitPane>
  </center>
</BorderPane>
