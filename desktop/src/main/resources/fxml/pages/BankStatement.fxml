<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.BankStatementController" styleClass="bank-recon-root,approved-screen,erp-screen-root">
  <top>
    <VBox spacing="10" styleClass="bank-recon-top-stack">
      <HBox alignment="CENTER_LEFT" spacing="12" styleClass="bank-recon-header,approved-page-header,erp-page-identity-header">
        <StackPane fx:id="pageIcon" prefWidth="42" prefHeight="42" styleClass="approved-page-icon,bank-recon-page-icon"/>
        <VBox spacing="2">
          <Label text="Bank Statement" styleClass="approved-page-title"/>
          <Label text="Review and reconcile imported bank transactions" styleClass="approved-page-subtitle,bank-recon-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox spacing="3" minWidth="300">
          <Label text="Statement / Bank Account" styleClass="bank-recon-field-caption"/>
          <ComboBox fx:id="cmbBatch" prefWidth="300" promptText="Select imported statement"/>
        </VBox>
        <Button fx:id="btnImport" text="Import Statement" onAction="#importStatement" styleClass="approved-button,approved-primary-button,bank-recon-import-button"/>
      </HBox>

      <GridPane hgap="10" vgap="0" styleClass="bank-recon-kpi-panel">
        <columnConstraints>
          <ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/>
          <ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/>
        </columnConstraints>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-blue" GridPane.columnIndex="0"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiTotalIcon" styleClass="bank-recon-kpi-icon"/><Label text="Total Transactions" styleClass="bank-recon-kpi-caption"/></HBox><Label fx:id="kpiTotal" text="0" styleClass="bank-recon-kpi-value"/><Label text="Imported rows" styleClass="bank-recon-kpi-note"/></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-red" GridPane.columnIndex="1"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiUnmatchedIcon" styleClass="bank-recon-kpi-icon"/><Label text="Unmatched" styleClass="bank-recon-kpi-caption"/></HBox><Label fx:id="kpiUnmatched" text="0" styleClass="bank-recon-kpi-value"/><Label text="Needs reconciliation" styleClass="bank-recon-kpi-note"/></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-orange" GridPane.columnIndex="2"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiSuggestedIcon" styleClass="bank-recon-kpi-icon"/><Label text="Suggested" styleClass="bank-recon-kpi-caption"/></HBox><Label fx:id="kpiSuggested" text="0" styleClass="bank-recon-kpi-value"/><Label text="System suggestions" styleClass="bank-recon-kpi-note"/></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-green" GridPane.columnIndex="3"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiMatchedIcon" styleClass="bank-recon-kpi-icon"/><Label text="Matched" styleClass="bank-recon-kpi-caption"/></HBox><Label fx:id="kpiMatched" text="0" styleClass="bank-recon-kpi-value"/><Label text="Linked to ERP" styleClass="bank-recon-kpi-note"/></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-purple" GridPane.columnIndex="4"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiExpenseIcon" styleClass="bank-recon-kpi-icon"/><Label text="Expenses" styleClass="bank-recon-kpi-caption"/></HBox><Label fx:id="kpiExpense" text="0" styleClass="bank-recon-kpi-value"/><Label text="Expense entries" styleClass="bank-recon-kpi-note"/></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-green" GridPane.columnIndex="5"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiCreditsIcon" styleClass="bank-recon-kpi-icon"/><Label text="Total Credits" styleClass="bank-recon-kpi-caption"/></HBox><Label fx:id="kpiCredits" text="0.00" styleClass="bank-recon-kpi-value"/><Label text="Money in" styleClass="bank-recon-kpi-note"/></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-red" GridPane.columnIndex="6"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiDebitsIcon" styleClass="bank-recon-kpi-icon"/><Label text="Total Debits" styleClass="bank-recon-kpi-caption"/></HBox><Label fx:id="kpiDebits" text="0.00" styleClass="bank-recon-kpi-value"/><Label text="Money out" styleClass="bank-recon-kpi-note"/></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-teal" GridPane.columnIndex="7"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiReconciledIcon" styleClass="bank-recon-kpi-icon"/><Label text="Reconciled" styleClass="bank-recon-kpi-caption"/></HBox><Label fx:id="kpiReconciled" text="0.0%" styleClass="bank-recon-kpi-value"/><Label text="Batch completion" styleClass="bank-recon-kpi-note"/></VBox>
      </GridPane>
    </VBox>
  </top>

  <center>
    <HBox spacing="10" styleClass="bank-recon-workspace">
      <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="bank-recon-main-panel">
        <VBox spacing="8" styleClass="bank-recon-filter-panel">
          <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch" promptText="Search narration, reference, amount..." HBox.hgrow="ALWAYS" onAction="#applyFilters"/>
            <Button fx:id="btnSearch" text="Search" onAction="#applyFilters" styleClass="approved-button,approved-primary-button"/>
            <Button fx:id="btnReset" text="Reset" onAction="#resetFilters" styleClass="approved-button,approved-secondary-button"/>
            <Button fx:id="btnRefresh" text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/>
          </HBox>
          <HBox spacing="10" alignment="CENTER_LEFT" styleClass="bank-bulk-toolbar">
            <CheckBox fx:id="chkSelectAll" text="Select all visible" onAction="#selectAllVisible"/>
            <Label fx:id="lblSelected" text="0 selected" styleClass="bank-recon-progress-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <MenuButton fx:id="bulkActions" text="Bulk Actions" disable="true" styleClass="approved-button,approved-secondary-button,erp-action-toolbar-menu">
              <items>
                <MenuItem text="Mark selected for review" onAction="#bulkMarkReview"/>
                <MenuItem text="Ignore selected" onAction="#bulkIgnore"/>
              </items>
            </MenuButton>
          </HBox>
          <HBox spacing="8" alignment="CENTER_LEFT">
            <VBox spacing="2" HBox.hgrow="ALWAYS"><Label text="From Date" styleClass="bank-recon-field-caption"/><DatePicker fx:id="fromDate" promptText="From" maxWidth="Infinity"/></VBox>
            <VBox spacing="2" HBox.hgrow="ALWAYS"><Label text="To Date" styleClass="bank-recon-field-caption"/><DatePicker fx:id="toDate" promptText="To" maxWidth="Infinity"/></VBox>
            <VBox spacing="2" HBox.hgrow="ALWAYS"><Label text="Reconciliation Status" styleClass="bank-recon-field-caption"/><ComboBox fx:id="cmbStatus" maxWidth="Infinity"/></VBox>
            <VBox spacing="2" minWidth="135"><Label text="Transaction Type" styleClass="bank-recon-field-caption"/><ComboBox fx:id="cmbDirection" maxWidth="Infinity"/></VBox>
            <VBox spacing="2" minWidth="210"><Label text="Batch Progress" styleClass="bank-recon-field-caption"/><HBox alignment="CENTER_LEFT" spacing="8"><ProgressBar fx:id="reconciliationProgress" HBox.hgrow="ALWAYS" maxWidth="Infinity" progress="0"/><Label fx:id="lblProgressText" text="0 / 0 reconciled" styleClass="bank-recon-progress-label"/></HBox></VBox>
          </HBox>
        </VBox>

        <VBox VBox.vgrow="ALWAYS" styleClass="bank-recon-table-panel">
          <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="approved-table,bank-recon-table,erp-table-profile-responsive">
            <columns>
              <TableColumn fx:id="colSelect" text="" prefWidth="54" sortable="false"/>
              <TableColumn fx:id="colDate" text="Date" prefWidth="92"/>
              <TableColumn fx:id="colValueDate" text="Value Date" prefWidth="92"/>
              <TableColumn fx:id="colReference" text="Reference / Cheque No." prefWidth="145"/>
              <TableColumn fx:id="colDescription" text="Description / Narration" prefWidth="225"/>
              <TableColumn fx:id="colDebit" text="Debit" prefWidth="92"/>
              <TableColumn fx:id="colCredit" text="Credit" prefWidth="92"/>
              <TableColumn fx:id="colBalance" text="Balance" prefWidth="105"/>
              <TableColumn fx:id="colStatus" text="Status" prefWidth="105"/>
              <TableColumn fx:id="colMatch" text="Match / Link" prefWidth="135"/>
              <TableColumn fx:id="colAction" text="Actions" minWidth="156" prefWidth="160" maxWidth="168" sortable="false" resizable="false"/>
            </columns>
            <placeholder><VBox alignment="CENTER" spacing="8"><Label text="No bank statement transactions to display" styleClass="bank-recon-empty-title"/><Label text="Import a CSV statement or select an existing statement batch." styleClass="bank-recon-empty-note"/></VBox></placeholder>
          </TableView>
          <HBox alignment="CENTER_LEFT" spacing="10" styleClass="bank-recon-footer">
            <Label fx:id="lblShowing" text="Showing 0 records" styleClass="finance-showing-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Rows" styleClass="finance-showing-label"/>
            <ComboBox fx:id="cmbPageSize" prefWidth="82"/>
            <Button fx:id="btnPrevPage" text="Previous" onAction="#previousPage" styleClass="approved-button,approved-secondary-button"/>
            <Label fx:id="lblPage" text="Page 0 of 0" styleClass="finance-showing-label"/>
            <Button fx:id="btnNextPage" text="Next" onAction="#nextPage" styleClass="approved-button,approved-secondary-button"/>
            <Label fx:id="lblBatchStatus" text="IMPORTED" styleClass="bank-recon-status-badge"/>
          </HBox>
        </VBox>

        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="bank-recon-how-panel">
          <StackPane fx:id="howIcon" styleClass="bank-recon-how-icon"/>
          <Label text="How Matching Works:" styleClass="bank-recon-how-title"/>
          <Label text="Match Transaction  →  DSE ERP searches automatically  →  Review Suggested Match  →  Confirm or Find Another  →  Bank Entry / Expense Entry is linked." wrapText="true" styleClass="bank-recon-how-text"/>
        </HBox>
      </VBox>

      <VBox spacing="10" prefWidth="260" minWidth="240" maxWidth="280" styleClass="bank-recon-flow-panel">
        <Label text="BANK RECONCILIATION FLOW" styleClass="bank-recon-flow-title"/>
        <VBox spacing="6" styleClass="bank-flow-step,bank-flow-blue"><HBox spacing="8" alignment="CENTER_LEFT"><StackPane fx:id="flowImportIcon" styleClass="bank-flow-icon"/><Label text="1  Import Statement" styleClass="bank-flow-step-title"/></HBox><Label text="Import the bank statement CSV through Data Import or this screen." wrapText="true" styleClass="bank-flow-step-note"/></VBox>
        <Label text="↓" styleClass="bank-flow-arrow"/>
        <VBox spacing="6" styleClass="bank-flow-step,bank-flow-orange"><HBox spacing="8" alignment="CENTER_LEFT"><StackPane fx:id="flowReviewIcon" styleClass="bank-flow-icon"/><Label text="2  Review Statement" styleClass="bank-flow-step-title"/></HBox><Label text="Review transactions and DSE ERP suggestions before posting." wrapText="true" styleClass="bank-flow-step-note"/></VBox>
        <Label text="↓" styleClass="bank-flow-arrow"/>
        <HBox spacing="7">
          <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="bank-flow-step,bank-flow-green"><Label text="3A  Match" styleClass="bank-flow-step-title"/><Label text="Create Bank Entry + payment allocation to Sales / Purchase." wrapText="true" styleClass="bank-flow-step-note"/></VBox>
          <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="bank-flow-step,bank-flow-purple"><Label text="3B  Expense" styleClass="bank-flow-step-title"/><Label text="Move an unmatched debit to the existing Expense Entry screen." wrapText="true" styleClass="bank-flow-step-note"/></VBox>
        </HBox>
        <Label text="↓" styleClass="bank-flow-arrow"/>
        <VBox spacing="6" styleClass="bank-flow-step,bank-flow-blue"><HBox spacing="8" alignment="CENTER_LEFT"><StackPane fx:id="flowAuditIcon" styleClass="bank-flow-icon"/><Label text="4  Audit Trail &amp; Evidence" styleClass="bank-flow-step-title"/></HBox><Label text="Imported bank evidence remains retained with complete reconciliation history." wrapText="true" styleClass="bank-flow-step-note"/></VBox>
        <VBox spacing="8" styleClass="bank-recon-status-guide">
          <Label text="Status Guide" styleClass="bank-recon-flow-title"/>
          <GridPane hgap="8" vgap="7">
            <Label text="●" styleClass="bank-dot-unmatched" GridPane.columnIndex="0" GridPane.rowIndex="0"/><Label text="UNMATCHED — needs action" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="●" styleClass="bank-dot-suggested" GridPane.columnIndex="0" GridPane.rowIndex="1"/><Label text="SUGGESTED — DSE ERP found a possible match" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="●" styleClass="bank-dot-matched" GridPane.columnIndex="0" GridPane.rowIndex="2"/><Label text="MATCHED — linked to Bank Entry and ERP transaction" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="●" styleClass="bank-dot-expense" GridPane.columnIndex="0" GridPane.rowIndex="3"/><Label text="EXPENSE — linked to Expense Entry" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Label text="●" styleClass="bank-dot-review" GridPane.columnIndex="0" GridPane.rowIndex="4"/><Label text="REVIEW — user decision required" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
          </GridPane>
        </VBox>
      </VBox>
    </HBox>
  </center>
  <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
</BorderPane>
