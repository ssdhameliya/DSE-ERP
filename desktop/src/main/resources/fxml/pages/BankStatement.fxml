<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.BankStatementController" styleClass="bank-recon-root,approved-screen,erp-screen-root">
  <top>
    <VBox spacing="10" styleClass="bank-recon-top-stack">
      <HBox alignment="CENTER_LEFT" spacing="12" styleClass="bank-recon-header,approved-page-header,erp-page-identity-header">
        <StackPane fx:id="pageIcon" prefWidth="42" prefHeight="42" styleClass="approved-page-icon,bank-recon-page-icon"/>
        <VBox spacing="2">
          <Label text="Bank Statement" styleClass="approved-page-title"/>
          <Label text="Review and reconcile imported bank transactions" styleClass="approved-page-subtitle,bank-recon-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox spacing="3" minWidth="300">
          <Label text="Statement / Bank Account" styleClass="bank-recon-field-caption"/>
          <ComboBox fx:id="cmbBatch" prefWidth="300" promptText="Select recent statement"/>
        </VBox>
        <Button fx:id="btnBrowseStatements" text="Browse Statements" onAction="#toggleStatementHistory" styleClass="approved-button,approved-secondary-button"/>
        <Button fx:id="btnDeleteStatement" text="Delete Statement" onAction="#deleteCurrentStatement" disable="true" styleClass="approved-button,approved-danger-button"/>
        <Button fx:id="btnImport" text="Import Statement" onAction="#importStatement" styleClass="approved-button,approved-primary-button,bank-recon-import-button"/>
      </HBox>

      <GridPane hgap="10" vgap="0" styleClass="bank-recon-kpi-panel">
        <columnConstraints>
          <ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/>
          <ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/><ColumnConstraints percentWidth="12.5"/>
        </columnConstraints>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-blue" GridPane.columnIndex="0"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiTotalIcon" styleClass="bank-recon-kpi-icon"/><Label text="Total Transactions" styleClass="bank-recon-kpi-caption"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiTotal" text="0" styleClass="bank-recon-kpi-value"/><Region HBox.hgrow="ALWAYS"/><Label text="Imported rows" wrapText="true" styleClass="bank-recon-kpi-note"/></HBox></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-red" GridPane.columnIndex="1"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiUnmatchedIcon" styleClass="bank-recon-kpi-icon"/><Label text="Unmatched" styleClass="bank-recon-kpi-caption"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiUnmatched" text="0" styleClass="bank-recon-kpi-value"/><Region HBox.hgrow="ALWAYS"/><Label text="Needs reconciliation" wrapText="true" styleClass="bank-recon-kpi-note"/></HBox></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-orange" GridPane.columnIndex="2"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiSuggestedIcon" styleClass="bank-recon-kpi-icon"/><Label text="Suggested" styleClass="bank-recon-kpi-caption"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiSuggested" text="0" styleClass="bank-recon-kpi-value"/><Region HBox.hgrow="ALWAYS"/><Label text="System suggestions" wrapText="true" styleClass="bank-recon-kpi-note"/></HBox></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-green" GridPane.columnIndex="3"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiMatchedIcon" styleClass="bank-recon-kpi-icon"/><Label text="Matched" styleClass="bank-recon-kpi-caption"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiMatched" text="0" styleClass="bank-recon-kpi-value"/><Region HBox.hgrow="ALWAYS"/><Label text="Linked to ERP" wrapText="true" styleClass="bank-recon-kpi-note"/></HBox></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-purple" GridPane.columnIndex="4"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiExpenseIcon" styleClass="bank-recon-kpi-icon"/><Label text="Expenses" styleClass="bank-recon-kpi-caption"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiExpense" text="0" styleClass="bank-recon-kpi-value"/><Region HBox.hgrow="ALWAYS"/><Label text="Expense entries" wrapText="true" styleClass="bank-recon-kpi-note"/></HBox></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-green" GridPane.columnIndex="5"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiCreditsIcon" styleClass="bank-recon-kpi-icon"/><Label text="Total Credits" styleClass="bank-recon-kpi-caption"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiCredits" text="0.00" styleClass="bank-recon-kpi-value"/><Region HBox.hgrow="ALWAYS"/><Label text="Money in" wrapText="true" styleClass="bank-recon-kpi-note"/></HBox></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-red" GridPane.columnIndex="6"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiDebitsIcon" styleClass="bank-recon-kpi-icon"/><Label text="Total Debits" styleClass="bank-recon-kpi-caption"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiDebits" text="0.00" styleClass="bank-recon-kpi-value"/><Region HBox.hgrow="ALWAYS"/><Label text="Money out" wrapText="true" styleClass="bank-recon-kpi-note"/></HBox></VBox>
        <VBox spacing="5" styleClass="bank-recon-kpi,kpi-teal" GridPane.columnIndex="7"><HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="kpiReconciledIcon" styleClass="bank-recon-kpi-icon"/><Label text="Reconciled" styleClass="bank-recon-kpi-caption"/></HBox><HBox alignment="BASELINE_LEFT" spacing="6"><Label fx:id="kpiReconciled" text="0.0%" styleClass="bank-recon-kpi-value"/><Region HBox.hgrow="ALWAYS"/><Label text="Batch completion" wrapText="true" styleClass="bank-recon-kpi-note"/></HBox></VBox>
      </GridPane>
    </VBox>
  </top>

  <center>
    <HBox spacing="10" styleClass="bank-recon-workspace">
      <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="bank-recon-main-panel">
        <VBox spacing="8" styleClass="bank-recon-filter-panel">
          <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch" promptText="Search narration, reference, amount..." HBox.hgrow="ALWAYS" onAction="#applyFilters"/>
            <Button fx:id="btnSearch" text="Search" onAction="#applyFilters" styleClass="approved-button,approved-primary-button"/>
            <Button fx:id="btnReset" text="Reset" onAction="#resetFilters" styleClass="approved-button,approved-secondary-button"/>
            <Button fx:id="btnRefresh" text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/>
          </HBox>
          <HBox spacing="10" alignment="CENTER_LEFT" styleClass="bank-bulk-toolbar">
            <CheckBox fx:id="chkSelectAll" text="Select all visible" onAction="#selectAllVisible" styleClass="bank-select-all"/>
            <Label fx:id="lblSelected" text="0 selected" styleClass="bank-recon-selection-count"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnBulkReview" text="Reviewed" onAction="#bulkMarkReview" disable="true" styleClass="approved-button,approved-secondary-button,bank-direct-action"/>
            <Button fx:id="btnBulkIgnore" text="Ignore" onAction="#bulkIgnore" disable="true" styleClass="approved-button,approved-secondary-button,bank-direct-action"/>
            <Button fx:id="btnMoveExpense" text="Move to Expense" onAction="#moveSelectedToExpense" disable="true" styleClass="approved-button,approved-secondary-button,bank-direct-action"/>
            <Button fx:id="btnMoveBankEntry" text="Move to Bank Entry" onAction="#moveSelectedToBankEntry" disable="true" styleClass="approved-button,approved-primary-button,bank-direct-action"/>
          </HBox>
          <HBox spacing="8" alignment="CENTER_LEFT">
            <VBox spacing="2" HBox.hgrow="ALWAYS"><Label text="From Date" styleClass="bank-recon-field-caption"/><DatePicker fx:id="fromDate" promptText="From" maxWidth="Infinity"/></VBox>
            <VBox spacing="2" HBox.hgrow="ALWAYS"><Label text="To Date" styleClass="bank-recon-field-caption"/><DatePicker fx:id="toDate" promptText="To" maxWidth="Infinity"/></VBox>
            <VBox spacing="2" HBox.hgrow="ALWAYS"><Label text="Reconciliation Status" styleClass="bank-recon-field-caption"/><ComboBox fx:id="cmbStatus" maxWidth="Infinity"/></VBox>
            <VBox spacing="2" minWidth="135"><Label text="Transaction Type" styleClass="bank-recon-field-caption"/><ComboBox fx:id="cmbDirection" maxWidth="Infinity"/></VBox>
            <VBox spacing="2" minWidth="210"><Label text="Batch Progress" styleClass="bank-recon-field-caption"/><HBox alignment="CENTER_LEFT" spacing="8"><ProgressBar fx:id="reconciliationProgress" HBox.hgrow="ALWAYS" maxWidth="Infinity" progress="0"/><Label fx:id="lblProgressText" text="0 / 0 reconciled" styleClass="bank-recon-progress-label"/></HBox></VBox>
          </HBox>
        </VBox>

        <VBox VBox.vgrow="ALWAYS" styleClass="bank-recon-table-panel">
          <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="approved-table,bank-recon-table,erp-table-profile-responsive">
            <columns>
              <TableColumn fx:id="colSelect" text="" prefWidth="54" sortable="false"/>
              <TableColumn fx:id="colDate" text="Date" prefWidth="92"/>
              <TableColumn fx:id="colValueDate" text="Value Date" prefWidth="92"/>
              <TableColumn fx:id="colReference" text="Reference / Cheque No." prefWidth="145"/>
              <TableColumn fx:id="colDescription" text="Description / Narration" prefWidth="225"/>
              <TableColumn fx:id="colDebit" text="Debit" prefWidth="92"/>
              <TableColumn fx:id="colCredit" text="Credit" prefWidth="92"/>
              <TableColumn fx:id="colBalance" text="Balance" prefWidth="105"/>
              <TableColumn fx:id="colStatus" text="Status" prefWidth="105"/>
              <TableColumn fx:id="colMatch" text="Match / Link" prefWidth="135"/>
              <TableColumn fx:id="colAction" text="Actions" minWidth="156" prefWidth="160" maxWidth="168" sortable="false" resizable="false"/>
            </columns>
            <placeholder><VBox alignment="CENTER" spacing="8"><Label text="No bank statement transactions to display" styleClass="bank-recon-empty-title"/><Label text="Import a CSV statement or select an existing statement batch." styleClass="bank-recon-empty-note"/></VBox></placeholder>
          </TableView>
          <HBox alignment="CENTER_LEFT" spacing="10" styleClass="bank-recon-footer">
            <Label fx:id="lblShowing" text="Showing 0 records" styleClass="finance-showing-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Rows" styleClass="finance-showing-label"/>
            <ComboBox fx:id="cmbPageSize" prefWidth="82"/>
            <Button fx:id="btnPrevPage" text="Previous" onAction="#previousPage" styleClass="approved-button,approved-secondary-button"/>
            <Label fx:id="lblPage" text="Page 0 of 0" styleClass="finance-showing-label"/>
            <Button fx:id="btnNextPage" text="Next" onAction="#nextPage" styleClass="approved-button,approved-secondary-button"/>
            <Label fx:id="lblBatchStatus" text="IMPORTED" styleClass="bank-recon-status-badge"/>
          </HBox>
        </VBox>

        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="bank-recon-how-panel">
          <StackPane fx:id="howIcon" styleClass="bank-recon-how-icon"/>
          <Label text="How Matching Works" styleClass="bank-recon-how-title"/>
          <Label text="Match Transaction  →  DSE ERP searches automatically  →  Review the suggestion  →  Confirm or find another  →  linked Bank / Expense Entry is stored." wrapText="true" styleClass="bank-recon-how-text"/>
        </HBox>
      </VBox>

      <VBox fx:id="statementHistoryDrawer" visible="false" managed="false" prefWidth="500" minWidth="430" maxWidth="560" spacing="10" styleClass="erp-detail-drawer-card,bank-statement-history-drawer">
        <HBox alignment="CENTER_LEFT" spacing="8"><StackPane fx:id="historyIcon" styleClass="erp-page-header-icon"/><VBox><Label text="Bank Statement History" styleClass="section-title"/><Label text="Search and open any previous import without loading the full history into the selector." wrapText="true" styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnCloseHistory" text="Close" onAction="#closeStatementHistory" styleClass="approved-button,approved-secondary-button"/></HBox>
        <TextField fx:id="txtHistorySearch" promptText="Search bank, account, filename or imported by..." onAction="#searchStatementHistory"/>
        <GridPane hgap="8" vgap="8"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
          <VBox spacing="2"><Label text="Bank / Account" styleClass="bank-recon-field-caption"/><TextField fx:id="txtHistoryAccount" promptText="Bank name or account digits"/></VBox>
          <VBox GridPane.columnIndex="1" spacing="2"><Label text="Status" styleClass="bank-recon-field-caption"/><ComboBox fx:id="cmbHistoryStatus" maxWidth="Infinity"/></VBox>
          <VBox GridPane.rowIndex="1" spacing="2"><Label text="Statement From" styleClass="bank-recon-field-caption"/><DatePicker fx:id="historyFrom" maxWidth="Infinity"/></VBox>
          <VBox GridPane.rowIndex="1" GridPane.columnIndex="1" spacing="2"><Label text="Statement To" styleClass="bank-recon-field-caption"/><DatePicker fx:id="historyTo" maxWidth="Infinity"/></VBox>
        </GridPane>
        <HBox spacing="8" alignment="CENTER_RIGHT"><Button text="Reset" onAction="#resetStatementHistory" styleClass="approved-button,approved-secondary-button"/><Button text="Search" onAction="#searchStatementHistory" styleClass="approved-button,approved-primary-button"/></HBox>
        <TableView fx:id="tableHistory" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-responsive,bank-statement-history-table"><columns><TableColumn fx:id="colHistoryImported" text="Imported" prefWidth="112"/><TableColumn fx:id="colHistoryBank" text="Bank / Account" prefWidth="150"/><TableColumn fx:id="colHistoryPeriod" text="Statement Period" prefWidth="145"/><TableColumn fx:id="colHistoryStatus" text="Status" prefWidth="125"/><TableColumn fx:id="colHistoryRows" text="Rows" prefWidth="65"/></columns></TableView>
        <HBox alignment="CENTER_LEFT" spacing="8"><Label fx:id="lblHistoryShowing" text="Showing 0 statements" styleClass="finance-showing-label"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnHistoryPrev" text="Previous" onAction="#previousStatementHistoryPage" styleClass="approved-button,approved-secondary-button"/><Label fx:id="lblHistoryPage" text="Page 0 of 0" styleClass="finance-showing-label"/><Button fx:id="btnHistoryNext" text="Next" onAction="#nextStatementHistoryPage" styleClass="approved-button,approved-secondary-button"/></HBox>
        <HBox spacing="8"><Button fx:id="btnHistoryDelete" text="Delete Statement" onAction="#deleteSelectedHistory" disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="approved-button,approved-danger-button"/><Button fx:id="btnOpenStatement" text="Open Statement" onAction="#openSelectedHistory" disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="approved-button,approved-primary-button"/></HBox>
      </VBox>

    </HBox>
  </center>
  <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
</BorderPane>
