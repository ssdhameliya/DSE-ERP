<?xml version='1.0' encoding='UTF-8'?>
<!-- Unified returns, finance, reminders and user access workspace. --><?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.OperationsController" spacing="14" styleClass="register-page,approved-ui,approved-screen,approved-screen-operations,erp-screen-root">
    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
    <VBox spacing="3"><Label text="Business Operations" styleClass="screen-title"/><Label text="Returns, expenses, payments, reminders and access control" styleClass="screen-subtitle"/></VBox>
    <HBox spacing="12">
        <VBox styleClass="metric-card,metric-blue" HBox.hgrow="ALWAYS"><Label text="Returns This Month" styleClass="metric-label"/><Label fx:id="lblReturns" styleClass="metric-value"/></VBox>
        <VBox styleClass="metric-card,metric-red" HBox.hgrow="ALWAYS"><Label text="Expenses This Month" styleClass="metric-label"/><Label fx:id="lblExpenses" styleClass="metric-value"/></VBox>
        <VBox styleClass="metric-card,metric-green" HBox.hgrow="ALWAYS"><Label text="Receipts This Month" styleClass="metric-label"/><Label fx:id="lblReceipts" styleClass="metric-value"/></VBox>
        <VBox styleClass="metric-card,metric-orange" HBox.hgrow="ALWAYS"><Label text="Open Reminders" styleClass="metric-label"/><Label fx:id="lblReminders" styleClass="metric-value"/></VBox>
    </HBox>
    <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="operations-tabs"><tabs>
        <Tab text="Returns"><content><VBox spacing="12" styleClass="operations-tab-content"><HBox alignment="CENTER_LEFT"><Label text="Sales &amp; Purchase Returns" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Record Return" onAction="#newReturn" styleClass="approved-button,approved-primary-button"/></HBox><TableView fx:id="returnTable" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="rNo" text="Return No." styleClass="approved-table-column"/><TableColumn fx:id="rType" text="Type" styleClass="approved-table-column"/><TableColumn fx:id="rDate" text="Date" styleClass="approved-table-column"/><TableColumn fx:id="rInvoice" text="Invoice" styleClass="approved-table-column"/><TableColumn fx:id="rParty" text="Party" styleClass="approved-table-column"/><TableColumn fx:id="rItem" text="Item" styleClass="approved-table-column"/><TableColumn fx:id="rQty" text="Qty" styleClass="approved-table-column"/><TableColumn fx:id="rAmount" text="Amount" styleClass="approved-table-column"/><TableColumn fx:id="rReason" text="Reason" styleClass="approved-table-column"/></columns></TableView></VBox></content></Tab>
        <Tab text="Expenses &amp; Payments"><content><VBox spacing="12" styleClass="operations-tab-content"><HBox alignment="CENTER_LEFT"><Label text="Financial Register" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Add Voucher" onAction="#newFinance" styleClass="approved-button,approved-primary-button"/></HBox><TableView fx:id="financeTable" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="fNo" text="Voucher No." styleClass="approved-table-column"/><TableColumn fx:id="fType" text="Type" styleClass="approved-table-column"/><TableColumn fx:id="fDate" text="Date" styleClass="approved-table-column"/><TableColumn fx:id="fParty" text="Party" styleClass="approved-table-column"/><TableColumn fx:id="fCategory" text="Category" styleClass="approved-table-column"/><TableColumn fx:id="fReference" text="Reference" styleClass="approved-table-column"/><TableColumn fx:id="fMode" text="Mode" styleClass="approved-table-column"/><TableColumn fx:id="fAmount" text="Amount" styleClass="approved-table-column"/></columns></TableView></VBox></content></Tab>
        <Tab text="Reminders"><content><VBox spacing="12" styleClass="operations-tab-content"><HBox alignment="CENTER_LEFT"><Label text="Reminders &amp; Follow-ups" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Add Reminder" onAction="#newReminder" styleClass="approved-button,approved-primary-button"/></HBox><TableView fx:id="reminderTable" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="mTitle" text="Reminder" styleClass="approved-table-column"/><TableColumn fx:id="mReference" text="Reference" styleClass="approved-table-column"/><TableColumn fx:id="mDue" text="Due Date" styleClass="approved-table-column"/><TableColumn fx:id="mPriority" text="Priority" styleClass="approved-table-column"/><TableColumn fx:id="mStatus" text="Status" styleClass="approved-table-column"/><TableColumn fx:id="mAction" text="Actions" styleClass="approved-table-column" minWidth="120" prefWidth="124" maxWidth="132" sortable="false" resizable="false"/></columns></TableView></VBox></content></Tab>
        <Tab text="User Access"><content><VBox spacing="12" styleClass="operations-tab-content"><HBox alignment="CENTER_LEFT"><Label text="Users &amp; Roles" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Add User" onAction="#openUserRegistration" styleClass="approved-button,approved-primary-button"/></HBox><TableView fx:id="userTable" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="uName" text="Username" styleClass="approved-table-column"/><TableColumn fx:id="uFull" text="Full Name" styleClass="approved-table-column"/><TableColumn fx:id="uEmail" text="Email" styleClass="approved-table-column"/><TableColumn fx:id="uRole" text="Role" styleClass="approved-table-column"/><TableColumn fx:id="uStatus" text="Status" styleClass="approved-table-column"/></columns></TableView></VBox></content></Tab>
    </tabs></TabPane>
</VBox>