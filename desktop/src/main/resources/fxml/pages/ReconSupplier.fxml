<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ReconSupplierController" spacing="12" styleClass="recon-page,recon-register-page,approved-ui,erp-screen-root">
 <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
 <HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header,approved-card"><StackPane fx:id="pageIcon" styleClass="erp-page-header-icon"/><VBox><Label text="Recon Supplier" styleClass="screen-title"/><Label text="Independent supplier master used only by Purchase Recon" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnRefresh" text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnNew" text="New Recon Supplier" onAction="#newSupplier" styleClass="approved-button,approved-primary-button"/></HBox>
 <HBox spacing="8" styleClass="standard-kpi-row,recon-metric-row,erp-kpi-section">
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-blue"><StackPane fx:id="kpiTotalIcon" styleClass="standard-kpi-icon"/><VBox spacing="3"><Label text="Total Suppliers" styleClass="metric-label"/><Label fx:id="kpiTotal" text="0" styleClass="metric-value"/><Label text="Recon supplier master" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-green"><StackPane fx:id="kpiActiveIcon" styleClass="standard-kpi-icon"/><VBox spacing="3"><Label text="Active" styleClass="metric-label"/><Label fx:id="kpiActive" text="0" styleClass="metric-value"/><Label text="Available for reconciliation" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-purple"><StackPane fx:id="kpiImportIcon" styleClass="standard-kpi-icon"/><VBox spacing="3"><Label text="Imported" styleClass="metric-label"/><Label fx:id="kpiImported" text="0" styleClass="metric-value"/><Label text="Created by Purchase Recon import" styleClass="metric-note"/></VBox></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="standard-kpi-card,recon-metric-card,kpi-orange"><StackPane fx:id="kpiReconIcon" styleClass="standard-kpi-icon"/><VBox spacing="3"><Label text="Recon Records" styleClass="metric-label"/><Label fx:id="kpiRecons" text="0" styleClass="metric-value"/><Label text="Linked Purchase Recon records" styleClass="metric-note"/></VBox></HBox>
 </HBox>
 <HBox fx:id="workspaceRow" spacing="12" VBox.vgrow="ALWAYS">
  <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="approved-card"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Recon Supplier Register" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><TextField fx:id="txtSearch" promptText="Search reference, name, GSTIN, phone..." prefWidth="330"/><Button text="Search" onAction="#applySearch" styleClass="approved-button,approved-secondary-button"/></HBox>
   <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-responsive,erp-purple-selection-table"><columns><TableColumn fx:id="colRef" text="Reference"/><TableColumn fx:id="colName" text="Legal / Trade Name"/><TableColumn fx:id="colGstin" text="GSTIN"/><TableColumn fx:id="colPhone" text="Phone"/><TableColumn fx:id="colCount" text="Recon Records"/><TableColumn fx:id="colSource" text="Source"/><TableColumn fx:id="colStatus" text="Status"/><TableColumn fx:id="colAction" text="Actions" sortable="false"/></columns></TableView>
  </VBox>
  <VBox fx:id="editorPanel" spacing="10" prefWidth="390" minWidth="360" styleClass="approved-card,recon-editor-panel"><HBox alignment="CENTER_LEFT"><VBox><Label fx:id="lblEditorTitle" text="New Recon Supplier" styleClass="section-title"/><Label fx:id="lblReference" text="Reference generated on save" styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Close" onAction="#cancelEdit" styleClass="approved-button,approved-secondary-button"/></HBox><Separator/>
   <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="import-inner-scroll"><VBox spacing="9"><Label text="Trade / Legal Name" styleClass="field-label"/><TextField fx:id="txtName" promptText="Recon supplier name"/><Label text="GSTIN" styleClass="field-label"/><TextField fx:id="txtGstin" promptText="GSTIN (unique when present)"/><Label text="PAN" styleClass="field-label"/><TextField fx:id="txtPan"/><Label text="Contact Person" styleClass="field-label"/><TextField fx:id="txtContact"/><Label text="Phone" styleClass="field-label"/><TextField fx:id="txtPhone"/><Label text="Email" styleClass="field-label"/><TextField fx:id="txtEmail"/><Label text="Status" styleClass="field-label"/><ComboBox fx:id="cmbStatus" maxWidth="Infinity"/><Label text="Notes" styleClass="field-label"/><TextArea fx:id="txtNotes" prefRowCount="5" wrapText="true"/></VBox></ScrollPane>
   <HBox alignment="CENTER_RIGHT" spacing="8"><Button text="Cancel" onAction="#cancelEdit" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnSave" text="Save Recon Supplier" onAction="#saveSupplier" styleClass="approved-button,approved-primary-button"/></HBox>
  </VBox>
 </HBox>
</VBox>
