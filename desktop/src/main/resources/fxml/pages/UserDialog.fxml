<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.UserDialogController"
            prefWidth="860" prefHeight="660"
            styleClass="entity-dialog,premium-entity-dialog,user-account-dialog,approved-ui,approved-screen,approved-screen-user-dialog,erp-screen-root">
 <top>
   <HBox alignment="CENTER_LEFT" spacing="14" styleClass="entity-dialog-header,premium-dialog-header,approved-section-header">
     <StackPane minWidth="44" minHeight="44" prefWidth="44" prefHeight="44" styleClass="dialog-title-icon"><Label text="U" styleClass="metric-title"/></StackPane>
     <VBox spacing="3"><Label fx:id="lblTitle" text="Add New User" styleClass="entity-dialog-title"/><Label fx:id="lblSubtitle" text="Identity, access and account security" styleClass="entity-dialog-subtitle"/></VBox>
   </HBox>
 </top>
 <center>
   <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll-pane">
     <VBox spacing="14" styleClass="entity-dialog-form">
       <padding><Insets top="18" right="24" bottom="18" left="24"/></padding>
       <VBox spacing="10" styleClass="form-section-card">
         <Label text="Identity &amp; Access" styleClass="dialog-section-title"/>
         <GridPane hgap="16" vgap="10">
           <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
           <VBox spacing="5" GridPane.rowIndex="0"><Label text="Full Name *"/><TextField fx:id="txtFullName" promptText="Enter full name" styleClass="approved-input"/></VBox>
           <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0"><Label text="Username *"/><TextField fx:id="txtUsername" promptText="Enter username" styleClass="approved-input"/></VBox>
           <VBox spacing="5" GridPane.rowIndex="1"><Label text="Email Address *"/><TextField fx:id="txtEmail" promptText="name@company.com" styleClass="approved-input"/></VBox>
           <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label text="Role *"/><ComboBox fx:id="cmbRole" promptText="Select role" maxWidth="Infinity" styleClass="approved-input"/></VBox>
           <VBox spacing="5" GridPane.rowIndex="2"><Label text="Department"/><TextField fx:id="txtDepartment" promptText="Sales, Purchase, Accounts..." styleClass="approved-input"/></VBox>
           <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2"><Label text="Branch / Location"/><TextField fx:id="txtBranch" promptText="Enter branch" styleClass="approved-input"/></VBox>
           <VBox spacing="5" GridPane.rowIndex="3"><Label text="Access Level *"/><ComboBox fx:id="cmbAccess" promptText="Select access" maxWidth="Infinity" styleClass="approved-input"/></VBox>
         </GridPane>
       </VBox>
       <VBox spacing="10" styleClass="form-section-card">
         <Label text="Credentials" styleClass="dialog-section-title"/>
         <GridPane hgap="16" vgap="10">
           <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
           <VBox spacing="5">
             <Label text="Password *"/>
             <StackPane maxWidth="Infinity"><PasswordField fx:id="txtPassword" promptText="8+ characters, letter and number" maxWidth="Infinity" styleClass="approved-input,password-reveal-explicit,user-password-input"/><TextField fx:id="txtPasswordVisible" promptText="8+ characters, letter and number" maxWidth="Infinity" visible="false" managed="false" styleClass="approved-input,user-password-input"/><Button fx:id="btnPasswordEye" onAction="#togglePasswordVisibility" focusTraversable="false" styleClass="password-reveal-button,user-password-eye" StackPane.alignment="CENTER_RIGHT"><StackPane.margin><Insets right="7"/></StackPane.margin></Button></StackPane>
           </VBox>
           <VBox spacing="5" GridPane.columnIndex="1">
             <Label text="Confirm Password *"/>
             <StackPane maxWidth="Infinity"><PasswordField fx:id="txtConfirm" promptText="Repeat password" maxWidth="Infinity" styleClass="approved-input,password-reveal-explicit,user-password-input"/><TextField fx:id="txtConfirmVisible" promptText="Repeat password" maxWidth="Infinity" visible="false" managed="false" styleClass="approved-input,user-password-input"/><Button fx:id="btnConfirmEye" onAction="#toggleConfirmVisibility" focusTraversable="false" styleClass="password-reveal-button,user-password-eye" StackPane.alignment="CENTER_RIGHT"><StackPane.margin><Insets right="7"/></StackPane.margin></Button></StackPane>
           </VBox>
         </GridPane>
       </VBox>
       <VBox spacing="10" styleClass="form-section-card">
         <Label text="Account &amp; Authentication" styleClass="dialog-section-title"/>
         <HBox spacing="16"><CheckBox fx:id="chkActive" text="Active"/><CheckBox fx:id="chkLocked" text="Locked"/><CheckBox fx:id="chkMfa" text="Require MFA"/></HBox>
         <GridPane hgap="16" vgap="8">
           <columnConstraints><ColumnConstraints percentWidth="28"/><ColumnConstraints percentWidth="72"/></columnConstraints>
           <Label text="MFA policy" GridPane.rowIndex="0" styleClass="field-help"/><Label fx:id="lblMfaPolicy" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="0"/>
           <Label text="Authenticator" GridPane.rowIndex="1" styleClass="field-help"/><Label fx:id="lblMfaStatus" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="1" wrapText="true"/>
         </GridPane>
         <HBox alignment="CENTER_LEFT" spacing="10"><Button fx:id="btnResetMfa" text="Reset Authenticator" onAction="#resetAuthenticator" visible="false" managed="false" styleClass="secondary-button"/><Label text="Reset invalidates the old phone and requires a new QR enrollment at the next sign-in." wrapText="true" styleClass="field-help"/></HBox>
       </VBox>
       <Label fx:id="lblMessage" wrapText="true" styleClass="validation-message"/>
     </VBox>
   </ScrollPane>
 </center>
 <bottom>
   <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="entity-dialog-actions,premium-dialog-actions"><Button fx:id="btnCancel" text="Cancel" onAction="#cancel" styleClass="secondary-button" cancelButton="true"/><Button fx:id="btnSave" text="Create User" onAction="#save" styleClass="primary-button" defaultButton="true"/></HBox>
 </bottom>
</BorderPane>
