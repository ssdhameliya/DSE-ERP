<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.UserDialogController"
            prefWidth="920" prefHeight="680"
            styleClass="user-account-dialog,approved-ui,approved-screen,approved-screen-user-dialog,erp-screen-root">
 <left>
   <VBox prefWidth="275" alignment="CENTER" spacing="16" styleClass="user-dialog-brand">
     <Label text="◈" styleClass="user-dialog-logo"/>
     <Label text="DSE ERP 9.0.22" styleClass="title"/>
     <Label text="USER ACCESS" styleClass="metric-title"/>
     <Label text="Create and maintain secure application accounts with database-backed roles."
            wrapText="true" textAlignment="CENTER" styleClass="subtitle" maxWidth="210"/>
   </VBox>
 </left>
 <center>
   <VBox spacing="15" styleClass="user-dialog-form">
     <padding><Insets top="26" right="34" bottom="24" left="34"/></padding>
     <HBox alignment="CENTER_LEFT">
       <VBox><Label fx:id="lblTitle" text="Add New User" styleClass="login-title"/>
             <Label fx:id="lblSubtitle" text="Account identity, credentials and role assignment" styleClass="entity-dialog-subtitle"/></VBox>
       <Region HBox.hgrow="ALWAYS"/><Button text="×" onAction="#cancel" styleClass="dialog-close-button"/>
     </HBox>
     <Separator/>
     <GridPane hgap="16" vgap="9">
       <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
       <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0"><Label text="Full Name *"/><TextField fx:id="txtFullName" promptText="Enter full name" styleClass="approved-input"/></VBox>
       <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0"><Label text="Username *"/><TextField fx:id="txtUsername" promptText="Enter username" styleClass="approved-input"/></VBox>
       <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1"><Label text="Email Address *"/><TextField fx:id="txtEmail" promptText="name@company.com" styleClass="approved-input"/></VBox>
       <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label text="Role *"/><ComboBox fx:id="cmbRole" promptText="Select role" maxWidth="Infinity" styleClass="approved-input"/></VBox>

       <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
         <Label text="Password *"/>
         <StackPane maxWidth="Infinity" styleClass="user-password-wrapper">
           <PasswordField fx:id="txtPassword" promptText="8+ characters, letter and number" maxWidth="Infinity" styleClass="approved-input,password-reveal-explicit,user-password-input"/>
           <TextField fx:id="txtPasswordVisible" promptText="8+ characters, letter and number" maxWidth="Infinity" visible="false" managed="false" styleClass="approved-input,user-password-input"/>
           <Button fx:id="btnPasswordEye" onAction="#togglePasswordVisibility" focusTraversable="false" styleClass="user-password-eye" StackPane.alignment="CENTER_RIGHT">
             <StackPane.margin><Insets right="7"/></StackPane.margin>
           </Button>
         </StackPane>
       </VBox>
       <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
         <Label text="Confirm Password *"/>
         <StackPane maxWidth="Infinity" styleClass="user-password-wrapper">
           <PasswordField fx:id="txtConfirm" promptText="Repeat password" maxWidth="Infinity" styleClass="approved-input,password-reveal-explicit,user-password-input"/>
           <TextField fx:id="txtConfirmVisible" promptText="Repeat password" maxWidth="Infinity" visible="false" managed="false" styleClass="approved-input,user-password-input"/>
           <Button fx:id="btnConfirmEye" onAction="#toggleConfirmVisibility" focusTraversable="false" styleClass="user-password-eye" StackPane.alignment="CENTER_RIGHT">
             <StackPane.margin><Insets right="7"/></StackPane.margin>
           </Button>
         </StackPane>
       </VBox>

       <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3"><Label text="Department"/><TextField fx:id="txtDepartment" promptText="Sales, Purchase, Accounts..." styleClass="approved-input"/></VBox>
       <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3"><Label text="Branch / Location"/><TextField fx:id="txtBranch" promptText="Enter branch" styleClass="approved-input"/></VBox>
       <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="4"><Label text="Access Level *"/><ComboBox fx:id="cmbAccess" promptText="Select access" maxWidth="Infinity" styleClass="approved-input"/></VBox>
       <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="4">
         <Label text="Account Security"/>
         <HBox spacing="14"><CheckBox fx:id="chkActive" text="Active"/><CheckBox fx:id="chkLocked" text="Locked"/><CheckBox fx:id="chkMfa" text="MFA required"/></HBox>
         <Label text="Admin: password only • Every other active role: password + OTP" styleClass="user-mfa-policy-hint" wrapText="true"/>
       </VBox>
     </GridPane>
     <Region VBox.vgrow="ALWAYS"/><Label fx:id="lblMessage" wrapText="true"/>
     <HBox spacing="12" alignment="CENTER_RIGHT"><Button fx:id="btnCancel" text="Cancel" onAction="#cancel" styleClass="secondary-button"/><Button fx:id="btnSave" text="Create User" onAction="#save" styleClass="primary-button" defaultButton="true"/></HBox>
   </VBox>
 </center>
</BorderPane>
