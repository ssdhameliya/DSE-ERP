<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.Customer360Controller" spacing="8"
      styleClass="register-page,customer-360-page,approved-ui,approved-screen,erp-screen-root">
    <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="entity-page-header,approved-section-header,erp-page-identity-header">
        <StackPane fx:id="pageIcon" styleClass="erp-page-header-icon"/>
        <VBox spacing="2"><Label fx:id="lblTitle" text="Customer 360°" styleClass="screen-title"/><Label text="One customer view across existing business records" styleClass="screen-subtitle"/></VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Back to Customers" onAction="#backToCustomers" styleClass="approved-button,approved-secondary-button,erp-nav-button"/>
        <Button text="Edit Customer" onAction="#editCustomer" styleClass="approved-button,approved-secondary-button"/>
        <Button text="New Sale" onAction="#newSale" styleClass="approved-button,approved-primary-button"/>
        <Button text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/>
    </HBox>

    <VBox spacing="6" styleClass="customer-360-profile-card,approved-section-card,customer-360-profile-compact">
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="customer-360-profile-heading">
            <Label text="Customer Details" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Status" styleClass="field-label-status"/>
            <Label fx:id="lblStatus" styleClass="status-pill"/>
        </HBox>
        <GridPane hgap="8" vgap="6" styleClass="customer-360-identity-grid">
            <columnConstraints><ColumnConstraints percentWidth="33.333"/><ColumnConstraints percentWidth="33.333"/><ColumnConstraints percentWidth="33.334"/></columnConstraints>
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="customer-360-detail-cell"><Label text="Customer Code" styleClass="field-label-reference"/><Label fx:id="lblCode" styleClass="field-value"/></VBox>
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="customer-360-detail-cell"><Label text="GSTIN" styleClass="field-label-tax"/><Label fx:id="lblGstin" styleClass="field-value"/></VBox>
            <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="customer-360-detail-cell"><Label text="Contact Person" styleClass="field-label-customer"/><Label fx:id="lblContact" styleClass="field-value"/></VBox>
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="customer-360-detail-cell"><Label text="Mobile" styleClass="field-label-phone"/><Label fx:id="lblPhone" styleClass="field-value"/></VBox>
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="customer-360-detail-cell"><Label text="Email" styleClass="field-label-email"/><Label fx:id="lblEmail" wrapText="true" styleClass="field-value"/></VBox>
            <VBox GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="customer-360-detail-cell"><Label text="Address" styleClass="field-label-address"/><Label fx:id="lblAddress" wrapText="true" styleClass="field-value"/></VBox>
        </GridPane>
    </VBox>

    <HBox spacing="8" styleClass="entity-kpi-row,erp-kpi-section,erp-kpi-profile-six">
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="9" styleClass="entity-kpi-card,kpi-blue"><StackPane fx:id="outstandingIcon" styleClass="entity-kpi-icon"/><VBox><Label text="Outstanding Receivable" styleClass="metric-label"/><Label fx:id="lblOutstanding" text="₹ 0.00" styleClass="metric-value"/></VBox></HBox>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="9" styleClass="entity-kpi-card,kpi-green"><StackPane fx:id="quotesIcon" styleClass="entity-kpi-icon"/><VBox><Label text="Open Quotations" styleClass="metric-label"/><Label fx:id="lblOpenQuotes" text="₹ 0.00" styleClass="metric-value"/></VBox></HBox>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="9" styleClass="entity-kpi-card,kpi-purple"><StackPane fx:id="ordersIcon" styleClass="entity-kpi-icon"/><VBox><Label text="Open Sales Orders" styleClass="metric-label"/><Label fx:id="lblOpenOrders" text="₹ 0.00" styleClass="metric-value"/></VBox></HBox>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="9" styleClass="entity-kpi-card,kpi-orange"><StackPane fx:id="projectsIcon" styleClass="entity-kpi-icon"/><VBox><Label text="Active Projects" styleClass="metric-label"/><Label fx:id="lblProjects" text="0" styleClass="metric-value"/></VBox></HBox>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="9" styleClass="entity-kpi-card,kpi-blue"><StackPane fx:id="salesIcon" styleClass="entity-kpi-icon"/><VBox><Label text="Total Sales" styleClass="metric-label"/><Label fx:id="lblSales" text="₹ 0.00" styleClass="metric-value"/></VBox></HBox>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="9" styleClass="entity-kpi-card,kpi-green"><StackPane fx:id="paymentIcon" styleClass="entity-kpi-icon"/><VBox><Label text="Last Payment" styleClass="metric-label"/><Label fx:id="lblLastPayment" text="₹ 0.00" styleClass="metric-value"/></VBox></HBox>
    </HBox>

    <TabPane fx:id="tabs" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="customer-360-tabs">
        <tabs>
            <Tab fx:id="tabOverview" text="Overview">
                <content><VBox spacing="10" styleClass="customer-360-tab-content">
                    <Label text="Recent Business Activity" styleClass="section-title"/>
                    <HBox spacing="10" VBox.vgrow="ALWAYS">
                        <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="entity-table-card"><Label text="Recent Quotations" styleClass="section-title"/><TableView fx:id="tblRecentQuotes" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="rqNo" text="Quotation"/><TableColumn fx:id="rqDate" text="Date"/><TableColumn fx:id="rqAmount" text="Amount"/><TableColumn fx:id="rqStatus" text="Status"/></columns></TableView><Label text="Double-click a record to open the existing Quotation screen." styleClass="muted-text"/></VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="entity-table-card"><Label text="Recent Sales Orders" styleClass="section-title"/><TableView fx:id="tblRecentOrders" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="roNo" text="Sales Order"/><TableColumn fx:id="roDate" text="Date"/><TableColumn fx:id="roAmount" text="Amount"/><TableColumn fx:id="roStatus" text="Status"/></columns></TableView><Label text="Double-click a record to open the existing Sales Order screen." styleClass="muted-text"/></VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="entity-table-card"><Label text="Recent Invoices" styleClass="section-title"/><TableView fx:id="tblRecentInvoices" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="riNo" text="Invoice"/><TableColumn fx:id="riDate" text="Date"/><TableColumn fx:id="riAmount" text="Amount"/><TableColumn fx:id="riOutstanding" text="Outstanding"/></columns></TableView><Label text="Double-click a record to open the existing Sales Register." styleClass="muted-text"/></VBox>
                    </HBox>
                </VBox></content>
            </Tab>

            <Tab fx:id="tabContacts" text="Contacts">
                <content><VBox spacing="8" styleClass="customer-360-tab-content"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Customer Contacts" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Add Contact" onAction="#addContact" styleClass="approved-button,approved-primary-button"/><Button text="Edit" onAction="#editContact" styleClass="approved-button,approved-secondary-button"/><Button text="Delete" onAction="#deleteContact" styleClass="approved-button,approved-danger-button"/></HBox><TableView fx:id="tblContacts" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-master"><columns><TableColumn fx:id="cName" text="Name"/><TableColumn fx:id="cDesignation" text="Designation"/><TableColumn fx:id="cDepartment" text="Department"/><TableColumn fx:id="cMobile" text="Mobile"/><TableColumn fx:id="cEmail" text="Email"/><TableColumn fx:id="cPrimary" text="Primary"/></columns></TableView></VBox></content>
            </Tab>

            <Tab fx:id="tabQuotations" text="Quotations">
                <content><VBox spacing="8" styleClass="customer-360-tab-content"><Label text="Customer Quotations" styleClass="section-title"/><TableView fx:id="tblQuotations" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="qNo" text="Quotation No."/><TableColumn fx:id="qDate" text="Date"/><TableColumn fx:id="qValid" text="Valid Upto"/><TableColumn fx:id="qSalesperson" text="Salesperson"/><TableColumn fx:id="qAmount" text="Amount"/><TableColumn fx:id="qStatus" text="Status"/><TableColumn fx:id="qFollowUp" text="Follow-up"/></columns></TableView><Label text="Double-click to open the existing Quotation register/detail." styleClass="muted-text"/></VBox></content>
            </Tab>

            <Tab fx:id="tabOrders" text="Sales Orders">
                <content><VBox spacing="10" styleClass="customer-360-tab-content">
                    <VBox spacing="6" VBox.vgrow="ALWAYS" styleClass="entity-table-card"><Label text="Project Execution Sales Orders" styleClass="section-title"/><TableView fx:id="tblOrders" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="oNo" text="Sales Order"/><TableColumn fx:id="oPo" text="Customer PO"/><TableColumn fx:id="oDate" text="Date"/><TableColumn fx:id="oProject" text="Project"/><TableColumn fx:id="oAmount" text="Amount"/><TableColumn fx:id="oStatus" text="Status"/></columns></TableView><Label text="Double-click to open the existing Sales Order screen." styleClass="muted-text"/></VBox>
                    <VBox spacing="6" VBox.vgrow="ALWAYS" styleClass="entity-table-card"><Label text="Direct / Unlinked Sales" styleClass="section-title"/><TableView fx:id="tblDirectSales" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="dsNo" text="Invoice"/><TableColumn fx:id="dsDate" text="Date"/><TableColumn fx:id="dsAmount" text="Amount"/><TableColumn fx:id="dsPaid" text="Paid"/><TableColumn fx:id="dsOutstanding" text="Outstanding"/><TableColumn fx:id="dsStatus" text="Status"/></columns></TableView><Label text="Sales created without a matching Project Execution Project or Sales Order. Double-click to open the existing Sales Register." wrapText="true" styleClass="muted-text"/></VBox>
                </VBox></content>
            </Tab>

            <Tab fx:id="tabProjects" text="Projects">
                <content><VBox spacing="8" styleClass="customer-360-tab-content"><Label text="Customer Projects / Jobs" styleClass="section-title"/><TableView fx:id="tblProjects" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="pNo" text="Project No."/><TableColumn fx:id="pName" text="Parent / Source"/><TableColumn fx:id="pDate" text="Start Date"/><TableColumn fx:id="pTarget" text="Target Date"/><TableColumn fx:id="pAmount" text="Value"/><TableColumn fx:id="pStatus" text="Status"/></columns></TableView><Label text="Double-click to open the existing Project Execution screen." styleClass="muted-text"/></VBox></content>
            </Tab>

            <Tab fx:id="tabInvoices" text="Invoices">
                <content><VBox spacing="8" styleClass="customer-360-tab-content"><Label text="Sales Invoices" styleClass="section-title"/><TableView fx:id="tblInvoices" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="iNo" text="Invoice No."/><TableColumn fx:id="iDate" text="Date"/><TableColumn fx:id="iOrder" text="Sales Order"/><TableColumn fx:id="iProject" text="Project"/><TableColumn fx:id="iAmount" text="Amount"/><TableColumn fx:id="iPaid" text="Paid"/><TableColumn fx:id="iOutstanding" text="Outstanding"/><TableColumn fx:id="iStatus" text="Status"/></columns></TableView><Label text="Double-click to open the existing Sales Register. Customer 360° does not recalculate invoice totals." styleClass="muted-text"/></VBox></content>
            </Tab>

            <Tab fx:id="tabPayments" text="Payments">
                <content><VBox spacing="8" styleClass="customer-360-tab-content"><Label text="Customer Payments / Receipts" styleClass="section-title"/><TableView fx:id="tblPayments" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="payNo" text="Payment ID"/><TableColumn fx:id="payDate" text="Date"/><TableColumn fx:id="payInvoice" text="Invoice"/><TableColumn fx:id="payMode" text="Mode"/><TableColumn fx:id="payReference" text="Reference"/><TableColumn fx:id="payAmount" text="Amount"/><TableColumn fx:id="payNotes" text="Notes"/></columns></TableView><Label text="Double-click a payment to open its linked Sale. Payment posting remains in the existing payment flow." styleClass="muted-text"/></VBox></content>
            </Tab>

            <Tab fx:id="tabNotes" text="Notes">
                <content><VBox spacing="8" styleClass="customer-360-tab-content"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Customer-level Notes" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Add Note" onAction="#addNote" styleClass="approved-button,approved-primary-button"/><Button text="Edit" onAction="#editNote" styleClass="approved-button,approved-secondary-button"/><Button text="Delete" onAction="#deleteNote" styleClass="approved-button,approved-danger-button"/></HBox><TableView fx:id="tblNotes" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="nDate" text="Date / Time"/><TableColumn fx:id="nBy" text="User"/><TableColumn fx:id="nText" text="Note"/></columns></TableView></VBox></content>
            </Tab>

            <Tab fx:id="tabDocuments" text="Documents">
                <content><VBox spacing="8" styleClass="customer-360-tab-content"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Customer Documents" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Add Document" onAction="#addDocument" styleClass="approved-button,approved-primary-button"/><Button text="Preview" onAction="#viewDocument" styleClass="approved-button,approved-secondary-button"/><Button text="Delete" onAction="#deleteDocument" styleClass="approved-button,approved-danger-button"/></HBox><TableView fx:id="tblDocuments" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register"><columns><TableColumn fx:id="dName" text="Document"/><TableColumn fx:id="dUploaded" text="Uploaded"/><TableColumn fx:id="dBy" text="Uploaded By"/></columns></TableView><Label text="Documents are stored through the existing server-managed attachment infrastructure." styleClass="muted-text"/></VBox></content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
