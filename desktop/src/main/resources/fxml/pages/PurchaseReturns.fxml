<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><!-- Purchase Return Register: supplier returns, refunds, documents and actions. --><VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.PurchaseReturnsController" spacing="14" styleClass="register-page,sales-register-page,approved-ui,approved-screen,approved-screen-purchase-returns,erp-screen-root">
  <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header">
    <StackPane styleClass="erp-page-header-icon"><Label text="↩" styleClass="erp-page-header-symbol"/></StackPane>
    <VBox><Label text="Purchase Return Register" styleClass="screen-title"/><Label text="Manage supplier returns, debit notes and refunds" styleClass="screen-subtitle"/></VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Button text="Create Purchase Return" onAction="#create" styleClass="primary-action"/>
  </HBox>
  <HBox spacing="12" styleClass="return-kpi-row,erp-kpi-section">
    <HBox alignment="CENTER_LEFT" spacing="11" styleClass="return-kpi-card,sales-metric-card,sales-metric-total" HBox.hgrow="ALWAYS"><StackPane styleClass="return-kpi-icon,sales-metric-icon"><Label text="↩" styleClass="return-kpi-symbol"/></StackPane><VBox spacing="4"><Label text="Total Returns" styleClass="metric-label"/><Label fx:id="total" styleClass="metric-value"/><Label text="All time" styleClass="metric-note"/></VBox></HBox>
    <HBox alignment="CENTER_LEFT" spacing="11" styleClass="return-kpi-card,sales-metric-card,sales-metric-today" HBox.hgrow="ALWAYS"><StackPane styleClass="return-kpi-icon,sales-metric-icon"><Label text="▣" styleClass="return-kpi-symbol"/></StackPane><VBox spacing="4"><Label text="This Month" styleClass="metric-label"/><Label fx:id="monthCount" styleClass="metric-value"/><Label text="Returns this month" styleClass="metric-note"/></VBox></HBox>
    <HBox alignment="CENTER_LEFT" spacing="11" styleClass="return-kpi-card,sales-metric-card,sales-metric-pending" HBox.hgrow="ALWAYS"><StackPane styleClass="return-kpi-icon,sales-metric-icon"><Label text="▤" styleClass="return-kpi-symbol"/></StackPane><VBox spacing="4"><Label text="Return Count" styleClass="metric-label"/><Label fx:id="count" styleClass="metric-value"/><Label text="All time" styleClass="metric-note"/></VBox></HBox>
    <HBox alignment="CENTER_LEFT" spacing="11" styleClass="return-kpi-card,sales-metric-card,sales-metric-email" HBox.hgrow="ALWAYS"><StackPane styleClass="return-kpi-icon,sales-metric-icon"><Label text="▰" styleClass="return-kpi-symbol"/></StackPane><VBox spacing="4"><Label text="Refunded Amount" styleClass="metric-label"/><Label fx:id="refund" styleClass="metric-value"/><Label text="Processed" styleClass="metric-note"/></VBox></HBox>
    <HBox alignment="CENTER_LEFT" spacing="11" styleClass="return-kpi-card,sales-metric-card,sales-metric-due" HBox.hgrow="ALWAYS"><StackPane styleClass="return-kpi-icon,sales-metric-icon"><Label text="₹" styleClass="return-kpi-symbol"/></StackPane><VBox spacing="4"><Label text="Average Return" styleClass="metric-label"/><Label fx:id="average" styleClass="metric-value"/><Label text="Per return" styleClass="metric-note"/></VBox></HBox>
  </HBox>
  <VBox spacing="10" styleClass="filter-surface,approved-filter-bar,erp-filter-section">
    <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
    <HBox spacing="10" alignment="CENTER_LEFT">
      <TextField fx:id="search" promptText="Search return, purchase or supplier..." HBox.hgrow="ALWAYS" styleClass="approved-input"/>
      <ComboBox fx:id="supplier" prefWidth="190" styleClass="approved-input"/>
      <DatePicker fx:id="dpFrom" prefWidth="145" styleClass="approved-input"/>
      <DatePicker fx:id="dpTo" prefWidth="145" styleClass="approved-input"/>
      <ComboBox fx:id="status" prefWidth="150" styleClass="approved-input"/>
      <Button text="Apply Filters" onAction="#filter" styleClass="approved-button,approved-primary-button"/>
      <Button text="Reset" onAction="#reset" styleClass="secondary-button"/>
      <Button text="Refresh" onAction="#load" styleClass="approved-button,approved-secondary-button"/>
      <Button text="Export" onAction="#export" styleClass="secondary-button"/>
    </HBox>
  </VBox>
  <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register">
    <columns>
      <TableColumn fx:id="cNo" text="Return No." prefWidth="150" styleClass="approved-table-column"/>
      <TableColumn fx:id="cDate" text="Return Date" prefWidth="100" styleClass="approved-table-column"/>
      <TableColumn fx:id="cInvoice" text="Purchase No." prefWidth="135" styleClass="approved-table-column"/>
      <TableColumn fx:id="cSupplier" text="Supplier" prefWidth="180" styleClass="approved-table-column"/>
      <TableColumn fx:id="cTotal" text="Total Amount (₹)" prefWidth="125" styleClass="approved-table-column"/>
      <TableColumn fx:id="cRefund" text="Refund Amount (₹)" prefWidth="130" styleClass="approved-table-column"/>
      <TableColumn fx:id="cStatus" text="Return Status" prefWidth="125" styleClass="approved-table-column"/>
      <TableColumn fx:id="cRefundStatus" text="Refund Status" prefWidth="125" styleClass="approved-table-column"/>
      <TableColumn fx:id="cAction" text="" prefWidth="90" styleClass="approved-table-column"/>
    </columns>
  </TableView>
  <HBox alignment="CENTER_LEFT" styleClass="table-footer"><Label fx:id="pageInfo" styleClass="register-record-count"/></HBox>
</VBox>