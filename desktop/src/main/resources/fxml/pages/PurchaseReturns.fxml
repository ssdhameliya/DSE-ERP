<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.PurchaseReturnsController" spacing="14" styleClass="register-page,purchase-register-page,approved-ui,approved-screen,approved-screen-purchase-returns,erp-screen-root">
 <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
 <HBox alignment="CENTER_LEFT" spacing="12" styleClass="erp-page-identity-header"><StackPane styleClass="erp-page-header-icon"><Label text="↩" styleClass="erp-page-header-symbol"/></StackPane><VBox><Label text="Purchase Return Register" styleClass="screen-title"/><Label text="Manage supplier returns, debit notes and refunds" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Create Purchase Return" onAction="#create" styleClass="primary-action"/></HBox>
 <SplitPane fx:id="mainSplit" dividerPositions="1" minHeight="0" VBox.vgrow="ALWAYS" styleClass="register-split,purchase-return-register-split"><items>
  <VBox spacing="14" minWidth="620" styleClass="register-workspace,purchase-return-register-workspace">
   <HBox spacing="12" styleClass="return-kpi-row,erp-kpi-section">
    <HBox alignment="CENTER_LEFT" spacing="11" styleClass="standard-kpi-card,kpi-blue" HBox.hgrow="ALWAYS"><StackPane styleClass="standard-kpi-icon"><Label text="↩" styleClass="return-kpi-symbol"/></StackPane><VBox spacing="4" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Total Returns" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="All" styleClass="metric-trend-pill,trend-neutral"/></HBox><Label fx:id="total" styleClass="metric-value"/><Label text="All time" styleClass="metric-note"/></VBox></HBox>
    <HBox alignment="CENTER_LEFT" spacing="11" styleClass="standard-kpi-card,kpi-green" HBox.hgrow="ALWAYS"><StackPane styleClass="standard-kpi-icon"><Label text="▣" styleClass="return-kpi-symbol"/></StackPane><VBox spacing="4" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="This Month" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Current" styleClass="metric-trend-pill,trend-positive"/></HBox><Label fx:id="monthCount" styleClass="metric-value"/><Label text="Returns this month" styleClass="metric-note"/></VBox></HBox>
    <HBox alignment="CENTER_LEFT" spacing="11" styleClass="standard-kpi-card,kpi-orange" HBox.hgrow="ALWAYS"><StackPane styleClass="standard-kpi-icon"><Label text="▤" styleClass="return-kpi-symbol"/></StackPane><VBox spacing="4" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Return Count" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Pending" styleClass="metric-trend-pill,trend-warning"/></HBox><Label fx:id="count" styleClass="metric-value"/><Label text="All time" styleClass="metric-note"/></VBox></HBox>
    <HBox alignment="CENTER_LEFT" spacing="11" styleClass="standard-kpi-card,kpi-purple" HBox.hgrow="ALWAYS"><StackPane styleClass="standard-kpi-icon"><Label text="▰" styleClass="return-kpi-symbol"/></StackPane><VBox spacing="4" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Refunded Amount" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Processed" styleClass="metric-trend-pill,trend-positive"/></HBox><Label fx:id="refund" styleClass="metric-value"/><Label text="Processed" styleClass="metric-note"/></VBox></HBox>
    <HBox alignment="CENTER_LEFT" spacing="11" styleClass="standard-kpi-card,kpi-red" HBox.hgrow="ALWAYS"><StackPane styleClass="standard-kpi-icon"><Label text="₹" styleClass="return-kpi-symbol"/></StackPane><VBox spacing="4" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Average Return" styleClass="metric-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Average" styleClass="metric-trend-pill,trend-info"/></HBox><Label fx:id="average" styleClass="metric-value"/><Label text="Per return" styleClass="metric-note"/></VBox></HBox>
   </HBox>
   <VBox spacing="10" styleClass="filter-surface,approved-filter-bar,erp-filter-section"><HBox spacing="10" alignment="CENTER_LEFT"><TextField fx:id="search" promptText="Search return, purchase or supplier..." HBox.hgrow="ALWAYS" styleClass="approved-input"/><ComboBox fx:id="supplier" prefWidth="190" styleClass="approved-input"/><DatePicker fx:id="dpFrom" prefWidth="145" promptText="From date" styleClass="approved-input"/><DatePicker fx:id="dpTo" prefWidth="145" promptText="To date" styleClass="approved-input"/><ComboBox fx:id="status" prefWidth="150" styleClass="approved-input"/><Button text="Reset" onAction="#reset" styleClass="secondary-button"/><Button fx:id="btnRefreshReturns" text="Refresh" onAction="#refreshWithFeedback" styleClass="approved-button,approved-secondary-button"/><Button text="Export" onAction="#export" styleClass="secondary-button"/></HBox></VBox>
   <VBox minHeight="0" VBox.vgrow="ALWAYS"><TableView fx:id="table" minHeight="0" VBox.vgrow="ALWAYS" styleClass="professional-table,erp-table-profile-register,erp-purple-selection-table"><columns><TableColumn fx:id="cNo" text="Return No." styleClass="approved-table-column"/><TableColumn fx:id="cDate" text="Return Date" styleClass="approved-table-column"/><TableColumn fx:id="cInvoice" text="Purchase No." styleClass="approved-table-column"/><TableColumn fx:id="cSupplier" text="Supplier" styleClass="approved-table-column"/><TableColumn fx:id="cTotal" text="Total Amount (₹)" styleClass="approved-table-column"/><TableColumn fx:id="cRefund" text="Refund Amount (₹)" styleClass="approved-table-column"/><TableColumn fx:id="cStatus" text="Return Status" styleClass="approved-table-column"/><TableColumn fx:id="cRefundStatus" text="Refund Status" styleClass="approved-table-column"/><TableColumn fx:id="cAction" text="Actions" sortable="false" resizable="false" styleClass="approved-table-column"/></columns></TableView><HBox alignment="CENTER_LEFT" spacing="8" styleClass="table-footer"><Label fx:id="pageInfo" styleClass="register-record-count"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnPrevPage" text="‹ Previous" onAction="#previousPage" styleClass="approved-button,approved-secondary-button"/><Button fx:id="btnNextPage" text="Next ›" onAction="#nextPage" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
  </VBox>
 </items></SplitPane>
</VBox>
