<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="panelShortcuts" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      spacing="12" minHeight="0" maxHeight="Infinity"
      styleClass="dse-shortcut-v3-root" stylesheets="@../../../css/shortcut-manager.css">
  <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="dse-shortcut-v3-header">
    <StackPane fx:id="shortcutHeaderIcon" minWidth="46" prefWidth="46" minHeight="46" prefHeight="46" styleClass="dse-shortcut-v3-header-icon"/>
    <VBox spacing="3" HBox.hgrow="ALWAYS">
      <Label text="Shortcut Manager" styleClass="dse-shortcut-v3-title"/>
      <Label text="Manage every application shortcut without disturbing the workspace." styleClass="dse-shortcut-v3-subtitle"/>
    </VBox>
    <Button text="Import" onAction="#importShortcuts" styleClass="dse-shortcut-v3-button,dse-shortcut-v3-import"/>
    <Button text="Export" onAction="#exportShortcuts" styleClass="dse-shortcut-v3-button,dse-shortcut-v3-export"/>
    <Button text="Reset to Defaults" onAction="#resetAllShortcuts" styleClass="dse-shortcut-v3-button,dse-shortcut-v3-reset-all"/>
    <Button text="Add Shortcut" onAction="#addShortcut" styleClass="dse-shortcut-v3-button,dse-shortcut-v3-primary"/>
  </HBox>

  <HBox alignment="CENTER_LEFT" spacing="10" styleClass="dse-shortcut-v3-toolbar">
    <TextField fx:id="txtShortcutSearch" promptText="Search actions, categories, keys or scope..." HBox.hgrow="ALWAYS" styleClass="dse-shortcut-v3-search"/>
    <ComboBox fx:id="cmbShortcutCategory" prefWidth="220" promptText="All Categories" styleClass="dse-shortcut-v3-filter"/>
    <Label fx:id="lblShortcutValidation" text="No shortcut conflicts detected." styleClass="dse-shortcut-v3-validation"/>
  </HBox>

  <HBox spacing="12" VBox.vgrow="ALWAYS">
    <VBox spacing="12" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
      <HBox spacing="10" styleClass="dse-shortcut-v3-kpi-row">
        <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="dse-shortcut-v3-kpi,dse-shortcut-v3-kpi-purple">
          <StackPane fx:id="shortcutKpiTotalIcon" styleClass="dse-shortcut-v3-kpi-icon"/>
          <VBox spacing="1"><Label fx:id="lblShortcutTotal" text="0" styleClass="dse-shortcut-v3-kpi-value"/><Label text="Total Shortcuts" styleClass="dse-shortcut-v3-kpi-label"/><Label text="Available actions" styleClass="dse-shortcut-v3-kpi-caption"/></VBox>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="dse-shortcut-v3-kpi,dse-shortcut-v3-kpi-green">
          <StackPane fx:id="shortcutKpiCustomIcon" styleClass="dse-shortcut-v3-kpi-icon"/>
          <VBox spacing="1"><Label fx:id="lblShortcutCustom" text="0" styleClass="dse-shortcut-v3-kpi-value"/><Label text="Custom Shortcuts" styleClass="dse-shortcut-v3-kpi-label"/><Label text="Changed from defaults" styleClass="dse-shortcut-v3-kpi-caption"/></VBox>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="dse-shortcut-v3-kpi,dse-shortcut-v3-kpi-amber">
          <StackPane fx:id="shortcutKpiConflictIcon" styleClass="dse-shortcut-v3-kpi-icon"/>
          <VBox spacing="1"><Label fx:id="lblShortcutConflicts" text="0" styleClass="dse-shortcut-v3-kpi-value"/><Label text="Conflicts Found" styleClass="dse-shortcut-v3-kpi-label"/><Label text="Needs attention" styleClass="dse-shortcut-v3-kpi-caption"/></VBox>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="dse-shortcut-v3-kpi,dse-shortcut-v3-kpi-blue">
          <StackPane fx:id="shortcutKpiCategoryIcon" styleClass="dse-shortcut-v3-kpi-icon"/>
          <VBox spacing="1"><Label fx:id="lblShortcutCategories" text="0" styleClass="dse-shortcut-v3-kpi-value"/><Label text="Categories" styleClass="dse-shortcut-v3-kpi-label"/><Label text="Shortcut groups" styleClass="dse-shortcut-v3-kpi-caption"/></VBox>
        </HBox>
      </HBox>

      <StackPane fx:id="shortcutWorkspaceStack" VBox.vgrow="ALWAYS" styleClass="dse-shortcut-v3-workspace">
        <GridPane fx:id="shortcutCards" hgap="10" vgap="10" alignment="TOP_LEFT" maxWidth="Infinity" maxHeight="Infinity" StackPane.alignment="CENTER" styleClass="dse-shortcut-v3-cards"/>
        <VBox fx:id="shortcutListPanel" visible="false" managed="false" spacing="9" styleClass="dse-shortcut-v3-list-panel">
          <HBox alignment="CENTER_LEFT" spacing="10">
            <Button text="← Overview" onAction="#showShortcutOverviewFromList" styleClass="dse-shortcut-v3-button,dse-shortcut-v3-secondary"/>
            <VBox spacing="1" HBox.hgrow="ALWAYS">
              <Label fx:id="lblShortcutListTitle" text="Shortcuts" styleClass="dse-shortcut-v3-list-title"/>
              <Label fx:id="lblShortcutListSubtitle" text="" styleClass="dse-shortcut-v3-list-subtitle"/>
            </VBox>
            <Button text="Add Shortcut" onAction="#addShortcut" styleClass="dse-shortcut-v3-button,dse-shortcut-v3-primary"/>
          </HBox>
          <ListView fx:id="lstShortcutActions" VBox.vgrow="ALWAYS" styleClass="dse-shortcut-v3-list"/>
        </VBox>
      </StackPane>
    </VBox>

    <VBox fx:id="shortcutDrawer" visible="false" managed="false" prefWidth="365" minWidth="330" maxWidth="410" spacing="10" styleClass="dse-shortcut-v3-drawer">
      <HBox alignment="CENTER_LEFT" spacing="10">
        <StackPane fx:id="shortcutDrawerIcon" styleClass="dse-shortcut-v3-drawer-icon"/>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
          <Label fx:id="lblShortcutDrawerTitle" text="Add / Edit Shortcut" styleClass="dse-shortcut-v3-drawer-title"/>
          <Label text="Assign any permitted ERP action and choose where it works." styleClass="dse-shortcut-v3-drawer-subtitle" wrapText="true"/>
        </VBox>
        <Button text="×" onAction="#closeShortcutDrawer" styleClass="dse-shortcut-v3-close"/>
      </HBox>

      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="dse-shortcut-v3-tabs">
        <tabs>
          <Tab text="Details">
            <content>
              <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dse-shortcut-v3-drawer-scroll">
                <content>
                  <VBox spacing="10">
                    <Label text="Action *" styleClass="dse-shortcut-v3-field-label"/>
                    <ComboBox fx:id="cmbShortcutAction" maxWidth="Infinity" visibleRowCount="14" styleClass="dse-shortcut-v3-input"/>
                    <Label text="The catalog includes Application Actions, Quick Create and Navigation commands allowed for this user." wrapText="true" styleClass="dse-shortcut-v3-help"/>

                    <Label text="Shortcut Keys *" styleClass="dse-shortcut-v3-field-label"/>
                    <HBox spacing="7">
                      <TextField fx:id="txtShortcutKeys" promptText="Press Capture Keys" HBox.hgrow="ALWAYS" editable="false" styleClass="dse-shortcut-v3-input,dse-shortcut-v3-key-capture"/>
                      <Button text="Capture Keys" onAction="#focusShortcutCapture" styleClass="dse-shortcut-v3-button,dse-shortcut-v3-capture"/>
                    </HBox>
                    <Label text="Press a key combination. Backspace/Delete disables the selected action." styleClass="dse-shortcut-v3-help" wrapText="true"/>

                    <Label text="Applies To *" styleClass="dse-shortcut-v3-field-label"/>
                    <ComboBox fx:id="cmbShortcutScope" maxWidth="Infinity" styleClass="dse-shortcut-v3-input"/>
                    <Label fx:id="lblShortcutScopeHint" text="Choose Application (Global) or narrow the shortcut to a module/context." wrapText="true" styleClass="dse-shortcut-v3-help"/>

                    <Label text="Description" styleClass="dse-shortcut-v3-field-label"/>
                    <TextArea fx:id="txtShortcutDescription" prefRowCount="3" wrapText="true" editable="false" styleClass="dse-shortcut-v3-description"/>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                      <VBox spacing="1" HBox.hgrow="ALWAYS"><Label text="Active" styleClass="dse-shortcut-v3-field-label"/><Label text="Disable to temporarily turn this shortcut off." styleClass="dse-shortcut-v3-help"/></VBox>
                      <CheckBox fx:id="chkShortcutActive" selected="true" styleClass="dse-shortcut-v3-active-toggle"/>
                    </HBox>

                    <VBox fx:id="shortcutConflictBox" spacing="4" styleClass="dse-shortcut-v3-conflict-box">
                      <Label text="Conflict Warning" styleClass="dse-shortcut-v3-conflict-title"/>
                      <Label fx:id="lblShortcutConflict" text="No conflicts for this shortcut." wrapText="true" styleClass="dse-shortcut-v3-conflict-text"/>
                    </VBox>
                  </VBox>
                </content>
              </ScrollPane>
            </content>
          </Tab>
          <Tab text="Advanced">
            <content>
              <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dse-shortcut-v3-drawer-scroll">
                <content>
                  <VBox spacing="12" styleClass="dse-shortcut-v3-advanced">
                    <Label text="Context Behaviour" styleClass="dse-shortcut-v3-field-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                      <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Allow while typing" styleClass="dse-shortcut-v3-advanced-title"/>
                        <Label text="When enabled, this shortcut may run while focus is inside a text input. Keep this off for normal typing safety." wrapText="true" styleClass="dse-shortcut-v3-help"/>
                      </VBox>
                      <CheckBox fx:id="chkShortcutAllowTextInput"/>
                    </HBox>
                    <Separator/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                      <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Require a selected record" styleClass="dse-shortcut-v3-advanced-title"/>
                        <Label text="Useful for Edit, Open or Delete. The shortcut is ignored until the active table/list has a selection." wrapText="true" styleClass="dse-shortcut-v3-help"/>
                      </VBox>
                      <CheckBox fx:id="chkShortcutRequireSelection"/>
                    </HBox>
                    <Separator/>
                    <Label text="Permission Guard" styleClass="dse-shortcut-v3-field-label"/>
                    <Label text="Security permissions are always enforced and cannot be bypassed by a shortcut assignment." wrapText="true" styleClass="dse-shortcut-v3-help"/>
                    <Separator/>
                    <Label text="Scope Resolution" styleClass="dse-shortcut-v3-field-label"/>
                    <Label text="Application (Global) works anywhere. Module scopes run only when that module is active. Editor commands retain their editor keyboard ownership." wrapText="true" styleClass="dse-shortcut-v3-help"/>
                  </VBox>
                </content>
              </ScrollPane>
            </content>
          </Tab>
        </tabs>
      </TabPane>

      <HBox alignment="CENTER_RIGHT" spacing="8">
        <Button text="Reset" onAction="#resetSelectedShortcut" styleClass="dse-shortcut-v3-button,dse-shortcut-v3-secondary"/>
        <Button text="Save Shortcut" onAction="#saveSelectedShortcut" styleClass="dse-shortcut-v3-button,dse-shortcut-v3-primary"/>
      </HBox>
    </VBox>
  </HBox>
</VBox>
