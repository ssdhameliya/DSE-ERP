<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="panelShortcuts" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" spacing="10" styleClass="settings-panel,settings-card,dse-shortcut-panel">
  <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
  <HBox alignment="CENTER_LEFT" spacing="10"><VBox spacing="2" HBox.hgrow="ALWAYS"><Label text="Application Shortcut Manager" styleClass="settings-section-title"/><Label text="One shortcut profile for the whole ERP. Click a key box and press the new combination; blank disables the action." wrapText="true" styleClass="settings-help-text,muted-label"/></VBox><Button text="Reset All" onAction="#resetAllShortcuts" styleClass="approved-button,approved-secondary-button"/></HBox>
  <Label fx:id="lblShortcutValidation" text="Shortcuts are loaded for the signed-in user." wrapText="true" styleClass="pill-info,dse-shortcut-validation"/>
  <TilePane fx:id="shortcutGroups" hgap="10" vgap="10" prefColumns="3" tileAlignment="TOP_LEFT" VBox.vgrow="ALWAYS" styleClass="dse-shortcut-groups"/>
</VBox>
