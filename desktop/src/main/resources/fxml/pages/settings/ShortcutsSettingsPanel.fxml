<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="panelShortcuts" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      spacing="8" styleClass="settings-panel,settings-card,dse-shortcut-panel,dse-shortcut-v2-panel">
  <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
  <HBox alignment="CENTER_LEFT" spacing="10">
    <VBox spacing="2" HBox.hgrow="ALWAYS">
      <Label text="Application Shortcut Manager" styleClass="settings-section-title"/>
      <Label text="One user-specific shortcut profile for the whole ERP. Click any key box and press a new combination; Backspace/Delete disables it." wrapText="true" styleClass="settings-help-text,muted-label"/>
    </VBox>
    <Button text="Reset All" onAction="#resetAllShortcuts" styleClass="approved-button,approved-secondary-button"/>
  </HBox>
  <HBox alignment="CENTER_LEFT" spacing="8" styleClass="dse-shortcut-status-row">
    <Label text="Global commands: Save • Edit • Refresh • New • Open • Delete • Print • Export • Back" styleClass="muted-label" HBox.hgrow="ALWAYS"/>
    <Label fx:id="lblShortcutValidation" text="Shortcuts are loaded for the signed-in user." wrapText="true" styleClass="pill-info,dse-shortcut-validation"/>
  </HBox>
  <TilePane fx:id="shortcutGroups" hgap="8" vgap="8" prefColumns="4" tileAlignment="TOP_LEFT"
            VBox.vgrow="ALWAYS" styleClass="dse-shortcut-groups,dse-shortcut-v2-groups"/>
</VBox>
