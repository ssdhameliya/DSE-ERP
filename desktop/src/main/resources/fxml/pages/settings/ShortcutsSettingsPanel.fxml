<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="panelShortcuts" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      spacing="12" minHeight="0" maxHeight="Infinity"
      styleClass="approved-ui,approved-screen,erp-screen-root,dse-shortcut-v3-root,shortcut-manager-root">
  <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="approved-page-header,approved-section-header,erp-page-identity-header,shortcut-manager-header">
    <StackPane fx:id="shortcutHeaderIcon" minWidth="46" prefWidth="46" minHeight="46" prefHeight="46"
               styleClass="erp-page-header-icon,shortcut-manager-header-icon"/>
    <VBox spacing="3" HBox.hgrow="ALWAYS">
      <Label text="Keyboard Shortcuts" styleClass="approved-page-title,page-title,shortcut-manager-title"/>
      <Label text="Manage application actions, quick-create commands and navigation shortcuts."
             styleClass="approved-page-subtitle,page-subtitle,shortcut-manager-subtitle"/>
    </VBox>
    <Button text="Import" onAction="#importShortcuts" styleClass="approved-button,approved-secondary-button"/>
    <Button text="Export" onAction="#exportShortcuts" styleClass="approved-button,approved-secondary-button"/>
    <Button text="Reset Defaults" onAction="#resetAllShortcuts" styleClass="approved-button,approved-secondary-button"/>
  </HBox>

  <HBox spacing="10" styleClass="shortcut-kpi-row">
    <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="approved-card,approved-surface,approved-kpi-card,shortcut-kpi-card">
      <StackPane fx:id="shortcutKpiTotalIcon" styleClass="approved-kpi-icon"/>
      <VBox spacing="1">
        <Label fx:id="lblShortcutTotal" text="0" styleClass="approved-kpi-value"/>
        <Label text="Available Actions" styleClass="approved-metric-note"/>
        <Label text="Three user-facing groups" styleClass="metric-note"/>
      </VBox>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="approved-card,approved-surface,approved-kpi-card,shortcut-kpi-card">
      <StackPane fx:id="shortcutKpiCustomIcon" styleClass="approved-kpi-icon"/>
      <VBox spacing="1">
        <Label fx:id="lblShortcutCustom" text="0" styleClass="approved-kpi-value"/>
        <Label text="Custom Assignments" styleClass="approved-metric-note"/>
        <Label text="Changed from defaults" styleClass="metric-note"/>
      </VBox>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="approved-card,approved-surface,approved-kpi-card,shortcut-kpi-card">
      <StackPane fx:id="shortcutKpiConflictIcon" styleClass="approved-kpi-icon"/>
      <VBox spacing="1">
        <Label fx:id="lblShortcutConflicts" text="0" styleClass="approved-kpi-value"/>
        <Label text="Conflicts" styleClass="approved-metric-note"/>
        <Label text="Must be zero to save" styleClass="metric-note"/>
      </VBox>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="approved-card,approved-surface,approved-kpi-card,shortcut-kpi-card">
      <StackPane fx:id="shortcutKpiCategoryIcon" styleClass="approved-kpi-icon"/>
      <VBox spacing="1">
        <Label fx:id="lblShortcutCategories" text="3" styleClass="approved-kpi-value"/>
        <Label text="Groups" styleClass="approved-metric-note"/>
        <Label text="Application • Quick Create • Navigation" styleClass="metric-note"/>
      </VBox>
    </HBox>
  </HBox>

  <HBox alignment="CENTER_LEFT" spacing="8" styleClass="approved-filter-bar,shortcut-group-bar">
    <Button fx:id="btnShortcutApplication" text="Application Actions" onAction="#showShortcutApplicationActions"
            styleClass="shortcut-group-button"/>
    <Button fx:id="btnShortcutQuickCreate" text="Quick Create" onAction="#showShortcutQuickCreate"
            styleClass="shortcut-group-button"/>
    <Button fx:id="btnShortcutNavigation" text="Navigation" onAction="#showShortcutNavigation"
            styleClass="shortcut-group-button"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Label fx:id="lblShortcutValidation" text="No shortcut conflicts detected." styleClass="shortcut-validation"/>
  </HBox>

  <HBox spacing="12" VBox.vgrow="ALWAYS">
    <VBox spacing="10" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="approved-card,approved-surface,shortcut-list-card">
      <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="txtShortcutSearch" promptText="Search action, key or scope..." HBox.hgrow="ALWAYS"
                   styleClass="approved-input,register-header-search-input"/>
      </HBox>
      <ListView fx:id="lstShortcutActions" VBox.vgrow="ALWAYS" styleClass="shortcut-action-list"/>
    </VBox>

    <VBox fx:id="shortcutDrawer" prefWidth="410" minWidth="370" maxWidth="450" spacing="10"
          styleClass="approved-card,approved-surface,shortcut-editor-card">
      <HBox alignment="CENTER_LEFT" spacing="10">
        <StackPane fx:id="shortcutDrawerIcon" styleClass="approved-kpi-icon"/>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
          <Label text="Edit Shortcut" styleClass="approved-card-title,section-title"/>
          <Label fx:id="lblShortcutDrawerTitle" text="Select an action" styleClass="shortcut-editor-action"/>
        </VBox>
      </HBox>

      <Label text="Action" styleClass="approved-field-label,field-label"/>
      <ComboBox fx:id="cmbShortcutAction" maxWidth="Infinity" visibleRowCount="14" styleClass="approved-input"/>

      <Label text="Shortcut Keys" styleClass="approved-field-label,field-label"/>
      <HBox spacing="8">
        <TextField fx:id="txtShortcutKeys" promptText="Press shortcut keys" HBox.hgrow="ALWAYS" editable="false"
                   styleClass="approved-input,shortcut-key-capture"/>
        <Button text="Capture" onAction="#focusShortcutCapture" styleClass="approved-button,approved-secondary-button"/>
      </HBox>

      <Label text="Applies To" styleClass="approved-field-label,field-label"/>
      <ComboBox fx:id="cmbShortcutScope" maxWidth="Infinity" styleClass="approved-input"/>
      <Label fx:id="lblShortcutScopeHint" text="Choose where this shortcut can run." wrapText="true" styleClass="approved-page-subtitle,field-help"/>

      <Label text="Description" styleClass="approved-field-label,field-label"/>
      <TextArea fx:id="txtShortcutDescription" prefRowCount="3" wrapText="true" editable="false"
                styleClass="approved-input,shortcut-description"/>

      <HBox alignment="CENTER_LEFT" spacing="8" styleClass="shortcut-option-row">
        <VBox spacing="1" HBox.hgrow="ALWAYS">
          <Label text="Active" styleClass="shortcut-option-title"/>
          <Label text="Turn this assignment on or off without changing the action." styleClass="approved-page-subtitle,field-help" wrapText="true"/>
        </VBox>
        <ToggleButton fx:id="chkShortcutActive" text="●" selected="true" alignment="CENTER_RIGHT" styleClass="shortcut-active-toggle"/>
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="8" styleClass="shortcut-option-row">
        <VBox spacing="1" HBox.hgrow="ALWAYS">
          <Label text="Allow while typing" styleClass="shortcut-option-title"/>
          <Label text="Enable only for commands that are safe while focus is in a text field." styleClass="approved-page-subtitle,field-help" wrapText="true"/>
        </VBox>
        <CheckBox fx:id="chkShortcutAllowTextInput"/>
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="8" styleClass="shortcut-option-row">
        <VBox spacing="1" HBox.hgrow="ALWAYS">
          <Label text="Require selected record" styleClass="shortcut-option-title"/>
          <Label text="Useful for View, Edit and Delete actions." styleClass="approved-page-subtitle,field-help" wrapText="true"/>
        </VBox>
        <CheckBox fx:id="chkShortcutRequireSelection"/>
      </HBox>

      <VBox fx:id="shortcutConflictBox" spacing="4" styleClass="shortcut-conflict-box,shortcut-conflict-ok">
        <Label text="Conflict Check" styleClass="shortcut-option-title"/>
        <Label fx:id="lblShortcutConflict" text="No conflicts for this shortcut." wrapText="true" styleClass="shortcut-conflict-text"/>
      </VBox>

      <Region VBox.vgrow="ALWAYS"/>
      <HBox alignment="CENTER_RIGHT" spacing="8">
        <Button text="Disable" onAction="#disableSelectedShortcut" styleClass="approved-button,approved-secondary-button"/>
        <Button text="Reset" onAction="#resetSelectedShortcut" styleClass="approved-button,approved-secondary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Save Shortcut" onAction="#saveSelectedShortcut" styleClass="approved-button,approved-primary-button"/>
      </HBox>
    </VBox>
  </HBox>
</VBox>
