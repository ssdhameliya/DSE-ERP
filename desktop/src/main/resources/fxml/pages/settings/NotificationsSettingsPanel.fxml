<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:id="panelNotifications" visible="false" managed="false" maxWidth="Infinity" styleClass="settings-card">

                            <VBox spacing="3">

                                <Label text="Notifications" styleClass="settings-section-title"/>

                                <Label text="Control whether application activity appears in the notification centre" wrapText="true" styleClass="settings-section-description"/>

                            </VBox>

                            <VBox spacing="14" styleClass="settings-information-card">

                                <CheckBox fx:id="chkNotifications" text="Show and keep application notifications" selected="true" wrapText="true" styleClass="settings-notification-check"/>

                                <Label text="Choose which activity categories may create notification-centre records and toast messages." wrapText="true" styleClass="settings-information-text"/>

                                <GridPane hgap="16" vgap="10" styleClass="settings-notification-grid">
                                    <columnConstraints><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/></columnConstraints>
                                    <CheckBox fx:id="chkNotifySales" text="Sales and invoices" selected="true" styleClass="settings-notification-category,notification-category-sales"/>
                                    <CheckBox fx:id="chkNotifyPurchases" text="Purchases and supplier invoices" selected="true" GridPane.columnIndex="1" styleClass="settings-notification-category,notification-category-purchases"/>
                                    <CheckBox fx:id="chkNotifyQuotations" text="Quotations and follow-ups" selected="true" GridPane.rowIndex="1" styleClass="settings-notification-category,notification-category-quotations"/>
                                    <CheckBox fx:id="chkNotifyReturns" text="Sales and purchase returns" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="settings-notification-category,notification-category-returns"/>
                                    <CheckBox fx:id="chkNotifyPayments" text="Payments and refunds" selected="true" GridPane.rowIndex="2" styleClass="settings-notification-category,notification-category-payments"/>
                                    <CheckBox fx:id="chkNotifyInventory" text="Inventory and low stock" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="settings-notification-category,notification-category-inventory"/>
                                    <CheckBox fx:id="chkNotifyReminders" text="Reminders" selected="true" GridPane.rowIndex="3" styleClass="settings-notification-category,notification-category-reminders"/>
                                    <CheckBox fx:id="chkNotifyCommunication" text="Email and WhatsApp" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="settings-notification-category,notification-category-communication"/>
                                    <CheckBox fx:id="chkNotifySystem" text="Imports, backups and updates" selected="true" GridPane.rowIndex="4" styleClass="settings-notification-category,notification-category-system"/>
                                </GridPane>

                            </VBox>

                        </VBox>

                        
