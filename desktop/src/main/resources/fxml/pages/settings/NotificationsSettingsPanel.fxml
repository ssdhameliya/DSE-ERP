<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:id="panelNotifications" visible="false" managed="false" maxWidth="Infinity" styleClass="settings-card">
    <VBox spacing="3">
        <Label text="Notifications" styleClass="settings-section-title"/>
        <Label text="Manage notification-centre and desktop-toast preferences for your signed-in user." wrapText="true" styleClass="settings-section-description"/>
    </VBox>

    <VBox spacing="14" styleClass="settings-information-card">
        <CheckBox fx:id="chkNotifications" text="Show application notifications" selected="true" wrapText="true" styleClass="settings-notification-check"/>
        <CheckBox fx:id="chkNotificationToasts" text="Show desktop toast messages" selected="true" wrapText="true" styleClass="settings-notification-check"/>
        <Label text="Choose which activity categories appear for your user. Critical errors and Security &amp; User Access records always remain in Notification Center." wrapText="true" styleClass="settings-information-text"/>

        <GridPane hgap="16" vgap="10" styleClass="settings-notification-grid">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            </columnConstraints>
            <CheckBox fx:id="chkNotifySales" text="Sales and invoices" selected="true" styleClass="settings-notification-category,notification-category-sales"/>
            <CheckBox fx:id="chkNotifyPurchases" text="Purchases and supplier invoices" selected="true" GridPane.columnIndex="1" styleClass="settings-notification-category,notification-category-purchases"/>
            <CheckBox fx:id="chkNotifyQuotations" text="Quotations and follow-ups" selected="true" GridPane.rowIndex="1" styleClass="settings-notification-category,notification-category-quotations"/>
            <CheckBox fx:id="chkNotifyReturns" text="Sales and purchase returns" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="settings-notification-category,notification-category-returns"/>
            <CheckBox fx:id="chkNotifyPayments" text="Payments and refunds" selected="true" GridPane.rowIndex="2" styleClass="settings-notification-category,notification-category-payments"/>
            <CheckBox fx:id="chkNotifyInventory" text="Inventory and low stock" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="settings-notification-category,notification-category-inventory"/>
            <CheckBox fx:id="chkNotifyBanking" text="Bank, expenses and reconciliation" selected="true" GridPane.rowIndex="3" styleClass="settings-notification-category,notification-category-banking"/>
            <CheckBox fx:id="chkNotifyReports" text="Reports and scheduled reports" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="settings-notification-category,notification-category-reports"/>
            <CheckBox fx:id="chkNotifyReminders" text="Reminders" selected="true" GridPane.rowIndex="4" styleClass="settings-notification-category,notification-category-reminders"/>
            <CheckBox fx:id="chkNotifyCommunication" text="Email &amp; WhatsApp activity" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="settings-notification-category,notification-category-communication"/>
            <CheckBox fx:id="chkNotifyApproval" text="Approvals" selected="true" GridPane.rowIndex="5" styleClass="settings-notification-category,notification-category-approval"/>
            <CheckBox fx:id="chkNotifyImports" text="Data imports" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="5" styleClass="settings-notification-category,notification-category-imports"/>
            <CheckBox fx:id="chkNotifyBackup" text="Backup, restore &amp; safe rollback" selected="true" GridPane.rowIndex="6" styleClass="settings-notification-category,notification-category-backup"/>
            <CheckBox fx:id="chkNotifyUpdate" text="Application updates" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="6" styleClass="settings-notification-category,notification-category-update"/>
            <CheckBox fx:id="chkNotifySystem" text="Other system activity" selected="true" GridPane.rowIndex="7" styleClass="settings-notification-category,notification-category-system"/>
            <CheckBox fx:id="chkNotifySecurity" text="Security &amp; User Access (mandatory)" selected="true" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="7" styleClass="settings-notification-category,notification-category-security"/>
        </GridPane>
    </VBox>
</VBox>
