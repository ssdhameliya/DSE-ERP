<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:id="panelCompany" maxWidth="Infinity" styleClass="settings-card,settings-card-tall-compact">

                            <VBox spacing="3">

                                <Label text="Company &amp; Billing" styleClass="settings-section-title"/>

                                <Label text="Business identity, primary contact details and document branding" wrapText="true" styleClass="settings-section-description"/>

                            </VBox>

                            <GridPane hgap="12" vgap="8">

                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">

                                    <Label text="Company Name" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtCompanyName" promptText="Enter company name" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">

                                    <Label text="Phone" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtPhone" promptText="Enter phone number" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">

                                    <Label text="Company Email" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtEmail" promptText="company@example.com" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="0">

                                    <Label text="GSTIN" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtGstin" promptText="Enter GSTIN" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">

                                    <Label text="PAN" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtCompanyPan" promptText="Enter PAN" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">

                                    <Label text="Business Type" styleClass="settings-form-label"/>

                                    <ComboBox fx:id="cmbBusinessType" promptText="Select business type" maxWidth="Infinity" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="1">

                                    <Label text="Industry" styleClass="settings-form-label"/>

                                    <ComboBox fx:id="cmbIndustry" promptText="Select industry" maxWidth="Infinity" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="1">

                                    <Label text="Financial Year Start" styleClass="settings-form-label"/>

                                    <DatePicker fx:id="dpFinancialYearStart" promptText="Select date" maxWidth="Infinity" styleClass="approved-input"/>

                                </VBox>

                                <!-- Application identity is intentionally kept at the bottom of the primary Company & Billing form. -->
                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="Application Name" styleClass="settings-form-label"/>
                                    <TextField fx:id="txtApplicationName" promptText="DSE ERP" styleClass="approved-input"/>
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="Application Tagline" styleClass="settings-form-label"/>
                                    <TextField fx:id="txtApplicationTagline" promptText="Business Management Suite" styleClass="approved-input"/>
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="2">
                                    <Label text="Startup Message" styleClass="settings-form-label"/>
                                    <TextField fx:id="txtApplicationStartingText" promptText="Starting DSE ERP..." styleClass="approved-input"/>
                                    <Label text="Used on splash and sign-in screens; document branding remains independent." wrapText="true" styleClass="settings-help-text"/>
                                </VBox>

                            </GridPane>




                            <Separator/>
                            <VBox spacing="10" maxWidth="Infinity" styleClass="settings-information-card,settings-application-branding-panel">
                                <VBox spacing="4">
                                    <Label text="Application Branding" styleClass="settings-subsection-title"/>
                                    <Label text="Used consistently on Splash, Login, Forgot Password, Registration and Email / OTP setup screens." wrapText="true" styleClass="settings-help-text"/>
                                </VBox>
                                <GridPane hgap="14" alignment="TOP_LEFT" maxWidth="Infinity" styleClass="settings-brand-assets-row">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="68" hgrow="ALWAYS"/>
                                        <ColumnConstraints percentWidth="32" hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <VBox spacing="7" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="0" styleClass="settings-asset-card,settings-brand-asset-card">
                                        <Label text="Application Banner" styleClass="settings-form-label"/>
                                        <Label text="Wide application artwork • Recommended 1600 × 320" wrapText="true" styleClass="settings-asset-purpose"/>
                                        <StackPane fx:id="applicationBrandPreview" minHeight="88" prefHeight="96" maxHeight="104" maxWidth="Infinity" styleClass="settings-image-preview">
                                            <ImageView fx:id="imgApplicationBrand" preserveRatio="false" smooth="true"/>
                                            <VBox fx:id="placeholderApplicationBrand" alignment="CENTER" spacing="8">
                                                <Label text="▰" styleClass="settings-placeholder-icon"/>
                                                <Label text="No application banner selected" styleClass="settings-help-text"/>
                                            </VBox>
                                        </StackPane>
                                        <Label fx:id="lblApplicationBrandFile" text="No image selected" maxWidth="Infinity" textOverrun="CENTER_ELLIPSIS" styleClass="settings-asset-filename"/>
                                        <HBox spacing="8">
                                            <Button text="Add / Replace" onAction="#uploadApplicationBrand" styleClass="settings-secondary-button,approved-button,approved-primary-button"/>
                                            <Button text="Preview" onAction="#previewApplicationBrand" styleClass="settings-secondary-button,approved-button,approved-secondary-button"/>
                                            <Button text="Remove" onAction="#removeApplicationBrand" styleClass="settings-remove-button,approved-button,approved-danger-button"/>
                                        </HBox>
                                    </VBox>
                                    <VBox spacing="7" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="1" styleClass="settings-asset-card,settings-brand-asset-card">
                                        <Label text="Application Mark / Splash Logo" styleClass="settings-form-label"/>
                                        <Label text="Small square mark shown below the banner • Recommended 512 × 512" wrapText="true" styleClass="settings-asset-purpose"/>
                                        <StackPane fx:id="applicationMarkPreview" minHeight="88" prefHeight="96" maxHeight="104" maxWidth="Infinity" styleClass="settings-image-preview">
                                            <ImageView fx:id="imgApplicationMark" preserveRatio="true" smooth="true"/>
                                            <VBox fx:id="placeholderApplicationMark" alignment="CENTER" spacing="6">
                                                <Label text="◆" styleClass="settings-placeholder-icon"/>
                                                <Label text="No application mark selected" styleClass="settings-help-text"/>
                                            </VBox>
                                        </StackPane>
                                        <Label fx:id="lblApplicationMarkFile" text="No image selected" maxWidth="Infinity" textOverrun="CENTER_ELLIPSIS" styleClass="settings-asset-filename"/>
                                        <HBox spacing="8">
                                            <Button text="Add / Replace" onAction="#uploadApplicationMark" styleClass="settings-secondary-button,approved-button,approved-primary-button"/>
                                            <Button text="Preview" onAction="#previewApplicationMark" styleClass="settings-secondary-button,approved-button,approved-secondary-button"/>
                                            <Button text="Remove" onAction="#removeApplicationMark" styleClass="settings-remove-button,approved-button,approved-danger-button"/>
                                        </HBox>
                                    </VBox>
                                </GridPane>
                            </VBox>
</VBox>


