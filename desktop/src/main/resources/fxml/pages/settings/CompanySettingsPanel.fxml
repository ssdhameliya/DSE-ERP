<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:id="panelCompany" maxWidth="Infinity" styleClass="settings-card,settings-card-tall-compact">

                            <VBox spacing="3">

                                <Label text="Company &amp; Billing" styleClass="settings-section-title"/>

                                <Label text="Business identity, primary contact details and document branding" wrapText="true" styleClass="settings-section-description"/>

                            </VBox>

                            <GridPane hgap="12" vgap="8">

                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">

                                    <Label text="Company Name" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtCompanyName" promptText="Enter company name" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">

                                    <Label text="Phone" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtPhone" promptText="Enter phone number" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">

                                    <Label text="Company Email" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtEmail" promptText="company@example.com" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="0">

                                    <Label text="GSTIN" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtGstin" promptText="Enter GSTIN" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">

                                    <Label text="PAN" styleClass="settings-form-label"/>

                                    <TextField fx:id="txtCompanyPan" promptText="Enter PAN" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">

                                    <Label text="Business Type" styleClass="settings-form-label"/>

                                    <ComboBox fx:id="cmbBusinessType" promptText="Select business type" maxWidth="Infinity" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="1">

                                    <Label text="Industry" styleClass="settings-form-label"/>

                                    <ComboBox fx:id="cmbIndustry" promptText="Select industry" maxWidth="Infinity" styleClass="approved-input"/>

                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="1">

                                    <Label text="Financial Year Start" styleClass="settings-form-label"/>

                                    <DatePicker fx:id="dpFinancialYearStart" promptText="Select date" maxWidth="Infinity" styleClass="approved-input"/>

                                </VBox>

                                <!-- Application identity is intentionally kept at the bottom of the primary Company & Billing form. -->
                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="Application Name" styleClass="settings-form-label"/>
                                    <TextField fx:id="txtApplicationName" promptText="DSE ERP" styleClass="approved-input"/>
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="Application Tagline" styleClass="settings-form-label"/>
                                    <TextField fx:id="txtApplicationTagline" promptText="Business Management Suite" styleClass="approved-input"/>
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="2">
                                    <Label text="Startup Message" styleClass="settings-form-label"/>
                                    <TextField fx:id="txtApplicationStartingText" promptText="Starting DSE ERP..." styleClass="approved-input"/>
                                    <Label text="Used on splash and sign-in screens; document branding remains independent." wrapText="true" styleClass="settings-help-text"/>
                                </VBox>

                            </GridPane>



                        </VBox>

                        
