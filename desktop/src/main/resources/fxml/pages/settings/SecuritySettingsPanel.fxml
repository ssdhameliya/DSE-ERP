<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:id="panelSecurity" spacing="16" maxWidth="Infinity" styleClass="settings-card,settings-card-tall-compact,security-settings-panel">
  <HBox alignment="CENTER_LEFT" spacing="10"><StackPane fx:id="securityHeaderIcon" styleClass="settings-section-icon"/><VBox spacing="3"><Label text="Security &amp; Session" styleClass="settings-section-title"/><Label text="Administrator-controlled inactivity policy shared by all ERP clients." wrapText="true" styleClass="settings-section-description"/></VBox></HBox>
  <Separator/>
  <GridPane hgap="16" vgap="12"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
    <VBox spacing="5"><Label text="Session Timeout (minutes)" styleClass="settings-form-label,field-label-time"/><TextField fx:id="txtSessionTimeoutMinutes" promptText="10" maxWidth="Infinity" styleClass="approved-input"/><Label text="Allowed: 5–120 minutes" styleClass="muted-text"/></VBox>
    <VBox spacing="5" GridPane.columnIndex="1"><Label text="Warning Before Logout (minutes)" styleClass="settings-form-label,field-label-reminder"/><TextField fx:id="txtSessionWarningMinutes" promptText="2" maxWidth="Infinity" styleClass="approved-input"/><Label text="Must be at least 1 minute and less than the timeout." styleClass="muted-text"/></VBox>
  </GridPane>
  <Separator/>
  <VBox spacing="7" styleClass="security-settings-subsection">
    <Label text="Authentication / MFA Policy" styleClass="settings-form-label"/>
    <ComboBox fx:id="cmbMfaPolicy" maxWidth="420" styleClass="approved-input"/>
    <Label text="Required: non-Admin MFA remains mandatory. Admin Controlled: the MFA checkbox in User Access is authoritative. Disabled: password-only login for all users." wrapText="true" styleClass="muted-text"/>
  </VBox>
  <HBox alignment="CENTER_LEFT" spacing="8" styleClass="settings-info-strip"><Label text="The timeout warning uses the same owned-dialog presentation standard as other ERP dialogs. Background refreshes do not count as activity." wrapText="true" styleClass="muted-text"/></HBox>
  <Separator/>
  <VBox spacing="7" styleClass="security-settings-subsection"><CheckBox fx:id="chkUiDiagnostics" text="Enable UI Diagnostics"/><Label text="When enabled, rendered screen, KPI, table and semantic-icon contract results are written to desktop.log and included in the existing Diagnostic Package." wrapText="true" styleClass="muted-text"/></VBox>
</VBox>
