<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:id="panelWorkspace" visible="false" managed="false" maxWidth="Infinity" styleClass="settings-card,workspace-settings-panel">
                            <VBox spacing="3">
                                <Label text="Workspace &amp; Storage" styleClass="settings-section-title"/>
                                <Label text="All business data is kept outside the installed application in one portable workspace." wrapText="true" styleClass="settings-section-description"/>
                            </VBox>
                            <VBox spacing="10" styleClass="settings-information-card">
                                <Label text="Current Workspace" styleClass="settings-subsection-title"/>
                                <Label fx:id="lblWorkspacePath" text="Workspace path" wrapText="true" styleClass="workspace-path-value"/>
                                <Label fx:id="lblWorkspaceStatus" wrapText="true" styleClass="workspace-status-ok,approved-status"/>
                            </VBox>
                            <VBox fx:id="deploymentSection" spacing="10" styleClass="settings-information-card">
                                <Label text="Deployment" styleClass="settings-subsection-title"/>
                                <Label text="Local mode preserves the current single-PC operation. Shared-client mode connects this desktop to one company server after restart." wrapText="true" styleClass="settings-help-text"/>
                                <ComboBox fx:id="cmbDeploymentMode" maxWidth="Infinity"/>
                                <HBox spacing="10"><TextField fx:id="txtCompanyServerUrl" promptText="https://erp.company.local" HBox.hgrow="ALWAYS" styleClass="approved-input"/><Button fx:id="btnTestCompanyServer" text="Test Connection" onAction="#testCompanyServer" styleClass="settings-action-button,settings-secondary-button"/></HBox>
                                <Label fx:id="lblCompanyServerStatus" wrapText="true" styleClass="settings-help-text"/>
                            </VBox>
                            <GridPane hgap="14" vgap="14">
                                <columnConstraints><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/></columnConstraints>
                                <VBox spacing="7" styleClass="workspace-folder-card">
                                    <Label text="Database &amp; Configuration" styleClass="settings-form-label"/>
                                    <Label text="Database/PostgreSQL/data  Config/config.properties" wrapText="true" styleClass="settings-help-text"/>
                                </VBox>
                                <VBox spacing="7" GridPane.columnIndex="1" styleClass="workspace-folder-card">
                                    <Label text="Recovery &amp; Documents" styleClass="settings-form-label"/>
                                    <Label text="Backups • Reports • Attachments • Imports • Exports • Logs" wrapText="true" styleClass="settings-help-text"/>
                                </VBox>
                            </GridPane>
                            <VBox spacing="7" styleClass="settings-security-note">
                                <Label text="Moving the workspace safely" styleClass="settings-form-label"/>
                                <Label text="A move is applied on the next start before managed services open. The original folder is retained, so you always have a recovery copy." wrapText="true" styleClass="settings-help-text"/>
                            </VBox>
                            <FlowPane hgap="10" vgap="10">
                                <Button text="Open Workspace" onAction="#openWorkspaceFolder" styleClass="settings-action-button,settings-secondary-button"/>
                                <Button text="Export Diagnostic Package" onAction="#exportDiagnostics" styleClass="settings-action-button,settings-secondary-button"/>
                                <Button text="Move Workspace" onAction="#moveWorkspace" styleClass="settings-action-button,settings-primary-button"/>
                            </FlowPane>
                        </VBox>


