<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="panelWorkspace" visible="false" managed="false" maxWidth="Infinity"
      spacing="16" styleClass="settings-card,workspace-settings-panel">
    <VBox spacing="4" styleClass="workspace-page-heading">
        <Label text="Workspace &amp; Storage" styleClass="settings-section-title"/>
        <Label text="Business evidence stays protected while operational logs, reports, exports and temporary files follow administrator-defined retention rules."
               wrapText="true" styleClass="settings-section-description"/>
    </VBox>

    <VBox spacing="8" styleClass="workspace-section">
        <Label text="Current Workspace" styleClass="settings-subsection-title"/>
        <Label fx:id="lblWorkspacePath" text="Workspace path" wrapText="true" styleClass="workspace-path-value"/>
        <Label fx:id="lblWorkspaceStatus" wrapText="true" styleClass="workspace-status-ok,approved-status"/>
    </VBox>
    <Separator styleClass="workspace-separator"/>

    <VBox fx:id="deploymentSection" spacing="10" styleClass="workspace-section">
        <Label text="Deployment" styleClass="settings-subsection-title"/>
        <Label text="Local mode preserves this PC. Shared-client mode connects this desktop to one verified company server after restart."
               wrapText="true" styleClass="settings-help-text"/>
        <GridPane hgap="18" vgap="8" styleClass="workspace-deployment-grid">
            <columnConstraints><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/></columnConstraints>
            <VBox spacing="5">
                <Label text="Connection mode" styleClass="settings-form-label"/>
                <ComboBox fx:id="cmbDeploymentMode" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="5" GridPane.columnIndex="1">
                <Label text="Environment" styleClass="settings-form-label"/>
                <ComboBox fx:id="cmbDeploymentEnvironment" maxWidth="Infinity"/>
            </VBox>
        </GridPane>
        <Label text="Use UAT while testing cloud deployment. Change to PROD only for the approved production endpoint." wrapText="true" styleClass="settings-help-text"/>
        <VBox spacing="5">
            <Label text="Company server URL" styleClass="settings-form-label"/>
            <HBox spacing="10">
                <TextField fx:id="txtCompanyServerUrl" promptText="https://erp.company.local" HBox.hgrow="ALWAYS" styleClass="approved-input"/>
                <Button fx:id="btnTestCompanyServer" text="Test Connection" onAction="#testCompanyServer"
                        minWidth="150" styleClass="settings-action-button,settings-secondary-button"/>
            </HBox>
        </VBox>
        <Label fx:id="lblCompanyServerStatus" wrapText="true" styleClass="settings-help-text"/>
    </VBox>
    <Separator styleClass="workspace-separator"/>

    <VBox spacing="10" styleClass="workspace-section">
        <Label text="Protected Workspace Data" styleClass="settings-subsection-title"/>
        <GridPane hgap="24" vgap="8">
            <columnConstraints><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/></columnConstraints>
            <VBox spacing="4"><Label text="Database &amp; Configuration" styleClass="settings-form-label"/><Label text="PostgreSQL data and application configuration are never automatically deleted." wrapText="true" styleClass="settings-help-text"/></VBox>
            <VBox spacing="4" GridPane.columnIndex="1"><Label text="Permanent Business Evidence" styleClass="settings-form-label"/><Label text="Documents, attachments and backups are permanently excluded from storage cleanup." wrapText="true" styleClass="settings-help-text"/></VBox>
        </GridPane>
    </VBox>
    <Separator styleClass="workspace-separator"/>

    <VBox spacing="10" styleClass="workspace-section">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Storage Usage" styleClass="settings-subsection-title"/>
                <Label text="Live sizes from the active company workspace." styleClass="settings-help-text"/>
            </VBox>
            <Button text="Refresh Usage" onAction="#refreshStorageUsage" styleClass="settings-action-button,settings-secondary-button"/>
        </HBox>
        <GridPane hgap="24" vgap="12" styleClass="workspace-metric-grid">
            <columnConstraints><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/></columnConstraints>
            <VBox spacing="3"><Label text="Documents" styleClass="settings-form-label"/><Label fx:id="lblStorageDocuments" text="—" styleClass="workspace-metric-value"/></VBox>
            <VBox spacing="3" GridPane.columnIndex="1"><Label text="Attachments" styleClass="settings-form-label"/><Label fx:id="lblStorageAttachments" text="—" styleClass="workspace-metric-value"/></VBox>
            <VBox spacing="3" GridPane.rowIndex="1"><Label text="Reports / Exports" styleClass="settings-form-label"/><Label fx:id="lblStorageReportsExports" text="—" styleClass="workspace-metric-value"/></VBox>
            <VBox spacing="3" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label text="Logs / Temp" styleClass="settings-form-label"/><Label fx:id="lblStorageLogsTemp" text="—" styleClass="workspace-metric-value"/></VBox>
        </GridPane>
        <Label fx:id="lblStorageTotal" text="Total managed storage: —" styleClass="settings-form-label"/>
        <Label fx:id="lblLastCleanup" text="Last cleanup: Never run" wrapText="true" styleClass="settings-help-text"/>
    </VBox>
    <Separator styleClass="workspace-separator"/>

    <VBox fx:id="storageRetentionSection" spacing="10" styleClass="workspace-section">
        <Label text="Storage Retention" styleClass="settings-subsection-title"/>
        <Label text="Only operational files are eligible. Business documents, attachments, backups and database records remain protected."
               wrapText="true" styleClass="settings-help-text"/>
        <GridPane hgap="22" vgap="11">
            <columnConstraints><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/></columnConstraints>
            <VBox spacing="5"><Label text="Logs retention" styleClass="settings-form-label"/><HBox spacing="8" alignment="CENTER_LEFT"><TextField fx:id="txtLogRetentionDays" promptText="30" HBox.hgrow="ALWAYS" styleClass="approved-input"/><Label text="days" styleClass="workspace-unit-label"/></HBox></VBox>
            <VBox spacing="5" GridPane.columnIndex="1"><Label text="Reports retention" styleClass="settings-form-label"/><HBox spacing="8" alignment="CENTER_LEFT"><TextField fx:id="txtReportRetentionDays" promptText="365" HBox.hgrow="ALWAYS" styleClass="approved-input"/><Label text="days" styleClass="workspace-unit-label"/></HBox></VBox>
            <VBox spacing="5" GridPane.rowIndex="1"><Label text="Exports retention" styleClass="settings-form-label"/><HBox spacing="8" alignment="CENTER_LEFT"><TextField fx:id="txtExportRetentionDays" promptText="90" HBox.hgrow="ALWAYS" styleClass="approved-input"/><Label text="days" styleClass="workspace-unit-label"/></HBox></VBox>
            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label text="Diagnostic ZIP retention" styleClass="settings-form-label"/><HBox spacing="8" alignment="CENTER_LEFT"><TextField fx:id="txtDiagnosticRetentionDays" promptText="30" HBox.hgrow="ALWAYS" styleClass="approved-input"/><Label text="days" styleClass="workspace-unit-label"/></HBox></VBox>
            <VBox spacing="5" GridPane.rowIndex="2"><Label text="Import result retention" styleClass="settings-form-label"/><HBox spacing="8" alignment="CENTER_LEFT"><TextField fx:id="txtImportResultRetentionDays" promptText="90" HBox.hgrow="ALWAYS" styleClass="approved-input"/><Label text="days" styleClass="workspace-unit-label"/></HBox></VBox>
            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2"><Label text="Temporary files retention" styleClass="settings-form-label"/><HBox spacing="8" alignment="CENTER_LEFT"><TextField fx:id="txtTempRetentionDays" promptText="7" HBox.hgrow="ALWAYS" styleClass="approved-input"/><Label text="days" styleClass="workspace-unit-label"/></HBox></VBox>
            <VBox spacing="5" GridPane.rowIndex="3"><Label text="Old log archives" styleClass="settings-form-label"/><CheckBox fx:id="chkCompressOldLogs" text="Compress eligible old logs"/></VBox>
        </GridPane>
        <FlowPane hgap="10" vgap="10"><Button text="Preview Cleanup" onAction="#previewStorageCleanup" styleClass="settings-action-button,settings-secondary-button"/><Button text="Clean Now" onAction="#cleanStorageNow" styleClass="settings-action-button,settings-primary-button"/></FlowPane>
        <Label text="Default policy: Logs 30 • Reports 365 • Exports 90 • Import results 90 • Diagnostics 30 • Temp 7 days." wrapText="true" styleClass="settings-help-text"/>
    </VBox>

    <VBox spacing="6" styleClass="workspace-safety-strip">
        <Label text="Safe Cleanup Boundary" styleClass="settings-form-label"/>
        <Label text="Cleanup never targets Documents, Attachments, Backups or Database. It can remove only expired Reports, Exports, Temp files and non-active Log archives." wrapText="true" styleClass="settings-help-text"/>
    </VBox>

    <FlowPane hgap="10" vgap="10" styleClass="workspace-actions">
        <Button text="Open Workspace" onAction="#openWorkspaceFolder" styleClass="settings-action-button,settings-secondary-button"/>
        <Button text="Open Documents" onAction="#openDocumentsFolder" styleClass="settings-action-button,settings-secondary-button"/>
        <Button text="Open Reports" onAction="#openReportsFolder" styleClass="settings-action-button,settings-secondary-button"/>
        <Button text="Open Logs" onAction="#openLogsFolder" styleClass="settings-action-button,settings-secondary-button"/>
        <Button text="Export Diagnostic Package" onAction="#exportDiagnostics" styleClass="settings-action-button,settings-secondary-button"/>
        <Button text="Select Existing Workspace" onAction="#selectExistingWorkspace" styleClass="settings-action-button,settings-secondary-button"/>
        <Button text="Move Workspace" onAction="#moveWorkspace" styleClass="settings-action-button,settings-primary-button"/>
    </FlowPane>
</VBox>
