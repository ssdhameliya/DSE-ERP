+@Composable private fun ConnectionChip(online:Boolean?,pending:Int){
+ val icon=when(online){true->Icons.Rounded.CloudDone;false->Icons.Rounded.CloudOff;null->Icons.Rounded.Sync}
+ val accent=if(online==false)MaterialTheme.colorScheme.error else if(pending>0)DseWarning else MaterialTheme.colorScheme.primary
+ val label=when{online==false&&pending>0->"Offline • $pending";online==false->"Offline";pending>0->"$pending pending";else->""}
+ Surface(shape=RoundedCornerShape(999.dp),color=accent.copy(.09f),border=androidx.compose.foundation.BorderStroke(1.dp,accent.copy(.16f))){
+  Row(Modifier.padding(horizontal=if(label.isBlank())7.dp else 8.dp,vertical=5.dp),verticalAlignment=Alignment.CenterVertically,horizontalArrangement=Arrangement.spacedBy(4.dp)){
+   Icon(icon,when(online){true->"Online";false->"Offline";null->"Checking"},Modifier.size(17.dp),tint=accent)
+   if(label.isNotBlank())Text(label,style=MaterialTheme.typography.labelSmall,color=accent,fontWeight=FontWeight.Bold)
+  }
+ }
+}
 private fun tabIcon(t:MainTab)=when(t){MainTab.DASHBOARD->Icons.Rounded.Dashboard;MainTab.SALES->Icons.Rounded.ReceiptLong;MainTab.PURCHASE->Icons.Rounded.ShoppingCart;MainTab.BANK->Icons.Rounded.AccountBalance;MainTab.IMPORT->Icons.Rounded.UploadFile;MainTab.MORE->Icons.Rounded.MoreHoriz}
 private fun displayName(u:UserPayload?)=u?.fullName?.takeIf{it.isNotBlank()}?:u?.username.orEmpty()
 private fun UserProfile.toUserPayload()=UserPayload(id=id,username=username,fullName=fullName,role=role,email=email,active=active,department=department,branch=branch,accessLevel=accessLevel,locked=locked,mfaEnabled=mfaEnabled)
