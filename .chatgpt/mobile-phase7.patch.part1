+private fun semanticKeyboardType(label:String):KeyboardType {
+    val key=label.lowercase()
+    return when {
+        "email" in key -> KeyboardType.Email
+        "phone" in key || "mobile" in key || "telephone" in key -> KeyboardType.Phone
+        "url" in key || "website" in key -> KeyboardType.Uri
+        else -> KeyboardType.Text
+    }
+}
