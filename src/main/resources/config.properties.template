# Runtime configuration is created inside the selected DSE ERP workspace:
#   <workspace>/Config/config.properties
# A small pointer in the operating-system application-data folder remembers
# the chosen workspace location.

# Company & email
company.email=
company.name=
company.phone=

# Theme (LIGHT or DARK)
theme=LIGHT

# PostgreSQL (password is read from DSE_DB_PASSWORD by default)
db.url=jdbc:postgresql://localhost:5432/dse_erp
db.username=dse_erp_app
migration.autoPostgres=true
migration.postgres.url=jdbc:postgresql://localhost:5432/dse_erp

# SMTP
smtp.host=
smtp.port=587
smtp.email=
smtp.appPassword=

# Payment / Bank details
payment.bankName=
payment.accountNumber=
payment.ifsc=
payment.upi=

# WhatsApp sender phone (international format without +)
whatsapp.senderPhone=

# Application updates (GitHub Releases)
update.github.owner=ssdhameliya
update.github.repository=DSE-ERP
update.channel=STABLE
update.checkAtStartup=true
update.downloadInBackground=false

# Update installation mode: AUTOMATIC uses a detached helper and falls back to the normal installer if required.
update.installMode=AUTOMATIC
