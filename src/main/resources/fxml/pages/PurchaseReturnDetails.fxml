<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><!-- Purchase Return Details: actions, document summary, line items, attachments and notes. --><ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" hbarPolicy="NEVER" fx:controller="org.example.controller.PurchaseReturnDetailsController" styleClass="purchase-scroll,approved-ui,approved-screen,approved-screen-purchase-return-details">
  <content>
    <VBox spacing="14" styleClass="purchase-page">
      <padding><Insets top="14" right="14" bottom="18" left="14"/></padding>
      <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back" onAction="#back" styleClass="approved-button,approved-secondary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Edit" onAction="#edit" styleClass="approved-button,approved-secondary-button"/>
        <Button text="Print / PDF" onAction="#print" styleClass="approved-button,approved-secondary-button"/>
        <Button text="Attach Document" onAction="#attach" styleClass="approved-button,approved-secondary-button"/>
        <Button text="Create Refund" onAction="#refund" styleClass="purchase-primary,approved-button,approved-primary-button"/>
      </HBox>
      <HBox spacing="14">
        <VBox spacing="12" styleClass="purchase-card,approved-surface" HBox.hgrow="ALWAYS">
          <HBox spacing="10"><Label fx:id="no" styleClass="purchase-section-title"/><Label fx:id="status" styleClass="pill-success"/></HBox>
          <GridPane hgap="28" vgap="10">
            <Label text="Return Date"/><Label fx:id="date" GridPane.columnIndex="1"/>
            <Label text="Total Amount" GridPane.columnIndex="2"/><Label fx:id="total" GridPane.columnIndex="3"/>
            <Label text="Purchase No." GridPane.rowIndex="1"/><Label fx:id="purchase" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Refund Status" GridPane.rowIndex="1" GridPane.columnIndex="2"/><Label fx:id="refundStatus" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
            <Label text="Supplier" GridPane.rowIndex="2"/><Label fx:id="supplier" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Created On" GridPane.rowIndex="2" GridPane.columnIndex="2"/><Label fx:id="created" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
            <Label text="Return Type" GridPane.rowIndex="3"/><Label fx:id="type" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Last Updated" GridPane.rowIndex="3" GridPane.columnIndex="2"/><Label fx:id="updated" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
            <Label text="Payment Terms" GridPane.rowIndex="4"/><Label fx:id="terms" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Currency" GridPane.rowIndex="5"/><Label fx:id="currency" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
          </GridPane>
        </VBox>
        <VBox spacing="12" styleClass="purchase-card,approved-surface" prefWidth="300">
          <Label text="Summary" styleClass="purchase-section-title"/><Label text="Refund Amount"/><Label fx:id="refund" styleClass="purchase-total"/>
        </VBox>
      </HBox>
      <VBox spacing="10" styleClass="purchase-card,approved-surface">
        <Label text="Return Items" styleClass="purchase-section-title"/>
        <TableView fx:id="table" prefHeight="280" styleClass="approved-table">
          <columns>
            <TableColumn fx:id="cName" text="Item Name" prefWidth="260" styleClass="approved-table-column"/>
            <TableColumn fx:id="cCode" text="Item Code" styleClass="approved-table-column"/>
            <TableColumn fx:id="cQty" text="Qty" styleClass="approved-table-column"/>
            <TableColumn fx:id="cUnit" text="Unit" styleClass="approved-table-column"/>
            <TableColumn fx:id="cRate" text="Rate" styleClass="approved-table-column"/>
            <TableColumn fx:id="cTax" text="Tax (%)" styleClass="approved-table-column"/>
            <TableColumn fx:id="cAmount" text="Amount" styleClass="approved-table-column"/>
            <TableColumn fx:id="cReason" text="Reason" prefWidth="180" styleClass="approved-table-column"/>
          </columns>
        </TableView>
      </VBox>
      <HBox spacing="14">
        <VBox spacing="8" styleClass="purchase-card,approved-surface" HBox.hgrow="ALWAYS"><Label text="Attachments" styleClass="purchase-section-title"/><Label fx:id="attachment" text="No attachment" wrapText="true"/></VBox>
        <VBox spacing="8" styleClass="purchase-card,approved-surface" HBox.hgrow="ALWAYS"><Label text="Notes / Remarks" styleClass="purchase-section-title"/><Label fx:id="notes" wrapText="true"/></VBox>
      </HBox>
    </VBox>
  </content>
</ScrollPane>