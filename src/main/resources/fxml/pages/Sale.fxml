<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.SalesController"
      fx:id="salesEntryRoot"
      spacing="10"
      styleClass="purchase-page,sales-entry-page,sales-entry-fixed-root,approved-ui,approved-screen,approved-screen-sale,erp-screen-root">
    <padding><Insets top="12" right="14" bottom="10" left="14"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="sales-entry-header,approved-section-header">
        <StackPane styleClass="sales-entry-title-icon"><Label text=""/></StackPane>
        <VBox spacing="2">
            <Label text="Create Sale Invoice" styleClass="sales-entry-page-title"/>
            <Label text="Create a new sale invoice for your customer" styleClass="sales-entry-page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Back to Sales" onAction="#cancel"
                styleClass="sales-entry-back-button,approved-button,approved-secondary-button"/>
    </HBox>

    <HBox spacing="12" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <VBox spacing="10" styleClass="purchase-card,flow-card,sales-entry-card,sales-entry-customer-card">
                <Label text="Customer &amp; Invoice Details"
                       styleClass="flow-title,sales-entry-section-title,sales-entry-section-customer"/>
                <GridPane hgap="12" vgap="9">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="34"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="20.5"/>
                        <ColumnConstraints percentWidth="20.5"/>
                    </columnConstraints>

                    <VBox spacing="4">
                        <Label text="Customer *" styleClass="sales-entry-field-label,field-label-customer"/>
                        <HBox spacing="7">
                            <ComboBox fx:id="cmbCustomer" promptText="Select customer..."
                                      maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="approved-input"/>
                            <Button fx:id="btnAddCustomer" text="New Customer" onAction="#addCustomer"
                                    styleClass="sales-entry-new-button,approved-button,approved-primary-button"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="1">
                        <Label text="Invoice No. *" styleClass="sales-entry-field-label,field-label-invoice"/>
                        <TextField fx:id="txtInvoiceNo" editable="false" styleClass="approved-input"/>
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="2">
                        <Label text="Invoice Date *" styleClass="sales-entry-field-label,field-label-date"/>
                        <DatePicker fx:id="dpInvoiceDate" maxWidth="Infinity" styleClass="approved-input"/>
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="3">
                        <Label text="PO Date" styleClass="sales-entry-field-label,field-label-due"/>
                        <DatePicker fx:id="dpDueDate" maxWidth="Infinity" styleClass="approved-input"/>
                    </VBox>

                    <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnSpan="2">
                        <Label text="Billing Address *" styleClass="sales-entry-field-label,field-label-address"/>
                        <TextArea fx:id="txtBillingAddress" promptText="Billing address..."
                                  prefRowCount="4" prefHeight="88" wrapText="true" maxWidth="Infinity"
                                  styleClass="approved-input,sales-entry-delivery-area,sales-entry-address-area"/>
                    </VBox>

                    <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="2" GridPane.columnSpan="2">
                        <Label text="Delivery Address *" styleClass="sales-entry-field-label,field-label-address"/>
                        <TextArea fx:id="txtDeliveryAddress" promptText="Enter delivery address..."
                                  prefRowCount="4" prefHeight="88" wrapText="true" maxWidth="Infinity"
                                  styleClass="approved-input,sales-entry-delivery-area,sales-entry-address-area"/>
                    </VBox>

                    <VBox spacing="4" GridPane.rowIndex="2">
                        <Label text="Payment Terms" styleClass="sales-entry-field-label,field-label-payment"/>
                        <ComboBox fx:id="cmbPaymentTerms" maxWidth="Infinity" promptText="Select payment terms..."
                                  styleClass="approved-input,sales-entry-payment-terms"/>
                    </VBox>

                    <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnIndex="1">
                        <Label text="Charges Type" styleClass="sales-entry-field-label,field-label-payment"/>
                        <ComboBox fx:id="cmbChargeType" maxWidth="Infinity" promptText="Select charges..."
                                  styleClass="approved-input,sales-entry-charge-type"/>
                    </VBox>

                    <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnIndex="2">
                        <Label text="Charge Amount" styleClass="sales-entry-field-label,field-label-payment"/>
                        <TextField fx:id="txtChargeAmount" text="0" promptText="0.00"
                                   styleClass="approved-input,sales-entry-charge-amount"/>
                    </VBox>
                    <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnIndex="3">
                        <Label text="Order No." styleClass="sales-entry-field-label,field-label-invoice"/>
                        <TextField fx:id="txtOrderNo" promptText="Enter order no. (optional)"
                                   styleClass="approved-input,sales-entry-order-field"/>
                    </VBox>
                </GridPane>

                <!-- Compatibility/backing controls retained but removed from the visible workflow. -->
                <TextArea fx:id="txtRemarks" visible="false" managed="false"/>
                <Label fx:id="lblInvoiceDisplay" visible="false" managed="false"/>
                <ComboBox fx:id="cmbSalesPerson" visible="false" managed="false"/>
                <TextField fx:id="txtOtherCharges" text="0" visible="false" managed="false"/>
                <TextField fx:id="txtTransport" text="0" visible="false" managed="false"/>
                <TextField fx:id="txtReference" visible="false" managed="false"/>
                <TextField fx:id="txtAttachment" visible="false" managed="false"/>
                <TextArea fx:id="txtInvoiceMessage" text="" visible="false" managed="false"/>
            </VBox>

            <VBox spacing="8" styleClass="purchase-card,flow-card,sales-entry-card,sales-entry-items-card" VBox.vgrow="ALWAYS">
                <Label text="Invoice Items" styleClass="flow-title,sales-entry-section-title,sales-entry-section-items"/>
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="sales-entry-line-toolbar,approved-toolbar">
                    <ComboBox fx:id="cmbItem" promptText="Search item by name / code..."
                              minWidth="230" HBox.hgrow="ALWAYS" styleClass="approved-input"/>
                    <TextField fx:id="txtQuantity" promptText="Qty" prefWidth="92" styleClass="approved-input"/>
                    <TextField fx:id="txtRate" promptText="Rate (₹)" prefWidth="112" styleClass="approved-input"/>
                    <TextField fx:id="txtLineDiscount" promptText="Discount %" prefWidth="106" styleClass="approved-input"/>
                    <TextField fx:id="txtGST" promptText="GST %" prefWidth="90" styleClass="approved-input"/>
                    <Button fx:id="btnAddLine" text="Add Item" onAction="#addLine"
                            styleClass="sales-entry-add-button,approved-button,approved-primary-button"/>
                    <Button fx:id="btnRemoveLine" text="Remove" onAction="#removeLine"
                            styleClass="sales-entry-remove-button,approved-button,approved-danger-button"/>
                    <CheckBox fx:id="chkSameAsBilling" text="Same as Billing Address" selected="true"
                              styleClass="sales-entry-same-address,sales-entry-action-toggle"/>
                </HBox>

                <TableView fx:id="tableLines" minHeight="190" VBox.vgrow="ALWAYS"
                           styleClass="sales-entry-table,approved-table,erp-table-profile-line-item">
                    <placeholder>
                        <VBox alignment="CENTER" spacing="5" styleClass="sales-entry-empty-state">
                            <Label text="No items added yet" styleClass="sales-entry-empty-title"/>
                            <Label text="Search and add items to create your invoice" styleClass="sales-entry-empty-message"/>
                        </VBox>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colItem" text="Item Name" prefWidth="270" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colQuantity" text="Qty" prefWidth="75" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colRate" text="Rate (₹)" prefWidth="105" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colDiscount" text="Discount %" prefWidth="92" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colDiscountAmount" text="Discount (₹)" prefWidth="112" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colGst" text="GST %" prefWidth="78" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colNetAmount" text="Taxable (₹)" prefWidth="120" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colGstAmount" text="GST Amount (₹)" prefWidth="125" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colTotal" text="Amount (₹)" prefWidth="125" styleClass="approved-table-column"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="sales-entry-table-summary">
                    <Label text="Total Items:" styleClass="sales-entry-summary-caption,sales-entry-summary-caption-items"/>
                    <Label fx:id="lblTotalItems" text="0" styleClass="sales-entry-summary-value"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Discount" styleClass="sales-entry-summary-caption,sales-entry-summary-caption-discount"/>
                    <Label fx:id="lblBottomDiscount" text="₹ 0.00" styleClass="sales-entry-summary-discount"/>
                    <Label text="GST" styleClass="sales-entry-summary-caption,sales-entry-summary-caption-tax"/>
                    <Label fx:id="lblBottomTax" text="₹ 0.00" styleClass="sales-entry-summary-tax"/>
                    <Label text="Charges" styleClass="sales-entry-summary-caption,sales-entry-summary-caption-charges"/>
                    <Label fx:id="lblBottomCharges" text="₹ 0.00" styleClass="sales-entry-summary-charges"/>
                    <Label text="Net" styleClass="sales-entry-summary-caption,sales-entry-summary-caption-net"/>
                    <Label fx:id="lblBottomNet" text="₹ 0.00" styleClass="sales-entry-summary-net"/>
                </HBox>
            </VBox>

        </VBox>

        <VBox spacing="10" prefWidth="300" minWidth="285" maxWidth="330">
            <VBox spacing="10" styleClass="purchase-card,flow-card,sales-entry-card,sales-entry-summary-card">
                <Label text="Invoice Summary" styleClass="flow-title,sales-entry-section-title,sales-entry-section-summary"/>
                <HBox styleClass="sales-summary-row,sales-summary-subtotal"><Label text="Sub Total" styleClass="sales-summary-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblNetAmount" styleClass="money-strong,sales-summary-value"/></HBox>
                <HBox styleClass="sales-summary-row,sales-summary-discount"><Label text="Total Discount" styleClass="sales-summary-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblDiscount" styleClass="sales-entry-discount-text,sales-summary-value"/></HBox>
                <HBox styleClass="sales-summary-row,sales-summary-taxable"><Label text="Taxable Amount" styleClass="sales-summary-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblTaxableAmount" text="₹ 0.00" styleClass="sales-summary-value,sales-summary-taxable-value"/></HBox>
                <HBox styleClass="sales-summary-row,sales-summary-charges"><Label fx:id="lblChargeCaption" text="Charges" styleClass="sales-summary-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblCharges" text="₹ 0.00" styleClass="sales-summary-value,sales-summary-charges-value"/></HBox>
                <HBox styleClass="sales-summary-row,sales-summary-tax"><Label text="Total GST" styleClass="sales-summary-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblGst" styleClass="blue-text,sales-summary-value"/></HBox>
                <Separator/>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Total Amount" styleClass="flow-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblGrandTotal" styleClass="money-large"/>
                </HBox>
            </VBox>

            <VBox spacing="9" styleClass="purchase-card,flow-card,sales-entry-card,sales-entry-transport-card">
                <Label text="Tax &amp; Transport Details"
                       styleClass="flow-title,sales-entry-section-title,sales-entry-section-transport"/>
                <GridPane hgap="9" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <VBox spacing="4">
                        <Label text="GST Type *" styleClass="sales-entry-field-label,field-label-tax"/>
                        <ComboBox fx:id="cmbGstType" promptText="Select GST type..." maxWidth="Infinity"
                                  styleClass="approved-input,sales-entry-tax-input"/>
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="1">
                        <Label text="GSTIN" styleClass="sales-entry-field-label,field-label-tax"/>
                        <TextField fx:id="txtGstin" promptText="Customer GSTIN..." maxWidth="Infinity"
                                   styleClass="approved-input,sales-entry-gstin-input"/>
                    </VBox>

                    <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnSpan="2">
                        <Label text="Transporter" styleClass="sales-entry-field-label,field-label-delivery"/>
                        <ComboBox fx:id="cmbTransporter" promptText="Select transporter..." maxWidth="Infinity"
                                  styleClass="approved-input"/>
                    </VBox>

                    <VBox spacing="4" GridPane.rowIndex="2">
                        <Label text="Door Delivery" styleClass="sales-entry-field-label,field-label-delivery"/>
                        <ComboBox fx:id="cmbDoorDelivery" promptText="Select..." maxWidth="Infinity"
                                  styleClass="approved-input,sales-entry-door-delivery"/>
                    </VBox>
                    <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnIndex="1">
                        <Label text="Vehicle Number" styleClass="sales-entry-field-label"/>
                        <TextField fx:id="txtVehicleNumber" promptText="Vehicle number..." styleClass="approved-input"/>
                    </VBox>

                    <VBox spacing="4" GridPane.rowIndex="3">
                        <Label text="Contact Person" styleClass="sales-entry-field-label"/>
                        <TextField fx:id="txtContactPerson" promptText="Contact person..." styleClass="approved-input"/>
                    </VBox>
                    <VBox spacing="4" GridPane.rowIndex="3" GridPane.columnIndex="1">
                        <Label text="Contact Mobile" styleClass="sales-entry-field-label,field-label-delivery"/>
                        <TextField fx:id="txtContactPersonMobile" promptText="Mobile number..." styleClass="approved-input"/>
                    </VBox>

                    <VBox spacing="4" GridPane.rowIndex="4" GridPane.columnSpan="2">
                        <Label text="Note" styleClass="sales-entry-field-label"/>
                        <TextField fx:id="txtTransportNote" promptText="Transport note..." maxWidth="Infinity"
                                   styleClass="approved-input"/>
                    </VBox>
                </GridPane>
            </VBox>

            <VBox spacing="10" styleClass="purchase-card,flow-card,sales-entry-card,sales-entry-actions-card">
                <Label text="Action Needed"
                       styleClass="flow-title,sales-entry-section-title,sales-entry-section-actions"/>
                <HBox alignment="CENTER" spacing="10" styleClass="sales-entry-side-actions">
                    <Button text="Cancel" onAction="#cancel" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            styleClass="sales-entry-cancel-button,approved-button,approved-secondary-button"/>
                    <Button fx:id="btnSaveSale" text="Save" onAction="#saveSale" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            styleClass="sales-entry-save-button,approved-button,approved-primary-button"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
