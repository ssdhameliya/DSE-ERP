<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.SalesController"
      fx:id="salesEntryRoot"
      spacing="10"
      styleClass="purchase-page,sales-entry-page,sales-entry-fixed-root,approved-ui,approved-screen,approved-screen-sale,erp-screen-root">

    <padding>
        <Insets top="12" right="14" bottom="10" left="14"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="sales-entry-header,approved-section-header">
        <StackPane styleClass="sales-entry-title-icon">
            <Label text=""/>
        </StackPane>
        <VBox spacing="2">
            <Label text="Create Sale Invoice" styleClass="sales-entry-page-title"/>
            <Label text="Create a new sale invoice for your customer" styleClass="sales-entry-page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Back to Sales" onAction="#cancel"
                styleClass="sales-entry-back-button,approved-button,approved-secondary-button"/>
    </HBox>

    <HBox spacing="12" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS">

            <VBox spacing="10" styleClass="purchase-card,flow-card,sales-entry-card,sales-entry-customer-card">
                <Label text="Customer &amp; Invoice Details"
                       styleClass="flow-title,sales-entry-section-title,sales-entry-section-customer"/>

                <GridPane hgap="12" vgap="9">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="34"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="20.5"/>
                        <ColumnConstraints percentWidth="20.5"/>
                    </columnConstraints>

                    <VBox spacing="4">
                        <Label text="Customer *" styleClass="sales-entry-field-label,field-label-customer"/>
                        <HBox spacing="7">
                            <ComboBox fx:id="cmbCustomer" promptText="Select customer..."
                                      maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="approved-input"/>
                            <Button fx:id="btnAddCustomer" text="New Customer" onAction="#addCustomer"
                                    styleClass="sales-entry-new-button,approved-button,approved-primary-button"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="1">
                        <Label text="Invoice No. *" styleClass="sales-entry-field-label,field-label-invoice"/>
                        <TextField fx:id="txtInvoiceNo" editable="false" styleClass="approved-input"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="2">
                        <Label text="Invoice Date *" styleClass="sales-entry-field-label,field-label-date"/>
                        <DatePicker fx:id="dpInvoiceDate" maxWidth="Infinity" styleClass="approved-input"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="3">
                        <Label text="Due Date" styleClass="sales-entry-field-label,field-label-due"/>
                        <DatePicker fx:id="dpDueDate" maxWidth="Infinity" styleClass="approved-input"/>
                    </VBox>

                    <VBox spacing="4" GridPane.rowIndex="1">
                        <Label text="Billing Address *" styleClass="sales-entry-field-label,field-label-address"/>
                        <HBox spacing="7">
                            <ComboBox fx:id="cmbBillingAddress" promptText="Select billing address..."
                                      maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="approved-input"/>
                            <Button text="New Address" onAction="#addCustomer"
                                    styleClass="sales-entry-new-button,approved-button,approved-primary-button"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <Label text="Payment Terms" styleClass="sales-entry-field-label,field-label-payment"/>
                        <ComboBox fx:id="cmbPaymentTerms" maxWidth="Infinity" styleClass="approved-input"/>
                    </VBox>

                    <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="2" GridPane.columnSpan="2">
                        <Label text="Delivery Status" styleClass="sales-entry-field-label,field-label-delivery"/>
                        <ComboBox fx:id="cmbDeliveryStatus" maxWidth="Infinity" styleClass="approved-input"/>
                    </VBox>

                    <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnSpan="4">
                        <Label text="Additional Reference (Optional)"
                               styleClass="sales-entry-field-label,field-label-reference"/>
                        <TextField fx:id="txtReference"
                                   promptText="Enter reference / PO / challan number..."
                                   styleClass="approved-input"/>
                    </VBox>
                </GridPane>

                <!-- Controller compatibility fields that are intentionally not part of this compact layout. -->
                <TextArea fx:id="txtBillingAddress" visible="false" managed="false"/>
                <Label fx:id="lblInvoiceDisplay" visible="false" managed="false"/>
                <ComboBox fx:id="cmbSalesPerson" visible="false" managed="false"/>
                <TextArea fx:id="txtDeliveryAddress" visible="false" managed="false"/>
                <TextField fx:id="txtOtherCharges" text="0" visible="false" managed="false"/>
                <TextField fx:id="txtTransport" text="0" visible="false" managed="false"/>
                <TextField fx:id="txtAttachment" visible="false" managed="false"/>
                <TextArea fx:id="txtInvoiceMessage" text="Thank you for your business." visible="false" managed="false"/>
            </VBox>

            <VBox spacing="8" styleClass="purchase-card,flow-card,sales-entry-card,sales-entry-items-card"
                  VBox.vgrow="ALWAYS">
                <Label text="Invoice Items"
                       styleClass="flow-title,sales-entry-section-title,sales-entry-section-items"/>

                <HBox spacing="8" alignment="CENTER_LEFT"
                      styleClass="sales-entry-line-toolbar,approved-toolbar">
                    <ComboBox fx:id="cmbItem" promptText="Search item by name / code..."
                              minWidth="230" HBox.hgrow="ALWAYS" styleClass="approved-input"/>
                    <TextField fx:id="txtQuantity" promptText="Qty" prefWidth="92" styleClass="approved-input"/>
                    <TextField fx:id="txtRate" promptText="Rate (₹)" prefWidth="112" styleClass="approved-input"/>
                    <TextField fx:id="txtLineDiscount" promptText="Discount %" prefWidth="106" styleClass="approved-input"/>
                    <TextField fx:id="txtGST" promptText="Tax %" prefWidth="90" styleClass="approved-input"/>
                    <Button fx:id="btnAddLine" text="Add Item" onAction="#addLine"
                            styleClass="sales-entry-add-button,approved-button,approved-primary-button"/>
                    <Button text="Remove" onAction="#removeLine"
                            styleClass="sales-entry-remove-button,approved-button,approved-danger-button"/>
                </HBox>

                <TableView fx:id="tableLines" minHeight="190" VBox.vgrow="ALWAYS"
                           styleClass="sales-entry-table,approved-table,erp-table-profile-line-item">
                    <placeholder>
                        <VBox alignment="CENTER" spacing="5" styleClass="sales-entry-empty-state">
                            <Label text="No items added yet" styleClass="sales-entry-empty-title"/>
                            <Label text="Search and add items to create your invoice"
                                   styleClass="sales-entry-empty-message"/>
                        </VBox>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colItem" text="Item Name" prefWidth="270" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colQuantity" text="Qty" prefWidth="75" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colRate" text="Rate (₹)" prefWidth="105" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colDiscount" text="Discount %" prefWidth="92" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colDiscountAmount" text="Discount (₹)" prefWidth="112" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colGst" text="Tax %" prefWidth="78" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colNetAmount" text="Taxable (₹)" prefWidth="120" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colGstAmount" text="Tax Amount (₹)" prefWidth="125" styleClass="approved-table-column"/>
                        <TableColumn fx:id="colTotal" text="Amount (₹)" prefWidth="125" styleClass="approved-table-column"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="sales-entry-table-summary">
                    <Label text="Total Items:" styleClass="sales-entry-summary-caption"/>
                    <Label text="0" styleClass="sales-entry-summary-value"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Discount" styleClass="sales-entry-summary-caption"/>
                    <Label text="₹ 0.00" styleClass="sales-entry-summary-discount"/>
                    <Label text="Tax" styleClass="sales-entry-summary-caption"/>
                    <Label text="₹ 0.00" styleClass="sales-entry-summary-tax"/>
                    <Label text="Net" styleClass="sales-entry-summary-caption"/>
                    <Label text="₹ 0.00" styleClass="sales-entry-summary-net"/>
                </HBox>

                <VBox spacing="4">
                    <Label text="Notes (Optional)" styleClass="sales-entry-field-label,field-label-notes"/>
                    <TextArea fx:id="txtRemarks" promptText="Enter notes or special instructions..."
                              prefRowCount="2" maxHeight="64" wrapText="true" styleClass="approved-input"/>
                </VBox>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sales-entry-bottom-actions">
                <Button text="Cancel" onAction="#cancel"
                        styleClass="sales-entry-cancel-button,approved-button,approved-secondary-button"/>
                <Button text="Save as Draft" onAction="#saveDraft"
                        styleClass="approved-button,approved-secondary-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnSaveSale" text="Save &amp; Print" onAction="#saveSale"
                        styleClass="sales-entry-save-button,approved-button,approved-primary-button"/>
            </HBox>
        </VBox>

        <VBox spacing="10" prefWidth="300" minWidth="285" maxWidth="330">
            <VBox spacing="10"
                  styleClass="purchase-card,flow-card,sales-entry-card,sales-entry-summary-card">
                <Label text="Invoice Summary"
                       styleClass="flow-title,sales-entry-section-title,sales-entry-section-summary"/>
                <HBox><Label text="Sub Total"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblNetAmount" styleClass="money-strong"/></HBox>
                <HBox><Label text="Total Discount"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblDiscount" styleClass="sales-entry-discount-text"/></HBox>
                <HBox><Label text="Taxable Amount"/><Region HBox.hgrow="ALWAYS"/><Label text="₹ 0.00"/></HBox>
                <HBox><Label text="Total Tax"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblGst" styleClass="blue-text"/></HBox>
                <Separator/>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Total Amount" styleClass="flow-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblGrandTotal" styleClass="money-large"/>
                </HBox>
            </VBox>

            <VBox spacing="9" styleClass="purchase-card,flow-card,sales-entry-card,sales-entry-quick-card">
                <Label text="Quick Actions"
                       styleClass="flow-title,sales-entry-section-title,sales-entry-section-quick"/>
                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <Button text="Preview" onAction="#preview" maxWidth="Infinity"
                            styleClass="approved-button,approved-secondary-button"/>
                    <Button text="Download PDF" onAction="#preview" GridPane.columnIndex="1" maxWidth="Infinity"
                            styleClass="approved-button,approved-secondary-button"/>
                    <Button text="Send Email" onAction="#preview" GridPane.rowIndex="1" maxWidth="Infinity"
                            styleClass="approved-button,approved-secondary-button"/>
                    <Button text="Send WhatsApp" onAction="#preview" GridPane.rowIndex="1"
                            GridPane.columnIndex="1" maxWidth="Infinity"
                            styleClass="approved-button,approved-secondary-button"/>
                </GridPane>
            </VBox>

            <VBox spacing="9"
                  styleClass="purchase-card,flow-card,sales-entry-card,sales-entry-document-card">
                <Label text="Document Actions"
                       styleClass="flow-title,sales-entry-section-title,sales-entry-section-document"/>
                <HBox spacing="8">
                    <Button text="Cancel" onAction="#cancel" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            styleClass="sales-entry-cancel-button,approved-button,approved-secondary-button"/>
                    <Button text="Save as Draft" onAction="#saveDraft" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            styleClass="approved-button,approved-secondary-button"/>
                </HBox>
                <Button text="Save &amp; Print" onAction="#saveSale" maxWidth="Infinity"
                        styleClass="sales-entry-save-button,approved-button,approved-primary-button"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>
