<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.PurchaseListController" styleClass="register-page">
 <top><VBox spacing="12" styleClass="register-top"><padding><Insets top="16" right="16" bottom="10" left="16"/></padding><HBox alignment="CENTER_LEFT"><VBox><Label text="Purchase Register" styleClass="screen-title"/><Label text="Purchase  ›  Purchase Register" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnNewPurchase" text="Create Purchase" onAction="#newPurchase" styleClass="primary-action"/></HBox><HBox spacing="10"><VBox styleClass="metric-card,metric-blue" HBox.hgrow="ALWAYS"><Label text="Total Purchases" styleClass="metric-label"/><Label fx:id="lblTotal" styleClass="metric-value"/><Label fx:id="lblTotalCount" styleClass="metric-note"/></VBox><VBox styleClass="metric-card,metric-green" HBox.hgrow="ALWAYS"><Label text="Total Orders" styleClass="metric-label"/><Label fx:id="lblToday" styleClass="metric-value"/><Label fx:id="lblTodayCount" styleClass="metric-note"/></VBox><VBox styleClass="metric-card,metric-orange" HBox.hgrow="ALWAYS"><Label text="Total Suppliers" styleClass="metric-label"/><Label fx:id="lblPending" styleClass="metric-value"/><Label fx:id="lblPendingCount" styleClass="metric-note"/></VBox><VBox styleClass="metric-card,metric-red" HBox.hgrow="ALWAYS"><Label text="Total Items" styleClass="metric-label"/><Label fx:id="lblOverdue" styleClass="metric-value"/><Label fx:id="lblOverdueCount" styleClass="metric-note"/></VBox><VBox styleClass="metric-card,metric-purple" HBox.hgrow="ALWAYS"><Label text="Total Paid" styleClass="metric-label"/><Label fx:id="lblPaid" styleClass="metric-value"/><Label text="All Time" styleClass="metric-note"/></VBox></HBox></VBox></top>
 <center><SplitPane fx:id="mainSplit" dividerPositions="0.8" styleClass="register-split"><items><VBox styleClass="register-workspace"><VBox spacing="10" styleClass="filter-surface"><padding><Insets top="10" right="12" bottom="10" left="12"/></padding><HBox spacing="8"><TextField fx:id="txtSearch" promptText="Search invoice, supplier, mobile or GSTIN..." HBox.hgrow="ALWAYS"/><ToggleButton fx:id="btnAdvanced" selected="true" text="Advanced Filters" onAction="#toggleAdvanced"/><Button fx:id="btnReset" text="Reset" onAction="#resetFilters" styleClass="secondary-button"/><Button fx:id="btnRefresh" text="Refresh" onAction="#refresh"/></HBox><GridPane fx:id="advancedFilters" hgap="10" vgap="8"><columnConstraints><ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/></columnConstraints><VBox spacing="3"><Label text="Supplier" styleClass="filter-label"/><ComboBox fx:id="cmbSupplier" maxWidth="Infinity"/></VBox><VBox spacing="3" GridPane.columnIndex="1"><Label text="From Date" styleClass="filter-label"/><DatePicker fx:id="dpFrom" maxWidth="Infinity"/></VBox><VBox spacing="3" GridPane.columnIndex="2"><Label text="To Date" styleClass="filter-label"/><DatePicker fx:id="dpTo" maxWidth="Infinity"/></VBox><VBox spacing="3" GridPane.columnIndex="3"><Label text="Payment Status" styleClass="filter-label"/><ComboBox fx:id="cmbPaymentStatus" maxWidth="Infinity"/></VBox><VBox spacing="3" GridPane.columnIndex="4"><Label text="Email Status" styleClass="filter-label"/><ComboBox fx:id="cmbMailStatus" maxWidth="Infinity"/></VBox></GridPane><HBox spacing="8" alignment="CENTER_LEFT" styleClass="quick-date-row"><Button fx:id="btnTodayRange" text="Today" onAction="#showToday" styleClass="quick-range-button"/><Button fx:id="btnYesterdayRange" text="Yesterday" onAction="#showYesterday" styleClass="quick-range-button"/><Button fx:id="btnSevenDaysRange" text="7 Days" onAction="#showSevenDays" styleClass="quick-range-button"/><Button fx:id="btnThirtyDaysRange" text="30 Days" onAction="#showThirtyDays" styleClass="quick-range-button"/><Button fx:id="btnCustomRange" text="Custom Range" onAction="#showCustomRange" styleClass="quick-range-button,quick-range-custom"/></HBox></VBox>
 <TableView fx:id="tablePurchase" VBox.vgrow="ALWAYS" styleClass="professional-table"><columns><TableColumn fx:id="colInvoice" text="Invoice No." prefWidth="125"/><TableColumn fx:id="colDate" text="Date" prefWidth="90"/><TableColumn fx:id="colSupplier" text="Supplier" prefWidth="180"/><TableColumn fx:id="colMobile" text="Mobile" prefWidth="105"/><TableColumn fx:id="colAmount" text="Amount" prefWidth="105"/><TableColumn fx:id="colPaid" text="Paid" prefWidth="100"/><TableColumn fx:id="colBalance" text="Balance" prefWidth="100"/><TableColumn fx:id="colDue" text="Payment Due" prefWidth="120"/><TableColumn fx:id="colStatus" text="Status" prefWidth="90"/><TableColumn fx:id="colMail" text="Email" prefWidth="80"/><TableColumn fx:id="colActions" text="Actions" prefWidth="118"/></columns></TableView><HBox spacing="10" alignment="CENTER_LEFT" styleClass="table-footer"><padding><Insets top="9" right="12" bottom="9" left="12"/></padding><Label fx:id="lblPageInfo" styleClass="muted-text"/><Region HBox.hgrow="ALWAYS"/><Label text="Rows per page:"/><ComboBox fx:id="cmbPageSize" prefWidth="75"/><Button fx:id="btnFirstPage" text="First" onAction="#firstPage" styleClass="pager-button"/><Button fx:id="btnPreviousPage" text="Previous" onAction="#previousPage" styleClass="pager-button"/><Label fx:id="lblPageNumber" styleClass="page-number"/><Button fx:id="btnNextPage" text="Next" onAction="#nextPage" styleClass="pager-button"/><Button fx:id="btnLastPage" text="Last" onAction="#lastPage" styleClass="pager-button"/></HBox><HBox spacing="10" styleClass="export-bar" alignment="CENTER_LEFT"><padding><Insets top="10" right="12" bottom="10" left="12"/></padding><Button fx:id="btnExportExcel" text="Export Excel" onAction="#exportPurchase" styleClass="secondary-button"/><Button fx:id="btnExportPdf" text="Export PDF" onAction="#exportPdf" styleClass="secondary-button"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblSummary" styleClass="summary-amount"/></HBox></VBox>
 <VBox fx:id="detailDrawer" spacing="11" styleClass="detail-drawer"><padding><Insets top="16" right="14" bottom="16" left="14"/></padding><HBox><Label text="Purchase Details" styleClass="drawer-title"/><Region HBox.hgrow="ALWAYS"/><Button text="×" onAction="#closeDetails" styleClass="icon-button"/></HBox><Label fx:id="lblDetailInvoice" styleClass="drawer-document"/><Label fx:id="lblDetailSupplier" styleClass="drawer-customer"/><Label fx:id="lblDetailContact" styleClass="muted-text" wrapText="true"/><Separator/><GridPane hgap="12" vgap="8"><Label text="Invoice Amount"/><Label fx:id="lblDetailAmount" GridPane.columnIndex="1" styleClass="drawer-money"/><Label text="Paid" GridPane.rowIndex="1"/><Label fx:id="lblDetailPaid" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="summary-paid"/><Label text="Balance" GridPane.rowIndex="2"/><Label fx:id="lblDetailBalance" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="summary-balance"/><Label text="Due" GridPane.rowIndex="3"/><Label fx:id="lblDetailDue" GridPane.rowIndex="3" GridPane.columnIndex="1"/></GridPane><Label text="Quick Actions" styleClass="drawer-section"/><Button text="Record Supplier Payment" onAction="#paySelected"/><Button text="View / Print PDF" onAction="#pdfSelected"/><Button text="Email Supplier" onAction="#emailSelected"/><Region VBox.vgrow="ALWAYS"/><Button text="Close" onAction="#closeDetails" styleClass="secondary-button"/></VBox></items></SplitPane></center>
</BorderPane>
