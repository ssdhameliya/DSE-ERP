<?xml version="1.0" encoding="UTF-8"?><?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" hbarPolicy="NEVER" fx:controller="org.example.controller.RecordPaymentController" styleClass="clean-scroll"><content><HBox spacing="16" styleClass="sales-flow-page"><padding><Insets top="18" right="18" bottom="20" left="18"/></padding>
<VBox spacing="14" HBox.hgrow="ALWAYS"><VBox spacing="16" styleClass="flow-card"><Label text="Payment Information" styleClass="flow-title"/><HBox spacing="28" styleClass="invoice-info-strip"><VBox><Label text="Invoice No." styleClass="caption"/><Label fx:id="invoiceNo" styleClass="money-strong"/></VBox><VBox><Label text="Customer" styleClass="caption"/><Label fx:id="customer"/></VBox><VBox><Label text="Invoice Date" styleClass="caption"/><Label fx:id="invoiceDate"/></VBox><VBox><Label text="Due Date" styleClass="caption"/><Label fx:id="dueDate"/></VBox><Region HBox.hgrow="ALWAYS"/><VBox><Label text="Total Amount" styleClass="caption"/><Label fx:id="total" styleClass="money-strong"/></VBox></HBox>
<GridPane hgap="22" vgap="16"><columnConstraints><ColumnConstraints percentWidth="33"/><ColumnConstraints percentWidth="33"/><ColumnConstraints percentWidth="34"/></columnConstraints><VBox spacing="5"><Label text="Payment Date *"/><DatePicker fx:id="paymentDate" maxWidth="Infinity"/></VBox><VBox spacing="5" GridPane.columnIndex="1"><Label text="Payment Mode *"/><ComboBox fx:id="mode" maxWidth="Infinity"/></VBox><VBox spacing="5" GridPane.columnIndex="2"><Label text="Reference No."/><TextField fx:id="reference"/></VBox><VBox spacing="5" GridPane.rowIndex="1"><Label text="Received From *"/><TextField text="Customer"/></VBox><VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="1"><Label text="Bank Account *"/><ComboBox promptText="Select account" maxWidth="Infinity"/></VBox><VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="2"><Label text="Amount Received *"/><TextField fx:id="amount" promptText="0.00"/></VBox></GridPane>
<HBox spacing="20"><RadioButton text="Full Payment"/><RadioButton text="Partial Payment" selected="true"/><RadioButton text="Advance Payment"/><Region HBox.hgrow="ALWAYS"/><VBox><Label text="Balance After Payment" styleClass="caption"/><Label fx:id="after" styleClass="red-text"/></VBox></HBox><HBox spacing="18"><VBox HBox.hgrow="ALWAYS"><Label text="Notes"/><TextArea fx:id="notes" prefRowCount="4" promptText="Payment notes"/></VBox><VBox alignment="CENTER" prefWidth="340" styleClass="upload-box"><Label text="⌕  Drag &amp; drop file here"/><Button text="Browse File"/></VBox></HBox><HBox alignment="CENTER_RIGHT" spacing="10"><Button text="Cancel" onAction="#cancel"/><Button text="Save Payment" onAction="#save" styleClass="blue-button"/></HBox></VBox>
<VBox spacing="10" styleClass="flow-card"><Label text="Allocate Payment" styleClass="flow-title"/><TableView prefHeight="210"><columns><TableColumn text="✓"/><TableColumn text="Invoice No."/><TableColumn text="Invoice Date"/><TableColumn text="Due Date"/><TableColumn text="Total Amount (₹)"/><TableColumn text="Due Amount (₹)"/><TableColumn text="Allocate Amount (₹)"/></columns></TableView></VBox></VBox>
<VBox spacing="14" prefWidth="440"><VBox spacing="15" styleClass="flow-card"><Label text="Payment Summary" styleClass="flow-title"/><Label text="Live invoice totals are shown in Payment Information."/><Separator/><Label text="The balance updates while you type the received amount." styleClass="caption"/></VBox><VBox spacing="14" styleClass="flow-card"><HBox><Label text="Payment History" styleClass="flow-title"/><Region HBox.hgrow="ALWAYS"/><Button text="View All" onAction="#history"/></HBox><Label text="●  Previous payments will appear here"/></VBox><VBox spacing="12" styleClass="flow-card"><Label text="Quick Actions" styleClass="flow-title"/><GridPane hgap="10" vgap="10"><Button text="▧  Print Receipt"/><Button text="✉  Send Receipt" GridPane.columnIndex="1"/><Button text="◉  Send WhatsApp" GridPane.rowIndex="1"/><Button text="▤  View Invoice" onAction="#cancel" GridPane.rowIndex="1" GridPane.columnIndex="1"/></GridPane></VBox></VBox>
</HBox></content></ScrollPane>
