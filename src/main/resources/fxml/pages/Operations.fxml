<?xml version="1.0" encoding="UTF-8"?>
<!-- Unified returns, finance, reminders and user access workspace. -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.OperationsController" spacing="14" styleClass="register-page">
    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
    <VBox spacing="3"><Label text="Business Operations" styleClass="screen-title"/><Label text="Returns, expenses, payments, reminders and access control" styleClass="screen-subtitle"/></VBox>
    <HBox spacing="12">
        <VBox styleClass="metric-card,metric-blue" HBox.hgrow="ALWAYS"><Label text="Returns This Month" styleClass="metric-label"/><Label fx:id="lblReturns" styleClass="metric-value"/></VBox>
        <VBox styleClass="metric-card,metric-red" HBox.hgrow="ALWAYS"><Label text="Expenses This Month" styleClass="metric-label"/><Label fx:id="lblExpenses" styleClass="metric-value"/></VBox>
        <VBox styleClass="metric-card,metric-green" HBox.hgrow="ALWAYS"><Label text="Receipts This Month" styleClass="metric-label"/><Label fx:id="lblReceipts" styleClass="metric-value"/></VBox>
        <VBox styleClass="metric-card,metric-orange" HBox.hgrow="ALWAYS"><Label text="Open Reminders" styleClass="metric-label"/><Label fx:id="lblReminders" styleClass="metric-value"/></VBox>
    </HBox>
    <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="operations-tabs"><tabs>
        <Tab text="Returns"><content><VBox spacing="12" styleClass="operations-tab-content"><HBox alignment="CENTER_LEFT"><Label text="Sales &amp; Purchase Returns" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Record Return" onAction="#newReturn"/></HBox><TableView fx:id="returnTable" VBox.vgrow="ALWAYS" styleClass="professional-table"><columns><TableColumn fx:id="rNo" text="Return No."/><TableColumn fx:id="rType" text="Type"/><TableColumn fx:id="rDate" text="Date"/><TableColumn fx:id="rInvoice" text="Invoice"/><TableColumn fx:id="rParty" text="Party"/><TableColumn fx:id="rItem" text="Item"/><TableColumn fx:id="rQty" text="Qty"/><TableColumn fx:id="rAmount" text="Amount"/><TableColumn fx:id="rReason" text="Reason"/></columns></TableView></VBox></content></Tab>
        <Tab text="Expenses &amp; Payments"><content><VBox spacing="12" styleClass="operations-tab-content"><HBox alignment="CENTER_LEFT"><Label text="Financial Register" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Add Voucher" onAction="#newFinance"/></HBox><TableView fx:id="financeTable" VBox.vgrow="ALWAYS" styleClass="professional-table"><columns><TableColumn fx:id="fNo" text="Voucher No."/><TableColumn fx:id="fType" text="Type"/><TableColumn fx:id="fDate" text="Date"/><TableColumn fx:id="fParty" text="Party"/><TableColumn fx:id="fCategory" text="Category"/><TableColumn fx:id="fReference" text="Reference"/><TableColumn fx:id="fMode" text="Mode"/><TableColumn fx:id="fAmount" text="Amount"/></columns></TableView></VBox></content></Tab>
        <Tab text="Reminders"><content><VBox spacing="12" styleClass="operations-tab-content"><HBox alignment="CENTER_LEFT"><Label text="Reminders &amp; Follow-ups" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Add Reminder" onAction="#newReminder"/></HBox><TableView fx:id="reminderTable" VBox.vgrow="ALWAYS" styleClass="professional-table"><columns><TableColumn fx:id="mTitle" text="Reminder"/><TableColumn fx:id="mReference" text="Reference"/><TableColumn fx:id="mDue" text="Due Date"/><TableColumn fx:id="mPriority" text="Priority"/><TableColumn fx:id="mStatus" text="Status"/><TableColumn fx:id="mAction" text="Actions"/></columns></TableView></VBox></content></Tab>
        <Tab text="User Access"><content><VBox spacing="12" styleClass="operations-tab-content"><HBox alignment="CENTER_LEFT"><Label text="Users &amp; Roles" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Add User" onAction="#openUserRegistration"/></HBox><TableView fx:id="userTable" VBox.vgrow="ALWAYS" styleClass="professional-table"><columns><TableColumn fx:id="uName" text="Username"/><TableColumn fx:id="uFull" text="Full Name"/><TableColumn fx:id="uEmail" text="Email"/><TableColumn fx:id="uRole" text="Role"/><TableColumn fx:id="uStatus" text="Status"/></columns></TableView></VBox></content></Tab>
    </tabs></TabPane>
</VBox>
