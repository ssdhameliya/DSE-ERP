<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.ItemMasterController"
      spacing="14" styleClass="register-page,master-entity-page,item-master-premium">
    <padding><Insets top="18" right="18" bottom="14" left="18"/></padding>
    <HBox alignment="CENTER_LEFT" styleClass="entity-page-header">
        <VBox spacing="3">
            <Label text="Items Master" styleClass="screen-title"/>
            <Label text="Manage product codes, tax, pricing and reorder settings" styleClass="screen-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="New Item" onAction="#newItem" styleClass="primary-action,entity-create-button"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-surface,entity-toolbar">
        <padding><Insets top="11" right="12" bottom="11" left="12"/></padding>
        <TextField fx:id="txtSearch" promptText="Search item code, name, category or brand..." HBox.hgrow="ALWAYS" styleClass="entity-search"/>
        <Button text="Edit" onAction="#editItem" styleClass="secondary-button"/>
        <Button text="Delete" onAction="#deleteItem" styleClass="danger-button"/>
        <Button text="Refresh" onAction="#refresh"/>
        <Separator orientation="VERTICAL" prefHeight="28"/>
        <Button text="Import Excel" onAction="#importItems" styleClass="secondary-button"/>
        <Button text="Export Excel" onAction="#exportItems" styleClass="secondary-button"/>
    </HBox>

    <VBox spacing="0" VBox.vgrow="ALWAYS" styleClass="entity-table-card">
        <TableView fx:id="tableItems" VBox.vgrow="ALWAYS" styleClass="professional-table,entity-table">
            <placeholder><VBox alignment="CENTER" spacing="8" styleClass="premium-empty-state"><Label text="No items found" styleClass="empty-state-title"/><Label text="Create a new item or adjust the current search." styleClass="muted-text"/></VBox></placeholder>
            <columns>
                <TableColumn fx:id="colCode" text="Item Code" prefWidth="110"/>
                <TableColumn fx:id="colDescription" text="Item Name" prefWidth="220"/>
                <TableColumn fx:id="colCategory" text="Category" prefWidth="110"/>
                <TableColumn fx:id="colBrand" text="Brand" prefWidth="100"/>
                <TableColumn fx:id="colMaterial" text="Material" prefWidth="100"/>
                <TableColumn fx:id="colSize" text="Size" prefWidth="80"/>
                <TableColumn fx:id="colUnit" text="Unit" prefWidth="70"/>
                <TableColumn fx:id="colHsn" text="HSN/SAC" prefWidth="95"/>
                <TableColumn fx:id="colGst" text="GST %" prefWidth="70"/>
                <TableColumn fx:id="colDiscount" text="Discount %" prefWidth="90"/>
                <TableColumn fx:id="colPurchasePrice" text="Purchase Price" prefWidth="105"/>
                <TableColumn fx:id="colSellingPrice" text="Selling Price" prefWidth="105"/>
                <TableColumn fx:id="colOpeningStock" text="In Stock" prefWidth="85"/>
                <TableColumn fx:id="colMinimumStock" text="Min Stock" prefWidth="85"/>
                <TableColumn fx:id="colLocation" text="Location" prefWidth="110"/>
                <TableColumn fx:id="colRemarks" text="Remarks" prefWidth="180"/>
                <TableColumn fx:id="colAction" text="Actions" prefWidth="120"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" styleClass="table-footer,entity-table-footer">
            <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>
            <Label text="Inventory master records" styleClass="muted-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblRecordCount" styleClass="record-count-pill"/>
        </HBox>
    </VBox>
</VBox>
