<?import java.lang.String?><?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" hbarPolicy="NEVER" fx:controller="org.example.controller.SalesDetailController" styleClass="clean-scroll,approved-ui,approved-screen,approved-screen-sales-invoice-details"><content><VBox spacing="14" styleClass="sales-flow-page"><padding><Insets top="16" right="18" bottom="20" left="18"/></padding>
