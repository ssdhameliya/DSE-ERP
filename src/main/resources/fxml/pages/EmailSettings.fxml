<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.EmailSettingsController" styleClass="auth-page,approved-ui,approved-screen,approved-screen-email-settings">

    <left>
        <VBox prefWidth="360" minWidth="320" alignment="CENTER" spacing="18" styleClass="auth-brand-panel">
            <StackPane styleClass="auth-logo-badge"><Label text="◆" styleClass="auth-logo-mark"/></StackPane>
            <Label text="JavaApp ERP" styleClass="auth-brand-title"/>
            <Region prefHeight="2" maxWidth="80" styleClass="auth-brand-line"/>
            <Label text="Engineering Business Suite" styleClass="auth-brand-subtitle"/>
            <Label text="Precision in Engineering Excellence in Business." wrapText="true" textAlignment="CENTER" styleClass="auth-brand-quote"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Version 2.0.0" styleClass="auth-version"/>
        </VBox>
    </left>

    <center><StackPane styleClass="auth-content"><VBox maxWidth="680" spacing="14" alignment="CENTER" styleClass="auth-card">
        <StackPane styleClass="auth-section-icon"><Label text="✉"/></StackPane>
        <Label text="Yahoo Email Setup" styleClass="auth-title"/>
        <Label text="Required for secure OTP sign-in and optional invoice emails." styleClass="auth-description"/>
        <VBox spacing="5" maxWidth="600"><Label text="Yahoo email address *" styleClass="auth-field-label"/><TextField fx:id="txtSmtpEmail" promptText="name@yahoo.com" styleClass="auth-input"/><Label fx:id="lblEmailError" managed="false" visible="false" styleClass="field-error"/></VBox>
        <VBox spacing="5" maxWidth="600"><Label text="Yahoo app password *" styleClass="auth-field-label"/><PasswordField fx:id="txtSmtpPassword" promptText="Yahoo app password" styleClass="auth-input"/><Label fx:id="lblPasswordError" managed="false" visible="false" styleClass="field-error"/></VBox>
        <HBox spacing="12" maxWidth="600" alignment="CENTER_LEFT" styleClass="auth-info-box"><Label text="i" styleClass="auth-info-icon"/><Label text="Create this in Yahoo Account Security → Generate app password. Your normal Yahoo password will not work." wrapText="true" HBox.hgrow="ALWAYS"/></HBox>
        <Button fx:id="btnSave" text="Save Email Settings" onAction="#save" maxWidth="360" styleClass="auth-primary-button"/>
        <Button fx:id="btnBack" text="Back to login" onAction="#back" maxWidth="220" styleClass="auth-secondary-button"/>
        <Label fx:id="lblMessage" wrapText="true" maxWidth="600" styleClass="auth-message"/>
    </VBox></StackPane></center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="auth-footer">
            <padding><Insets top="9" right="18" bottom="9" left="18"/></padding>
            <Label text="DS Engineers" styleClass="auth-footer-strong"/>
            <Label text="•"/><Label text="Phone: 9099839193"/>
            <Label text="•"/><Label text="Email: jatindhameliya1989@gmail.com"/>
            <Label text="•"/><Label text="Website: www.company.com"/>
            <Label text="•"/><Label text="GSTIN: BEEPD4909N123456"/>
            <Label text="•"/><Label text="Address: H-52 darshan Villa society, New Naroda, Ahmedabad - 382346" HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblClock" text="00:00:00" styleClass="auth-footer-clock"/>
        </HBox>
    </bottom>
</BorderPane>