<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.ReportsController" spacing="10" styleClass="reports-content,reports-single-page,approved-ui,approved-screen,approved-screen-reports,erp-screen-root">
  <HBox alignment="CENTER_LEFT" spacing="12" minHeight="56" prefHeight="56" styleClass="reports-header,approved-section-header">
    <VBox spacing="3" alignment="CENTER_LEFT" minHeight="50" styleClass="reports-title-block">
      <Label text="Reports Dashboard" styleClass="page-title"/>
      <Label text="Real-time financial and operational summary" styleClass="page-subtitle,reports-header-subtitle"/>
    </VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <DatePicker fx:id="dpFrom" styleClass="report-date,approved-input"/><Label text="to" styleClass="page-subtitle"/><DatePicker fx:id="dpTo" styleClass="report-date,approved-input"/>
    <Button fx:id="btnRefresh" text="Refresh" onAction="#refresh" styleClass="secondary-button"/>
    <MenuButton fx:id="btnExport" text="Export" minWidth="140" prefWidth="140" styleClass="primary-button,approved-menu-button,reports-export-button"><items><MenuItem fx:id="miExcel" text="Export Excel" onAction="#exportExcel"/><MenuItem fx:id="miPdf" text="Export PDF" onAction="#exportPdf"/></items></MenuButton>
  </HBox>
  <GridPane hgap="12" vgap="12" minHeight="108" prefHeight="116" styleClass="report-kpi-grid">
    <columnConstraints><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/><ColumnConstraints percentWidth="16.66"/></columnConstraints>
    <HBox GridPane.columnIndex="0" alignment="CENTER_LEFT" spacing="10" styleClass="report-kpi-card,sales-metric-card,sales-metric-total,kpi-sales"><StackPane fx:id="reportSalesIcon" styleClass="sales-metric-icon"/><VBox spacing="3"><Label text="Total Sales" styleClass="metric-label"/><Label fx:id="lblSales" styleClass="kpi-value,metric-value,report-responsive-value"/><Label text="Selected period" styleClass="page-subtitle,metric-note"/></VBox></HBox>
    <HBox GridPane.columnIndex="1" alignment="CENTER_LEFT" spacing="10" styleClass="report-kpi-card,sales-metric-card,sales-metric-today,kpi-purchase"><StackPane fx:id="reportPurchaseIcon" styleClass="sales-metric-icon"/><VBox spacing="3"><Label text="Total Purchases" styleClass="metric-label"/><Label fx:id="lblPurchase" styleClass="kpi-value,metric-value,report-responsive-value"/><Label text="Selected period" styleClass="page-subtitle,metric-note"/></VBox></HBox>
    <HBox GridPane.columnIndex="2" alignment="CENTER_LEFT" spacing="10" styleClass="report-kpi-card,sales-metric-card,sales-metric-email,kpi-profit"><StackPane fx:id="reportProfitIcon" styleClass="sales-metric-icon"/><VBox spacing="3"><Label text="Gross Profit" styleClass="metric-label"/><Label fx:id="lblProfit" styleClass="kpi-value,metric-value,report-responsive-value"/><Label text="Sales less purchases" styleClass="page-subtitle,metric-note"/></VBox></HBox>
    <HBox GridPane.columnIndex="3" alignment="CENTER_LEFT" spacing="10" styleClass="report-kpi-card,sales-metric-card,sales-metric-pending,kpi-receivable"><StackPane fx:id="reportReceivableIcon" styleClass="sales-metric-icon"/><VBox spacing="3"><Label text="Receivables" styleClass="metric-label"/><Label fx:id="lblReceivables" styleClass="kpi-value,metric-value,report-responsive-value"/><Label text="Outstanding sales" styleClass="page-subtitle,metric-note"/></VBox></HBox>
    <HBox GridPane.columnIndex="4" alignment="CENTER_LEFT" spacing="10" styleClass="report-kpi-card,sales-metric-card,sales-metric-due,kpi-stock"><StackPane fx:id="reportStockIcon" styleClass="sales-metric-icon"/><VBox spacing="3"><Label text="Stock Value" styleClass="metric-label"/><Label fx:id="lblStock" styleClass="kpi-value,metric-value,report-responsive-value"/><Label fx:id="lblLowStock" styleClass="page-subtitle,metric-note"/></VBox></HBox>
    <HBox GridPane.columnIndex="5" alignment="CENTER_LEFT" spacing="10" styleClass="report-kpi-card,sales-metric-card,sales-metric-total,kpi-customer"><StackPane fx:id="reportCustomerIcon" styleClass="sales-metric-icon"/><VBox spacing="3"><Label text="Total Customers" styleClass="metric-label"/><Label fx:id="lblCustomers" styleClass="kpi-value,metric-value"/><Label text="Active customers" styleClass="page-subtitle,metric-note"/></VBox></HBox>
  </GridPane>
  <HBox spacing="10" alignment="CENTER_LEFT" styleClass="report-filter-card,approved-filter-bar"><ComboBox fx:id="cmbReportType" prefWidth="190" styleClass="approved-input"/><ComboBox fx:id="cmbParty" prefWidth="230" styleClass="approved-input"/><ComboBox fx:id="cmbItem" prefWidth="210" styleClass="approved-input"/><ComboBox fx:id="cmbSalesPerson" prefWidth="190" styleClass="approved-input"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnApply" text="Apply Filters" onAction="#refresh" styleClass="primary-button"/><Button fx:id="btnReset" text="Reset" onAction="#resetFilters" styleClass="secondary-button"/></HBox>
  <GridPane hgap="10" vgap="10" VBox.vgrow="ALWAYS" minHeight="250" prefHeight="300" styleClass="report-table-row,reports-grow-row"><rowConstraints><RowConstraints vgrow="ALWAYS" fillHeight="true"/></rowConstraints><columnConstraints><ColumnConstraints percentWidth="40"/><ColumnConstraints percentWidth="40"/><ColumnConstraints percentWidth="20"/></columnConstraints>
    <VBox GridPane.columnIndex="0" GridPane.vgrow="ALWAYS" maxHeight="Infinity" styleClass="report-card"><HBox alignment="CENTER_LEFT"><Label text="Recent Sales Invoices" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnViewSales" text="View All" onAction="#viewAllSales" styleClass="link-button,approved-button,approved-secondary-button"/></HBox><TableView fx:id="tblSales" VBox.vgrow="ALWAYS" styleClass="report-table,approved-table,erp-table-profile-summary"><columns><TableColumn fx:id="colSaleNo" text="Invoice No."/><TableColumn fx:id="colSaleDate" text="Date"/><TableColumn fx:id="colSaleParty" text="Customer"/><TableColumn fx:id="colSaleAmount" text="Amount"/><TableColumn fx:id="colSaleStatus" text="Status"/></columns></TableView></VBox>
    <VBox GridPane.columnIndex="1" GridPane.vgrow="ALWAYS" maxHeight="Infinity" styleClass="report-card"><HBox alignment="CENTER_LEFT"><Label text="Recent Purchase Invoices" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnViewPurchases" text="View All" onAction="#viewAllPurchases" styleClass="link-button,approved-button,approved-secondary-button"/></HBox><TableView fx:id="tblPurchases" VBox.vgrow="ALWAYS" styleClass="report-table,approved-table,erp-table-profile-summary"><columns><TableColumn fx:id="colPurchaseNo" text="Invoice No."/><TableColumn fx:id="colPurchaseDate" text="Date"/><TableColumn fx:id="colPurchaseParty" text="Supplier"/><TableColumn fx:id="colPurchaseAmount" text="Amount"/><TableColumn fx:id="colPurchaseStatus" text="Status"/></columns></TableView></VBox>
    <VBox GridPane.columnIndex="2" GridPane.vgrow="ALWAYS" maxHeight="Infinity" spacing="8" styleClass="report-card"><Label text="Payment Summary" styleClass="section-title"/><ListView fx:id="paymentSummary" VBox.vgrow="ALWAYS" styleClass="summary-list,payment-summary-list,approved-list,report-static-summary"/></VBox>
  </GridPane>
  <GridPane hgap="10" vgap="10" minHeight="180" prefHeight="200" styleClass="report-bottom-row,reports-bottom-fill"><rowConstraints><RowConstraints vgrow="ALWAYS" fillHeight="true"/></rowConstraints><columnConstraints><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/></columnConstraints>
    <VBox GridPane.columnIndex="0" GridPane.vgrow="ALWAYS" maxHeight="Infinity" spacing="8" styleClass="report-card"><Label text="Top Customers" styleClass="section-title"/><ListView fx:id="topCustomersSummary" VBox.vgrow="ALWAYS" styleClass="summary-list,approved-list,report-static-summary"/></VBox>
    <VBox GridPane.columnIndex="1" GridPane.vgrow="ALWAYS" maxHeight="Infinity" spacing="8" styleClass="report-card"><Label text="Top Selling Items" styleClass="section-title"/><ListView fx:id="topItemsSummary" VBox.vgrow="ALWAYS" styleClass="summary-list,approved-list,report-static-summary"/></VBox>
    <VBox GridPane.columnIndex="2" GridPane.vgrow="ALWAYS" maxHeight="Infinity" spacing="8" styleClass="report-card"><Label text="Performance Summary" styleClass="section-title"/><Label fx:id="lblMargin" text="0.00%" styleClass="report-big-value"/><ProgressBar fx:id="profitProgress" maxWidth="Infinity"/><ListView fx:id="performanceSummary" VBox.vgrow="ALWAYS" styleClass="summary-list,approved-list,report-static-summary"/></VBox>
    <VBox GridPane.columnIndex="3" GridPane.vgrow="ALWAYS" maxHeight="Infinity" spacing="8" styleClass="report-card"><Label text="Stock Overview" styleClass="section-title"/><ListView fx:id="stockSummary" VBox.vgrow="ALWAYS" styleClass="summary-list,stock-summary-list,approved-list,report-static-summary"/></VBox>
  </GridPane>
</VBox>