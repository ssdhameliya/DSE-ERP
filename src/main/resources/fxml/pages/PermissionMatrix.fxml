<?xml version="1.0" encoding="UTF-8"?><?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.PermissionMatrixController" spacing="14" styleClass="user-access-page,approved-ui,erp-screen-root"><padding><Insets top="14" right="18" bottom="14" left="18"/></padding><HBox alignment="CENTER_LEFT"><VBox><Label text="Permission Matrix" styleClass="screen-title"/><Label text="Grant only the ERP actions each role needs" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Back to Roles" onAction="#back" styleClass="approved-button,approved-secondary-button"/><Button text="Save Permissions" onAction="#save" styleClass="primary-button"/></HBox><HBox spacing="12"><VBox styleClass="user-kpi,user-kpi-green" HBox.hgrow="ALWAYS"><Label text="Granted" styleClass="metric-title"/><Label fx:id="lblGranted" text="0" styleClass="metric-value"/></VBox><VBox styleClass="user-kpi,user-kpi-red" HBox.hgrow="ALWAYS"><Label text="Not Granted" styleClass="metric-title"/><Label fx:id="lblDenied" text="0" styleClass="metric-value"/></VBox></HBox><VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="user-access-card,ua-full-card"><HBox alignment="CENTER_LEFT" spacing="10"><Label text="Role" styleClass="field-label"/><ComboBox fx:id="cmbRole" prefWidth="240" styleClass="approved-input"/><Label fx:id="lblHint" text="Select a role" styleClass="muted-label"/><Region HBox.hgrow="ALWAYS"/><Button text="Grant All" onAction="#grantAll" styleClass="approved-button,approved-secondary-button"/><Button text="Revoke All" onAction="#revokeAll" styleClass="approved-button,approved-secondary-button"/></HBox><TableView fx:id="table" editable="true" VBox.vgrow="ALWAYS" styleClass="approved-table,erp-table-profile-administration"><columns><TableColumn fx:id="colModule" text="Module"/><TableColumn fx:id="colAction" text="Action"/><TableColumn fx:id="colDescription" text="Description"/><TableColumn fx:id="colAllowed" text="Allowed"/></columns></TableView><HBox alignment="CENTER_RIGHT" spacing="8"><Button text="Reset Changes" onAction="#reset" styleClass="approved-button,approved-secondary-button"/><Button text="Save Permissions" onAction="#save" styleClass="primary-button"/></HBox></VBox></VBox>
