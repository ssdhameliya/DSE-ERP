<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Create Purchase: concise supplier, dates, payment terms, items, totals and attachments. -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true" hbarPolicy="NEVER"
            fx:controller="org.example.controller.PurchaseController" styleClass="purchase-scroll">
  <content>
    <HBox spacing="15" styleClass="purchase-page">
      <padding><Insets top="14" right="14" bottom="18" left="14"/></padding>
      <VBox spacing="14" HBox.hgrow="ALWAYS">
        <VBox spacing="12" styleClass="purchase-card">
          <Label text="Purchase Details" styleClass="purchase-section-title"/>
          <GridPane hgap="14" vgap="12">
            <columnConstraints>
              <ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/>
              <ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/>
            </columnConstraints>
            <VBox spacing="4">
              <Label text="Supplier *"/>
              <HBox spacing="6"><ComboBox fx:id="cmbSupplier" maxWidth="Infinity" HBox.hgrow="ALWAYS"/><Button text="＋" onAction="#addSupplier"/></HBox>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="1"><Label text="Purchase No."/><TextField fx:id="txtInvoiceNo" editable="false" promptText="Auto Generate"/></VBox>
            <VBox spacing="4" GridPane.columnIndex="2"><Label text="Purchase Date *"/><DatePicker fx:id="dpInvoiceDate" maxWidth="Infinity"/></VBox>
            <VBox spacing="4" GridPane.columnIndex="3"><Label text="Delivery Date"/><DatePicker fx:id="dpDeliveryDate" maxWidth="Infinity"/></VBox>
            <VBox spacing="4" GridPane.rowIndex="1"><Label text="Billing Address"/><ComboBox promptText="Supplier billing address" maxWidth="Infinity"/></VBox>
            <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="1"><Label text="Payment Terms"/><ComboBox fx:id="cmbPaymentTerms" maxWidth="Infinity"/></VBox>
            <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="2"><Label text="Currency"/><ComboBox fx:id="cmbCurrency" maxWidth="Infinity"/></VBox>
            <!-- Legacy fields stay hidden so older database records remain compatible. -->
            <ComboBox fx:id="cmbWarehouse" visible="false" managed="false"/>
            <TextField fx:id="txtReference" visible="false" managed="false"/>
            <ComboBox fx:id="cmbGstTreatment" visible="false" managed="false"/>
            <ComboBox fx:id="cmbTransporter" visible="false" managed="false"/>
            <TextField fx:id="txtLrAwb" visible="false" managed="false"/>
            <ComboBox fx:id="cmbDiscountType" visible="false" managed="false"/>
            <TextField fx:id="txtDiscount" text="0.00" visible="false" managed="false"/>
            <TextArea fx:id="txtRemarks" visible="false" managed="false"/>
            <DatePicker fx:id="dpDueDate" visible="false" managed="false"/>
            <Label fx:id="lblInvoiceDisplay" visible="false" managed="false"/>
          </GridPane>
        </VBox>
        <VBox spacing="10" styleClass="purchase-card" VBox.vgrow="ALWAYS">
          <Label text="Purchase Items" styleClass="purchase-section-title"/>
          <HBox spacing="7"><ComboBox fx:id="cmbItem" promptText="Select item" HBox.hgrow="ALWAYS"/><TextField fx:id="txtQuantity" promptText="Qty" prefWidth="85"/><TextField fx:id="txtRate" promptText="Rate" prefWidth="110"/><TextField fx:id="txtLineDiscount" promptText="Discount %" prefWidth="100"/><TextField fx:id="txtGST" promptText="Tax %" prefWidth="85"/><Button fx:id="btnAddLine" text="＋ Add Item" onAction="#addLine"/><Button text="Cancel Edit" onAction="#cancelEdit"/><Button text="Delete" onAction="#removeLine" styleClass="danger-button"/></HBox>
          <TableView fx:id="tableLines" prefHeight="340" VBox.vgrow="ALWAYS">
            <columns><TableColumn text="#" prefWidth="45"/><TableColumn fx:id="colItem" text="Item Name *" prefWidth="360"/><TableColumn fx:id="colQuantity" text="Qty" prefWidth="100"/><TableColumn fx:id="colRate" text="Rate (₹)" prefWidth="125"/><TableColumn fx:id="colDiscount" text="Discount %" prefWidth="100"/><TableColumn fx:id="colDiscountAmount" text="Discount" prefWidth="115"/><TableColumn fx:id="colGst" text="Tax (%)" prefWidth="90"/><TableColumn fx:id="colNetAmount" text="Taxable" prefWidth="150"/><TableColumn fx:id="colGstAmount" text="Tax" prefWidth="130"/><TableColumn fx:id="colTotal" text="Amount (₹)" prefWidth="160"/></columns>
          </TableView>
        </VBox>
        <VBox spacing="10" styleClass="purchase-card"><Label text="Attachments" styleClass="purchase-section-title"/><Button text="☁  Drag &amp; drop files here or click to browse&#10;Supported: PDF, JPG, PNG (Max size: 5MB)" wrapText="true" onAction="#chooseAttachment" styleClass="attachment-button" maxWidth="Infinity"/><Label fx:id="lblAttachment" text="No document selected" styleClass="muted-text"/></VBox>
      </VBox>
      <VBox spacing="14" prefWidth="315">
        <HBox spacing="8" alignment="CENTER_RIGHT"><Button text="Save as Draft" onAction="#saveDraft"/><MenuButton text="Save &amp; Print" styleClass="purchase-primary"><items><MenuItem text="Save" onAction="#savePurchase"/><MenuItem text="Save &amp; Print" onAction="#saveAndPrint"/><MenuItem text="Save as Draft" onAction="#saveDraft"/><MenuItem text="Save &amp; Email" onAction="#saveAndEmail"/><SeparatorMenuItem/><MenuItem text="Preview" onAction="#preview"/><MenuItem text="Cancel" onAction="#cancel"/></items></MenuButton></HBox>
        <VBox spacing="12" styleClass="purchase-card"><Label text="Purchase Summary" styleClass="purchase-section-title"/><HBox><Label text="Sub Total"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblNetAmount"/></HBox><HBox><Label text="Total Discount"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblDiscount" styleClass="warning-text"/></HBox><HBox><Label text="Total Tax"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblGst"/></HBox><Separator/><HBox><Label text="Total Amount" styleClass="purchase-section-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblGrandTotal" styleClass="purchase-total"/></HBox></VBox>
        <VBox spacing="10" styleClass="purchase-card"><Label text="Quick Actions" styleClass="purchase-section-title"/><Button text="Clear All" onAction="#clearLines" maxWidth="Infinity"/></VBox>
        <VBox spacing="8" styleClass="purchase-note"><Label text="ⓘ Note" styleClass="purchase-section-title"/><Label text="Please review all details before saving the purchase." wrapText="true"/></VBox>
        <Region VBox.vgrow="ALWAYS"/><Button text="Cancel" onAction="#cancel"/><Button text="Save Purchase" onAction="#savePurchase" styleClass="purchase-primary"/>
      </VBox>
    </HBox>
  </content>
</ScrollPane>
