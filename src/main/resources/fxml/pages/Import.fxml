<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ImportController" styleClass="import-page,approved-ui,approved-screen,approved-screen-import,erp-screen-root">
 <top>
  <VBox spacing="8">
   <HBox alignment="CENTER_LEFT" spacing="14" styleClass="import-page-header,approved-section-header,erp-page-identity-header">
    <padding><Insets top="10" right="18" bottom="8" left="18"/></padding>
    <StackPane fx:id="importPageIcon" minWidth="38" minHeight="38" prefWidth="38" prefHeight="38" styleClass="erp-page-header-icon,import-header-icon-box"/>
    <VBox spacing="2" HBox.hgrow="ALWAYS"><Label text="Data Import" styleClass="screen-title"/><Label text="Import ERP master and transaction data through validated templates and API services" styleClass="screen-subtitle"/></VBox>
    <Button fx:id="btnImportGuide" text="Import Guide" onAction="#showImportGuide" styleClass="approved-button,approved-secondary-button"/>
   </HBox>
   <HBox alignment="CENTER" spacing="18" styleClass="import-wizard-stepper">
    <Label fx:id="step1Badge" text="1  Select Data" styleClass="import-wizard-step,import-wizard-step-active"/>
    <Label text="→"/><Label fx:id="step2Badge" text="2  Upload File" styleClass="import-wizard-step"/>
    <Label text="→"/><Label fx:id="step3Badge" text="3  Map Columns" styleClass="import-wizard-step"/>
    <Label text="→"/><Label fx:id="step4Badge" text="4  Review &amp; Import" styleClass="import-wizard-step"/>
   </HBox>
  </VBox>
 </top>
 <center>
  <StackPane>
   <padding><Insets top="8" right="18" bottom="12" left="18"/></padding>

   <VBox fx:id="step1Panel" spacing="12">
    <VBox spacing="3"><Label text="What would you like to import?" styleClass="import-section-title"/><Label text="Choose a data area. Download the matching template when you need a reference file." styleClass="import-section-description"/></VBox>
    <GridPane hgap="12" vgap="12" VBox.vgrow="ALWAYS">
     <columnConstraints><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.34"/></columnConstraints>
     <VBox spacing="8" styleClass="import-card,import-selection-card"><Label text="Item Master" styleClass="import-section-title"/><Label text="Products, HSN, UOM, rates and stock levels." wrapText="true"/><HBox spacing="8"><Button text="Select" onAction="#selectItemMaster" styleClass="approved-button,approved-primary-button"/><Button text="Download Template" onAction="#downloadItemTemplate" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
     <VBox spacing="8" GridPane.columnIndex="1" styleClass="import-card,import-selection-card"><Label text="Customers / CRM" styleClass="import-section-title"/><Label text="Customer master, contact and opening balance data." wrapText="true"/><HBox spacing="8"><Button text="Select" onAction="#selectCustomers" styleClass="approved-button,approved-primary-button"/><Button text="Download Template" onAction="#downloadCustomerTemplate" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
     <VBox spacing="8" GridPane.columnIndex="2" styleClass="import-card,import-selection-card"><Label text="Suppliers / HRM" styleClass="import-section-title"/><Label text="Supplier master, contacts and opening balances." wrapText="true"/><HBox spacing="8"><Button text="Select" onAction="#selectSuppliers" styleClass="approved-button,approved-primary-button"/><Button text="Download Template" onAction="#downloadSupplierTemplate" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
     <VBox spacing="8" GridPane.rowIndex="1" styleClass="import-card,import-selection-card"><Label text="Sales" styleClass="import-section-title"/><Label text="Sales invoices and line-item transaction data." wrapText="true"/><HBox spacing="8"><Button text="Select" onAction="#selectSales" styleClass="approved-button,approved-primary-button"/><Button text="Download Template" onAction="#downloadSalesTemplate" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
     <VBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="import-card,import-selection-card"><Label text="Purchases" styleClass="import-section-title"/><Label text="Purchase invoices, bills and line-item data." wrapText="true"/><HBox spacing="8"><Button text="Select" onAction="#selectPurchases" styleClass="approved-button,approved-primary-button"/><Button text="Download Template" onAction="#downloadPurchaseTemplate" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
     <VBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="2" styleClass="import-card,import-selection-card"><Label text="Master Categories &amp; Values" styleClass="import-section-title"/><Label text="Reusable lookup values. Saved through Spring API in PostgreSQL mode." wrapText="true"/><HBox spacing="8"><Button text="Select" onAction="#selectMasters" styleClass="approved-button,approved-primary-button"/><Button text="Download Template" onAction="#downloadMasterTemplate" styleClass="approved-button,approved-secondary-button"/></HBox></VBox>
     <VBox spacing="8" GridPane.rowIndex="2" GridPane.columnSpan="3" styleClass="import-card,import-selection-card"><Label text="Bank Statement" styleClass="import-section-title"/><Label text="Import supported bank CSV statements into Bank Reconciliation. Original evidence remains retained." wrapText="true"/><Button text="Select Bank Statement" onAction="#selectBankStatement" styleClass="approved-button,approved-primary-button"/></VBox>
    </GridPane>
    <HBox alignment="CENTER_RIGHT"><Label text="Safe &amp; Secure • Auto Validation • Backup First • Easy Mapping" styleClass="muted-text"/></HBox>
   </VBox>

   <VBox fx:id="step2Panel" visible="false" managed="false" spacing="14">
    <HBox alignment="CENTER_LEFT"><VBox><Label text="Upload Import File" styleClass="import-section-title"/><Label text="Use the template format for best results. Bank Statement uses CSV." styleClass="import-section-description"/></VBox><Region HBox.hgrow="ALWAYS"/><ComboBox fx:id="cmbImportModule" prefWidth="280" styleClass="approved-input"/></HBox>
    <HBox spacing="18" VBox.vgrow="ALWAYS">
     <VBox fx:id="dropZone" alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS" onDragOver="#onDragOver" onDragEntered="#onDragEntered" onDragExited="#onDragExited" onDragDropped="#onDragDropped" styleClass="import-drop-zone,import-card">
      <Label fx:id="lblDropIcon"/><Label text="Drag and drop your import file here" styleClass="import-section-title"/><Label text="Excel templates: .xlsx / .xls   •   Bank Statement: .csv" styleClass="muted-text"/><Button fx:id="btnChooseFile" text="Browse File" onAction="#onChooseImportFile" styleClass="approved-button,approved-primary-button"/>
     </VBox>
     <VBox prefWidth="430" spacing="12" styleClass="import-card"><Label text="Selected File" styleClass="import-section-title"/><Label fx:id="lblChosenFile" text="No file selected" wrapText="true" styleClass="selected-file"/><Label text="The file is parsed locally for preview. Persisted import records go through Spring REST services when API mode is enabled." wrapText="true" styleClass="muted-text"/><TextField fx:id="txtImportNote" promptText="Optional import note"/><HBox spacing="8"><Button text="Change File" onAction="#onChooseImportFile"/><Button text="Remove / choose another" onAction="#onChooseImportFile"/></HBox></VBox>
    </HBox>
    <HBox><Button text="Back" onAction="#goStep1"/><Region HBox.hgrow="ALWAYS"/><Button text="Continue" onAction="#goStep3" styleClass="approved-button,approved-primary-button"/></HBox>
   </VBox>

   <VBox fx:id="step3Panel" visible="false" managed="false" spacing="12">
    <HBox alignment="CENTER_LEFT"><VBox><Label text="Map Excel / CSV Columns to ERP Fields" styleClass="import-section-title"/><Label text="Auto-map common columns and review required fields before validation." styleClass="import-section-description"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnAutoMap" text="Auto Map" onAction="#autoMapColumns"/><Button fx:id="btnResetMapping" text="Reset Mapping" onAction="#resetMapping"/></HBox>
    <HBox spacing="12" VBox.vgrow="ALWAYS">
     <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="import-card"><HBox><Label text="Column Mapping" styleClass="import-section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="Mapping status updates during auto-map"/></HBox><ScrollPane fx:id="mappingScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"><content><GridPane fx:id="gridMapping" hgap="0" vgap="0" minWidth="850" styleClass="import-mapping-grid"/></content></ScrollPane></VBox>
     <VBox prefWidth="390" spacing="8" styleClass="import-card"><Label text="Mapping Summary" styleClass="import-section-title"/><Label text="Required fields are marked by the mapping engine. Ignored source columns are not imported." wrapText="true"/><Separator/><Label text="Sample Data Preview" styleClass="import-section-title"/><Label text="Preview is generated from the selected file"/><Label text="Continue to Review &amp; Import to inspect rows." wrapText="true"/></VBox>
    </HBox>
    <HBox><Button text="Back" onAction="#goStep2"/><Region HBox.hgrow="ALWAYS"/><Button text="Continue" onAction="#goStep4" styleClass="approved-button,approved-primary-button"/></HBox>
   </VBox>

   <VBox fx:id="step4Panel" visible="false" managed="false" spacing="10">
    <HBox alignment="CENTER_LEFT"><VBox><Label text="Review &amp; Validate Data" styleClass="import-section-title"/><Label text="Review mapped data before importing. Use Validate only for a dry run." styleClass="import-section-description"/></VBox><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblReadyStatus" text="Ready for validation" styleClass="approved-status"/></HBox>
    <HBox spacing="10">
     <VBox HBox.hgrow="ALWAYS" styleClass="import-wizard-kpi,import-card"><Label text="Rows"/><Label fx:id="lblPreviewStatus" text="Preview" styleClass="metric-value"/></VBox>
     <VBox HBox.hgrow="ALWAYS" styleClass="import-wizard-kpi,import-card"><Label text="Mapped Fields"/><Label fx:id="lblMappingCount" text="0 / 0" styleClass="metric-value"/></VBox>
     <VBox HBox.hgrow="ALWAYS" styleClass="import-wizard-kpi,import-card"><Label text="Preview Count"/><Label fx:id="lblPreviewCount" text="0 rows" styleClass="metric-value"/></VBox>
    </HBox>
    <TableView fx:id="tblPreview" editable="false" VBox.vgrow="ALWAYS" minHeight="360" styleClass="import-preview-table,approved-table,erp-table-profile-import"/>
    <VBox fx:id="progressContainer" spacing="6" visible="false" managed="false" styleClass="import-progress-card"><HBox><Label fx:id="lblProgressStatus" text="Importing data..."/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblProgressPercent" text="0%"/></HBox><ProgressBar fx:id="progressBar" maxWidth="Infinity"/></VBox>
    <HBox alignment="CENTER_LEFT" spacing="10"><Button text="Back" onAction="#goStep3"/><CheckBox fx:id="chkDryRun" text="Validate only (do not save)"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnRunImport" text="Import Records" onAction="#onRunImport" disable="true" styleClass="approved-button,approved-primary-button"/></HBox>
   </VBox>
  </StackPane>
 </center>
</BorderPane>
