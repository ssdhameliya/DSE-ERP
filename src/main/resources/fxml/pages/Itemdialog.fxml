<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.ItemDialogController" prefWidth="980" prefHeight="700" styleClass="entity-dialog,premium-entity-dialog,item-dialog,approved-ui,approved-screen,approved-screen-itemdialog">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="entity-dialog-header,premium-dialog-header,approved-section-header">
            <StackPane fx:id="headerIconHolder" minWidth="44" minHeight="44" prefWidth="44" prefHeight="44" styleClass="dialog-title-icon,item-title-icon"/>
            <VBox spacing="3">
                <Label fx:id="lblTitle" text="Add Item" styleClass="entity-dialog-title"/>
                <Label fx:id="lblSubtitle" text="Add a new item to your inventory" styleClass="entity-dialog-subtitle"/>
            </VBox>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll-pane">
            <VBox spacing="18" styleClass="premium-dialog-content">
                <VBox spacing="10" styleClass="form-section-card">
                    <Label text="Item Information" styleClass="dialog-section-title,item-section-title"/>
                    <GridPane hgap="18" vgap="8" styleClass="premium-form-grid">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <Label text="Item Code *" styleClass="field-label"/>
                            <TextField fx:id="txtItemCode" editable="false" styleClass="readonly-field"/>
                        </VBox>
                        <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <Label text="Brand" styleClass="field-label"/>
                            <ComboBox fx:id="cmbBrand" promptText="Select brand (optional)" maxWidth="Infinity" styleClass="approved-input"/>
                        </VBox>

                        <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <Label text="Description *" styleClass="field-label"/>
                            <TextField fx:id="txtDescription" promptText="Enter item description" styleClass="approved-input"/>
                            <Label fx:id="errDescription" managed="false" visible="false" styleClass="validation-message"/>
                        </VBox>
                        <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label text="Material" styleClass="field-label"/>
                            <ComboBox fx:id="cmbMaterial" promptText="Select material (optional)" maxWidth="Infinity" styleClass="approved-input"/>
                        </VBox>

                        <VBox spacing="5" GridPane.rowIndex="2" GridPane.columnIndex="0">
                            <Label text="Category *" styleClass="field-label"/>
                            <ComboBox fx:id="cmbCategory" promptText="Select category" maxWidth="Infinity" styleClass="approved-input"/>
                            <Label fx:id="errCategory" managed="false" visible="false" styleClass="validation-message"/>
                        </VBox>
                        <VBox spacing="5" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <Label text="Size" styleClass="field-label"/>
                            <TextField fx:id="txtSize" promptText="Enter size (optional)" styleClass="approved-input"/>
                        </VBox>

                        <VBox spacing="5" GridPane.rowIndex="3" GridPane.columnIndex="0">
                            <Label text="Unit *" styleClass="field-label"/>
                            <ComboBox fx:id="cmbUnit" promptText="Select unit" maxWidth="Infinity" styleClass="approved-input"/>
                            <Label fx:id="errUnit" managed="false" visible="false" styleClass="validation-message"/>
                        </VBox>
                        <VBox spacing="5" GridPane.rowIndex="3" GridPane.columnIndex="1">
                            <Label text="GST % *" styleClass="field-label"/>
                            <ComboBox fx:id="cmbGST" promptText="Select GST %" maxWidth="Infinity" styleClass="approved-input"/>
                            <Label fx:id="errGst" managed="false" visible="false" styleClass="validation-message"/>
                        </VBox>

                        <VBox spacing="5" GridPane.rowIndex="4" GridPane.columnIndex="0">
                            <Label text="Default Discount % *" styleClass="field-label"/>
                            <ComboBox fx:id="cmbDiscount" promptText="Select discount %" maxWidth="Infinity" styleClass="approved-input"/>
                            <Label fx:id="errDiscount" managed="false" visible="false" styleClass="validation-message"/>
                        </VBox>
                        <VBox spacing="5" GridPane.rowIndex="4" GridPane.columnIndex="1">
                            <Label text="HSN Code" styleClass="field-label"/>
                            <TextField fx:id="txtHSN" promptText="Enter HSN code (optional)" styleClass="approved-input"/>
                        </VBox>

                        <VBox spacing="5" GridPane.rowIndex="5" GridPane.columnIndex="0">
                            <Label text="Purchase Price" styleClass="field-label"/>
                            <TextField fx:id="txtPurchasePrice" promptText="0.00" styleClass="numeric-field"/>
                            <Label fx:id="errPurchasePrice" managed="false" visible="false" styleClass="validation-message"/>
                        </VBox>
                        <VBox spacing="5" GridPane.rowIndex="5" GridPane.columnIndex="1">
                            <Label text="Selling Price *" styleClass="field-label"/>
                            <TextField fx:id="txtSellingPrice" promptText="0.00" styleClass="numeric-field"/>
                            <Label fx:id="errSellingPrice" managed="false" visible="false" styleClass="validation-message"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <VBox spacing="10" styleClass="form-section-card">
                    <Label text="Stock Information" styleClass="dialog-section-title,item-section-title"/>
                    <GridPane hgap="18" vgap="8" styleClass="premium-form-grid">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <Label text="Opening Stock *" styleClass="field-label"/>
                            <TextField fx:id="txtOpeningStock" promptText="0.00" styleClass="numeric-field"/>
                            <Label fx:id="errOpeningStock" managed="false" visible="false" styleClass="validation-message"/>
                        </VBox>
                        <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <Label text="Minimum Stock" styleClass="field-label"/>
                            <TextField fx:id="txtMinimumStock" promptText="0.00" styleClass="numeric-field"/>
                            <Label fx:id="errMinimumStock" managed="false" visible="false" styleClass="validation-message"/>
                        </VBox>
                        <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="2">
                            <Label text="Rack Location" styleClass="field-label"/>
                            <TextField fx:id="txtLocation" promptText="Enter rack location (optional)" styleClass="approved-input"/>
                        </VBox>
                        <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="3">
                            <Label text="Remarks" styleClass="field-label"/>
                            <TextArea fx:id="txtRemarks" promptText="Add internal remarks (optional)" prefRowCount="2" wrapText="true" styleClass="approved-input"/>
                        </VBox>
                    </GridPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="entity-dialog-actions,premium-dialog-actions">
            <Button fx:id="btnCancel" text="Cancel" onAction="#closeDialog" styleClass="secondary-button" cancelButton="true"/>
            <Button fx:id="btnSave" text="Save Item" onAction="#saveItem" styleClass="primary-button" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>