<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.CommunicationCenterController" spacing="14" styleClass="register-page">
  <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
  <HBox alignment="CENTER_LEFT"><VBox><Label text="Communication Center" styleClass="screen-title"/><Label text="Track invoice emails, WhatsApp activity and delivery failures" styleClass="screen-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="⚙ Email Settings" onAction="#openEmailSettings" styleClass="secondary-button"/></HBox>
  <HBox spacing="10"><VBox styleClass="metric-card,metric-blue" HBox.hgrow="ALWAYS"><Label text="Total Activity" styleClass="metric-label"/><Label fx:id="lblTotal" styleClass="metric-value"/></VBox><VBox styleClass="metric-card,metric-green" HBox.hgrow="ALWAYS"><Label text="Successful" styleClass="metric-label"/><Label fx:id="lblSuccess" styleClass="metric-value"/></VBox><VBox styleClass="metric-card,metric-red" HBox.hgrow="ALWAYS"><Label text="Failed" styleClass="metric-label"/><Label fx:id="lblFailed" styleClass="metric-value"/></VBox><VBox styleClass="metric-card,metric-purple" HBox.hgrow="ALWAYS"><Label text="Email / WhatsApp" styleClass="metric-label"/><Label fx:id="lblChannels" styleClass="metric-value"/></VBox></HBox>
  <HBox spacing="8"><TextField fx:id="txtSearch" promptText="Search recipient, subject or document..." HBox.hgrow="ALWAYS"/><ComboBox fx:id="cmbChannel" prefWidth="150"/><ComboBox fx:id="cmbStatus" prefWidth="150"/><Button text="Refresh" onAction="#refresh"/></HBox>
  <!-- A constrained table guarantees that Subject remains visible and consumes unused width. -->
  <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="professional-table"><columns><TableColumn fx:id="colTime" text="Date &amp; Time" prefWidth="150"/><TableColumn fx:id="colEntity" text="Document" prefWidth="120"/><TableColumn fx:id="colChannel" text="Channel" prefWidth="100"/><TableColumn fx:id="colRecipient" text="Recipient" prefWidth="220"/><TableColumn fx:id="colSubject" text="Subject" prefWidth="300"/><TableColumn fx:id="colStatus" text="Status" prefWidth="100"/><TableColumn fx:id="colError" text="Result / Error" prefWidth="280"/><TableColumn fx:id="colUser" text="Created By" prefWidth="110"/></columns></TableView>
</VBox>
