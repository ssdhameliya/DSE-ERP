<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.CommunicationCenterController" spacing="14" styleClass="register-page,approved-ui,approved-screen,approved-screen-communication-center">
  <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
  <HBox alignment="CENTER_LEFT"><VBox><Label text="Communication Center" styleClass="screen-title,approved-page-title"/><Label text="Track invoice emails, WhatsApp activity and delivery failures" styleClass="screen-subtitle,approved-page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="⚙ Email Settings" onAction="#openEmailSettings" styleClass="secondary-button,approved-button,approved-secondary-button"/></HBox>
  <HBox spacing="10"><VBox styleClass="metric-card,metric-blue,approved-kpi,approved-surface" HBox.hgrow="ALWAYS"><Label text="Total Activity" styleClass="metric-label"/><Label fx:id="lblTotal" styleClass="metric-value"/></VBox><VBox styleClass="metric-card,metric-green,approved-kpi,approved-surface" HBox.hgrow="ALWAYS"><Label text="Successful" styleClass="metric-label"/><Label fx:id="lblSuccess" styleClass="metric-value"/></VBox><VBox styleClass="metric-card,metric-red,approved-kpi,approved-surface" HBox.hgrow="ALWAYS"><Label text="Failed" styleClass="metric-label"/><Label fx:id="lblFailed" styleClass="metric-value"/></VBox><VBox styleClass="metric-card,metric-purple,approved-kpi,approved-surface" HBox.hgrow="ALWAYS"><Label text="Email / WhatsApp" styleClass="metric-label"/><Label fx:id="lblChannels" styleClass="metric-value"/></VBox></HBox>
  <HBox spacing="8"><TextField fx:id="txtSearch" promptText="Search recipient, subject or document..." HBox.hgrow="ALWAYS" styleClass="approved-input"/><ComboBox fx:id="cmbChannel" prefWidth="150" styleClass="approved-input"/><ComboBox fx:id="cmbStatus" prefWidth="150" styleClass="approved-input"/><Button text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/></HBox>
  <!-- A constrained table guarantees that Subject remains visible and consumes unused width. -->
  <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="professional-table,approved-table"><columns><TableColumn fx:id="colTime" text="Date &amp; Time" prefWidth="150" styleClass="approved-table-column"/><TableColumn fx:id="colEntity" text="Document" prefWidth="120" styleClass="approved-table-column"/><TableColumn fx:id="colChannel" text="Channel" prefWidth="100" styleClass="approved-table-column"/><TableColumn fx:id="colRecipient" text="Recipient" prefWidth="220" styleClass="approved-table-column"/><TableColumn fx:id="colSubject" text="Subject" prefWidth="300" styleClass="approved-table-column"/><TableColumn fx:id="colStatus" text="Status" prefWidth="100" styleClass="approved-table-column"/><TableColumn fx:id="colError" text="Result / Error" prefWidth="280" styleClass="approved-table-column"/><TableColumn fx:id="colUser" text="Created By" prefWidth="110" styleClass="approved-table-column"/></columns></TableView>
</VBox>