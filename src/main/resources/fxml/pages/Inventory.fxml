<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?><?import javafx.scene.chart.*?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.InventoryController" spacing="14" styleClass="register-page,inventory-premium-page,approved-ui,approved-screen,approved-screen-inventory,erp-screen-root">
    <padding><Insets top="18" right="18" bottom="14" left="18"/></padding>
    <HBox alignment="CENTER_LEFT" styleClass="entity-page-header,approved-section-header">
        <VBox spacing="3"><Label text="Stock Register" styleClass="screen-title"/><Label text="Track inventory levels, reservations, valuation and stock movement" styleClass="screen-subtitle"/></VBox>
        <Region HBox.hgrow="ALWAYS"/><Button text="Stock Adjustment" onAction="#adjustStock" styleClass="primary-action,entity-create-button"/>
    </HBox>

    <HBox spacing="12" styleClass="standard-kpi-row,inventory-metrics">
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-blue" HBox.hgrow="ALWAYS"><StackPane fx:id="inventoryTotalIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Total Items" styleClass="metric-label"/><Label fx:id="lblTotalItems" styleClass="metric-value"/><Label text="Inventory records" styleClass="metric-note"/></VBox></HBox>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-green" HBox.hgrow="ALWAYS"><StackPane fx:id="inventoryStockIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="In Stock" styleClass="metric-label"/><Label fx:id="lblInStock" styleClass="metric-value"/><Label text="Healthy stock levels" styleClass="metric-note"/></VBox></HBox>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-orange" HBox.hgrow="ALWAYS"><StackPane fx:id="inventoryLowIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Low Stock" styleClass="metric-label"/><Label fx:id="lblLowStock" styleClass="metric-value"/><Label text="Needs attention" styleClass="metric-note"/></VBox></HBox>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-red" HBox.hgrow="ALWAYS"><StackPane fx:id="inventoryOutIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Out of Stock" styleClass="metric-label"/><Label fx:id="lblOutStock" styleClass="metric-value"/><Label text="Unavailable items" styleClass="metric-note"/></VBox></HBox>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="standard-kpi-card,kpi-purple" HBox.hgrow="ALWAYS"><StackPane fx:id="inventoryValueIcon" styleClass="standard-kpi-icon"/><VBox spacing="4"><Label text="Stock Value" styleClass="metric-label"/><Label fx:id="lblStockValue" styleClass="metric-value"/><Label text="Current purchase valuation" styleClass="metric-note"/></VBox></HBox>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-surface,entity-toolbar,approved-filter-bar,approved-toolbar"><padding><Insets top="11" right="12" bottom="11" left="12"/></padding>
        <TextField fx:id="txtSearch" promptText="Search item code, name, HSN or location..." HBox.hgrow="ALWAYS" styleClass="entity-search"/>
        <ComboBox fx:id="cmbCategory" promptText="All categories" prefWidth="170" styleClass="approved-input"/><ComboBox fx:id="cmbStatus" prefWidth="150" styleClass="approved-input"/>
        <Button fx:id="btnRefresh" text="Refresh" onAction="#refresh" styleClass="approved-button,approved-secondary-button"/><Button text="Export Excel" onAction="#exportExcel" styleClass="secondary-button"/>
    </HBox>

    <SplitPane dividerPositions="1.0" VBox.vgrow="ALWAYS" styleClass="register-split,inventory-split"><items>
        <VBox spacing="0" styleClass="entity-table-card">
            <TableView fx:id="tableItems" VBox.vgrow="ALWAYS" styleClass="professional-table,entity-table,erp-table-profile-master"><placeholder><VBox alignment="CENTER" spacing="8" styleClass="premium-empty-state"><Label text="No stock records found" styleClass="empty-state-title"/><Label text="Adjust the search or create an item in Item Master." styleClass="muted-text"/></VBox></placeholder><columns><TableColumn fx:id="colCode" text="Item Code" prefWidth="110" styleClass="approved-table-column"/><TableColumn fx:id="colDescription" text="Item Name" prefWidth="210" styleClass="approved-table-column"/><TableColumn fx:id="colCategory" text="Category" prefWidth="120" styleClass="approved-table-column"/><TableColumn fx:id="colHsn" text="HSN/SAC" prefWidth="100" styleClass="approved-table-column"/><TableColumn fx:id="colUnit" text="Unit" prefWidth="75" styleClass="approved-table-column"/><TableColumn fx:id="colStock" text="In Stock" prefWidth="90" styleClass="approved-table-column"/><TableColumn fx:id="colReserved" text="Reserved" prefWidth="85" styleClass="approved-table-column"/><TableColumn fx:id="colAvailable" text="Available" prefWidth="90" styleClass="approved-table-column"/><TableColumn fx:id="colMinimum" text="Min Stock" prefWidth="90" styleClass="approved-table-column"/><TableColumn fx:id="colValue" text="Value" prefWidth="110" styleClass="approved-table-column"/><TableColumn fx:id="colStatus" text="Status" prefWidth="100" styleClass="approved-table-column"/><TableColumn fx:id="colActions" text="" prefWidth="105" styleClass="approved-table-column"/></columns></TableView>
        </VBox>
        <VBox spacing="12" managed="false" visible="false" styleClass="detail-drawer,inventory-insights-card"><padding><Insets top="16" right="14" bottom="16" left="14"/></padding>
            <HBox alignment="CENTER_LEFT"><VBox spacing="2"><Label text="Inventory Insights" styleClass="drawer-title"/><Label text="Live stock distribution and selection details" styleClass="muted-text"/></VBox></HBox>
            <Label text="Stock by Category" styleClass="drawer-section"/><PieChart fx:id="categoryChart" prefHeight="245" legendVisible="true"/>
            <Separator/>
            <Label text="Selected Item" styleClass="drawer-section"/><Label fx:id="lblSelectedItem" styleClass="drawer-document" wrapText="true"/><Label fx:id="lblSelectedDetail" wrapText="true" styleClass="selected-item-detail"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="View Stock History" onAction="#viewSelectedHistory" maxWidth="Infinity" styleClass="secondary-button,drawer-action"/>
            <Button text="Adjust Selected Stock" onAction="#adjustSelectedStock" maxWidth="Infinity" styleClass="primary-button,drawer-action"/>
        </VBox>
    </items></SplitPane>
</VBox>